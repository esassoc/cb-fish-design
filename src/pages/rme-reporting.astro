---
// /rme-reporting — the "RM&E Reporting: Summary" area landing page. Lands
// anyone browsing Reporting on what RM&E is and why BPA funds it, then
// branches into the area's sub-pages via the tab strip — today just the
// RM&E Work Elements Report; more will land here as they're built. No prod
// equivalent exists to lift a photo/menu from (unlike /biop-reporting's
// BiOpReporting.mvc/Index) — the summary text was supplied directly; the
// hero photo reuses /project-budgets-hero.jpg (a Columbia Basin stream shot
// already in this spoke) rather than inventing a new asset for one page.
// Mirrors /project-budgets and /biop-reporting, the sibling Report Center
// summary pages this pattern (tab strip + photo/prose intro) was built for.
// Thin assembler: chrome from cbf-* shared components, content from cbf-* sections.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../components/shared/cbf-page-heading.astro';
import CbfReportTabs from '../components/shared/cbf-report-tabs.astro';
import CbfReportIntro from '../components/shared/cbf-report-intro.astro';
import { rmeReportingTabs } from '../components/shared/rme-reporting-tabs';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Reporting' },
  { label: 'RM&E Reporting' },
];

const intro = {
  image: {
    src: withBase('/project-budgets-hero.jpg'),
    alt: 'A Columbia River Gorge stream in autumn',
  },
  lede: "Research, monitoring, and evaluation (RM&E) is the process by which BPA assesses whether Fish & Wildlife Program investments are achieving their intended biological outcomes.",
  body: "BPA funds RM&E activities across the Columbia River Basin to track the status and trends of fish and wildlife populations, measure the effectiveness of habitat and other restoration actions, and evaluate overall program performance. Data collected through RM&E contractual work efforts informs investment decisions and supports adaptive management: the iterative process of implementing actions, evaluating results, and making adjustments based on what the data show. BPA's RM&E approach is guided by the Northwest Power and Conservation Council's Fish & Wildlife Program and involves collaborations with fish and wildlife managers, project sponsors, NOAA Fisheries, and other regional partners.",
};
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - top nav       -> cbf-public-nav
    - page frame    -> esa-container
    - page heading  -> cbf-page-heading
    - sub-nav tabs  -> cbf-report-tabs
    - intro band    -> cbf-report-intro
-->
<BaseLayout title="RM&amp;E Reporting: Summary — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPageHeading title="RM&E Reporting: Summary" />
        <CbfReportTabs tabs={rmeReportingTabs('summary')} ariaLabel="RM&E reporting sections" />
        <CbfReportIntro image={intro.image} lede={intro.lede} body={intro.body} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
