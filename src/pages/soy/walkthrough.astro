---
// /soy/walkthrough — the client-facing entry point to the SOY future-state
// prototype: how to use it, the FY2028 story as seven linked steps, the
// decisions we need with our recommendation, and the problem-to-change map.
//
// Thin assembler: chrome from cbf-* shared components, content from
// cbf-soy-walkthrough (which reads src/lib/soy/changes.ts at build time).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../../components/shared/cbf-page-heading.astro';
import CbfSoyWalkthrough from '../../components/soy/cbf-soy-walkthrough.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Funding' },
  { label: 'Project budgets', href: withBase('/project-budgets') },
  { label: 'Start-of-year (SOY)', href: withBase('/soy') },
  { label: 'Walkthrough' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel       # page spine — width frame + app-page chrome
  sections:
    - top nav      -> cbf-public-nav
    - page heading -> cbf-page-heading
    - walkthrough  -> cbf-soy-walkthrough  (how-to, 7 step cards, decisions table, problem map, scope)
-->
<BaseLayout title="SOY future state: Walkthrough — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />
  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPageHeading title="SOY future state: Walkthrough" />
        <CbfSoyWalkthrough />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
