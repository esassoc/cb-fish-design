---
// /invoice-review/<number> — the COR's full-page invoice PROCESSING surface,
// reached from the "Process invoice" button on the Dashboard → My Invoices queue
// overlay. One page per invoice (getStaticPaths over the review queue). This is
// where the heavy work lives: the document viewer (invoice + Line Item Budget +
// backups, side by side), and the Approve / Return-for-revision decision — all
// moved off the lightweight queue preview so that stays a quick glance.
//
// Thin assembler: esa-container + cbf-app-panel chrome; the processing surface is
// the cbf-invoice-processor component. Modeled on the vendor invoice form's
// full-page document-left / panel-right workspace.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../../components/shared/cbf-app-panel.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfInvoiceProcessor from '../../components/invoice-review/cbf-invoice-processor.astro';
import { withBase } from '../../lib/base';
import { reviewQueue } from '../../data/invoice-review.mjs';

// One static page per invoice in the queue. Invoice numbers (e.g. INV-2026-0051)
// are already URL-safe, so they map straight to the [number] route param.
export function getStaticPaths() {
  return reviewQueue.map((invoice) => ({
    params: { number: invoice.number },
    props: { invoice },
  }));
}

const { invoice } = Astro.props;

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Dashboard', href: withBase('/my-work#invoices') },
  { label: invoice.number },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav                 -> cbf-public-nav
    - page header         -> esa-page-header
    - processing surface  -> cbf-invoice-processor (doc viewer + budget + approve/return)
-->
<BaseLayout title={`Process ${invoice.number} — Columbia Basin Fish & Wildlife Program`}>
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <EsaPageHeader
          eyebrow={`${invoice.vendor} · ${invoice.contract}`}
          title={`Process invoice ${invoice.number}`}
        />
        <CbfInvoiceProcessor invoice={invoice} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
