---
// CBFish — Pattern library (coming soon). A placeholder that sets the direction:
// composed, multi-component patterns assembled from the design system. Two cbf-*
// section components (the hero + the "what's coming" grid of esa-card tiles).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfSoonHero from '../../components/patterns/cbf-soon-hero.astro';
import CbfSoonPlanned from '../../components/patterns/cbf-soon-planned.astro';
import { withBase } from '../../lib/base';

const planned = [
  { title: 'Application page shell', body: 'The standard chrome — admin bar, header nav, breadcrumb strip, sidebar + content card.' },
  { title: 'Report & data views', body: 'Filterable report center, result lists, stat tiles, and the empty / loading states.' },
  { title: 'Search & filter flows', body: 'The command palette, faceted results page, and the filter pill patterns working together.' },
  { title: 'Form flows', body: 'Multi-step forms, validation, and review — composed from the form primitives.' },
];
---
<!-- manifest:
  layout: stack
  sections:
    - coming-soon hero -> cbf-soon-hero
    - planned grid     -> cbf-soon-planned
-->
<BaseLayout title="CBFish — Pattern library (coming soon)">
  <main class="soon">
    <CbfSoonHero backHref={withBase('/')} ctaHref={withBase('/design-system')} />
    <CbfSoonPlanned planned={planned} />
  </main>
</BaseLayout>

<style>
  /* page-level centering + outer rhythm only — sections are cbf-* components */
  .soon { max-width: 1040px; margin: 0 auto; padding: var(--spacing-600) var(--spacing-500) var(--spacing-900); }
</style>
