---
import ComponentDoc from '../../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Preview from '@esa/docs/Preview.astro';
import Api from '@esa/docs/Api.astro';
import EsaAppBar from '@esa/ecology/esa-app-bar.astro';
import EsaIconLink from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';

const props = [
  { name: 'tone', type: "'surface' | 'brand' | 'brand-strong'", default: "'surface'", description: 'Color context. surface → --color-background-elevation-raised/text-primary; brand → --color-background-brand/text-inverse; brand-strong → --color-background-default-knockout/text-inverse. Children inherit the text color.' },
  { name: 'contained', type: 'boolean', default: 'false', description: 'Constrain the inner row to maxWidth and center it.' },
  { name: 'maxWidth', type: 'string', default: "'1556px'", description: 'Inner row max-width when contained.' },
  { name: 'as', type: "'header' | 'nav' | 'footer' | 'div'", default: "'div'", description: 'Semantic host element.' },
];
---
<ComponentDoc
  name="App bar"
  category="Navigation"
  slug="esa-app-bar"
  type=".astro"
  summary="The inherited Ecology chrome shell, wearing the CBFish skin. It sets a color context from semantic tokens via <code>tone</code> — the <code>brand</code> tone resolves to CBFish navy from <code>--color-background-brand</code> — then exposes start / default / end slots. This is the shell behind the CBFish public nav."
>
  <Section id="tones" title="Tones">
    <p>Each tone maps to ecology semantic tokens; CBFish re-themes by re-pointing those tokens (e.g. <code>--color-background-brand</code>, <code>--color-background-default-knockout</code>) — never by touching this component.</p>
    <Preview align="start" code={`<EsaAppBar tone="surface">…</EsaAppBar>\n<EsaAppBar tone="brand">…</EsaAppBar>\n<EsaAppBar tone="brand-strong">…</EsaAppBar>`}>
      <div style="display:flex;flex-direction:column;gap:12px;width:100%">
        <EsaAppBar tone="surface">
          <EsaIconLink variant="chrome" icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink variant="chrome" icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton variant="chrome" iconOnly slot="end" icon="search" label="Search" />
        </EsaAppBar>
        <EsaAppBar tone="brand">
          <EsaIconLink variant="chrome" icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink variant="chrome" icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton variant="chrome" iconOnly slot="end" icon="search" label="Search" />
        </EsaAppBar>
        <EsaAppBar tone="brand-strong">
          <EsaIconLink variant="chrome" icon="trees">Mitigation work</EsaIconLink>
          <EsaIconLink variant="chrome" icon="trending-up">Reporting</EsaIconLink>
          <EsaIconButton variant="chrome" iconOnly slot="end" icon="search" label="Search" />
        </EsaAppBar>
      </div>
    </Preview>
  </Section>

  <Section id="slots" title="Slots: start · main · end">
    <p>The <code>end</code> slot is pushed right with <code>margin-left:auto</code>. This is the whole anatomy of a top bar — the CBFish brand header is exactly this.</p>
    <Preview align="start" code={`<EsaAppBar tone="brand" as="header">\n  <span slot="start"><strong>CBFish</strong></span>\n  <EsaIconLink variant="chrome" icon="trees" iconRight="chevron-down">Mitigation work</EsaIconLink>\n  <EsaIconLink variant="chrome" icon="trending-up" iconRight="chevron-down">Reporting</EsaIconLink>\n  <EsaIconLink variant="chrome" icon="credit-card" iconRight="chevron-down">Funding</EsaIconLink>\n  <EsaIconButton variant="chrome" iconOnly slot="end" icon="search" label="Search" />\n  <EsaIconLink variant="chrome" slot="end" href="/dashboard" icon="layout-dashboard">Dashboard</EsaIconLink>\n</EsaAppBar>`}>
      <EsaAppBar tone="brand" as="header">
        <span slot="start" style="font-weight:700;font-size:18px">CB&nbsp;Fish</span>
        <EsaIconLink variant="chrome" icon="trees" iconRight="chevron-down">Mitigation work</EsaIconLink>
        <EsaIconLink variant="chrome" icon="trending-up" iconRight="chevron-down">Reporting</EsaIconLink>
        <EsaIconLink variant="chrome" icon="credit-card" iconRight="chevron-down">Funding</EsaIconLink>
        <EsaIconButton variant="chrome" iconOnly slot="end" icon="search" label="Search" />
        <EsaIconLink variant="chrome" slot="end" href="/dashboard" icon="layout-dashboard">Dashboard</EsaIconLink>
      </EsaAppBar>
    </Preview>
  </Section>

  <Section id="api" title="API">
    <Api props={props} />
  </Section>
</ComponentDoc>
