---
import ComponentDoc from '../../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Preview from '@esa/docs/Preview.astro';
import Api from '@esa/docs/Api.astro';
import Badge from '@esa/ecology/esa-badge.astro';

const props = [
  { name: 'value', type: 'string | number', description: 'Text or count shown inside the badge. Ignored in dot mode.' },
  { name: 'variant', type: "'primary' | 'secondary' | 'success' | 'warning' | 'danger' | 'info'", default: "'primary'", description: 'Background color intent.' },
  { name: 'size', type: "'xs' | 'sm' | 'md' | 'lg'", default: "'md'", description: 'Badge height and text size.' },
  { name: 'dot', type: 'boolean', default: 'false', description: 'Renders a small status dot with no text.' },
];
---
<ComponentDoc
  name="Badge"
  category="Display"
  slug="esa-badge"
  type=".astro"
  summary="The inherited Ecology badge, wearing the CBFish skin. A small pill for counts, statuses, and labels; the primary variant picks up brand navy from <code>--color-primary</code>."
>
  <Section id="preview" title="Preview">
    <Preview code={`<Badge value="New" />`}>
      <Badge value="New" />
    </Preview>
  </Section>

  <Section id="variants" title="Variants">
    <Preview code={`<Badge value="Primary" variant="primary" />\n<Badge value="Secondary" variant="secondary" />\n<Badge value="Success" variant="success" />\n<Badge value="Warning" variant="warning" />\n<Badge value="Danger" variant="danger" />\n<Badge value="Info" variant="info" />`}>
      <Badge value="Primary" variant="primary" />
      <Badge value="Secondary" variant="secondary" />
      <Badge value="Success" variant="success" />
      <Badge value="Warning" variant="warning" />
      <Badge value="Danger" variant="danger" />
      <Badge value="Info" variant="info" />
    </Preview>
  </Section>

  <Section id="sizes" title="Sizes">
    <Preview code={`<Badge value="3" size="xs" />\n<Badge value="9" size="sm" />\n<Badge value="42" size="md" />\n<Badge value="128" size="lg" />`}>
      <Badge value="3" size="xs" />
      <Badge value="9" size="sm" />
      <Badge value="42" size="md" />
      <Badge value="128" size="lg" />
    </Preview>
  </Section>

  <Section id="dot" title="Dot mode">
    <p>With <code>dot</code>, the badge collapses to an 8px circle — useful as an inline status indicator next to a label.</p>
    <Preview code={`<Badge dot variant="success" />\n<Badge dot variant="warning" />\n<Badge dot variant="danger" />`}>
      <Badge dot variant="success" />
      <Badge dot variant="warning" />
      <Badge dot variant="danger" />
    </Preview>
  </Section>

  <Section id="api" title="API">
    <Api props={props} />
  </Section>
</ComponentDoc>
