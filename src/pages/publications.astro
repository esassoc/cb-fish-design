---
// /publications — the document (full-text) search results page (CBF-8117).
// Publications "fork" out of the unified /search into this prod-style flow
// ("Publications search → By text in documents"): a tabbed search-mode strip, a
// Search/Clear toolbar, and [pdf]-badged document hits with green Viewer paths. Same
// app-page panel as /search. Rows + filtering are painted by publications-page.client.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../components/shared/cbf-page-heading.astro';
import CbfPubsTabs from '../components/publications/cbf-pubs-tabs.astro';
import CbfPubsToolbar from '../components/publications/cbf-pubs-toolbar.astro';
import CbfPubsResults from '../components/publications/cbf-pubs-results.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Interactive Data and Reports' },
  { label: 'Publications search' },
  { label: 'By text in documents' },
];

// Search modes mirror prod; only "By text in documents" is wired in this prototype.
const tabs = [
  { label: 'By Title, Description, Type, Author or Publish Date' },
  { label: 'By Project and Contract' },
  { label: 'By Document ID' },
  { label: 'By text in documents', active: true },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel       # page spine — width frame + app-page chrome
  sections:
    - top nav      -> cbf-public-nav
    - page frame   -> esa-container
    - page heading -> cbf-page-heading
    - search modes -> cbf-pubs-tabs
    - toolbar      -> cbf-pubs-toolbar
    - results      -> cbf-pubs-results
-->
<BaseLayout title="Publications search — Columbia Basin Fish & Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page" data-pubs-page>
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPageHeading title="By text in documents" />
        <CbfPubsTabs tabs={tabs} />
        <CbfPubsToolbar />
        <CbfPubsResults />
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <script>
    import { initPublicationsPage } from '../components/search/publications-page.client';
    initPublicationsPage();
  </script>
</BaseLayout>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
