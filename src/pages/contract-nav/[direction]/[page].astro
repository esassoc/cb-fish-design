---
// /contract-nav/{a|b}/{page} — the contract header nav prototype (brief: cbfish-nav-header).
// One route per contract page per direction: 27 pages × 2. Only the header differs
// between A and B; the body below it is a placeholder, because the pages themselves
// do not change.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../../../components/shared/cbf-app-panel.astro';
import CbfPrototypeStrip from '../../../components/shared/cbf-prototype-strip.astro';
import CbfRoleSwitch from '../../../components/shared/cbf-role-switch.astro';
import CbfRouteSwitch from '../../../components/shared/cbf-route-switch.astro';
import CbfRecordHeader from '../../../components/contract-nav/cbf-record-header.astro';
import CbfRecordMenus from '../../../components/contract-nav/cbf-record-menus.astro';
import CbfRecordLifecycle from '../../../components/contract-nav/cbf-record-lifecycle.astro';
import CbfRecordPageTitle from '../../../components/contract-nav/cbf-record-page-title.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../../../lib/base';
import { ALL_PAGES, DIRECTIONS, NAV_ROLES, NAV_ROLE_KEY, contract, findPage } from '../../../data/contract-nav.mjs';

export function getStaticPaths() {
  return DIRECTIONS.flatMap((d) => ALL_PAGES.map((p) => ({ params: { direction: d.key, page: p.slug } })));
}

const { direction, page: slug } = Astro.params as { direction: 'a' | 'b'; page: string };
const page = findPage(slug)!;
const base = withBase(`/contract-nav/${direction}`);

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  // Links above the contract leave this prototype; they go to Home as stand-ins.
  { label: 'Projects', href: withBase('/home') },
  { label: contract.project, href: withBase('/home') },
  { label: 'Contracts', href: withBase('/home') },
  { label: contract.number, href: `${base}/summary` },
  { label: page.label },
];
const views = DIRECTIONS.map((d) => ({ key: d.key, label: d.label, href: withBase(`/contract-nav/${d.key}/${slug}`) }));
---
<!-- manifest:
  layout: esa-container > cbf-prototype-strip + cbf-app-panel
  sections:
    - nav              -> cbf-public-nav          (shared)
    - page frame       -> esa-container           (1920px max, holds the strip and the panel)
    - prototype strip  -> cbf-prototype-strip     (shared; direction switch + role lens)
    - direction switch -> cbf-route-switch        (shared; A menus ⇄ B lifecycle, same page)
    - role lens        -> cbf-role-switch         (shared; system admin, BPA COR, contractor)
    - contract frame   -> cbf-app-panel           (shared; breadcrumb strip)
    - record header    -> cbf-record-header       (number, title, status; nav slotted under)
    - nav, A           -> cbf-record-menus        (one menu per tab)
    - nav, B           -> cbf-record-lifecycle    (Overview · phase track · Files)
    - page body        -> cbf-record-page-title   (placeholder: the page's name only)
-->
<BaseLayout title={`${contract.number}: ${page.label} — Columbia Basin Fish & Wildlife Program`}>
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfPrototypeStrip note="One contract, two header directions. Contract dates and status are mock.">
        <CbfRouteSwitch views={views} active={direction} label="Header" />
        <CbfRoleSwitch roles={NAV_ROLES} storageKey={NAV_ROLE_KEY} />
      </CbfPrototypeStrip>

      <CbfAppPanel crumbs={crumbs} overflow="visible">
        <CbfRecordHeader eyebrow={`Contract ${contract.number}`} title={contract.title} status={contract.status}>
          {direction === 'a' ? <CbfRecordMenus current={slug} base={base} /> : <CbfRecordLifecycle current={slug} base={base} />}
        </CbfRecordHeader>
        <CbfRecordPageTitle title={page.label} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
