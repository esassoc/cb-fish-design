---
// /contract-nav/v2/wse/{letter}/{tab} — a work statement element's page in round 4's
// "SOW hub" variation (research: docs/private/briefs/cbfish-nav-header/research-wse.md).
// The contract header stays above it with the SOW menu filled; the WSE header carries
// the revision, the WSE, the switcher and the sub-tabs; the body is a placeholder.
import CbfContractFrame from '../../../../../components/contract-nav/cbf-contract-frame.astro';
import CbfWseHeader from '../../../../../components/contract-nav/cbf-wse-header.astro';
import CbfSkeletonBody from '../../../../../components/shared/cbf-skeleton-body.astro';
import { withBase } from '../../../../../lib/base';
import {
  CONTRACT_TABS_V2,
  STAGES_V2,
  WSES,
  WSE_REVISION,
  WSE_TABS,
  headerViews,
} from '../../../../../data/contract-nav-v2.mjs';

export function getStaticPaths() {
  return WSES.flatMap((w) => WSE_TABS.map((t) => ({ params: { wse: w.letter.toLowerCase(), tab: t.key } })));
}

const { wse: letter, tab } = Astro.params as { wse: string; tab: string };
const wse = WSES.find((w) => w.letter.toLowerCase() === letter)!;
const tabLabel = WSE_TABS.find((t) => t.key === tab)!.label;
const base = withBase('/contract-nav/v2');
const revision = `SOW Rev ${WSE_REVISION.rev}, ${WSE_REVISION.type}`;
const seed = WSES.indexOf(wse) + WSE_TABS.findIndex((t) => t.key === tab);
const views = headerViews('sow').map((v) => ({ ...v, href: withBase(v.path) }));
---
<!-- manifest:
  layout: cbf-contract-frame > WSE header + body
  sections:
    - contract frame      -> cbf-contract-frame      (site nav, record card with header, Overview/SOW/Files and lifecycle track, role gate, prototype controls)
    - WSE header          -> cbf-wse-header          (revision line back to SOW, WSE title, searchable switcher, sub-tabs with needs-input flags)
    - page body           -> cbf-skeleton-body       (static gray placeholder; WSE page bodies not in scope)
-->
<CbfContractFrame
  tabs={CONTRACT_TABS_V2}
  ends={['overview', 'sow', 'files']}
  stages={STAGES_V2}
  base={base}
  current="sow"
  crumbs={[
    { label: 'SOW', href: `${base}/sow` },
    { label: `Rev ${WSE_REVISION.rev}`, href: `${base}/sow` },
    { label: `WE ${wse.letter}`, href: `${base}/wse/${letter}/summary` },
    { label: tabLabel },
  ]}
  title={`Rev ${WSE_REVISION.rev}: WE ${wse.letter}: ${tabLabel}`}
  views={views}
  activeView="sow-hub"
>
  <CbfWseHeader
    wse={wse}
    wses={WSES}
    tabs={WSE_TABS}
    tab={tab}
    revision={revision}
    sowHref={`${base}/sow`}
    wseBase={`${base}/wse`}
  />
  <CbfSkeletonBody seed={seed} />
</CbfContractFrame>
