---
// /lib-entry-wizard — the THIRD version of the vendor's Line Item Budget entry
// screen. /lib-entry and /lib-entry-sheet are unchanged and both still ship.
//
// THE THREE BETS, IN ONE PLACE
//   /lib-entry         a live control in every grid cell; a new line is appended
//                      inline. The whole web of cross-line dependencies stays
//                      visible while you type — you watch fringe follow a salary
//                      line and a phone line follow a position's months.
//   /lib-entry-sheet   a read-only ledger; every create and edit happens on a
//                      side sheet, where a field can finally carry a real label,
//                      its own help text and its own error.
//   /lib-entry-wizard  (this) ONE CATEGORY PER STEP, front to back. Nothing is on
//                      screen except the step being answered.
//
// WHY A WIZARD IS A REAL OPTION HERE
// A LIB has nine categories that do not resemble each other, and both other
// versions have to answer all nine with one set of columns or one form. A wizard
// does not: each category gets its own page, its own rules in words, its own
// vocabulary and its own subtotal. It also gives the screen a beginning and an
// end — which is the thing a first-time vendor actually lacks, because a grid
// never tells you whether you are finished, only what is currently wrong.
//
// AND WHAT IT COSTS, STATED HONESTLY
// The dependencies go off-screen. Fringe is generated on another step; a
// cell-phone line's months follow a position two steps back; indirect is a
// percentage of eight of the nine. The wizard pays that back four ways, all of
// them in cbf-libw-wizard: the reconciliation rail never leaves, every gate ROLLS
// UP to a badge on the stepper, a dependent card flashes when an edit on another
// step moves it, and the Fringe step says out loud that it was filled in for you.
//
// REUSED UNCHANGED from /lib-entry — the same test the side-sheet version had to
// pass. The surfaces that are not about ENTERING a line should not be able to
// tell which entry model is mounted: the context header, the reconciliation rail,
// the overhead block, the review panel and the subcontract jump-out all talk over
// the same `cbf-lib:*` document events.
//
// NO ROLE SWITCH, DELIBERATELY. A wizard is a vendor construct — a reviewer does
// not walk a ten-step creation flow to read someone else's finished budget, and a
// COR lens here would be nine steps of read-only cards. The COR's marks still
// appear on the cards they belong to, read-only, and the change list is on the
// Review step; MARKING a line stays on /lib-entry and /lib-entry-sheet, which is
// where a reviewer sees the whole budget at once.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfContractTabs from '../components/shared/cbf-contract-tabs.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfPrototypeStrip from '../components/shared/cbf-prototype-strip.astro';
import CbfLibViewSwitch from '../components/lib-entry/cbf-lib-view-switch.astro';
import CbfLibContextHeader from '../components/lib-entry/cbf-lib-context-header.astro';
import CbfLibSubcontractSheet from '../components/lib-entry/cbf-lib-subcontract-sheet.astro';
import CbfLibwWizard from '../components/lib-entry-wizard/cbf-libw-wizard.astro';
import { withBase } from '../lib/base';
import { contract, contractTabs } from '../data/lib-entry.mjs';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Projects' },
  { label: contract.project },
  { label: 'Contracts' },
  { label: contract.number },
  { label: 'LIB' },
];
---
<!-- manifest:
  layout: esa-container > cbf-prototype-strip + cbf-app-panel > stack
  sections:
    - nav                -> cbf-public-nav             (shared)
    - prototype strip    -> cbf-prototype-strip        (shared — the dashed frame; no role lens on this screen)
    - entry model switch -> cbf-lib-view-switch        (REUSED — grid ⇄ side sheet ⇄ wizard)
    - contract frame     -> cbf-app-panel              (shared — breadcrumb strip)
    - contract tab bar   -> cbf-contract-tabs          (shared — LIB active)
    - header strip       -> cbf-lib-context-header     (REUSED from /lib-entry, unchanged)
    - the wizard         -> cbf-libw-wizard            (NEW — stepper + 11 steps + pinned nav;
                                                        composes cbf-libw-stepper, cbf-libw-step,
                                                        cbf-libw-line-form, cbf-libw-review-step,
                                                        and REUSES cbf-lib-reconcile-rail,
                                                        cbf-lib-indirect-config, cbf-lib-review-panel)
    - subcontract sheet  -> cbf-lib-subcontract-sheet  (REUSED — the jump-out stub)
-->
<BaseLayout title="Line Item Budget entry (wizard) — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1600px">
      <!-- The strip carries ONE device here. No role lens: this screen is a
           vendor construct, and a COR does not walk a ten-step creation flow to
           read someone else's finished budget (see the note at the top of this
           file) — so the frame holds the jump to the other two versions and
           nothing else. -->
      <CbfPrototypeStrip note="One category per step. The grid and the side-sheet versions of this budget are one click away.">
        <CbfLibViewSwitch active="wizard" />
      </CbfPrototypeStrip>

      <CbfAppPanel crumbs={crumbs}>
        <CbfContractTabs tabs={contractTabs} active="lib" />

        <CbfLibContextHeader />

        <CbfLibwWizard />
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <!-- The subcontract jump-out — opened by a card on the Subcontracts step. -->
  <CbfLibSubcontractSheet />

  <esa-snackbar-container data-snackbar></esa-snackbar-container>

  <script>
    import '@esa/ecology/esa-snackbar-container';
  </script>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
  /* The stepper sticks to the top and the nav to the bottom, so the panel must
     NOT clip — and the add-line esa-dropdown-menu positions absolutely and
     cannot escape a clipping ancestor either. Page-scoped, so /search and
     /publications keep their clipping. */
  .cbf-page :global(.cbf-app-panel) { overflow: visible; }
</style>
