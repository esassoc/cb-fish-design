---
// /invoice-review — the COR's (Contracting Officer's Representative) review queue.
// The reviewer lands here to triage every invoice assigned to their contracts by
// the review-by clock, then opens one to QA/QC the submitted document in detail.
// Thin assembler: esa-container + cbf-app-panel chrome; all content is components.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import CbfReviewTriageStrip from '../components/invoice-review/cbf-review-triage-strip.astro';
import CbfInvoiceReviewQueue from '../components/invoice-review/cbf-invoice-review-queue.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';
import { reviewQueue, reviewer, deriveTriage, fmtExact } from '../data/invoice-review.mjs';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/'), icon: homeIcon },
  { label: 'Invoice review' },
];

const triage = deriveTriage(reviewQueue);
const caption = `${reviewer.role} · across your assigned contracts`;
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav            -> cbf-public-nav
    - page header    -> esa-page-header
    - urgency triage -> cbf-review-triage-strip
    - review queue   -> cbf-invoice-review-queue
-->
<BaseLayout title="Invoice review — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <EsaPageHeader
          eyebrow={reviewer.name}
          title="Invoices awaiting your review"
          lede="Review submitted invoices against the contract before they move to payment. Act before the review-by date on each."
        />
        <CbfReviewTriageStrip
          open={triage.open}
          overdue={triage.overdue}
          dueSoon={triage.dueSoon}
          awaiting={fmtExact(triage.awaitingAmount)}
          caption={caption}
        />
        <CbfInvoiceReviewQueue invoices={reviewQueue} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
