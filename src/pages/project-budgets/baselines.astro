---
// /project-budgets/baselines — the Baselines sub-page of the Project budgets
// area, built to CBF-8142: a FundManager reviews per-project baseline budgets
// for the fiscal year and bulk-uploads updates via a validated template flow
// (download → enter in bulk → upload → review errors → re-upload → apply).
// Thin assembler: chrome from cbf-* shared components, content from the two
// cbf-baselines-* sections.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../../components/shared/cbf-page-heading.astro';
import CbfReportTabs from '../../components/shared/cbf-report-tabs.astro';
import CbfBaselinesUpload from '../../components/project-budgets/cbf-baselines-upload.astro';
import CbfBaselinesTable from '../../components/project-budgets/cbf-baselines-table.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Funding' },
  { label: 'Project budgets', href: withBase('/project-budgets') },
  { label: 'Baselines' },
];

// Sub-nav: Baselines is this page; Summary links back to the landing; the
// remaining detail pages aren't built yet (href='#').
const tabs = [
  { label: 'Summary', href: withBase('/project-budgets') },
  { label: 'Baselines', active: true },
  { label: 'Start-of-year (SOY)' },
  { label: 'Decisions' },
  { label: 'Change requests (BOG)' },
];

const related = [
  { title: 'Reviews', href: '#' },
  { title: 'Featured reviews', href: '#' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel       # page spine — width frame + app-page chrome
  sections:
    - top nav       -> cbf-public-nav
    - page frame    -> esa-container
    - page heading  -> cbf-page-heading
    - sub-nav tabs  -> cbf-report-tabs
    - bulk upload   -> cbf-baselines-upload   # the CBF-8142 flow
    - baselines     -> cbf-baselines-table
-->
<BaseLayout title="Project budgets: Baselines — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPageHeading title="Project budgets: Baselines" />
        <CbfReportTabs tabs={tabs} related={related} ariaLabel="Project budget sections" />
        <CbfBaselinesUpload />
        <CbfBaselinesTable />
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <esa-snackbar-container data-snackbar></esa-snackbar-container>
</BaseLayout>

<script>
  import '@esa/ecology/esa-snackbar-container';
</script>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
