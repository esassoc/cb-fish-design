---
// /search — full results page (CBF-8117), the CBFish Modernization "Report Center v2"
// (Figma 2614:11113). A manifest of components on the app-page panel; result rows +
// the scope vocabulary are painted by search-page.client from the shared omni-render
// core, so they stay pixel-identical to the ⌘K palette.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfSearchFacets from '../components/search/cbf-search-facets.astro';
import CbfPageHeading from '../components/shared/cbf-page-heading.astro';
import CbfSearchField from '../components/search/cbf-search-field.astro';
import CbfSearchResults from '../components/search/cbf-search-results.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Search' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel       # page spine — width frame + app-page chrome
  sections:
    - top nav       -> cbf-public-nav
    - page frame    -> esa-container
    - scope rail    -> cbf-search-facets     # panel sidebar slot
    - page heading  -> cbf-page-heading
    - access notice -> esa-alert-box
    - omnibox       -> cbf-search-field
    - results       -> cbf-search-results
-->
<BaseLayout title="Search — Columbia Basin Fish & Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page" data-search-page>
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfSearchFacets slot="sidebar" />
        <CbfPageHeading title="Search" data-search-title />
        <EsaAlertBox variant="info">
          Results are limited to records you have permission to view.
        </EsaAlertBox>
        <CbfSearchField data-search-input placeholder="Search projects, contracts, people, publications…" />
        <CbfSearchResults />
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <script>
    import { initSearchPage } from '../components/search/search-page.client';
    initSearchPage();
  </script>
</BaseLayout>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
