---
// /lib-pi-editing — CBF-8204: a supportive, fully explained process for unlocking
// Line Item Budget & Property Inventory document edits under select business
// conditions (award-state × role rule tiers), with notices to CORs when
// already-approved documents are edited. Thin assembler: all behavior lives in
// the lib-pi-editing components + src/data/lib-pi-editing.mjs.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfDocDemoControls from '../components/lib-pi-editing/cbf-doc-demo-controls.astro';
import CbfLibPiDocuments from '../components/lib-pi-editing/cbf-lib-pi-documents.astro';
import CbfDocRulesPanel from '../components/lib-pi-editing/cbf-doc-rules-panel.astro';
import { withBase } from '../lib/base';
import { contract } from '../data/lib-pi-editing.mjs';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Projects & contracts' },
  { label: contract.project },
  { label: 'Contracts' },
  { label: contract.number },
  { label: 'Documents' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav              -> cbf-public-nav
    - page header      -> esa-page-header
    - demo switcher    -> cbf-doc-demo-controls   (prototype-only)
    - docs + workflow  -> cbf-lib-pi-documents    (tabs, tables, dialogs, email mock)
    - rules explainer  -> cbf-doc-rules-panel
-->
<BaseLayout title="LIB &amp; PI document editing — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <EsaPageHeader
          eyebrow={contract.label}
          title="LIB & PI document editing"
          lede="Replace a Line Item Budget or Property Inventory file without deleting it and re-entering its specifications. What you can do depends on where the award is in its lifecycle — and the COR is notified whenever an already-approved document changes."
        />
        <CbfDocDemoControls />
        <CbfLibPiDocuments />
        <CbfDocRulesPanel />
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <!-- Toast stack for the lightweight confirmations (copy link, replace, save). -->
  <esa-snackbar-container data-snackbar></esa-snackbar-container>

  <script>
    import '@esa/ecology/esa-snackbar-container';
  </script>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
