---
// /lib-pi-editing — CBF-8204: a supportive, fully explained process for unlocking
// Line Item Budget & Property Inventory document edits under select business
// conditions (award-state × role rule tiers), with notices to CORs when
// already-approved documents are edited. Thin assembler: all behavior lives in
// the lib-pi-editing components + src/data/lib-pi-editing.mjs.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfContractShell from '../components/contract-shell/cbf-contract-shell.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfDocDemoControls from '../components/lib-pi-editing/cbf-doc-demo-controls.astro';
import CbfLibPiDocuments from '../components/lib-pi-editing/cbf-lib-pi-documents.astro';
---
<!-- manifest:
  layout: esa-container > [prototype settings bar] + cbf-contract-shell
  sections:
    - nav              -> cbf-public-nav
    - prototype bar    -> cbf-doc-demo-controls   (prototype-only — sits ABOVE the app frame; holds the editing-state explainer)
    - contract shell   -> cbf-contract-shell       (breadcrumb + Go to, header, tabs; Overview, Changes and approvals and Documents are panels)
    - panels           -> cbf-lib-pi-documents    (Overview task list + summary, workflow, documents, dialogs, email mock)
-->
<BaseLayout title="LIB &amp; PI document editing — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <!-- Prototype settings live OUTSIDE the contract frame below, so it's clear
           these switches configure the demo, not the application. -->
      <CbfDocDemoControls />

      <CbfContractShell contract="pi" tab="overview" panels={['overview', 'changes', 'documents']}>
        <CbfLibPiDocuments />
      </CbfContractShell>
    </EsaContainer>
  </main>

  <!-- Toast stack for the lightweight confirmations (copy link, replace, save). -->
  <esa-snackbar-container data-snackbar></esa-snackbar-container>

  <script>
    import '@esa/ecology/esa-snackbar-container';
  </script>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
  /* Space the prototype-settings bar off the contract frame beneath it. */
  .cbf-page :global(.cbf-demo-controls) { margin-block-end: var(--spacing-500); }
  /* cbf-app-panel clips with overflow:hidden (rounded-corner card). That clips the
     row-actions dropdown on the lower document rows, since esa-dropdown-menu positions
     absolutely and can't escape a clipping ancestor. Let the panel overflow on THIS
     page only (page-scoped; the 4px corner rounding is imperceptible) so the menu shows
     in full. Scoped selector keeps /search and /publications untouched. */
  .cbf-page :global(.cbf-app-panel) { overflow: visible; }
</style>
