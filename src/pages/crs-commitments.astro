---
// /crs-commitments — the "2020 CRS Commitments" index. A BiOp Commitment
// Administrator lands here to browse every tracked fish/wildlife mitigation
// commitment, filter by category or status, and open one to read its full
// record. Lift-and-shift of the legacy CBFish BiologicalOpinionCommitmentsIndex
// page — the grid matches prod's column set field-for-field (see the grid
// component's header note); the detail page still holds the same full record
// laid out for reading rather than scanning.
// Thin assembler: chrome from cbf-* shared components, content from the grid.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../components/shared/cbf-page-heading.astro';
import CbfCrsCommitmentsGrid from '../components/crs-commitments/cbf-crs-commitments-grid.astro';
import CbfReportTabs from '../components/shared/cbf-report-tabs.astro';
import CbfPasswordGate from '../components/shared/cbf-password-gate.astro';
import { crsReportTabs } from '../components/crs-commitments/report-tabs';
import { CRS_GATE_PASSWORD } from '../components/crs-commitments/gate-password';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: '2020 CRS Commitments', href: withBase('/crs-commitments') },
  { label: 'Commitments' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - top nav          -> cbf-public-nav
    - page frame       -> esa-container
    - password gate    -> cbf-password-gate
    - page heading     -> cbf-page-heading
    - sub-nav tabs     -> cbf-report-tabs
    - commitments grid -> cbf-crs-commitments-grid
-->
<BaseLayout title="Commitments — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPasswordGate password={CRS_GATE_PASSWORD}>
          <CbfPageHeading title="Commitments" />
          <CbfReportTabs tabs={crsReportTabs('grid')} ariaLabel="2020 CRS Commitments sections" />
          <CbfCrsCommitmentsGrid />
        </CbfPasswordGate>
      </CbfAppPanel>
    </EsaContainer>
  </main>

  <esa-snackbar-container data-snackbar></esa-snackbar-container>
</BaseLayout>

<script>
  import '@esa/ecology/esa-snackbar-container';
</script>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
