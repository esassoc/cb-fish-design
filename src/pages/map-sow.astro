---
// /map-sow — Habitat Design Tool
// Map-based SOW builder. Sits inside the standard page chrome (public nav +
// EsaContainer + bordered card) matching vendor-invoice / vendor-portal.
//
// Layout: toolbar above map holds the H1, contract metadata, WE switcher,
// and action buttons. The left WE panel is removed — WEs are managed via
// the dropdown in the toolbar.
//
// bcn-lego-checked: .msow-card / .msow-crumb-strip is the same established
// cbf-app-card page-chrome pattern (bordered content card + gold breadcrumb
// strip) used by vendor-invoice.astro / search.astro / publications.astro —
// not a reinvention, just the pre-existing msow- prefix instead of the
// cbf-app-card class name (a rename to align naming is a follow-up, not done
// here). esa-card is a content container, not a full-page shell, so it does
// not fit this role. The .msow-page/.msow-root display:flex is the locked
// full-viewport-height chrome this map tool needs (no page scroll, map fills
// available height) — checked @esa/tokens/layouts.css: .stack/.sidebar cover
// normal-flow layouts, not a height-locked flex shell with overflow:hidden.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import EsaBreadcrumbs from '@esa/ecology/esa-breadcrumbs.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfMsowToolbar from '../components/map-sow/cbf-msow-toolbar.astro';
import CbfMsowWizardPanel from '../components/map-sow/cbf-msow-wizard-panel.astro';
import CbfMsowSidebar from '../components/map-sow/cbf-msow-sidebar.astro';
import CbfMsowMap from '../components/map-sow/cbf-msow-map.astro';
import CbfMsowModals from '../components/map-sow/cbf-msow-modals.astro';
import '../styles/map-sow.css';
import { withBase } from '../lib/base';
import { workElements } from '../data/work-elements';

// The Habitat Design Tool is WE H's live design-tool session (see
// src/data/work-elements.ts) — pull its name from there so the breadcrumb and
// toolbar's "Back to Work Element" link can't drift from the entry point.
const activeWorkElement = workElements.find((we) => we.designToolHref === '/map-sow')!;

// Matches the breadcrumb hierarchy on /legacy/sow and /legacy/we exactly —
// this tool is one level deeper than the Habitat Design tab, not a
// separate modern-nav hierarchy.
const crumbs = [
  { label: 'Projects & Contracts' },
  { label: 'Projects' },
  { label: '2023-001-00' },
  { label: 'Contracts' },
  { label: '84051 REL 50' },
  { label: 'SOW Rev 2', href: withBase('/legacy/sow') },
  { label: `Summary of ${activeWorkElement.letter}: ${activeWorkElement.weType} - ${activeWorkElement.name}`, href: withBase('/legacy/we') },
  { label: 'Habitat Design Tool' },
];

const contractNum = activeWorkElement.contractNum;
const cor = 'Virginia Preiss';
const fy = '2026';

// Cache-bust the vanilla JS in dev so browsers don't serve stale versions
const mapSowSrc = import.meta.env.BASE_URL + 'scripts/map-sow.js?v=' + Date.now();
---
<!-- manifest:
  layout: esa-container > stack                # page spine — width frame + bordered card
  sections:
    - top nav       -> cbf-public-nav
    - breadcrumbs   -> esa-breadcrumbs
    - toolbar       -> cbf-msow-toolbar
    - wizard column -> cbf-msow-wizard-panel
    - sidebar       -> cbf-msow-sidebar
    - map           -> cbf-msow-map
    - modals        -> cbf-msow-modals
-->
<BaseLayout title="Habitat Design Tool — Columbia Basin Fish &amp; Wildlife Program">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
  />

  <a href="#map" class="skip-link">Skip to map</a>

  <CbfPublicNav />

  <main class="msow-page">
    <EsaContainer maxWidth="1920px">

      <div class="msow-card">

        <!-- Gold breadcrumb strip -->
        <div class="msow-crumb-strip">
          <EsaBreadcrumbs items={crumbs} />
        </div>

        <CbfMsowToolbar contractNum={contractNum} cor={cor} fy={fy} backHref={withBase('/legacy/we')} />

        <!-- GIS layout: [wizard column] [collapse rail] [sidebar] [map] — wizard only visible when active -->
        <div class="msow-root">
          <div id="msow-layout">
            <CbfMsowWizardPanel />
            <!-- bcn-lego-checked: a floating rail-edge control docked to the panel boundary,
                 not a form action — same exception already established for #edit-done-bar's
                 .msow-done-btn/.msow-pan-btn and the map legend's #leg-toggle (esa-icon-button
                 has no docked-to-a-panel-edge variant). A sibling of #wizard-panel (not nested
                 inside it) so it stays visible and clickable when the panel's width collapses
                 to 0 and overflow:hidden clips its contents — see toggleWizardPanel() in
                 map-sow.js. -->
            <button
              id="wizard-collapse-toggle"
              class="msow-wizard-collapse-toggle"
              onclick="toggleWizardPanel()"
              aria-label="Collapse steps panel"
              aria-expanded="true"
              aria-controls="wizard-panel"
              title="Collapse steps panel"
            >&#10094;</button>
            <CbfMsowSidebar />
            <CbfMsowMap />
          </div>
        </div>

      </div>

    </EsaContainer>
  </main>

  <CbfMsowModals />

  <!-- map-sow.js is a static public/ asset with no access to import.meta.env — hand it
       the base-prefixed legacy WE-page URL so the wizard's "Design Complete" step can
       link back to it without hardcoding an unprefixed path that would 404 in prod. -->
  <script is:inline define:vars={{ workElementsHref: withBase('/legacy/we') }}>
    window.MSOW_WORK_ELEMENTS_HREF = workElementsHref;
  </script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script is:inline src={mapSowSrc}></script>

  <script>
    import '@esa/ecology/esa-text-field';
    import '@esa/ecology/esa-checkbox';
    import '@esa/ecology/esa-dialog';
    import '@esa/ecology/esa-select';
    import '@esa/ecology/esa-tab-layout';
    import '@esa/ecology/esa-file-upload';
    import '@esa/ecology/esa-range-slider';
  </script>

</BaseLayout>

<style is:global>
  html:has(.msow-page) { height: 100%; }
  html:has(.msow-page) body {
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .msow-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: var(--spacing-600);
    overflow: hidden;
    min-height: 0;
  }

  .msow-page .esa-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .msow-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-100);
    overflow: hidden;
    background: var(--color-background-elevation-raised);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--color-background-default-knockout) 8%, transparent);
  }

  .msow-crumb-strip {
    background: var(--color-gold-2);
    border-bottom: 1px solid var(--color-border-default);
    padding: var(--spacing-400) var(--spacing-600);
    flex-shrink: 0;
  }
  .msow-crumb-strip .esa-breadcrumbs {
    --breadcrumbs-link-color: var(--color-content-default-secondary);
    --breadcrumbs-link-hover: var(--color-background-brand);
  }

  .msow-root {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }

  /* Short-viewport compaction — a laptop's browser chrome plus this page's
     stacked bars (admin tray + header + page padding + breadcrumb + toolbar)
     can eat 300px+ before the map itself starts, and this page is
     height-locked (no page scroll, see the class="msow-page" comment above)
     so that space has nowhere to overflow to — it just squeezes the map.
     A HEIGHT breakpoint (not the usual width one) reclaims it specifically
     when vertical space is tight, leaving the full chrome alone otherwise.
     Scoped to this page via html:has(.msow-page), same pattern as the
     overflow:hidden rules above — a single simple selector inside :has(),
     see the CSS :has() invalidation note elsewhere in this spoke. */
  @media (max-height: 800px) {
    html:has(.msow-page) .cbf-app-bar--admin { display: none; }
    html:has(.msow-page) .cbf-app-bar--header { --app-bar-pad-y: var(--spacing-200, 8px); }
    html:has(.msow-page) .msow-page { padding-block: var(--spacing-200, 8px); }
    html:has(.msow-page) .msow-crumb-strip { padding-block: var(--spacing-200, 8px); }
    html:has(.msow-page) .msow-toolbar { padding-block: var(--spacing-200, 8px); }
  }
</style>
