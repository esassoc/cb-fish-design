---
// /invoice-history — the paid-invoice archive behind the "View invoice history"
// link on My Work → My Invoices. Shows every invoice Asset Suite has marked Paid,
// kept OUT of the active workspace grid so that surface stays scoped to what still
// needs attention. Same reviewQueue split feeds both, so the two never diverge.
//
// Thin assembler: esa-container + cbf-app-panel chrome; the archive itself is the
// existing cbf-invoice-review-queue (workspace variant), reused verbatim with the
// paid subset — the Asset Suite column reads "Paid <date>" for every row, and the
// navigation works the same as in the workspace: a row (or its invoice-number link)
// goes to that invoice's page, and the quick-view control opens the peek drawer.
// A paid invoice is terminal, so the page's decision actions have nothing left to
// act on — it is read as a record, not worked.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import EsaPageHeader from '@esa/ecology/esa-page-header.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfInvoiceReviewQueue from '../components/invoice-review/cbf-invoice-review-queue.astro';
import { withBase } from '../lib/base';
import { paidInvoices, assetSuiteFeedAsOf } from '../data/invoice-review.mjs';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Dashboard', href: withBase('/my-work#invoices') },
  { label: 'Processed invoices' },
];

const paid = paidInvoices();
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav                     -> cbf-public-nav
    - page header             -> esa-page-header
    - paid invoice archive    -> cbf-invoice-review-queue (workspace variant, paid subset)
-->
<BaseLayout title="Processed invoices — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <EsaPageHeader
          eyebrow="Dashboard · Invoices"
          title="Processed invoices"
          lede={`Invoices Asset Suite has confirmed paid. Figures as of ${assetSuiteFeedAsOf} — nightly Asset Suite feed.`}
        />
        <CbfInvoiceReviewQueue invoices={paid} variant="workspace" title="Paid invoices" />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
