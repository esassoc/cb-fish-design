---
// /vendor-invoice — three-step invoice submission wizard (vendor accountant flow).
// Thin assembler: page chrome + EsaContainer shell; all sections are components.
//
// bcn-lego-checked: (1) cbf-app-card is the established spoke page chrome (bordered
// content card with gold breadcrumb strip). It is NOT a content card — it is the
// full-page app shell. esa-card is a general content container, not a shell. The
// identical pattern lives in search.astro and publications.astro; cbf-app-card is
// the reusable spoke chrome, not an ad-hoc reinvention. (2) The display:flex in
// cbf-app-card__body is the rail+main split inside this page-chrome shell. A
// .sidebar layout primitive covers the inner two-column split; it does not wrap the
// breadcrumb strip + body as a single bordered shell — that combination is the
// cbf-app-card spoke pattern. Checked @esa/tokens/layouts.css: .sidebar handles
// rail+main, not the outer chrome that includes the gold strip border.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import EsaBreadcrumbs from '@esa/ecology/esa-breadcrumbs.astro';
import CbfInvoiceStepDetails from '../components/vendor-invoice/cbf-invoice-step-details.astro';
import CbfInvoiceStepReview from '../components/vendor-invoice/cbf-invoice-step-review.astro';
import CbfInvoiceConfirm from '../components/vendor-invoice/cbf-invoice-confirm.astro';
import CbfInvoicePdfPanel from '../components/vendor-invoice/cbf-invoice-pdf-panel.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: 'Vendor dashboard', href: withBase('/vendor-dashboard') },
  { label: 'Submit invoice' },
];

// Mock supplier context — in production this comes from the authenticated session.
const vendor = {
  company: 'Pacific Environmental Services, LLC',
  contact: 'Maria Garcia',
  address: '1425 Riverside Dr, Suite 200, Portland, OR 97201',
  taxId: '91-1234567',
  email: 'maria.garcia@pacificenv.com',
};

// Mock buyer context — in production this comes from the contract/project lookup.
const buyer = {
  company: 'Columbia Basin Fish & Wildlife Program',
  contact: 'James Whitfield',
  address: '700 NE Multnomah St, Suite 1200, Portland, OR 97232',
  email: 'j.whitfield@cbfwp.org',
};
---
<!-- manifest:
  layout: cbf-app-card
  sections:
    - nav             -> cbf-public-nav
    - upload step     -> cbf-invoice-pdf-panel (step 0 workspace)
    - details step    -> cbf-invoice-step-details
    - review step     -> cbf-invoice-step-review
    - confirmation    -> cbf-invoice-confirm
-->
<BaseLayout title="Submit invoice — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-app-page" data-invoice-wizard>
    <EsaContainer maxWidth="1920px">
      <div class="cbf-app-card">

        <div class="cbf-app-card__crumb">
          <EsaBreadcrumbs items={crumbs} />
        </div>

        <div class="cbf-app-card__body">
          <div class="cbf-invoice-content">

            <!-- Parties bar: full-width above the workspace, only on step 0 -->
            <div class="cbf-parties-bar" data-parties-bar hidden>
              <div class="cbf-party-card">
                <p class="cbf-party-card__eyebrow">Supplier</p>
                <p class="cbf-party-card__name">{vendor.company}</p>
                <p class="cbf-party-card__meta">{vendor.contact} &middot; {vendor.email}</p>
                <p class="cbf-party-card__meta">{vendor.address}</p>
              </div>
              <div class="cbf-parties-bar__divider" aria-hidden="true"></div>
              <div class="cbf-party-card">
                <p class="cbf-party-card__eyebrow">Buyer</p>
                <p class="cbf-party-card__name">{buyer.company}</p>
                <p class="cbf-party-card__meta">{buyer.contact} &middot; {buyer.email}</p>
                <p class="cbf-party-card__meta">{buyer.address}</p>
              </div>
            </div>

            <!-- Form + PDF panel workspace -->
            <div class="cbf-invoice-workspace">
              <CbfInvoicePdfPanel />

              <section class="cbf-invoice-main">
                <CbfInvoiceStepDetails vendor={vendor} />
                <CbfInvoiceStepReview />
                <CbfInvoiceConfirm
                  vendorEmail={vendor.email}
                  homeHref={withBase('/home')}
                  resubmitHref={withBase('/vendor-invoice')}
                />

                <!-- Dev toggle: prototype-only, not shown in production -->
                <div class="cbf-dev-bar" data-confirm-mode-bar aria-label="Dev tools">
                  <span class="cbf-dev-bar__label">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    Confirmation mode
                  </span>
                  <div class="cbf-dev-bar__options">
                    <button type="button" class="cbf-dev-bar__opt is-active" data-confirm-mode="page">Page</button>
                    <button type="button" class="cbf-dev-bar__opt" data-confirm-mode="modal">Modal</button>
                  </div>
                </div>
              </section>
            </div>

          </div>
        </div>

      </div>
    </EsaContainer>
  </main>

  <script>
    import '@esa/ecology/esa-text-field';
    import '@esa/ecology/esa-select';
    import '@esa/ecology/esa-combobox';
    import '@esa/ecology/esa-checkbox';
    import '@esa/ecology/esa-confirm-dialog';
    import '@esa/ecology/esa-dialog';
    import '../components/bcn-date-picker';
    import '@esa/ecology/esa-textarea';
    import { initInvoiceWizard } from '../components/vendor-invoice/invoice-wizard.client';
    initInvoiceWizard();
  </script>
</BaseLayout>

<style>
  .cbf-app-page {
    padding-block: var(--spacing-600) var(--spacing-800);
  }

  /* ---- Bordered app card (mirrors search.astro — established spoke chrome) ---- */
  .cbf-app-card {
    display: flex;
    flex-direction: column;
    min-height: 80vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    overflow: clip;
    background: var(--color-surface);
    box-shadow: 0 1px 3px rgba(19, 39, 62, 0.08);
  }
  .cbf-app-card__crumb {
    background: var(--color-gold-50);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-400) var(--spacing-600);
  }
  .cbf-app-card__crumb :global(.esa-breadcrumbs) {
    --breadcrumbs-link-color: var(--color-text-secondary, #464646);
    --breadcrumbs-link-hover: var(--color-primary);
  }
  .cbf-app-card__body {
    flex: 1;
    display: flex;
    align-items: stretch;
  }

  /* ---- Content column (parties bar + workspace) ---- */
  .cbf-invoice-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ---- Parties bar ---- */
  .cbf-parties-bar {
    display: flex;
    align-items: stretch;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-sunken, #f8f9fb);
    padding: var(--spacing-400) var(--spacing-600);
    gap: var(--spacing-600);
  }
  .cbf-parties-bar[hidden] { display: none; }

  .cbf-parties-bar__divider {
    width: 1px;
    background: var(--color-border);
    flex: none;
  }

  .cbf-party-card {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
  }
  .cbf-party-card__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cbf-party-card__name {
    margin: 0;
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .cbf-party-card__meta {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Workspace (form + PDF panel) ---- */
  .cbf-invoice-workspace {
    flex: 1;
    display: flex;
    align-items: stretch;
    min-height: 0;
  }

  /* ---- Main content area ---- */
  .cbf-invoice-main {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-600) var(--spacing-700);
    max-width: 820px;
  }

  /* When PDF panel is open alongside step 0, cap the form width */
  .cbf-invoice-workspace.has-pdf .cbf-invoice-main {
    flex: 0 0 520px;
    max-width: 520px;
  }

  /* ---- Responsive ---- */

  /* Below 1100px: uncap the form when PDF is open — workspace stacks */
  @media (max-width: 1100px) {
    .cbf-invoice-workspace {
      flex-direction: column;
    }
    .cbf-invoice-workspace.has-pdf .cbf-invoice-main {
      flex: 1;
      max-width: none;
    }
  }

  /* Below 960px: break the flex:1/flex-basis:0 chain so the form grows to its
     natural content height instead of collapsing to zero or being clipped to
     the card's 80vh. */
  @media (max-width: 960px) {
    /* Reset every flex:1 descendant so each sizes from its content, not from
       a zero flex-basis that collapses in a parent with no explicit height. */
    .cbf-invoice-content,
    .cbf-invoice-workspace,
    .cbf-invoice-main {
      flex: none;
      width: 100%;
      min-height: unset;
    }
    .cbf-invoice-main {
      padding: var(--spacing-500);
      max-width: none;
    }
    .cbf-parties-bar {
      gap: var(--spacing-400);
      padding: var(--spacing-400);
    }
  }

  /* Below 600px: stack parties bar, tighten page padding */
  @media (max-width: 600px) {
    .cbf-app-page {
      padding-block: var(--spacing-300) var(--spacing-500);
    }
    .cbf-invoice-main {
      padding: var(--spacing-400);
    }
    .cbf-parties-bar {
      flex-direction: column;
      gap: var(--spacing-300);
    }
    .cbf-parties-bar__divider {
      display: none;
    }
  }

  /* ---- Dev toggle bar ---- */
  .cbf-dev-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    margin-top: var(--spacing-700);
    padding: var(--spacing-250) var(--spacing-400);
    border: 1px dashed color-mix(in srgb, var(--color-border) 60%, transparent);
    border-radius: var(--radius-100);
    background: color-mix(in srgb, var(--color-surface-sunken, #f8f9fb) 60%, transparent);
  }
  .cbf-dev-bar__label {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    flex: none;
  }
  .cbf-dev-bar__options {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    overflow: hidden;
    background: var(--color-surface);
  }
  .cbf-dev-bar__opt {
    padding: var(--spacing-100) var(--spacing-300);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-right: 1px solid var(--color-border);
    cursor: pointer;
    transition: background 0.1s ease, color 0.1s ease;
  }
  .cbf-dev-bar__opt:last-child { border-right: none; }
  .cbf-dev-bar__opt:hover { background: var(--color-surface-sunken, #f8f9fb); color: var(--color-text-primary); }
  .cbf-dev-bar__opt.is-active {
    background: var(--color-primary);
    color: var(--color-surface);
  }
</style>
