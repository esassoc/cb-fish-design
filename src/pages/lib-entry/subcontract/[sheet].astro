---
// /lib-entry/subcontract/<sheet> — a subcontract's own Line Item Budget.
//
// A subcontract is one line on the contract's LIB; behind it is a LIB of its
// own, entered on the SAME grid (cbf-lib-cost-table, handed this subcontract's
// budget). Same sections less Subcontracts, no indirect rate, no work-element
// split (the contract's line carries it), no lump sums, no contingency. The
// contract's line takes its amount from here.
//
// Thin assembler — the subcontract's type, preparer, cost share and bid results
// are cbf-lib-subcontract-details; the budget is cbf-lib-cost-table.
//
// Prototype limit: like the contract's LIB, edits live in the page and reset on
// reload, so a change here doesn't reach the contract's LIB page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../../components/shared/cbf-public-nav.astro';
import CbfContractShell from '../../../components/contract-shell/cbf-contract-shell.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import CbfPrototypeStrip from '../../../components/shared/cbf-prototype-strip.astro';
import CbfRoleSwitch from '../../../components/shared/cbf-role-switch.astro';
import CbfLibSubcontractDetails from '../../../components/lib-entry/cbf-lib-subcontract-details.astro';
import CbfLibCostTable from '../../../components/lib-entry/cbf-lib-cost-table.astro';
import CbfLibStandardRateDialog from '../../../components/lib-entry/cbf-lib-standard-rate-dialog.astro';
import CbfLibImportDialog from '../../../components/lib-entry/cbf-lib-import-dialog.astro';
import CbfLibCopyDialog from '../../../components/lib-entry/cbf-lib-copy-dialog.astro';
import { subcontractSheets, costLines } from '../../../data/lib-entry.mjs';

export function getStaticPaths() {
  return Object.keys(subcontractSheets).map((sheet) => ({ params: { sheet } }));
}

const { sheet } = Astro.params as { sheet: string };
const parent: any = costLines.find((l: any) => l.id === (subcontractSheets as any)[sheet]?.parentLine);
const name = parent?.label || 'New subcontract';

---
<!-- manifest:
  layout: esa-container > cbf-prototype-strip + cbf-contract-shell > stack(xl)
  sections:
    - nav                   -> cbf-public-nav                 (shared)
    - prototype strip       -> cbf-prototype-strip            (shared — role lens only)
    - role lens             -> cbf-role-switch                (shared — vendor ⇄ BPA COR)
    - contract shell        -> cbf-contract-shell             (shared — breadcrumb + Go to, header, tabs; … › Line item budget › Subcontract)
    - subcontract           -> cbf-lib-subcontract-details    (type, preparer, cost share, bid results, totals, issues)
    - subcontract budget    -> cbf-lib-cost-table             (budget=<sheet>; hidden for fixed price already bid out)
    - standard rate dialog  -> cbf-lib-standard-rate-dialog   (the grid's own)
    - import dialog         -> cbf-lib-import-dialog          (the grid's own)
    - copy dialog           -> cbf-lib-copy-dialog            (the grid's own)
-->
<BaseLayout title={`${name} — subcontract LIB — Columbia Basin Fish & Wildlife Program`}>
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfPrototypeStrip note="A subcontract’s own budget, behind one line on the contract’s LIB.">
        <CbfRoleSwitch />
      </CbfPrototypeStrip>

      <CbfContractShell contract="lib" tab="budget" child="lib" trail={[{ label: `Subcontract: ${name}` }]}>
        <div class="stack" data-gap="xl">
          <CbfLibSubcontractDetails sheetId={sheet} />
          <div data-sub-lib>
            <CbfLibCostTable
              budget={sheet}
              heading="Subcontract budget"
              lede="The contract’s sections, without Subcontracts. Every cost needs a quantity and a rate."
            />
          </div>
        </div>
      </CbfContractShell>
    </EsaContainer>
  </main>

  <CbfLibStandardRateDialog />
  <CbfLibImportDialog />
  <CbfLibCopyDialog />

  <esa-snackbar-container data-snackbar></esa-snackbar-container>

  <script>
    import '@esa/ecology/esa-snackbar-container';
  </script>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
  /* Same reason as /lib-entry: the grid's popovers and add menus have to escape
     the rounded panel. */
  .cbf-page :global(.cbf-app-panel) { overflow: visible; }
  [data-sub-lib][hidden] { display: none; }
</style>
