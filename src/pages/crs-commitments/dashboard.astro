---
// /crs-commitments/dashboard — the "2020 CRS Commitments Dashboard". A category-
// tabbed, filterable overview: status counts scoped to the active tab, and one
// row per commitment carrying its type/category tags and a 15-year status
// strip. Lift-and-shift of the legacy CBFish BiologicalOpinionCommitmentDashboard
// page (Overall Progress view). Thin assembler: chrome from cbf-* shared
// components, content from the dashboard section.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfPublicNav from '../../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../../components/shared/cbf-app-panel.astro';
import CbfPageHeading from '../../components/shared/cbf-page-heading.astro';
import CbfCrsCommitmentsDashboard from '../../components/crs-commitments/cbf-crs-commitments-dashboard.astro';
import CbfReportTabs from '../../components/shared/cbf-report-tabs.astro';
import { crsReportTabs } from '../../components/crs-commitments/report-tabs';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  { label: '2020 CRS Commitments', href: withBase('/crs-commitments') },
  { label: 'Dashboard' },
];
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - top nav    -> cbf-public-nav
    - page frame -> esa-container
    - page heading -> cbf-page-heading
    - sub-nav tabs -> cbf-report-tabs
    - dashboard  -> cbf-crs-commitments-dashboard
-->
<BaseLayout title="Dashboard — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfPageHeading title="Dashboard" />
        <CbfReportTabs tabs={crsReportTabs('dashboard')} ariaLabel="2020 CRS Commitments sections" />
        <CbfCrsCommitmentsDashboard />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  /* page-level outer rhythm only — every section is a component (manifest above) */
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
