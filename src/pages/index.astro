---
// CBFish — Home. A mark-forward hub on white: the brand hero, then the three layers
// of the repo — the Design system (live), the Pattern library (coming soon), and the
// Prototypes (working screens, straight off the typed registry in
// src/data/prototypes.ts, so shipping one is a one-row data edit). Composed entirely
// from cbf-* section components on layout-primitive spines (.switcher / .grid).
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfHomeHero from '../components/home/cbf-home-hero.astro';
import CbfLayer from '../components/home/cbf-layer.astro';
import CbfPrototype from '../components/home/cbf-prototype.astro';
import CbfSiteFooter from '../components/shared/cbf-site-footer.astro';
import { withBase } from '../lib/base';
import { prototypesByStatus, type PrototypeStatus } from '../data/prototypes';

const activeRows = prototypesByStatus('in-progress');
const pastRows = prototypesByStatus('live');

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Format from the ISO parts directly — avoids new Date() timezone drift that can
// roll a UTC-midnight date back a day in the build environment.
const fmtDate = (iso: string): string => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${d}, ${y}`;
};

const STATUS_LABEL: Record<PrototypeStatus, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  archived: 'Archived',
};
---
<!-- manifest:
  layout: stack                              # centered max-width column; sections stacked
  sections:
    - hero       -> cbf-home-hero
    - layers     -> cbf-layer
    - prototypes -> cbf-prototype
    - footer     -> cbf-site-footer
-->
<BaseLayout title="CBFish — Design & prototypes">
  <main class="home">
    <CbfHomeHero />

    <section class="home__layers switcher" aria-label="Layers">
      <CbfLayer
        href={withBase('/design-system')}
        tone="live"
        statusLabel="Live"
        title="Design system"
        body="The brand layer — navy + gold palette, IBM Plex type, and the inherited Ecology components re-skinned for CBFish."
        cta="Open the design system"
      />
      <CbfLayer
        href={withBase('/patterns')}
        tone="soon"
        statusLabel="Coming soon"
        title="Pattern library"
        body="Composed, multi-component patterns — page shells, report views, search & filter flows — assembled from the system."
        cta="Preview"
      />
    </section>

    <section class="home__protos" aria-label="Prototypes">
      <div class="home__protos-head">
        <h2 class="typography-heading-md">Prototypes</h2>
        <p class="typography-body-md">Working screens for the program, built on the system.</p>
      </div>
      <ul class="home__proto-list grid">
        {activeRows.map((p) => (
          <li>
            <CbfPrototype
              title={p.title}
              description={p.description}
              href={withBase(p.route)}
              status={p.status}
              statusLabel={STATUS_LABEL[p.status]}
              dateLabel={fmtDate(p.createdAt)}
              datetime={p.createdAt}
              ticket={p.ticket}
            />
          </li>
        ))}
      </ul>
    </section>

    {pastRows.length > 0 && (
      <section class="home__protos" aria-label="Past explorations">
        <div class="home__protos-head">
          <h2 class="typography-heading-md">Past explorations</h2>
          <p class="typography-body-md">Earlier prototypes that have shipped or landed live.</p>
        </div>
        <ul class="home__proto-list grid">
          {pastRows.map((p) => (
            <li>
              <CbfPrototype
                title={p.title}
                description={p.description}
                href={withBase(p.route)}
                status={p.status}
                statusLabel={STATUS_LABEL[p.status]}
                dateLabel={fmtDate(p.createdAt)}
                datetime={p.createdAt}
                ticket={p.ticket}
              />
            </li>
          ))}
        </ul>
      </section>
    )}

    <CbfSiteFooter />
  </main>
</BaseLayout>

<style>
  /* page-level centering + section rhythm only — sections are cbf-* components,
     grids are the .switcher / .grid primitives (no hand-rolled flex/grid/type here) */
  .home { max-width: 1040px; margin: 0 auto; padding: 0 var(--spacing-500); }
  .home__layers { padding-bottom: var(--spacing-800); --switcher-threshold: 36rem; }
  .home__protos { padding-bottom: var(--spacing-800); }
  .home__protos-head { margin-bottom: var(--spacing-400); }
  .home__protos-head p { margin-top: var(--spacing-100); color: var(--color-content-default-secondary); }
  .home__proto-list { list-style: none; margin: 0; padding: 0; --grid-min: 20rem; }
</style>
