---
// /vendor-portal — accountant landing page for vendor invoice management.
// The primary action (Submit Invoice) leads to the /vendor-invoice wizard.
// Thin assembler: esa-container + cbf-app-panel chrome; all content is components.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfVendorPortalHeader from '../components/vendor-portal/cbf-vendor-portal-header.astro';
import CbfVendorPortalActions from '../components/vendor-portal/cbf-vendor-portal-actions.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/'), icon: homeIcon },
  { label: 'Vendor Portal' },
];

// Mock vendor session — in production this comes from the authenticated user.
const vendor = {
  company: 'Pacific Environmental Services, LLC',
  contact: 'Maria Garcia',
};
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav            -> cbf-public-nav
    - welcome header -> cbf-vendor-portal-header
    - action grid    -> cbf-vendor-portal-actions
-->
<BaseLayout title="Vendor Portal — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfVendorPortalHeader
          firstName={vendor.contact.split(' ')[0]}
          company={vendor.company}
          submitHref={withBase('/vendor-invoice')}
        />
        <CbfVendorPortalActions submitHref={withBase('/vendor-invoice')} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
