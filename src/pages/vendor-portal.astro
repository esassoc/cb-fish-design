---
// /vendor-portal — the vendor's invoices & financial-outlook view.
// The CM lands here to read their cross-contract money position at a glance,
// act on anything blocked on them, and browse/submit invoices. The primary
// action (Submit Invoice) leads to the /vendor-invoice wizard.
// Thin assembler: esa-container + cbf-app-panel chrome; all content is components.
import BaseLayout from '../layouts/BaseLayout.astro';
import CbfPublicNav from '../components/shared/cbf-public-nav.astro';
import CbfAppPanel from '../components/shared/cbf-app-panel.astro';
import CbfVendorPortalHeader from '../components/vendor-portal/cbf-vendor-portal-header.astro';
import CbfVendorFinancialOutlook from '../components/vendor-portal/cbf-vendor-financial-outlook.astro';
import CbfVendorAttention from '../components/vendor-portal/cbf-vendor-attention.astro';
import CbfVendorPortalInvoices from '../components/vendor-portal/cbf-vendor-portal-invoices.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../lib/base';
import { invoices, deriveOutlook, fmtCompact, fmtExact } from '../data/vendor-portal-invoices.mjs';

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';

const crumbs = [
  { label: 'Home', href: withBase('/'), icon: homeIcon },
  { label: 'Vendor portal' },
];

// Mock vendor session — in production this comes from the authenticated user.
const vendor = {
  company: 'Pacific Environmental Services, LLC',
  contact: 'Maria Garcia',
};

// Derive the financial position once, here in the assembler, and feed the band,
// the attention strip, and the table from the same source.
const outlook = deriveOutlook(invoices);
const sub = (n: number) => (n === 1 ? '1 invoice' : `${n} invoices`);

const outlookStats = [
  { value: fmtCompact(outlook.contracted), label: 'Total contracted' },
  { value: fmtCompact(outlook.expended), label: 'Expended to date', sub: `as of ${outlook.asOf}` },
  { value: fmtCompact(outlook.remaining), label: 'Remaining' },
  { value: fmtExact(outlook.awaiting.amount), label: 'Awaiting approval', sub: sub(outlook.awaiting.count), accent: true },
  { value: fmtExact(outlook.approvedUnpaid.amount), label: 'Approved, unpaid', sub: sub(outlook.approvedUnpaid.count) },
];
const outlookCaption = `Across ${outlook.contractCount} active contracts · as of ${outlook.asOf}`;
---
<!-- manifest:
  layout: esa-container > cbf-app-panel
  sections:
    - nav             -> cbf-public-nav
    - welcome header  -> cbf-vendor-portal-header
    - financial band  -> cbf-vendor-financial-outlook
    - needs attention -> cbf-vendor-attention
    - invoices table  -> cbf-vendor-portal-invoices
-->
<BaseLayout title="Vendor portal — Columbia Basin Fish &amp; Wildlife Program">
  <CbfPublicNav />

  <main class="cbf-page">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={crumbs}>
        <CbfVendorPortalHeader
          firstName={vendor.contact.split(' ')[0]}
          company={vendor.company}
          submitHref={withBase('/vendor-invoice')}
          showStats={false}
        />
        <CbfVendorFinancialOutlook stats={outlookStats} caption={outlookCaption} />
        <CbfVendorAttention count={outlook.needsRevision.count} />
        <CbfVendorPortalInvoices invoices={invoices} />
      </CbfAppPanel>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-page { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
