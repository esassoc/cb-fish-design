---
// cbf-my-invoices — thin section wrapper for the Invoices tab on the Dashboard
// (COR landing) page. Owns the status summary strip, the link out to the other
// invoices, and delegates all invoice rendering to cbf-invoice-review-queue.
//
// The grid is scoped to the OPEN pile — invoices on the COR's contracts still
// awaiting their decision (Submitted / In review). Returned and approved invoices
// are counted in the summary strip but kept out of the grid; they live behind the
// "View other invoices" link, so this workspace stays scoped to what needs action.
//
// bcn-lego-checked: no esa-* lego covers a summary-strip-plus-delegated-queue
// section, so the wrapper stays minimal. The "View other invoices" affordance is the
// esa-button lego rendered as a link (href). The summary strip + queue are existing
// spoke components. No bespoke primitives introduced here.
import CbfInvoiceReviewQueue from '../invoice-review/cbf-invoice-review-queue.astro';
import CbfInvoiceQueueMetrics from '../invoice-review/cbf-invoice-queue-metrics.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { openInvoices, deriveWorkspaceMetrics } from '../../data/invoice-review.mjs';
import { withBase } from '../../lib/base';

interface Props {
  invoices: any[];
}

const { invoices } = Astro.props;

// The grid shows the open pile only; the summary strip breaks the full set down
// by status (both derived from the same reviewQueue split, so nothing diverges).
const open = openInvoices(invoices);
const metrics = deriveWorkspaceMetrics(invoices);
---

<div class="stack cbf-my-invoices" data-gap="sm">
  <CbfInvoiceQueueMetrics metrics={metrics} />
  <CbfInvoiceReviewQueue
    invoices={open}
    variant="workspace"
    title="Invoices for contracts where I am the COR"
    showDaysLeft={false}
    showAssetSuite={false}
  >
    <EsaButton
      slot="controls-end"
      href={withBase('/invoice-history')}
      appearance="outline"
      color="secondary"
      size="sm"
      icon="history"
    >
      View other invoices
    </EsaButton>
  </CbfInvoiceReviewQueue>
</div>
