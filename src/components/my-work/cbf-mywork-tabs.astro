---
// cbf-mywork-tabs — the tabbed shell for the Dashboard (COR landing) page.
//
// Mirrors the tab set in the QA environment, in the same order: Invoices,
// Contracts, Projects, Portfolios, Contracts by project, Alerts, Contract work
// activity tasks. This prototype is focused on Invoices, so every other tab is
// DISABLED — present for orientation and layout fidelity, but not yet built out.
//
// Pure composition of the esa-tab-layout lego (its `disabled` per-tab flag drives
// the disabled state, and keyboard nav skips disabled tabs for free). The only
// content is the Invoices panel, filled by the page via the `invoices` slot. The
// only CSS is a pre-upgrade FOUC guard and the min-width:0 the AG Grid inside the
// panel needs so it scrolls instead of clipping the flex/grid track.
const tabs = [
  { label: 'Invoices' },
  { label: 'Contracts', disabled: true },
  { label: 'Projects', disabled: true },
  { label: 'Portfolios', disabled: true },
  { label: 'Contracts by project', disabled: true },
  { label: 'Alerts', disabled: true },
  { label: 'Contract work activity tasks', disabled: true },
];
---

<esa-tab-layout
  class="cbf-mywork-tabs"
  size="md"
  appearance="underline"
  active-index="0"
  tabs={JSON.stringify(tabs)}
>
  <div slot="panel-0" class="cbf-mywork-tabs__panel stack" data-gap="lg">
    <slot name="invoices" />
  </div>
</esa-tab-layout>

<style>
  /* Pre-upgrade FOUC guard: before esa-tab-layout defines, there is no shadow DOM
     and the panel slot renders in document order. Hide it until the custom element
     upgrades and takes over active-panel rendering. */
  esa-tab-layout:not(:defined) > [slot^='panel-'] {
    display: none;
  }
  /* An AG Grid lives in the invoices panel; min-width:0 lets it scroll horizontally
     instead of clipping / forcing the flex track wider than the viewport. */
  .cbf-mywork-tabs__panel {
    min-width: 0;
  }
  /* Seven tabs fit at desktop widths; on a narrow desktop / tablet the strip would
     otherwise clip the last tab. The lego exposes the tablist as ::part(tabs) — let
     it scroll horizontally on overflow (no scrollbar shows when it all fits). */
  .cbf-mywork-tabs::part(tabs) {
    overflow-x: auto;
  }
</style>

<script>
  import '@esa/ecology/esa-tab-layout';
</script>
