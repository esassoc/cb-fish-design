---
// cbf-task-queue — "Action queue" band for the My Tasks tab on the My Work page.
// Renders the COR's complete obligation list as a semantic <ol>: one fixed sort
// (daysRemaining asc — overdue first; caller pre-sorts, we render in order),
// no filtering/sorting affordances (anti-genre for a queue-first orientation
// surface per the My Work design laws).
//
// Atom legos composed inside each row:
//   esa-pill   — due-state inline per row (SSR, no clone-template)
//   esa-button — trailing action (size sm; for invoice tasks the data-open-invoice
//                attr is on the WRAPPING SPAN, not on esa-button itself, because
//                esa-button.astro destructures a fixed prop list with no rest spread
//                so unknown data-* attrs are silently dropped and never reach the DOM)
//   esa-empty-state — when tasks is empty
//
// Layout uses .repel / .cluster / .stack layout primitives from @esa/tokens.
//
// bcn-lego-checked: no esa-* lego covers a heterogeneous action-queue row
// (a verb-first label + meta caption + due pill + action button in a single
// horizontal row with hairline separators). esa-card is a card surface, not a
// dense list row. AG Grid is the tabular choice in this spoke but is unsuitable
// for heterogeneous obligations with distinct per-row actions. Beacon has no
// ui-queue-row equivalent. The row container below is the minimal bespoke
// addition; every atom inside it is an esa-* lego.

import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';

// ---------------------------------------------------------------------------
// Due-state helpers
// ---------------------------------------------------------------------------
function duePillVariant(days: number): 'danger' | 'warning' | 'default' {
  if (days < 0) return 'danger';
  if (days <= 7) return 'warning';
  return 'default';
}

function duePillLabel(days: number, due: string): string {
  if (days < 0) {
    const abs = Math.abs(days);
    return abs === 1 ? '1 day past due' : `${abs} days past due`;
  }
  if (days === 0) return 'Due today';
  if (days <= 7) return `Due in ${days} day${days === 1 ? '' : 's'}`;
  // Default — format the date passed in (already a readable string from data layer)
  return `Due ${due}`;
}

// ---------------------------------------------------------------------------
// Props
// ---------------------------------------------------------------------------
export interface WorkTask {
  id: string;
  kind: 'invoice-review' | 'status-report-review' | 'status-report-waiting' | 'ec-requirements' | 'final-invoice-due' | 'closeout-form';
  what: string;
  contract: string;
  project: string;
  due: string;
  daysRemaining: number;
  actionLabel: string;
  href?: string;
  invoiceNumber?: string;
  amount?: string;
  vendor?: string;
  waiting?: boolean;
}

interface Props {
  tasks: WorkTask[];
}

const { tasks } = Astro.props;

// Count actionable items (exclude waiting rows — those are informational)
const actionableCount = tasks.filter((t) => !t.waiting).length;
---

<section class="cbf-task-queue stack" data-gap="md" aria-label="Action queue">
  <!-- Section header: title + actionable item caption -->
  <header class="cbf-task-queue__head repel">
    <h2 class="typography-heading-md">Action queue</h2>
    {actionableCount > 0 && (
      <span class="typography-meta cbf-task-queue__count" aria-live="polite">
        {actionableCount === 1 ? '1 item waiting on you' : `${actionableCount} items waiting on you`}
      </span>
    )}
  </header>

  {tasks.length === 0 ? (
    <!-- Empty state when no tasks -->
    <EsaEmptyState
      title="You're clear — nothing waiting on you."
      description="New obligations will appear here as they arise."
      size="sm"
      headingLevel={3}
    />
  ) : (
    <!-- Semantic ordered list — order is meaningful (overdue first) -->
    <ol class="cbf-task-queue__list" role="list">
      {tasks.map((task) => {
        const pillVariant = duePillVariant(task.daysRemaining);
        const pillLabel = duePillLabel(task.daysRemaining, task.due);
        const isInvoiceTask = task.kind === 'invoice-review';
        // Invoice rows: contract · vendor · amount (project omitted — keeps meta scannable).
        // All other rows: contract · project (· vendor when present, e.g. status-report tasks).
        const metaParts = isInvoiceTask
          ? [task.contract, task.vendor, task.amount].filter(Boolean)
          : [task.contract, task.project, task.vendor].filter(Boolean);

        return (
          <li class:list={['cbf-task-queue__row', task.waiting && 'cbf-task-queue__row--waiting']} data-task-id={task.id}>
            <!-- Main content: what + meta -->
            <span class="cbf-task-queue__body stack" data-gap="xs">
              <span class="cbf-task-queue__what typography-body-md">{task.what}</span>
              <span class="cbf-task-queue__meta typography-meta">
                {metaParts.join(' · ')}
              </span>
            </span>

            <!-- Due-state pill -->
            <span class="cbf-task-queue__due">
              <EsaPill label={pillLabel} variant={pillVariant} removable={false} size="sm" />
            </span>

            <!-- Trailing action (omitted for waiting rows) -->
            {!task.waiting ? (
              isInvoiceTask ? (
                // data-open-invoice lives on the SPAN, not on esa-button.
                // esa-button.astro destructures a fixed prop list with no rest spread,
                // so data-* attrs passed to it are silently dropped and never reach the DOM.
                // The delegated click handler uses target.closest('[data-open-invoice]'),
                // so a click on the button inside the span still resolves correctly.
                <span class="cbf-task-queue__action" data-open-invoice={task.invoiceNumber}>
                  <EsaButton
                    variant="secondary"
                    appearance="outline"
                    size="sm"
                    type="button"
                  >
                    {task.actionLabel}
                  </EsaButton>
                </span>
              ) : (
                <span class="cbf-task-queue__action">
                  <EsaButton
                    variant="secondary"
                    appearance="outline"
                    size="sm"
                    href={task.href ?? '#'}
                  >
                    {task.actionLabel}
                  </EsaButton>
                </span>
              )
            ) : (
              <span class="cbf-task-queue__waiting-label typography-meta">
                Waiting to be accepted
              </span>
            )}
          </li>
        );
      })}
    </ol>
  )}
</section>

<style>
  /* -------------------------------------------------------------------------
     Queue section shell
  ------------------------------------------------------------------------- */
  .cbf-task-queue {
    /* stack gap is set via data-gap="md" on the element */
  }

  .cbf-task-queue__head {
    align-items: baseline;
    gap: var(--spacing-400, 1rem);
    flex-wrap: wrap;
  }

  .cbf-task-queue__count {
    color: var(--color-content-default-tertiary, #737373);
    white-space: nowrap;
  }

  /* -------------------------------------------------------------------------
     Queue list — semantic <ol>, no list bullets
  ------------------------------------------------------------------------- */
  .cbf-task-queue__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border-default-subtle, #e5e5e5);
  }

  /* -------------------------------------------------------------------------
     Row — horizontal repel layout inside the item
     bcn-lego-checked: no esa-* list-row or queue-row lego exists; esa-card is
     a card surface; AG Grid suits tabular/homogeneous data (not heterogeneous
     obligations); checked Beacon (no ui-queue-row). Minimal bespoke layout here;
     every atom (pill/button) is an esa-* lego.
  ------------------------------------------------------------------------- */
  .cbf-task-queue__row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    padding-block: var(--spacing-300, 0.75rem);
    padding-inline: var(--spacing-200, 0.5rem);
    border-bottom: 1px solid var(--color-border-default-subtle, #e5e5e5);
    min-height: 52px; /* 16px lead text + 12px meta + 2×12px padding — dense-floor compliant */
  }

  /* Waiting rows: muted treatment — status is informational, not actionable */
  .cbf-task-queue__row--waiting {
    opacity: 0.65;
  }

  /* -------------------------------------------------------------------------
     Row zones
  ------------------------------------------------------------------------- */
  .cbf-task-queue__body {
    flex: 1 1 0;
    min-width: 0; /* allow text to truncate/wrap in flex context */
  }

  .cbf-task-queue__what {
    font-weight: var(--typography-font-weight-medium, 500);
    color: var(--color-content-default, #171717);
    /* Ensure 16px floor per design-principles */
    font-size: var(--type-body-size, 14px);
    line-height: 1.4;
  }

  .cbf-task-queue__meta {
    color: var(--color-content-default-tertiary, #737373);
    line-height: 1.3;
  }

  .cbf-task-queue__due {
    flex-shrink: 0;
  }

  .cbf-task-queue__action {
    flex-shrink: 0;
  }

  .cbf-task-queue__waiting-label {
    flex-shrink: 0;
    color: var(--color-content-default-tertiary, #737373);
    font-style: italic;
    white-space: nowrap;
  }

  /* -------------------------------------------------------------------------
     Narrow viewports — stack pill below meta on very small screens
  ------------------------------------------------------------------------- */
  @media (max-width: 480px) {
    .cbf-task-queue__row {
      flex-wrap: wrap;
    }
    .cbf-task-queue__due,
    .cbf-task-queue__action,
    .cbf-task-queue__waiting-label {
      /* pill + action collapse to their own row on mobile */
      margin-left: var(--spacing-200, 0.5rem);
    }
  }
</style>

<!-- Delegated click handler: [data-open-invoice] → dispatch cbf:open-invoice
     PINNED CONTRACT: event name `cbf:open-invoice`, detail `{ number }`.
     The parent cbf-mywork-tabs catches this, switches to the My Invoices panel,
     awaits updateComplete, then forwards to the queue root to open the peek drawer
     (which carries on to the invoice's full page via "Process invoice").
-->
<script>
  (function () {
    document.querySelectorAll<HTMLElement>('.cbf-task-queue').forEach((root) => {
      root.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Walk up from click target to find a button with data-open-invoice
        const btn = target.closest<HTMLElement>('[data-open-invoice]');
        if (!btn) return;
        const number = btn.dataset.openInvoice;
        if (!number) return;
        btn.dispatchEvent(
          new CustomEvent('cbf:open-invoice', {
            bubbles: true,
            composed: true,
            detail: { number },
          })
        );
      });
    });
  })();
</script>
