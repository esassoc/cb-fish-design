---
// cbf-invoice-queue-metrics — the status-summary strip above the My Invoices grid.
// A four-way breakdown of every invoice on the COR's contracts by where it sits in
// the review lifecycle, each answering "how many are in this state, and why does it
// matter":
//   1. Overdue           — open invoices past the review-by clock; review now.
//                          (A subset of Awaiting review — the urgent ones, in red.)
//   2. Awaiting review   — the open pile the vendor has submitted for the COR.
//   3. Returned          — sent back to the vendor, awaiting resubmission.
//   4. Recently approved — approved by the COR, pending payment-request creation.
//
// bcn-lego-checked: esa-stat is the single-metric lego — composed here in a .cluster
// row exactly like cbf-vendor-financial-outlook. The danger tint on the Overdue value
// is applied through esa-stat's public --stat-value-color token, not bespoke text
// markup. The row uses the .cluster layout primitive; no hand-rolled flex. Each stat
// is value / label / sub — the three-line block esa-stat renders natively.
import EsaStat from '@esa/ecology/esa-stat.astro';

interface Metrics {
  overdue: number;
  awaitingReview: number;
  returned: number;
  recentlyApproved: number;
}
interface Props {
  metrics: Metrics;
}
const { metrics } = Astro.props;
const { overdue, awaitingReview, returned, recentlyApproved } = metrics;
---
<section class="cbf-invoice-queue-metrics" aria-label="Invoice status summary">
  <div class="cbf-invoice-queue-metrics__row cluster" data-gap="xl">
    <div class="cbf-invoice-queue-metrics__overdue">
      <EsaStat value={overdue} label="Overdue" sub="Immediate review needed" />
    </div>

    <EsaStat
      value={awaitingReview}
      label="Awaiting review"
      sub="Submitted by vendor"
    />

    <EsaStat
      value={returned}
      label="Returned"
      sub="Awaiting vendor resubmission"
    />

    <EsaStat
      value={recentlyApproved}
      label="Recently approved"
      sub="Pending PR creation"
    />
  </div>
</section>

<style>
  .cbf-invoice-queue-metrics {
    padding-bottom: var(--spacing-500);
    border-bottom: 1px solid var(--color-border-default);
  }
  .cbf-invoice-queue-metrics__row {
    /* Top-align the stats instead of the .cluster default (center). */
    --align: flex-start;
    row-gap: var(--spacing-400);
  }
  /* Overdue is a payment-timeliness alarm — tint its value danger. */
  .cbf-invoice-queue-metrics__overdue {
    --stat-value-color: var(--color-background-utility-danger, #b42318);
  }
</style>
