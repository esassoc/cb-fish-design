---
// cbf-invoice-review-queue — the COR's invoice review queue AND its review
// overlay. A searchable, status-filterable, sortable grid of every invoice
// assigned to the reviewer, sorted by urgency (most overdue first) so the
// review-by clock drives triage.
//
// NAVIGATION: a row click — and the invoice-number anchor in every row — goes to
// /invoice-review/<number>, the full processing page where the COR edits fields,
// flags issues, and decides. That page is the invoice's home; the grid is an index
// of links to it, which is why the number renders as a real <a> (cmd/middle-click
// and keyboard both work).
//
// The esa-side-dialog overlay is DEMOTED TO A PEEK: a split-view glance (SUBMITTED
// DOCUMENT left, contract context + decision right) opened only from the explicit
// quick-view control in each row's trailing cell, never from the row itself. Its
// prev/next footer still steps through the displayed rows for fast triage, and its
// "Process invoice" button hands off to the same detail page.
//
// bcn-lego-checked: (1) ecology has NO table/grid lego (checked the full
// node_modules/@esa/ecology/src/components catalog — esa-badge/esa-pill are atoms,
// none render a sortable tabular surface) — the grid is AG Grid Community (already
// a dependency, used by the vendor grid). (2) No esa-* lego renders an invoice
// DOCUMENT (a paper vendor bill with letterhead, bill-to, line-item ledger,
// totals) — that markup is bespoke and reusable, and lives here. Beacon is not on
// this machine. Every other control IS a lego: the overlay is esa-side-dialog; the
// split is the .sidebar layout primitive; status + days-left are esa-pill (real
// markup cloned into cells/panel so styling is identical, never reinvented); the
// final-invoice notice + decision result are esa-alert-box; Approve/Return and the
// nav are esa-button; Return's comment capture is esa-textarea; search reuses
// cbf-search-field; the status filter is esa-chip-group; empty is esa-empty-state.
import CbfSearchField from '../search/cbf-search-field.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import { reviewQueue as defaultQueue } from '../../data/invoice-review.mjs';

type Stage = 'Submitted' | 'In review' | 'Returned' | 'Approved';

interface Props {
  invoices?: typeof defaultQueue;
  // 'review' = the COR review queue (default, unchanged). 'workspace' = My
  // Invoices: adds the Asset Suite processing + aging columns, same overlay.
  variant?: 'review' | 'workspace';
  // Section heading text — defaults to the review-queue title so existing usage
  // is byte-for-byte unchanged; My Invoices passes "My invoices".
  title?: string;
}

// Asset Suite processing state → esa-pill variant. Mirrors the external Asset
// Suite money-processing lifecycle surfaced only in the workspace variant.
const assetVariant = { 'not-sent': 'default', processing: 'info', paid: 'success' } as const;
const assetKeys = Object.keys(assetVariant) as (keyof typeof assetVariant)[];

// esa-pill variant per review stage — color conveys state, not decoration.
// Same soft-tinted status chip the vendor dashboard invoices grid uses.
const stageVariant: Record<Stage, 'info' | 'warning' | 'success' | 'danger'> = {
  Submitted: 'info',
  'In review': 'warning',
  Returned: 'danger',
  Approved: 'success',
};
const stages = Object.keys(stageVariant) as Stage[];

// Urgency pill variants, keyed by bucket (see urgencyOf in the data module).
const urgencyVariant = { overdue: 'danger', 'due-soon': 'warning', 'on-track': 'default' } as const;
const urgencyKeys = Object.keys(urgencyVariant) as (keyof typeof urgencyVariant)[];

const stageFilters = [
  { value: '', label: 'All' },
  { value: 'Submitted', label: 'Submitted' },
  { value: 'In review', label: 'In review' },
  { value: 'Returned', label: 'Returned' },
  { value: 'Approved', label: 'Approved' },
];

const { invoices = defaultQueue, variant = 'review', title = 'Review queue' } = Astro.props;
---
<section class="cbf-invoice-review-queue stack" data-gap="md" data-variant={variant}>
  <header class="cbf-invoice-review-queue__header repel">
    <h2 class="type-section-title">{title}</h2>
    <div class="cbf-invoice-review-queue__search">
      <CbfSearchField
        placeholder="Search invoices, vendors or contracts…"
        iconSize={18}
        data-queue-search
        aria-label="Search the review queue"
      />
    </div>
  </header>

  <div class="cbf-invoice-review-queue__controls">
    <esa-chip-group
      data-queue-stage-filter
      size="sm"
      label="Filter by status"
      value=""
      options={JSON.stringify(stageFilters)}
    ></esa-chip-group>
    {/* Optional trailing controls (e.g. a "View invoice history" link) — sit at
        the right edge of the filter row. Empty in the review variant. */}
    <div class="cbf-invoice-review-queue__controls-end">
      <slot name="controls-end" />
    </div>
  </div>

  <!-- AG Grid mounts here; auto-height grows with rows so the page owns scroll. -->
  <div class="cbf-invoice-review-queue__grid" data-queue-grid></div>

  <div class="cbf-invoice-review-queue__empty" data-queue-empty hidden>
    <EsaEmptyState
      title="No invoices match your filters"
      description="Try a different invoice number, vendor, contract, or status."
      size="sm"
    />
  </div>

  <footer class="cbf-invoice-review-queue__footer">
    <span class="type-caption" data-queue-count>
      Showing {invoices.length} of {invoices.length} invoices
    </span>
  </footer>

  <!-- Real esa-pill legos, server-rendered once per stage AND per urgency bucket
       with the design-system scope hash intact. Grid cells + the panel clone the
       matching template's markup — so every pill is byte-identical to the lego,
       matching the vendor dashboard invoices grid's status chips. -->
  <div class="cbf-invoice-review-queue__badge-templates" data-badge-templates hidden aria-hidden="true">
    {stages.map((s) => (
      <span data-stage={s}><EsaPill label={s} variant={stageVariant[s]} size="md" removable={false} /></span>
    ))}
    {urgencyKeys.map((u) => (
      <span data-urgency={u}><EsaPill label={u} variant={urgencyVariant[u]} size="md" removable={false} /></span>
    ))}
    <span data-flag="final"><EsaPill label="Final" variant="default" size="md" removable={false} /></span>
    {variant === 'workspace' && assetKeys.map((a) => (
      <span data-asset={a}><EsaPill label={a} variant={assetVariant[a]} size="md" removable={false} /></span>
    ))}
    {/* The quick-view control, server-rendered once as a real esa-icon-button and
        cloned into every row's peek cell — so the grid never hand-rolls a button. */}
    <span data-peek-button><EsaIconButton icon="eye" label="Quick view" size="sm" /></span>
  </div>

  <!-- Row data for the client grid module (avoids a second fetch). -->
  <script type="application/json" data-queue-data set:html={JSON.stringify(invoices)}></script>

  <!-- ───────── Review overlay: the split-view QA/QC surface (lego drawer) ─────────
       Populated from the clicked row; prev/next step through the displayed rows. -->
  <esa-side-dialog data-review-dialog size="lg" heading="Invoice" class="cbf-review-dialog">
    <!-- Custom header: a large invoice-number title pushed to the right so it sits
         over the info panel (the side strip), instead of a small title lost top-left. -->
    <div slot="header" class="cbf-review-dialog__titlebar">
      <span class="cbf-review-dialog__title cbf-num" data-f-dialog-title></span>
    </div>
    <div
      class="cbf-review-split sidebar"
      data-side="end"
      style="--sidebar-width: 22rem; --sidebar-content-min: 50%; --gap: var(--spacing-600);"
    >
      <!-- Panel (first child → ordered right by data-side=end). -->
      <aside class="cbf-review-panel stack" data-gap="lg" aria-label="Review">
        <!-- Deadline leads (matches the detail page); the status pill stays on the
             right because the preview must still show where the invoice sits in the
             pipeline. The review-by date goes red only when overdue; the urgency
             alert + a quiet submitted/net-terms line sit beneath it. -->
        <header class="cbf-review-hero repel">
          <div class="cbf-review-deadline">
            <span class="cbf-review__label">Review by</span>
            <span class="cbf-review-deadline__date" data-f-reviewby></span>
            <span class="cbf-review-deadline__urgency" data-f-urgency></span>
            <p class="cbf-review-deadline__support">
              Submitted <span data-f-submitted></span> · <span data-f-net-terms></span>
            </p>
          </div>
          <span class="cbf-review-hero__status" data-f-status></span>
        </header>

        <div data-f-final-alert hidden>
          <EsaAlertBox variant="info" title="Final invoice">
            Closes out this contract. Confirm all deliverables are accepted and any retainage is accounted for before approving.
          </EsaAlertBox>
        </div>

        <!-- Invoice information — uniform-weight fields; contract & project lead with
             the reference NUMBER (that's what's copied), the name as a quiet sub. The
             performance-end row notes how close it runs to the contract end date. -->
        <dl class="cbf-review-fields">
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Invoice</dt>
            <dd class="cbf-review-fields__value cbf-num" data-f-number-panel></dd>
            <span class="cbf-review-fields__copy" data-copy>
              <EsaIconButton icon="copy" label="Copy invoice number" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Vendor</dt>
            <dd class="cbf-review-fields__value" data-f-vendor-panel></dd>
            <span class="cbf-review-fields__copy" data-copy>
              <EsaIconButton icon="copy" label="Copy vendor" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Contract</dt>
            <dd class="cbf-review-fields__value cbf-num" data-f-contract>
              <span data-f-contract-num></span>
              <span class="cbf-review-fields__sub" data-f-contract-name></span>
            </dd>
            <span class="cbf-review-fields__copy" data-copy data-f-contract-copy>
              <EsaIconButton icon="copy" label="Copy contract number" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Project</dt>
            <dd class="cbf-review-fields__value cbf-num" data-f-project>
              <span data-f-project-num></span>
              <span class="cbf-review-fields__sub" data-f-project-name></span>
            </dd>
            <span class="cbf-review-fields__copy" data-copy data-f-project-copy>
              <EsaIconButton icon="copy" label="Copy project number" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Perf. start</dt>
            <dd class="cbf-review-fields__value" data-f-perf-start></dd>
            <span class="cbf-review-fields__copy" data-copy>
              <EsaIconButton icon="copy" label="Copy performance start date" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Perf. end</dt>
            <dd class="cbf-review-fields__value" data-f-perf-end>
              <span data-f-perf-end-date></span>
              <span class="cbf-review-fields__sub" data-f-contract-end></span>
            </dd>
            <span class="cbf-review-fields__copy" data-copy data-f-perf-end-copy>
              <EsaIconButton icon="copy" label="Copy performance end date" size="xs" />
            </span>
          </div>
        </dl>

        <!-- Amount information — left-aligned rows matching the fields above. -->
        <dl class="cbf-review-fields cbf-review-money" aria-label="Amount">
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Amount</dt>
            <dd class="cbf-review-fields__value cbf-review-money__amount cbf-num" data-f-amount-hero></dd>
            <span class="cbf-review-fields__copy" data-copy data-f-amount-copy>
              <EsaIconButton icon="copy" label="Copy amount" size="xs" />
            </span>
          </div>
          <div class="cbf-review-fields__row">
            <dt class="cbf-review__label">Contract remaining</dt>
            <dd class="cbf-review-fields__value cbf-num" data-f-remaining>
              <span data-f-remaining-val></span>
              <span class="cbf-review-fields__sub" data-f-rem-after></span>
            </dd>
          </div>
        </dl>

        <!-- Backup documentation: the supporting files the vendor uploaded with
             the invoice. Each row carries a "view" control that renders the file in
             the document pane (left) and a download control. The COR downloads any
             single file or all at once. Rows are injected by JS; the per-row view +
             download controls clone the server-rendered esa-icon-button templates
             below so the lego markup stays byte-identical. (Mock files — download
             produces a named placeholder PDF, since no real blob exists.) -->
        <section class="cbf-review-attachments" aria-label="Backup documentation">
          <div class="cbf-review-attachments__head repel">
            <h3 class="cbf-review__section-title" data-f-attach-title>Backup documentation</h3>
            <span data-attach-all>
              <EsaButton appearance="outline" color="secondary" size="sm" icon="download">Download all</EsaButton>
            </span>
          </div>
          <ul class="cbf-review-attachments__list" data-f-attachments></ul>
        </section>

        <div data-dl-template hidden aria-hidden="true">
          <EsaIconButton icon="download" label="Download file" size="sm" />
        </div>

        <!-- Single action: this overlay is a quick preview. Processing the invoice
             (reviewing the documents + Line Item Budget and approving or returning)
             happens on the invoice's own page. EsaButton renders as a link; its href
             is set to the invoice's process page per record in populate(). -->
        <div class="cbf-review-process" data-process>
          <EsaButton href="#" color="primary" size="md" icon="arrow-right">Process invoice</EsaButton>
        </div>
      </aside>

      <!-- Document (last child → fluid, left). A read-only preview of the submitted
           invoice so the COR can eyeball the bill from the queue. The full document
           workspace (Line Item Budget, backup files side by side, approve / return)
           lives on the invoice's Process page, not this preview. -->
      <div class="cbf-review-docpane">
        <div class="cbf-review-docpane__scroll">
        <article class="cbf-invoice-doc" data-doc-view="invoice" aria-label="Submitted invoice document">
          <div class="cbf-invoice-doc__stamp" data-f-stamp hidden>Final invoice</div>
          <header class="cbf-invoice-doc__head">
            <div>
              <p class="cbf-invoice-doc__vendor" data-f-vendor-doc></p>
              <p class="cbf-invoice-doc__sub">Vendor</p>
            </div>
            <div class="cbf-invoice-doc__meta">
              <p><span>Invoice #</span> <strong class="cbf-num" data-f-num-doc></strong></p>
              <p><span>Date</span> <strong data-f-date></strong></p>
            </div>
          </header>

          <div class="cbf-invoice-doc__billto">
            <p class="cbf-invoice-doc__sub">Bill to</p>
            <p data-f-billto></p>
          </div>

          <table class="cbf-invoice-doc__items">
            <thead>
              <tr>
                <th scope="col">Description</th>
                <th scope="col" class="cbf-num">Qty</th>
                <th scope="col" class="cbf-num">Unit</th>
                <th scope="col" class="cbf-num">Total</th>
              </tr>
            </thead>
            <tbody data-f-items></tbody>
            <tfoot>
              <tr><th scope="row" colspan="3">Subtotal</th><td class="cbf-num" data-f-subtotal></td></tr>
              <tr><th scope="row" colspan="3">Tax</th><td class="cbf-num" data-f-tax></td></tr>
              <tr class="cbf-invoice-doc__total"><th scope="row" colspan="3">Total</th><td class="cbf-num" data-f-total></td></tr>
            </tfoot>
          </table>

          <p class="cbf-invoice-doc__memo" data-f-memo-wrap hidden><span>Memo:</span> <span data-f-memo></span></p>
          <p class="cbf-invoice-doc__generated" data-f-pdf></p>
        </article>
        </div>
      </div>
    </div>

    <div slot="footer" class="cbf-review-footer repel">
      <span class="cbf-review-footer__position" data-f-position></span>
      <div class="cluster" data-gap="xs">
        <span data-review-prev><EsaButton appearance="outline" color="secondary" icon="chevron-left">Previous</EsaButton></span>
        <span data-review-next><EsaButton appearance="outline" color="secondary" icon="chevron-right">Next</EsaButton></span>
      </div>
    </div>
  </esa-side-dialog>
</section>

<style>
  .cbf-invoice-review-queue__header {
    align-items: center;
    gap: var(--spacing-400);
    flex-wrap: wrap;
  }
  .cbf-invoice-review-queue__search {
    flex: 1 1 280px;
    max-width: 440px;
    min-width: 220px;
  }
  /* Filter row: status chips on the left, optional trailing controls (the
     controls-end slot) pushed to the right corner. Wraps on narrow widths. */
  .cbf-invoice-review-queue__controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-300) var(--spacing-400);
    flex-wrap: wrap;
  }
  .cbf-invoice-review-queue__controls-end { margin-left: auto; }
  /* No trailing controls (review variant / empty slot) → the wrapper adds no gap. */
  .cbf-invoice-review-queue__controls-end:empty { display: none; }
  .cbf-invoice-review-queue__grid {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    overflow: hidden;
    background: var(--color-surface);
  }
  .cbf-invoice-review-queue__footer { color: var(--color-text-tertiary); }

  /* A wide overlay so the split breathes — clamps to the viewport on small screens.
     Effectively a full-bleed review surface on desktop, like the Acctual reference.
     Scales to 75% of the viewport on the widest screens, but never below 1180px so
     mid-width desktops don't regress (a flat 75vw would be narrower than 1180 below
     ~1573px). The lego still clamps to calc(100vw - inset) on small screens.
     NB: the panel is size="lg", so the lego resolves its width from
     --side-dialog-width-lg (NOT --side-dialog-width, which the lg selector
     overrides). Re-point the lg token or the override is silently ignored. */
  .cbf-review-dialog { --side-dialog-width-lg: max(1180px, 75vw); }

  /* Dialog title (custom header slot): a large invoice number pushed to the right
     so it sits over the info panel (the side strip) rather than getting lost small
     in the top-left. flex:1 + right-align places it beside the close button. */
  .cbf-review-dialog__titlebar { flex: 1; min-width: 0; text-align: right; }
  .cbf-review-dialog__title {
    font-size: var(--type-size-500);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  /* Panel ----------------------------------------------------------------- */
  .cbf-review__label {
    font-size: var(--type-size-150);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
  }
  .cbf-review__section-title {
    margin: 0;
    font-size: var(--type-size-150);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-tertiary);
  }

  /* Deadline leads the panel (matches the detail page); standard text color, red
     ONLY when overdue. The status pill stays on the right so the preview shows where
     the invoice sits in the pipeline. */
  .cbf-review-hero { align-items: flex-start; gap: var(--spacing-400); }
  .cbf-review-hero__status { flex: none; }
  .cbf-review-deadline { display: flex; flex-direction: column; gap: var(--spacing-100); min-width: 0; }
  .cbf-review-deadline__date {
    font-size: var(--type-size-500);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .cbf-review-deadline__date--overdue { color: var(--color-danger, #b42318); }
  .cbf-review-deadline__urgency { display: block; }
  .cbf-review-deadline__urgency:empty { display: none; }
  .cbf-review-deadline__support {
    margin: var(--spacing-100) 0 0;
    font-size: var(--type-size-100);
    color: var(--color-text-tertiary);
  }

  /* Amount block reuses the field-row grid; a top/bottom hairline sets it off. The
     amount is emphasized by size only (no bold), left-aligned in the shared column. */
  .cbf-review-money { padding-block: var(--spacing-200); border-block: 1px solid var(--color-border); }
  .cbf-review-money__amount {
    font-size: var(--type-size-400);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  .cbf-review-fields { margin: 0; }
  .cbf-review-fields__row {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    gap: var(--spacing-300);
    align-items: baseline;
    padding-block: var(--spacing-250);
    border-top: 1px solid var(--color-border-light, var(--color-border));
  }
  .cbf-review-fields__row:first-child { border-top: 0; padding-top: 0; }
  .cbf-review-fields__value { margin: 0; font-size: var(--type-size-200); color: var(--color-text-secondary); }
  /* Secondary line under a value — the contract/project NAME (the number leads) or
     the contract-end note under the performance end date. Quieter than the value. */
  .cbf-review-fields__sub {
    display: block;
    margin-top: var(--spacing-50);
    font-size: var(--type-size-100);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-tertiary);
  }

  /* Per-field copy control — the esa-icon-button lego, quiet until hovered.
     They're transcribing these values into another system, so every atomic
     value (incl. the split performance dates) is copyable on its own. */
  .cbf-review-fields__copy {
    align-self: center;
    position: relative;
    line-height: 0;
    color: var(--color-text-tertiary);
  }
  .cbf-review-fields__copy :global(.esa-icon-button) { color: inherit; }
  .cbf-review-fields__copy :global(.esa-icon-button:hover) {
    background: color-mix(in srgb, var(--color-text-tertiary) 14%, transparent);
    color: var(--color-text-primary);
  }
  /* Copied feedback: tint the control + a transient "Copied" label beside it.
     -strong is the accessible TEXT step; plain --color-success is the solid-FILL
     step and lands near 2:1 painted onto a glyph. */
  .cbf-review-fields__copy[data-state='copied'] { color: var(--color-success-strong); }
  .cbf-review-fields__copy[data-state='copied']::after {
    content: 'Copied';
    position: absolute;
    right: calc(100% + var(--spacing-150));
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: var(--type-size-050);
    font-weight: var(--font-weight-medium);
    color: var(--color-success-strong);
    pointer-events: none;
  }

  /* Attachments ----------------------------------------------------------- */
  .cbf-review-attachments { margin-top: var(--spacing-200); }
  .cbf-review-attachments__head {
    align-items: center;
    gap: var(--spacing-300);
    margin-bottom: var(--spacing-300);
  }
  .cbf-review-attachments__head .cbf-review__section-title { margin: 0; }
  .cbf-review-attachments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    overflow: hidden;
  }

  /* Single "Process invoice" CTA — right-aligned at the foot of the preview panel
     (this overlay is a quick preview; the decision happens on the Process page). */
  .cbf-review-process { display: flex; justify-content: flex-end; margin-top: var(--spacing-200); }

  /* Fill the dialog body's full height (the side-dialog .body is flex:1 inside a
     fixed-height panel) so the split — and the document pane within it — runs the
     whole height of the overlay, like a real PDF viewer, instead of sizing to the
     taller of the two columns. */
  .cbf-review-split { min-height: 100%; }

  /* Document pane --------------------------------------------------------- */
  .cbf-review-docpane {
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }
  /* Scroll area holds the centered invoice document. */
  .cbf-review-docpane__scroll {
    flex: 1;
    min-height: 0;
    padding: var(--spacing-600);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-y: auto;
  }

  .cbf-invoice-doc {
    position: relative;
    flex: 1 0 auto;
    width: 100%;
    max-width: 620px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-surface-inverse) 10%, transparent);
    padding: var(--spacing-700) var(--spacing-700) var(--spacing-600);
    color: var(--color-text-primary);
    font-size: var(--type-size-150);
    line-height: var(--line-height-normal);
  }
  .cbf-invoice-doc__stamp {
    position: absolute;
    top: var(--spacing-500);
    right: var(--spacing-500);
    font-size: var(--type-size-100);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-danger, #b42318);
    border: 1.5px solid currentColor;
    border-radius: var(--radius-100);
    padding: 2px var(--spacing-200);
    transform: rotate(-4deg);
    opacity: 0.8;
  }
  .cbf-invoice-doc__head {
    display: flex; justify-content: space-between; gap: var(--spacing-400);
    align-items: flex-start; margin-bottom: var(--spacing-500);
  }
  .cbf-invoice-doc__vendor { margin: 0; font-size: var(--type-size-400); font-weight: var(--font-weight-bold); }
  .cbf-invoice-doc__sub { margin: 0; color: var(--color-text-tertiary); font-size: var(--type-size-100); }
  .cbf-invoice-doc__meta { text-align: right; }
  .cbf-invoice-doc__meta p { margin: 0 0 var(--spacing-100); }
  .cbf-invoice-doc__meta span { color: var(--color-text-tertiary); margin-right: var(--spacing-200); }
  .cbf-invoice-doc__billto { margin-bottom: var(--spacing-500); }
  .cbf-invoice-doc__billto p { margin: 0; }

  .cbf-invoice-doc__items { width: 100%; border-collapse: collapse; }
  .cbf-invoice-doc__items th, .cbf-invoice-doc__items td { text-align: left; padding: var(--spacing-250) 0; vertical-align: top; }
  .cbf-invoice-doc__items thead th {
    border-bottom: 1px solid var(--color-text-primary);
    font-weight: var(--font-weight-semibold); font-size: var(--type-size-100); color: var(--color-text-secondary);
  }
  .cbf-invoice-doc__items tbody tr + tr td { border-top: 1px solid var(--color-border-light, var(--color-border)); }
  .cbf-invoice-doc__items tfoot th, .cbf-invoice-doc__items tfoot td { padding: var(--spacing-150) 0; text-align: right; }
  .cbf-invoice-doc__items tfoot th { font-weight: var(--font-weight-regular); color: var(--color-text-secondary); }
  .cbf-invoice-doc__items tfoot tr:first-child th, .cbf-invoice-doc__items tfoot tr:first-child td { padding-top: var(--spacing-400); }
  .cbf-invoice-doc__total th, .cbf-invoice-doc__total td {
    border-top: 1px solid var(--color-text-primary); font-weight: var(--font-weight-bold);
    font-size: var(--type-size-200); padding-top: var(--spacing-300) !important;
  }
  .cbf-invoice-doc .cbf-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cbf-invoice-doc__items th.cbf-num { text-align: right; }
  .cbf-invoice-doc__memo { margin: var(--spacing-600) 0 0; color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .cbf-invoice-doc__memo span { color: var(--color-text-tertiary); }
  .cbf-invoice-doc__generated {
    margin: var(--spacing-600) 0 0; padding-top: var(--spacing-400);
    border-top: 1px solid var(--color-border-light, var(--color-border));
    color: var(--color-text-tertiary); font-size: var(--type-size-100); font-style: italic;
  }

  .cbf-review-footer { align-items: center; gap: var(--spacing-400); width: 100%; }
  .cbf-review-footer__position {
    font-size: var(--type-size-150); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums;
  }
</style>

<style is:global>
  .cbf-invoice-review-queue__grid .cbf-grid-status { display: inline-flex; align-items: center; height: 100%; }
  .cbf-invoice-review-queue__grid .cbf-grid-num,
  .cbf-invoice-review-queue__grid .cbf-grid-num .ag-header-cell-label {
    justify-content: flex-end; text-align: right; font-variant-numeric: tabular-nums;
  }
  .cbf-invoice-review-queue__grid .cbf-grid-id { font-variant-numeric: tabular-nums; color: var(--color-text-secondary); }
  /* Workspace Invoice # cell: number + inline Final pill (Final? column dropped). */
  .cbf-invoice-review-queue__grid .cbf-grid-idcell { display: inline-flex; align-items: center; gap: var(--spacing-200); height: 100%; }
  /* Terminal-stage Days-left cell: a quiet placeholder, not an urgency pill. */
  .cbf-invoice-review-queue__grid .cbf-grid-muted { color: var(--color-text-tertiary); }
  .cbf-invoice-review-queue__grid .ag-row { cursor: pointer; }

  /* Invoice-number anchor → the invoice's processing page. Injected by the cell
     renderer (no Astro scope hash), so it is styled here. Reads as a link on hover
     and focus rather than shouting in link-blue at rest — the whole row is
     clickable, and a grid of underlined blue IDs would be noise. */
  .cbf-invoice-review-queue__grid .cbf-grid-link {
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-100, 4px);
  }
  .cbf-invoice-review-queue__grid .cbf-grid-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .cbf-invoice-review-queue__grid .cbf-grid-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Quick-view cell: the peek drawer's only entry point. The control is quiet at
     rest and surfaces on row hover / keyboard focus, so it never competes with the
     data — but it is always reachable by tab. */
  .cbf-invoice-review-queue__grid .cbf-grid-peek { display: flex; align-items: center; justify-content: center; }
  .cbf-invoice-review-queue__grid .cbf-grid-peek__btn {
    display: inline-flex;
    color: var(--color-text-tertiary);
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .cbf-invoice-review-queue__grid .ag-row:hover .cbf-grid-peek__btn,
  .cbf-invoice-review-queue__grid .cbf-grid-peek__btn:focus-within { opacity: 1; }
  /* Touch / coarse pointers never hover — the control must always be visible there. */
  @media (hover: none) {
    .cbf-invoice-review-queue__grid .cbf-grid-peek__btn { opacity: 1; }
  }

  /* Document line items are injected by JS (no Astro scope hash) — styled globally. */
  .cbf-invoice-doc__items tbody td { font-size: var(--type-size-150); }

  /* Backup-documentation rows are injected by JS — styled globally. The filename
     carries its own extension; the affordances are the view control (renders the
     file in the document pane) and the download control — actions, not decoration. */
  .cbf-review-attach {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-150) var(--spacing-200) var(--spacing-150) var(--spacing-400);
  }
  .cbf-review-attach + .cbf-review-attach { border-top: 1px solid var(--color-border-light, var(--color-border)); }
  .cbf-review-attach__name {
    flex: 1;
    min-width: 0;
    font-size: var(--type-size-150);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cbf-review-attach--empty .cbf-review-attach__name { color: var(--color-text-tertiary); }
  .cbf-review-attach__dl { flex: none; line-height: 0; color: var(--color-text-tertiary); }
  .cbf-review-attach__dl .esa-icon-button:hover {
    background: color-mix(in srgb, var(--color-text-tertiary) 14%, transparent);
    color: var(--color-text-primary);
  }
</style>

<script>
  import { createGrid, ModuleRegistry, AllCommunityModule, themeQuartz } from 'ag-grid-community';
  import '@esa/ecology/esa-chip-group';
  import '@esa/ecology/esa-side-dialog';

  ModuleRegistry.registerModules([AllCommunityModule]);

  type Dir = 1 | -1;
  type Stage = 'Submitted' | 'In review' | 'Returned' | 'Approved';
  type LineItem = { description: string; qty: number; unitPrice: number };
  type Invoice = {
    number: string; vendor: string;
    contract: string; contractNumber: string; project: string; projectNumber: string;
    submitted: string; reviewBy: string; daysRemaining: number; netTerms: string;
    amount: number; stage: Stage; final: boolean;
    invoiceDate: string; perfStart: string; perfEnd: string; contractEnd: string;
    billTo: string; lineItems: LineItem[]; notes?: string; pdfName: string;
    supportingDocs: string[];
    contractValue: number; expended: number; remaining: number; asOf: string;
    // Workspace-variant fields (My Invoices). Present on every record; only
    // read when the queue renders the workspace columns.
    assetSuite?: string; inStatusDays?: number;
  };

  const usd = new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2,
  });
  // Compact for the supporting contract figures ($420K) — the exact billed amount
  // is the hero; the context recedes in precision as well as in size.
  const usdCompact = new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1,
  });
  const qtyFmt = new Intl.NumberFormat('en-US');

  // ---- File download (prototype) ---------------------------------------
  // No real blobs exist for the mock invoices, so a download builds a minimal
  // valid one-page PDF named after the file. Enough for the COR flow to feel
  // real — the file saves with the right name and opens.
  const pdfEscape = (s: string) => s.replace(/([()\\])/g, '\\$1');
  function makePlaceholderPdf(filename: string, subtitle: string): Blob {
    const body =
      `BT /F1 18 Tf 60 740 Td (${pdfEscape(filename)}) Tj ` +
      `/F1 11 Tf 0 -26 Td (${pdfEscape(subtitle)}) Tj ` +
      `0 -18 Td (Columbia Basin Fish & Wildlife Program — prototype placeholder) Tj ET`;
    const objs = [
      '<</Type/Catalog/Pages 2 0 R>>',
      '<</Type/Pages/Kids[3 0 R]/Count 1>>',
      '<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 5 0 R>>>>/Contents 4 0 R>>',
      `<</Length ${body.length}>>\nstream\n${body}\nendstream`,
      '<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>',
    ];
    let pdf = '%PDF-1.4\n';
    const offsets: number[] = [];
    objs.forEach((o, i) => { offsets.push(pdf.length); pdf += `${i + 1} 0 obj\n${o}\nendobj\n`; });
    const xref = pdf.length;
    pdf += `xref\n0 ${objs.length + 1}\n0000000000 65535 f \n`;
    offsets.forEach((off) => { pdf += `${String(off).padStart(10, '0')} 00000 n \n`; });
    pdf += `trailer\n<</Size ${objs.length + 1}/Root 1 0 R>>\nstartxref\n${xref}\n%%EOF`;
    return new Blob([pdf], { type: 'application/pdf' });
  }
  function downloadFile(filename: string, invoiceNumber: string) {
    const blob = makePlaceholderPdf(filename, `Attachment for invoice ${invoiceNumber}`);
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  // The invoice's full processing page — the destination for a row click, the
  // invoice-number anchor, and the drawer's "Process invoice" button alike.
  const detailHref = (number: string) =>
    `${import.meta.env.BASE_URL}invoice-review/${encodeURIComponent(number)}`;

  const urgencyOf = (d: number) => (d < 0 ? 'overdue' : d <= 3 ? 'due-soon' : 'on-track');
  const daysLabel = (d: number) => {
    if (d < 0) { const n = Math.abs(d); return `${n} day${n === 1 ? '' : 's'} overdue`; }
    if (d === 0) return 'Due today';
    return `${d} day${d === 1 ? '' : 's'} left`;
  };

  // Open (actionable) stages — the review clock is only meaningful here. Mirrors
  // openStages in the data module: Returned/Approved are terminal, so their
  // stored daysRemaining no longer signals urgency. rank sorts open before
  // terminal; isOpenStage gates the urgency pill (grid + overlay clock).
  const openStages: Stage[] = ['Submitted', 'In review'];
  const isOpenStage = (s: Stage) => openStages.includes(s);

  // How the invoice's performance-period END sits relative to the contract's END.
  const contractEndGap = (perfEndStr: string, contractEndStr: string): string => {
    const a = new Date(perfEndStr);
    const b = new Date(contractEndStr);
    if (isNaN(a.getTime()) || isNaN(b.getTime())) return '';
    const days = Math.round((b.getTime() - a.getTime()) / 86_400_000);
    if (days === 0) return 'ends on the contract end date';
    const n = Math.abs(days);
    return days > 0
      ? `${n} day${n === 1 ? '' : 's'} before contract end`
      : `${n} day${n === 1 ? '' : 's'} past contract end`;
  };
  const stageRank = (inv: Invoice) => (isOpenStage(inv.stage) ? 0 : 1);

  const cbfTheme = themeQuartz.withParams({
    fontFamily: 'inherit', fontSize: '14px',
    foregroundColor: 'var(--color-text-primary)', backgroundColor: 'var(--color-surface)',
    headerBackgroundColor: 'var(--color-surface-sunken, transparent)',
    headerTextColor: 'var(--color-text-secondary)', headerFontWeight: 600,
    borderColor: 'var(--color-border)',
    rowHoverColor: 'var(--color-surface-subtle, var(--color-primary-subtle))',
    accentColor: 'var(--color-primary)', wrapperBorderRadius: 0, borderRadius: 'var(--radius-100, 4px)',
  });

  function initQueue(root: HTMLElement) {
    const gridHost = root.querySelector<HTMLElement>('[data-queue-grid]');
    const dataEl = root.querySelector<HTMLScriptElement>('[data-queue-data]');
    if (!gridHost || !dataEl) return;

    const data: Invoice[] = JSON.parse(dataEl.textContent ?? '[]');
    const total = data.length;

    const search = root.querySelector<HTMLInputElement>('[data-queue-search]');
    const stageFilter = root.querySelector<HTMLElement & { value: string }>('[data-queue-stage-filter]');
    const empty = root.querySelector<HTMLElement>('[data-queue-empty]');
    const count = root.querySelector<HTMLElement>('[data-queue-count]');

    // Pre-clone the real esa-pill markup per stage + urgency (scope hash intact).
    const stageHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-badge-templates] [data-stage]').forEach((el) => {
      stageHTML.set(el.dataset.stage ?? '', el.innerHTML);
    });
    const urgencyHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-badge-templates] [data-urgency]').forEach((el) => {
      urgencyHTML.set(el.dataset.urgency ?? '', el.innerHTML);
    });
    const finalHTML = root.querySelector<HTMLElement>('[data-badge-templates] [data-flag="final"]')?.innerHTML ?? 'Final';
    const peekBtnHTML = root.querySelector<HTMLElement>('[data-badge-templates] [data-peek-button]')?.innerHTML ?? '';

    // Asset Suite pill templates (workspace variant only). Empty in the review
    // variant since those templates aren't server-rendered there.
    const assetHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-badge-templates] [data-asset]').forEach((el) => {
      assetHTML.set(el.dataset.asset ?? '', el.innerHTML);
    });

    // Clone a pill template and swap its text node for a custom label.
    const badgeWith = (html: string, label: string) => {
      const tmpl = document.createElement('div');
      tmpl.innerHTML = html;
      const labelEl = tmpl.querySelector('.esa-pill__label') ?? tmpl.firstElementChild ?? tmpl;
      labelEl.textContent = label;
      return tmpl.innerHTML;
    };
    // Open-stage rows show the urgency pill; terminal rows (Returned/Approved)
    // have a finished clock, so a plain muted em dash — never a red "overdue" pill.
    const urgencyBadge = (inv: Invoice) =>
      isOpenStage(inv.stage)
        ? `<span class="cbf-grid-status">${badgeWith(urgencyHTML.get(urgencyOf(inv.daysRemaining)) ?? '', daysLabel(inv.daysRemaining))}</span>`
        : '<span class="cbf-grid-muted" aria-hidden="true">—</span>';

    // Map an Asset Suite display string to its processing state, then render the
    // matching pill with the full display string as its label — same
    // label-inside-the-pill presentation the stage/urgency cells use.
    const assetStateOf = (display: string) =>
      display.startsWith('Paid') ? 'paid' : display.startsWith('Processing') ? 'processing' : 'not-sent';
    const assetBadge = (inv: Invoice) => {
      const display = inv.assetSuite ?? 'Not sent';
      return `<span class="cbf-grid-status">${badgeWith(assetHTML.get(assetStateOf(display)) ?? '', display)}</span>`;
    };

    let stageValue = '';
    let overdueOnly = false;
    let openDetail: (inv: Invoice) => void = () => {};

    const isWorkspace = root.dataset.variant === 'workspace';

    // Days-left cell renders as pill (open) or muted em dash (terminal); the
    // custom comparator keeps open-stage rows above terminal rows under the
    // default 'asc' sort, then daysRemaining ascending within each group — so a
    // -20 "Approved" record can never surface above a genuinely open invoice.
    const daysLeftCol = {
      headerName: 'Days left', field: 'daysRemaining', colId: 'daysRemaining',
      minWidth: isWorkspace ? 140 : 150, sort: 'asc' as const,
      cellRenderer: (p: { data: Invoice }) => urgencyBadge(p.data),
      comparator: (a: number, b: number, nodeA: { data: Invoice }, nodeB: { data: Invoice }) =>
        stageRank(nodeA.data) - stageRank(nodeB.data) || (a - b),
    };

    // Invoice #. The number is a REAL anchor to the invoice's detail page — so it
    // reads as a link, supports middle-click / cmd-click / open-in-new-tab, and is
    // reachable by keyboard. (A row click navigates to the same href; the anchor is
    // what makes that destination discoverable and honest.)
    // In the workspace variant the "Final?" column is dropped, so the final flag
    // rides inline after the number (same clone/scope-hash pill the standalone
    // column used). Review variant keeps a bare linked number + a separate Final?
    // column.
    const invoiceNumCol = {
      headerName: 'Invoice #', field: 'number', colId: 'number',
      cellClass: 'cbf-grid-id', minWidth: 160,
      getQuickFilterText: (p: { data: Invoice }) => `${p.data.number} ${p.data.project}`,
      cellRenderer: (p: { data: Invoice }) => {
        const link = `<a class="cbf-grid-link" href="${detailHref(p.data.number)}">${p.data.number}</a>`;
        return isWorkspace && p.data.final
          ? `<span class="cbf-grid-idcell">${link}<span class="cbf-grid-status">${finalHTML}</span></span>`
          : link;
      },
    };

    // Quick view — the ONLY way into the peek drawer now that the row itself goes to
    // the full detail page. An explicit, labelled affordance beats a hidden gesture:
    // the COR chooses between "glance" (drawer) and "work it" (page).
    const quickViewCol = {
      headerName: '', colId: 'quickView',
      minWidth: 56, maxWidth: 56, sortable: false, resizable: false,
      cellClass: 'cbf-grid-peek',
      cellRenderer: () => `<span class="cbf-grid-peek__btn" data-quick-view>${peekBtnHTML}</span>`,
    };

    const amountCol = {
      headerName: 'Amount', field: 'amount', colId: 'amount',
      type: 'numericColumn', headerClass: 'cbf-grid-num', cellClass: 'cbf-grid-num',
      minWidth: 130, valueFormatter: (p: { value: number }) => usd.format(p.value),
    };
    const statusCol = {
      headerName: 'Status', field: 'stage', colId: 'stage', minWidth: 150,
      cellRenderer: (p: { value: string }) => `<span class="cbf-grid-status">${stageHTML.get(p.value) ?? p.value}</span>`,
    };

    // Trim min-widths in the workspace so the full set fits ~1350px without
    // horizontal scroll — the Asset Suite column stays in view. The review
    // variant keeps its original min-widths (and its Review by + Final? columns).
    const vendorMin = isWorkspace ? 170 : 200;
    const contractMin = isWorkspace ? 170 : 200;
    const vendorCol = { headerName: 'Vendor', field: 'vendor', colId: 'vendor', flex: 2, minWidth: vendorMin };
    const contractCol = { headerName: 'Contract', field: 'contract', colId: 'contract', flex: 2, minWidth: contractMin };

    // Review-variant-only columns: the review-by date + the standalone Final flag.
    const reviewOnlyCols = isWorkspace
      ? []
      : [
          { headerName: 'Final?', field: 'final', colId: 'final', minWidth: 100, sortable: true,
            cellRenderer: (p: { value: boolean }) => (p.value ? `<span class="cbf-grid-status">${finalHTML}</span>` : '') },
        ];
    const reviewByCol = isWorkspace
      ? []
      : [{ headerName: 'Review by', field: 'reviewBy', colId: 'reviewBy', minWidth: 130 }];

    // Workspace-variant-only columns: Asset Suite processing pill + aging column.
    const workspaceCols = isWorkspace
      ? [
          {
            headerName: 'Asset Suite', field: 'assetSuite', colId: 'assetSuite',
            flex: 2, minWidth: 180,
            cellRenderer: (p: { data: Invoice }) => assetBadge(p.data),
          },
          {
            headerName: 'In status', field: 'inStatusDays', colId: 'inStatusDays',
            minWidth: 110,
            valueFormatter: (p: { value: number }) => `${p.value ?? 0} days`,
          },
        ]
      : [];

    // Column order (each variant then gains a trailing 56px quick-view cell):
    //  review    → Days left · Review by · Invoice # · Vendor · Contract · Amount · Final? · Status  (8)
    //  workspace → Days left · Invoice # · Vendor · Contract · Amount · Status · Asset Suite · In status  (8)
    //
    // Workspace: add flex:1 to the five non-flex columns so all 8 columns fill the
    // viewport exactly, with minWidths still guarding narrow cases. The review
    // variant's column objects are left byte-identical — flex is applied via a
    // spread-override at the point where the workspace array is assembled.
    const columnDefs = isWorkspace
      ? [
          { ...daysLeftCol, flex: 1 },
          { ...invoiceNumCol, flex: 1 },
          vendorCol,
          contractCol,
          { ...amountCol, flex: 1 },
          { ...statusCol, flex: 1 },
          ...workspaceCols.map((col, i) => (i === 1 ? { ...col, flex: 1 } : col)), // In status gets flex:1; Asset Suite already has flex:2
          quickViewCol,
        ]
      : [
          daysLeftCol,
          ...reviewByCol,
          invoiceNumCol,
          vendorCol,
          contractCol,
          amountCol,
          ...reviewOnlyCols,
          statusCol,
          quickViewCol,
        ];

    const gridApi = createGrid(gridHost, {
      theme: cbfTheme,
      rowData: data,
      domLayout: 'autoHeight',
      animateRows: false,
      suppressCellFocus: true,
      defaultColDef: { sortable: true, resizable: true, suppressHeaderMenuButton: true },
      columnDefs,
      // Two external filters, ANDed: the status chip (stageValue) and the
      // metrics-strip "overdue only" toggle (overdueOnly). Overdue mirrors the
      // urgency pill's rule — open stage AND past the review-by clock.
      isExternalFilterPresent: () => stageValue !== '' || overdueOnly,
      doesExternalFilterPass: (node) => {
        const inv = node.data as Invoice;
        if (stageValue !== '' && inv.stage !== stageValue) return false;
        if (overdueOnly && !(isOpenStage(inv.stage) && inv.daysRemaining < 0)) return false;
        return true;
      },
      onModelUpdated: () => {
        const shown = gridApi.getDisplayedRowCount();
        if (count) count.textContent = `Showing ${shown} of ${total} invoices`;
        if (empty) empty.hidden = shown !== 0;
        gridHost.hidden = shown === 0;
      },
      // A row click GOES TO THE INVOICE — the full processing page, where the COR
      // edits, flags issues, and decides. The peek drawer is no longer the default
      // destination; it opens only from the explicit quick-view control, which is
      // handled here and short-circuits the navigation.
      // The invoice-number anchor is left alone: the browser follows it natively
      // (preserving cmd/middle-click), so intercepting it would break new-tab.
      onRowClicked: (e) => {
        const inv = e.data as Invoice | undefined;
        if (!inv) return;
        const target = (e.event?.target as HTMLElement | null) ?? null;
        if (target?.closest('[data-quick-view]')) { openDetail(inv); return; }
        if (target?.closest('a')) return;
        window.location.href = detailHref(inv.number);
      },
    });

    search?.addEventListener('input', () => {
      gridApi.setGridOption('quickFilterText', (search.value ?? '').trim());
    });
    stageFilter?.addEventListener('change', () => {
      stageValue = stageFilter.value ?? '';
      gridApi.onFilterChanged();
    });

    // Metrics-strip bridge: the "Overdue" toggle (a sibling component) dispatches
    // cbf:queue-filter { overdue }, forwarded onto this root by the section wrapper.
    // Apply it as the overdue-only external filter.
    root.addEventListener('cbf:queue-filter', (e) => {
      const detail = (e as CustomEvent<{ overdue?: boolean }>).detail ?? {};
      overdueOnly = Boolean(detail.overdue);
      gridApi.onFilterChanged();
    });

    openDetail = bindReview(root, gridApi, stageHTML, urgencyHTML);

    // Public opener for the tab console: open the detail overlay for a given
    // invoice number (same code path as a row click). Unknown number → no-op.
    const openByNumber = (number: string) => {
      const inv = data.find((d) => d.number === number);
      if (inv) openDetail(inv);
    };
    return { openByNumber, gridApi };
  }

  // Bind the review overlay once; returns an opener that populates + shows it.
  function bindReview(
    root: HTMLElement,
    gridApi: ReturnType<typeof createGrid>,
    stageHTML: Map<string, string>,
    urgencyHTML: Map<string, string>,
  ): (inv: Invoice) => void {
    const dialog = root.querySelector<HTMLElement & { heading: string; show(): void }>('[data-review-dialog]');
    if (!dialog) return () => {};
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => dialog.querySelector<T>(sel);

    const badgeWith = (html: string, label: string) => {
      const t = document.createElement('div');
      t.innerHTML = html;
      const el = t.querySelector('.esa-pill__label') ?? t.firstElementChild ?? t;
      el.textContent = label;
      return t.innerHTML;
    };

    const statusSlot = $('[data-f-status]');
    const prevWrap = $('[data-review-prev]');
    const nextWrap = $('[data-review-next]');
    const prevBtn = prevWrap?.querySelector('button') ?? null;
    const nextBtn = nextWrap?.querySelector('button') ?? null;
    // "Process invoice" — esa-button rendered as a link; its href points at the
    // current invoice's own processing page, set per record in populate().
    const processLink = dialog.querySelector<HTMLAnchorElement>('[data-process] a');

    // Attachments: list element + the cloneable download-button markup (the
    // server-rendered esa-icon-button lego, reused verbatim per row). This overlay
    // is a preview — backups download only; viewing them (side by side with the
    // invoice) happens on the Process page.
    const attachList = $('[data-f-attachments]');
    const attachTitle = $('[data-f-attach-title]');
    const dlBtnHTML = $('[data-dl-template]')?.querySelector('button')?.outerHTML ?? '';
    const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    // The backup-documentation files for the currently shown invoice.
    let currentFiles: string[] = [];
    let currentNumber = '';

    const displayed = (): Invoice[] => {
      const out: Invoice[] = [];
      gridApi.forEachNodeAfterFilterAndSort((n) => { if (n.data) out.push(n.data as Invoice); });
      return out;
    };

    let current = -1;

    const setText = (sel: string, value: string) => { const el = $(sel); if (el) el.textContent = value; };

    const populate = (inv: Invoice) => {
      const list = displayed();
      current = list.findIndex((d) => d.number === inv.number);
      dialog.heading = inv.number; // aria-label
      setText('[data-f-dialog-title]', inv.number); // visible custom-header title

      // Status badge — the preview keeps it so the COR sees where the invoice sits
      // in the pipeline (the detail page drops it, since there you're already acting).
      if (statusSlot) statusSlot.innerHTML = `<span class="cbf-grid-status">${stageHTML.get(inv.stage) ?? inv.stage}</span>`;

      // Submission & review deadline. The date uses the standard color, going red
      // ONLY when overdue; the urgency alert shows only while the invoice is open.
      setText('[data-f-submitted]', inv.submitted);
      setText('[data-f-net-terms]', inv.netTerms);
      setText('[data-f-reviewby]', inv.reviewBy);
      const open = isOpenStage(inv.stage);
      const bucket = urgencyOf(inv.daysRemaining);
      const reviewByEl = $('[data-f-reviewby]');
      if (reviewByEl) {
        reviewByEl.className = 'cbf-review-deadline__date'
          + (open && bucket === 'overdue' ? ' cbf-review-deadline__date--overdue' : '');
      }
      const urg = $('[data-f-urgency]');
      if (urg) urg.innerHTML = open
        ? `<span class="cbf-grid-status">${badgeWith(urgencyHTML.get(bucket) ?? '', daysLabel(inv.daysRemaining))}</span>`
        : '';

      // Final-invoice notice + document stamp.
      const finalAlert = $('[data-f-final-alert]');
      if (finalAlert) finalAlert.hidden = !inv.final;
      const stamp = $('[data-f-stamp]');
      if (stamp) stamp.hidden = !inv.final;

      // Invoice information.
      setText('[data-f-number-panel]', inv.number);
      setText('[data-f-vendor-panel]', inv.vendor);
      // Contract & project: the reference NUMBER leads, the name is a quiet sub, and
      // the copy control carries the number (the ID transcribed into other systems).
      setText('[data-f-contract-num]', inv.contractNumber);
      setText('[data-f-contract-name]', inv.contract);
      const contractCopy = $('[data-f-contract-copy]');
      if (contractCopy) contractCopy.dataset.copyValue = inv.contractNumber || inv.contract;
      setText('[data-f-project-num]', inv.projectNumber);
      setText('[data-f-project-name]', inv.project);
      const projectCopy = $('[data-f-project-copy]');
      if (projectCopy) projectCopy.dataset.copyValue = inv.projectNumber || inv.project;
      setText('[data-f-perf-start]', inv.perfStart);
      setText('[data-f-perf-end-date]', inv.perfEnd);
      setText('[data-f-contract-end]', `Contract ends ${inv.contractEnd} · ${contractEndGap(inv.perfEnd, inv.contractEnd)}`);
      const perfEndCopy = $('[data-f-perf-end-copy]');
      if (perfEndCopy) perfEndCopy.dataset.copyValue = inv.perfEnd;

      // Amount information.
      setText('[data-f-amount-hero]', usd.format(inv.amount));
      const amtCopy = $('[data-f-amount-copy]');
      if (amtCopy) amtCopy.dataset.copyValue = inv.amount.toFixed(2);
      setText('[data-f-remaining-val]', usdCompact.format(inv.remaining));
      const remAfter = inv.remaining - inv.amount;
      setText('[data-f-rem-after]', `${usdCompact.format(remAfter)} after this invoice`);

      // Document.
      setText('[data-f-vendor-doc]', inv.vendor);
      setText('[data-f-num-doc]', inv.number);
      setText('[data-f-date]', inv.invoiceDate);
      setText('[data-f-billto]', inv.billTo);
      const itemsBody = $('[data-f-items]');
      const subtotal = inv.lineItems.reduce((t, li) => t + li.qty * li.unitPrice, 0);
      if (itemsBody) {
        itemsBody.innerHTML = inv.lineItems.map((li) => `<tr>
          <td>${li.description}</td>
          <td class="cbf-num">${qtyFmt.format(li.qty)}</td>
          <td class="cbf-num">${usd.format(li.unitPrice)}</td>
          <td class="cbf-num">${usd.format(li.qty * li.unitPrice)}</td>
        </tr>`).join('');
      }
      setText('[data-f-subtotal]', usd.format(subtotal));
      setText('[data-f-tax]', usd.format(0));
      setText('[data-f-total]', usd.format(inv.amount));
      const memoWrap = $('[data-f-memo-wrap]');
      if (memoWrap) memoWrap.hidden = !inv.notes;
      setText('[data-f-memo]', inv.notes ?? '');
      setText('[data-f-pdf]', `Submitted document · ${inv.pdfName}`);

      // Backup documentation: the supporting files the vendor uploaded (the invoice
      // itself lives in the document pane, not this list). Each row carries a view
      // control (renders the file in the pane) and a download control.
      currentFiles = [...inv.supportingDocs];
      currentNumber = inv.number;
      if (attachTitle) attachTitle.textContent = `Backup documentation (${currentFiles.length})`;
      const attachAll = $('[data-attach-all]');
      if (attachAll) attachAll.hidden = currentFiles.length === 0;
      if (attachList) {
        attachList.innerHTML = currentFiles.length
          ? currentFiles
              .map((name) => `<li class="cbf-review-attach">
            <span class="cbf-review-attach__name" title="${escAttr(name)}">${escAttr(name)}</span>
            <span class="cbf-review-attach__dl" data-attach-dl data-file="${escAttr(name)}">${dlBtnHTML}</span>
          </li>`)
              .join('')
          : '<li class="cbf-review-attach cbf-review-attach--empty"><span class="cbf-review-attach__name">No backup documentation was submitted with this invoice.</span></li>';
        // Give each cloned control a file-specific accessible name.
        attachList.querySelectorAll<HTMLElement>('[data-attach-dl]').forEach((slot) => {
          const file = slot.dataset.file ?? '';
          const btn = slot.querySelector('button');
          if (btn) { btn.setAttribute('aria-label', `Download ${file}`); btn.setAttribute('title', `Download ${file}`); }
        });
      }

      // Process link → the invoice's own processing page (documents + Line Item
      // Budget + approve/return live there, not in this preview).
      if (processLink) processLink.href = detailHref(inv.number);

      // Nav.
      setText('[data-f-position]', `Invoice ${current + 1} of ${list.length}`);
      if (prevBtn) prevBtn.disabled = current <= 0;
      if (nextBtn) nextBtn.disabled = current >= list.length - 1;
    };

    const step = (dir: Dir) => { const t = displayed()[current + dir]; if (t) populate(t); };

    prevWrap?.addEventListener('click', () => step(-1));
    nextWrap?.addEventListener('click', () => step(1));

    // Per-file download (delegated over the injected rows).
    attachList?.addEventListener('click', (e) => {
      const slot = (e.target as HTMLElement)?.closest<HTMLElement>('[data-attach-dl]');
      const file = slot?.dataset.file;
      if (file) downloadFile(file, currentNumber);
    });
    // Download all: each file in turn, lightly staggered so the browser accepts
    // the burst rather than blocking it as repeated auto-downloads.
    $('[data-attach-all]')?.addEventListener('click', () => {
      currentFiles.forEach((file, i) => setTimeout(() => downloadFile(file, currentNumber), i * 250));
    });

    // Copy controls: they're transcribing these values into another system, so
    // each [data-copy] copies one atomic value to the clipboard. Source priority:
    // a raw [data-copy-value] override (money copies as a bare 3960.00 — no symbol
    // or commas — so it pastes into a numeric field cleanly), then an explicit
    // [data-copy-target], then the value cell in the same field row. Delegated so
    // it covers every row without per-row wiring.
    const copyTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
    const writeClipboard = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback for non-secure contexts: a transient textarea + execCommand.
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
        return ok;
      }
    };
    dialog.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement)?.closest<HTMLElement>('[data-copy]');
      if (!trigger || !dialog.contains(trigger)) return;
      let text = (trigger.dataset.copyValue ?? '').trim();
      if (!text) {
        const targetSel = trigger.dataset.copyTarget;
        const valueEl = targetSel
          ? dialog.querySelector<HTMLElement>(targetSel)
          : trigger.closest('.cbf-review-fields__row')?.querySelector<HTMLElement>('.cbf-review-fields__value');
        text = (valueEl?.textContent ?? '').trim();
      }
      if (!text) return;
      void writeClipboard(text).then((ok) => {
        if (!ok) return;
        trigger.dataset.state = 'copied';
        clearTimeout(copyTimers.get(trigger));
        copyTimers.set(trigger, setTimeout(() => { delete trigger.dataset.state; }, 1200));
      });
    });

    return (inv: Invoice) => { populate(inv); dialog.show(); };
  }

  // Per-root setup. The queue is reused inside an esa-tab-layout panel, which
  // only slots the ACTIVE panel — an inactive panel is unslotted (zero width),
  // and AG Grid must never init at zero width (flex columns + autoHeight break).
  // So: attach the open API immediately (works before the grid exists via a
  // pending-open), init synchronously when already visible (byte-for-byte the
  // old eager behavior), and otherwise defer init until the panel first sizes.
  type QueueApi = ReturnType<typeof initQueue>;
  function setup(root: HTMLElement) {
    let api: QueueApi | undefined;
    let pendingOpen: string | null = null;

    // PINNED CONTRACT: the tab console dispatches CustomEvent 'cbf:open-invoice'
    // with detail { number } on THIS root element. Attach before init so a
    // pre-init event is honored once the grid comes up.
    root.addEventListener('cbf:open-invoice', (e) => {
      const number = (e as CustomEvent<{ number: string }>).detail?.number;
      if (!number) return;
      if (api) api.openByNumber(number);
      else pendingOpen = number;
    });

    if (root.clientWidth > 0) {
      // Visible at load — preserve today's behavior exactly (synchronous init).
      api = initQueue(root);
      if (pendingOpen && api) { api.openByNumber(pendingOpen); pendingOpen = null; }
      return;
    }

    // Hidden tab panel: wait for the first nonzero width, then init once.
    const ro = new ResizeObserver(() => {
      if (root.clientWidth <= 0) return;
      ro.disconnect();
      api = initQueue(root);
      if (pendingOpen && api) { api.openByNumber(pendingOpen); pendingOpen = null; }
    });
    ro.observe(root);
  }

  document.querySelectorAll<HTMLElement>('.cbf-invoice-review-queue').forEach(setup);
</script>
