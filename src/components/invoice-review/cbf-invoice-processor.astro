---
// cbf-invoice-processor — the COR's full-page "process invoice" surface. The heavy
// invoice-processing experience (à la Acctual) lifted out of the review-queue's
// esa-side-dialog overlay into a STANDALONE page component that a route renders for
// a single invoice: the SUBMITTED DOCUMENT pane on the LEFT (fluid — hosts the
// invoice sheet, the Line Item Budget, and backup files opened side-by-side with the
// invoice at independent per-column scroll) and the REVIEW PANEL on the RIGHT
// (~24rem — hero amount + copy, review clock, final-invoice alert, contract context,
// copyable spec fields, backup + documents, and the Approve / Return-for-revision
// decision actions with their confirm/comment sub-states and in-place result alert).
//
// Differs from the overlay: no esa-side-dialog, no prev/next footer, no grid, no
// initQueue, no cross-row decisions Map. The script is self-contained — it reads the
// single serialized invoice from the [data-processor-data] JSON tag, populates the
// one record, and wires view controls + approve/return + copy + download. A decision
// updates the result alert in place. The docpane gets a bounded, sticky height so its
// internal scroll (and the compare columns) can scroll while the right panel scrolls
// in normal page flow.
//
// ── What is under review, and what is only the yardstick ─────────────────────
// The panel holds two kinds of value and they do NOT get the same affordances. The
// split is not a guess: it mirrors the vendor's own submission wizard
// (src/components/vendor-invoice/cbf-invoice-step-details.astro) field for field.
// If that form changes, this list changes with it.
//
//   SUBMITTED — what the vendor actually TYPED or CHOSE on the form: invoice number,
//               invoice date, performance start/end, the contract they billed
//               against, their notes, and the TOTAL AMOUNT (a required free-text
//               field: "Enter the total due, matching your uploaded invoice PDF").
//               Editable and flaggable — this is the thing being reviewed.
//
//   REFERENCE — everything the vendor could not have got wrong, because their own
//               form would not let them enter it. Their identity (a read-only strip
//               drawn from their account), Bill to (never on the form — every invoice
//               bills BPA), Project (disabled and auto-filled from the contract), and
//               the executed contract's own term / value / expenditure plus the
//               remaining balance derived from them. Read-only, and NOT flaggable: an
//               objection the vendor has no field to act on is not an objection.
//               Copy is the one affordance these carry — they get transcribed
//               downstream into Asset Suite.
//
// The line-item ledger is a THIRD thing: the submission form hides line items
// entirely ("the breakdown lives in the PDF"), so the ledger this screen draws is a
// reproduction of the attached document, not structured submitted data. A COR cannot
// rewrite someone else's document, so a line is FLAGGED and never edited — and the
// ledger totals ITSELF, independently of the vendor's typed Amount, so the two can
// disagree. That disagreement is the point: it is the check this screen exists for.
//
// ── The three things a COR does here ──────────────────────────────────────────
// 1. EDIT — PER FIELD, in place. Every editable row carries its own pencil; clicking
//    it turns THAT row's value into an input and swaps the row's control cluster to
//    save/cancel (copy and flag disappear for the duration — you don't copy or object
//    to a value you're mid-way through rewriting). Nothing else on the surface
//    changes state, so the COR is never made to re-read an entire invoice as a form
//    in order to fix one transposed date. Line items work the same way: a line's
//    pencil opens a labelled editor for that line beneath it (a four-column bill is
//    for READING; correcting it needs labelled controls).
//    The contract's remaining balance is the one figure never typed — it is contract
//    value less expenditures, re-derived on every save.
// 2. FLAG. Any SUBMITTED field, and any single line item, can be marked as an issue
//    with a written reason. The mark rides on the field itself (a warning tint
//    carrying the reason) AND collects into cbf-invoice-issues.
// 3. RETURN. Return for revision opens with those flags already written up as the
//    memo, so returning the invoice is just sending what the COR marked. An invoice
//    carrying flags cannot be Approved — the two statements contradict each other,
//    and neither decision is available while an edit is still open.
//
// Contract context is stated in full: the contract's OWN start and end dates
// explicitly (never inferred from one invoice's performance period), the full award
// value, and what share of that award this single invoice represents.
//
// bcn-lego-checked: no esa-* lego renders an invoice/budget DOCUMENT (a paper vendor
// bill with letterhead, bill-to, line-item ledger, totals — or the reconciled Line
// Item Budget sheet) — that paper-doc markup is bespoke and reusable, and lives here
// (same justification the review-queue overlay carries). Beacon is not on this
// machine. Every other control IS a lego: hero/status/urgency + Final are esa-pill
// (real markup cloned so styling is byte-identical, never reinvented); the
// final-invoice notice + decision result are esa-alert-box; Approve/Return and the
// download/back controls are esa-button; per-field copy + per-file view/download are
// esa-icon-button; Return's comment capture is esa-textarea. The split is the
// .sidebar layout primitive.
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import CbfInvoiceField from './cbf-invoice-field.astro';
import CbfInvoiceIssues from './cbf-invoice-issues.astro';
import { withBase } from '../../lib/base';
import { contractFacts, budgetRevisions, indirectRate } from '../../data/invoice-review.mjs';

type Stage = 'Submitted' | 'In review' | 'Returned' | 'Approved';

interface Props {
  invoice: any;
  /** Where "Return to dashboard" (shown after a decision) links. */
  dashboardHref?: string;
}

// esa-pill variant per review stage — color conveys state, not decoration. Cloned
// client-side per stage so the panel's status chip is byte-identical to the lego.
const stageVariant: Record<Stage, 'info' | 'warning' | 'success' | 'danger'> = {
  Submitted: 'info',
  'In review': 'warning',
  Returned: 'danger',
  Approved: 'success',
};
const stages = Object.keys(stageVariant) as Stage[];

// Urgency pill variants, keyed by bucket (see urgencyOf in the data module).
const urgencyVariant = { overdue: 'danger', 'due-soon': 'warning', 'on-track': 'default' } as const;
const urgencyKeys = Object.keys(urgencyVariant) as (keyof typeof urgencyVariant)[];

const { invoice, dashboardHref = withBase('/my-work#invoices') } = Astro.props;

// Every Line Item Budget revision this invoice's contract has had, newest first.
// Serialized alongside the record so the client script renders the list without a
// second source of truth.
const libRevisions = budgetRevisions(invoice);

// The indirect rate governing this invoice — the newest on file for the BPA Vendor it
// was submitted under. Null when that Vendor has no rate on record at all.
const indirect = indirectRate(invoice);

// The page supplies its own title through the "doc-header" slot so the title rides
// INSIDE the sticky document column rather than scrolling away above the split.
// Optional: without it the column is just the document pane, with no empty gap.
const hasDocHeader = Astro.slots.has('doc-header');
---
<section class="cbf-invoice-processor" aria-label="Process invoice">
  <div
    class="cbf-invoice-processor__split sidebar"
    data-side="end"
    style="--sidebar-width: 24rem; --sidebar-content-min: 50%; --gap: var(--spacing-600);"
  >
    <!-- Panel (first child → ordered right by data-side=end). -->
    <aside class="cbf-review-panel stack" data-gap="lg" aria-label="Review">
      <!-- Invoice information leads. The SUBMITTED date is the figure called out
           (large), since when the vendor submitted is the clock a COR reads this
           against; the payment terms and how long it has sat in its current status
           are quiet supporting context beneath it. The identifying spec fields
           follow, all of equal weight; the amount + draw-down come after. -->
      <header class="cbf-review-hero">
        <div class="cbf-review-deadline">
          <span class="cbf-review__label">Submitted</span>
          <span class="cbf-review-deadline__date" data-f-submitted></span>
          <p class="cbf-review-deadline__support">
            <span data-f-net-terms></span> · <span data-f-days-in-status></span>
          </p>
        </div>
      </header>

      <div data-f-final-alert hidden>
        <EsaAlertBox variant="info" title="Final invoice">
          Closes out this contract. Confirm you've accepted all deliverables and accounted for any retainage before approving.
        </EsaAlertBox>
      </div>

      <!-- Invoice information — the identifying fields, all of roughly equal weight.
           This block is what the VENDOR SUBMITTED, so every row can be copied,
           corrected in place, or flagged as an issue: the row owns those three
           affordances itself (see cbf-invoice-field), so there is no surface-wide
           "edit invoice" mode to enter and leave. The contract block below is a
           different kind of thing and is read-only — see the note there. -->

      <dl class="cbf-review-fields">
        <CbfInvoiceField field="number" label="Invoice" copy editable flaggable control="text" />
        <!-- Vendor identity is an account fact, shown to the vendor as a read-only
             strip on the submission form — they never type it, so there is nothing
             here for them to correct. -->
        <CbfInvoiceField field="vendor" label="Vendor" copy />
        <!-- Invoice date and Amount are the vendor's own claims: read-only here (the
             COR does not silently rewrite the bill), but flaggable, so a wrong figure
             is returned to the vendor to fix rather than edited in place. -->
        <CbfInvoiceField field="invoiceDate" label="Invoice date" copy flaggable />
        <!-- Contract is reference, not invoice input: a read-only link out to the
             contract record (opens in a new tab). Not editable, not flaggable. -->
        <CbfInvoiceField field="contractNumber" label="Contract" copy />
        <!-- Project is DERIVED from the contract on the submission form (disabled,
             "Read-only — determined by the selected contract"). Objecting to it would
             ask the vendor to change a field their own form won't let them touch; if
             it's wrong, the CONTRACT is what was picked wrong — and picking a
             different one above re-derives this row. -->
        <CbfInvoiceField field="projectNumber" label="Project" copy />
        <!-- Each end of the performance period carries the matching end of the
             CONTRACT beneath it. That pairing is the whole judgement — work billed
             outside the contract's own term is not billable — and it belongs here,
             next to the date being judged, rather than in a contract block the COR
             has to open and hold in their head. -->
        <CbfInvoiceField field="perfStart" label="Performance period start date" copy editable flaggable control="date" />
        <CbfInvoiceField field="perfEnd" label="Performance period end date" copy editable flaggable control="date" />
        <!-- The block closes on the figure it is all leading to, and this is the one
             the vendor most has to get right: the submission form asks for it
             directly and REQUIRES it — "Enter the total due, matching your uploaded
             invoice PDF." It is a typed claim, not a sum this screen computes, which
             is exactly why the COR can both correct it and object to it. The document
             pane totals the PDF's own lines independently; the two disagreeing is a
             finding, and it could not be one if this number were derived from them. -->
        <CbfInvoiceField
          field="amount"
          label="Amount"
          copy
          flaggable
          emphasis="amount"
        />
      </dl>

      <!-- Contract context — the award this invoice draws against. COLLAPSED by
           default: it is the YARDSTICK, not the thing under review, so it should not
           cost the COR a screenful on every invoice. The summary keeps the two facts
           a collapsed section still has to answer — how much of the award is gone,
           and how much is left — so nothing that gates a decision is ever more than a
           number away.

           READ-ONLY, deliberately: none of this is invoice input. It is the executed
           contract as the system of record holds it. A COR does not correct a
           contract's value from an invoice screen, and "flagging" a contract term
           would send the vendor an objection to a document they did not submit and
           cannot revise. If a figure here is genuinely wrong, the contract record is
           what needs fixing — a different act, in a different place.

           bcn-lego-checked: a disclosure section — no esa-* lego is one (checked the
           full node_modules/@esa/ecology/src/components catalog: esa-tab-layout
           switches between peers rather than hiding one block, esa-dialog/
           esa-popover take the content off the page entirely, esa-card is a static
           container). Native <details>/<summary> IS the platform primitive for this
           and brings keyboard, ARIA and find-in-page for free, so the CSS below only
           dresses it. Beacon is not on this machine. The draw-down block composes
           esa-progress-bar rather than drawing its own bar. -->
      <details class="cbf-review-collapse" data-contract-collapse>
        <summary class="cbf-review-collapse__summary">
          <span class="cbf-review-collapse__chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
          <span class="cbf-review-collapse__title">Contract details</span>
          <!-- The collapsed state still has to answer "is there room for this bill?" -->
          <span class="cbf-review-collapse__digest" data-f-contract-digest></span>
        </summary>

        <div class="cbf-review-collapse__body">
          <!-- Draw-down — the award and what is left of it are ONE fact (a part of a
               whole), so they read as one: a meter for the shape, then the figures
               aligned on their decimal for transcription into Asset Suite. The list
               walks the COR straight down the arithmetic they were doing in their
               head — what's left, what this bill takes, what that leaves.

               EXPENDED is deliberately absent from the figures. It is the same fact
               as Remaining read from the other end, and Remaining is the one that
               answers the question in front of the COR ("is there room for this?").
               The bar still shows it — it IS the filled part — which is what a bar
               is good for and a number is not.

               bcn-lego-checked: esa-progress-bar is the right lego and was used here
               until this meter needed TWO segments (drawn, plus what this invoice
               would add) driven by a value the COR can edit — the lego is a static
               single-segment snapshot with no API for either, and faking it would
               mean writing into its internals from JS. Checked the full
               node_modules/@esa/ecology/src/components catalog for a stacked or
               segmented meter; there is none. Beacon is not on this machine. Two
               spans in a track, token-driven, is the whole of it. -->
          <section class="cbf-review-drawdown" aria-label="Contract balance">
            <div class="cbf-review-drawdown__head">
              <span class="cbf-review__label">Contract balance</span>
            </div>
            <!-- Decorative: every figure it encodes is stated in the list below, so
                 there is nothing here for a screen reader to gain by parsing a bar. -->
            <div class="cbf-review-meter" aria-hidden="true">
              <span class="cbf-review-meter__seg cbf-review-meter__seg--drawn" data-f-dd-drawn></span>
              <span class="cbf-review-meter__seg cbf-review-meter__seg--pending" data-f-dd-pending></span>
            </div>
            <dl class="cbf-review-drawdown__figures">
              <div><dt>Contract value</dt><dd class="cbf-num" data-f-dd-value></dd></div>
              <div><dt>Invoiced to-date</dt><dd class="cbf-num" data-f-dd-invoiced></dd></div>
              <div><dt>This invoice</dt><dd class="cbf-num" data-f-dd-amount></dd></div>
              <!-- The conclusion of the block, and the only line in it that moves when
                   the COR corrects the amount. -->
              <div class="cbf-review-drawdown__after" data-f-dd-after-row>
                <dt data-f-dd-after-label></dt>
                <dd class="cbf-num" data-f-dd-after></dd>
              </div>
            </dl>
          </section>

          <!-- Term. The contract's own start and end are stated EXPLICITLY rather
               than left to be inferred from the performance period, so the COR can
               place this bill on the contract's timeline: early work, mid-term, or a
               closeout draw running up against the end. -->
        </div>
      </details>

      <!-- Backup documentation: the supporting files the vendor uploaded with the
           invoice — LED BY the invoice document itself. The bill is the thing being
           reviewed, so it belongs at the top of the list of what was submitted, and
           "Download all" means all of it: a COR forwarding this package to the
           Contracting Officer needs the invoice in the bundle, not just its evidence.
           Each row carries "view" (renders the file in the document pane), download,
           and a FLAG — a document can be the thing that's wrong (missing, unreadable,
           the wrong period), and that objection has to reach the vendor like any
           other. Rows are injected by JS; the per-row controls clone the
           server-rendered esa-icon-button templates below so the lego markup stays
           byte-identical. -->
      <section class="cbf-review-attachments" aria-label="Submitted documents">
        <div class="cbf-review-attachments__head repel">
          <h3 class="cbf-review__section-title" data-f-attach-title>Submitted documents</h3>
          <span data-attach-all>
            <EsaButton appearance="outline" variant="secondary" size="sm" icon="download">Download all</EsaButton>
          </span>
        </div>
        <ul class="cbf-review-attachments__list" data-f-attachments></ul>
      </section>

      <!-- Contract documents: the Line Item Budget, in every REVISION it has had.
           A LIB is re-issued whenever the budget moves — a modification, a
           reallocation — so "the budget" is ambiguous unless the COR can see which
           one. Each revision states the date it was issued; an invoice for April work
           gets judged against the LIB in force in April, not against whatever was
           issued last month.

           The CURRENT revision stays out in the open — it is the one a COR wants
           nine times in ten — and the superseded ones fold away behind it. History is
           there when a back-dated performance period needs it, and costs nothing the
           rest of the time.

           Each revision downloads as its own workbook — a budget is read in a
           spreadsheet alongside the invoice, not in this page's document pane. -->
      <section class="cbf-review-attachments" aria-label="Contract line item budgets">
        <div class="cbf-review-attachments__head repel">
          <h3 class="cbf-review__section-title" data-f-budget-title>Contract line item budgets</h3>
        </div>
        <ul class="cbf-review-attachments__list" data-f-budget-docs></ul>
        <!-- Superseded revisions. Hidden entirely when there are none, so the page
             never offers to expand an empty list. -->
        <details class="cbf-review-collapse cbf-review-collapse--sub" data-f-budget-past-wrap hidden>
          <summary class="cbf-review-collapse__summary">
            <span class="cbf-review-collapse__chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <span class="cbf-review-collapse__title" data-f-budget-past-title></span>
          </summary>
          <div class="cbf-review-collapse__body">
            <ul class="cbf-review-attachments__list" data-f-budget-past></ul>
          </div>
        </details>
      </section>

      <!-- Indirect rate — moved out of the collapsed contract box so it sits directly
           under the budgets it is read against. The rate that governed the WORK,
           matched to the performance period (not today's rate); the percent links out
           to the rate agreement (opens in a new tab). Read-only reference, not invoice
           input, so it is neither editable nor flaggable. -->
      <dl class="cbf-review-fields cbf-review-indirect" aria-label="Indirect rate">
        <CbfInvoiceField field="indirectRate" label="Indirect rate" copy>
          <span slot="alert" data-f-rate-alert-text></span>
        </CbfInvoiceField>
      </dl>

      <div data-open-template hidden aria-hidden="true">
        <EsaIconButton variant="chrome" iconOnly icon="external-link" label="Open in a new tab" size="sm" />
      </div>
      <div data-dl-template hidden aria-hidden="true">
        <EsaIconButton variant="chrome" iconOnly icon="download" label="Download file" size="sm" />
      </div>

      <!-- Everything the COR has flagged, and the source of the return memo. LAST
           before the decision, because it is the summary that decision is made on:
           the panel above is the reading, this is the verdict, and Approve is shut
           while anything sits here. -->
      <CbfInvoiceIssues />

      <!-- Decisions. Approve opens a guard modal (esa-dialog); Return opens its
           comment capture inline. -->
      <div class="cbf-review-actions" data-actions>
        <!-- Return left, Approve right — the primary action sits at the right edge. -->
        <div class="repel cbf-review-actions__default" data-actions-default>
          <span data-act-return><EsaButton variant="danger" appearance="outline" size="md">Return for revision</EsaButton></span>
          <span data-act-approve><EsaButton variant="primary" size="md">Approve</EsaButton></span>
        </div>
        <!-- Why Approve is shut, said where the COR is looking when they find it
             shut. Empty (and hidden) whenever nothing is flagged. -->
        <p class="cbf-review-actions__note" data-decide-note hidden></p>

        <div class="stack" data-gap="sm" data-actions-return hidden>
          <esa-textarea
            data-return-reason
            label="Comments for the vendor"
            placeholder="e.g. the mileage rate exceeds the contract, or line 3 needs a receipt"
            rows="4"
          ></esa-textarea>
          <div class="repel">
            <span data-act-return-cancel><EsaButton appearance="outline" variant="secondary" size="md">Cancel</EsaButton></span>
            <span data-act-return-confirm><EsaButton variant="danger" size="md">Return for revision</EsaButton></span>
          </div>
        </div>
      </div>

      <!-- Approve guard modal — a deliberate confirmation before routing to payment,
           with an optional Payment Request (PR) number the COR can record on approval.
           The esa-dialog lego owns the overlay, focus trap, and Esc-to-close. -->
      <esa-dialog data-approve-dialog heading="Approve invoice" size="sm">
        <div class="stack" data-gap="md">
          <p class="cbf-review-fields__value">
            Approve <strong class="cbf-num" data-f-num-approve></strong> for <span data-f-amount-approve></span> for payment?
          </p>
          <esa-text-field
            data-approve-pr
            label="Payment request (PR) number"
            placeholder="Optional"
          ></esa-text-field>
        </div>
        <div slot="footer" class="repel">
          <span data-act-approve-cancel><EsaButton appearance="outline" variant="secondary" size="md">Cancel</EsaButton></span>
          <span data-act-approve-confirm><EsaButton variant="primary" size="md">Confirm approval</EsaButton></span>
        </div>
      </esa-dialog>

      <!-- Decision result — replaces the action bar in place once a decision is
           made, so the outcome appears where the COR clicked. The invoice is now
           processed, so the next step is back to the queue. -->
      <div class="cbf-review-result stack" data-gap="md" data-review-result hidden>
        <EsaAlertBox variant="success" title="Approved">
          <span data-result-text></span>
        </EsaAlertBox>
        <div class="cbf-review-result__actions">
          <EsaButton href={dashboardHref} variant="primary" size="md" icon="arrow-left">Return to dashboard</EsaButton>
        </div>
      </div>
    </aside>

    <!-- Document column (last child → fluid, left). The page title and the document
         travel together as ONE sticky unit, so the COR can always see what they're
         reading and which invoice it belongs to while the review panel scrolls past
         it in normal page flow. The column owns the viewport-bounded height; the
         pane takes whatever the title leaves. -->
    <div class="cbf-invoice-processor__doccol">
      {hasDocHeader && (
        <div class="cbf-invoice-processor__doctitle"><slot name="doc-header" /></div>
      )}

    <!-- The pane the COR reads — the submitted invoice, always. Backups and the
         Line Item Budget open in a new tab or download, so this pane stays focused
         on the one document under review and never has to swap what it shows. -->
    <div class="cbf-invoice-processor__docpane cbf-review-docpane">
      <div class="cbf-review-docpane__scroll">
        <article class="cbf-invoice-doc" data-doc-view="invoice" aria-label="Submitted invoice document">
          <div class="cbf-invoice-doc__stamp" data-f-stamp hidden>Final invoice</div>
          <header class="cbf-invoice-doc__head">
            <div>
              <p class="cbf-invoice-doc__vendor" data-f-vendor-doc></p>
              <p class="cbf-invoice-doc__sub">Vendor</p>
            </div>
            <div class="cbf-invoice-doc__meta">
              <p><span>Invoice #</span> <strong class="cbf-num" data-f-num-doc></strong></p>
              <p><span>Date</span> <strong data-f-date></strong></p>
            </div>
          </header>

          <div class="cbf-invoice-doc__billto">
            <p class="cbf-invoice-doc__sub">Bill to</p>
            <p data-f-billto></p>
          </div>

          <table class="cbf-invoice-doc__items">
            <thead>
              <tr>
                <th scope="col">Description</th>
                <th scope="col" class="cbf-num">Qty</th>
                <th scope="col" class="cbf-num">Unit</th>
                <th scope="col" class="cbf-num">Total</th>
              </tr>
            </thead>
            <!-- Line rows are injected by the script — a read-only reproduction of the
                 vendor's PDF. There are no per-line controls: the COR reads the bill
                 here and raises any objection on the panel fields, not on the document. -->
            <tbody data-f-items></tbody>
            <tfoot>
              <tr><th scope="row" colspan="3">Subtotal</th><td class="cbf-num" data-f-subtotal></td></tr>
              <tr><th scope="row" colspan="3">Tax</th><td class="cbf-num" data-f-tax></td></tr>
              <tr class="cbf-invoice-doc__total"><th scope="row" colspan="3">Total</th><td class="cbf-num" data-f-total></td></tr>
            </tfoot>
          </table>

          <p class="cbf-invoice-doc__memo" data-f-memo-wrap hidden><span>Memo:</span> <span data-f-memo></span></p>
          <p class="cbf-invoice-doc__generated" data-f-pdf></p>
        </article>
      </div>
    </div>
    </div>
  </div>

  <!-- Real esa-pill legos, server-rendered once per stage AND per urgency bucket
       with the design-system scope hash intact. The panel clones the matching
       template's markup so every pill is byte-identical to the lego. -->
  <div class="cbf-invoice-processor__badge-templates" data-badge-templates hidden aria-hidden="true">
    {stages.map((s) => (
      <span data-stage={s}><EsaPill label={s} variant={stageVariant[s]} size="md" removable={false} /></span>
    ))}
    {urgencyKeys.map((u) => (
      <span data-urgency={u}><EsaPill label={u} variant={urgencyVariant[u]} size="md" removable={false} /></span>
    ))}
    <span data-flag="final"><EsaPill label="Final" variant="default" size="md" removable={false} /></span>
  </div>

  <!-- Single-invoice record for the client script (no second fetch). -->
  <script type="application/json" data-processor-data set:html={JSON.stringify(invoice)}></script>
  <!-- What follows from choosing a contract: its name and its project. Same shape the
       vendor's wizard encodes on its own combobox, so re-picking a contract on review
       re-derives the same downstream fields it would have on submission. -->
  <script type="application/json" data-contract-facts set:html={JSON.stringify(contractFacts)}></script>
  <!-- The contract's Line Item Budget revisions, newest first. -->
  <script type="application/json" data-budget-revisions set:html={JSON.stringify(libRevisions)}></script>
  <!-- The indirect rate in play, with the BPA Vendor it belongs to. -->
  <script type="application/json" data-indirect-rate set:html={JSON.stringify(indirect)}></script>
</section>

<style>
  /* Root: the page owns vertical scroll; the docpane is a sticky bounded viewer
     while the panel scrolls in normal flow (see the docpane rules below). */
  .cbf-invoice-processor { display: block; }
  /* --cbf-panel-offset drops the review panel to start level with the document
     pane, since the title now rides inside the sticky column beside it. The script
     measures the title and writes the value; 0 is the honest fallback (no title
     slotted, columns stacked, or no JS) — the panel simply starts at the top. */
  .cbf-invoice-processor__split { align-items: start; --cbf-panel-offset: 0px; }
  .cbf-review-panel { margin-block-start: var(--cbf-panel-offset); }

  /* Panel ----------------------------------------------------------------- */
  .cbf-review__label {
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default-tertiary);
  }
  .cbf-review__section-title {
    margin: 0;
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default-tertiary);
  }

  /* Invoice-information hero — the review-by DEADLINE leads. Large and red so it
     calls attention to itself; the overdue/countdown alert sits on its own line
     directly beneath, and submitted + net terms are quiet supporting context. */
  .cbf-review-deadline { display: flex; flex-direction: column; gap: var(--spacing-100); min-width: 0; }
  /* Prominent by size/weight; standard text color unless the invoice is OVERDUE,
     in which case it goes red — so red always means "this is late", nothing else. */
  .cbf-review-deadline__date {
    font-size: var(--font-size-500);
    font-weight: var(--typography-font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
  }
  .cbf-review-deadline__date--overdue { color: var(--color-background-utility-danger, #b42318); }
  .cbf-review-deadline__urgency { display: block; }
  .cbf-review-deadline__urgency:empty { display: none; }
  .cbf-review-deadline__support {
    margin: var(--spacing-100) 0 0;
    font-size: var(--font-size-100);
    color: var(--color-content-default-tertiary);
  }

  /* The field BLOCKS. Each is a <dl> of cbf-invoice-field rows (which own the row
     grid, the value type, the copy/flag affordances and the issue note); what's left
     here is how the blocks are separated from one another. A hairline top/bottom rule
     sets the contract block and the money block off as groups. */
  .cbf-review-fields { margin: 0; }
  .cbf-review-fields__value { margin: 0; font-size: var(--font-size-200); color: var(--color-content-default-secondary); }
  /* Inside the collapse the term rows need no rule of their own — the collapse is
     already the group boundary. Only the top hairline stays, to separate them from
     the draw-down block above. */
  .cbf-review-contract { padding-block-start: var(--spacing-300); border-block-start: 1px solid var(--color-border-default); }
  /* Indirect rate — relocated out of the collapsed contract box to sit under the
     budgets. A little top space sets it off from the section above. */
  .cbf-review-indirect { margin: 0; margin-block-start: var(--spacing-500); }

  /* Contract collapse ----------------------------------------------------- */
  /* Native <details>. The whole summary row is the hit target, so the chevron is
     decoration and the accessible name is the row's text — <summary> supplies the
     expanded/collapsed state to assistive tech on its own. */
  .cbf-review-collapse {
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
  }
  .cbf-review-collapse__summary {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200);
    padding: var(--spacing-300);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-200);
  }
  /* Safari still paints the default disclosure triangle without this. */
  .cbf-review-collapse__summary::-webkit-details-marker { display: none; }
  .cbf-review-collapse__summary:hover { background: var(--color-background-elevation-sunken); }
  .cbf-review-collapse__summary:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: -2px;
  }
  .cbf-review-collapse__chevron {
    display: inline-flex;
    align-self: center;
    flex: none;
    color: var(--color-content-default-tertiary);
    transition: transform 150ms ease;
  }
  .cbf-review-collapse[open] .cbf-review-collapse__chevron { transform: rotate(90deg); }
  @media (prefers-reduced-motion: reduce) {
    .cbf-review-collapse__chevron { transition: none; }
  }
  .cbf-review-collapse__title {
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default-tertiary);
  }
  /* The digest carries the numbers, so it is NOT the faint end of the row — it sits
     at the same size as the title and right-aligns to the edge. */
  .cbf-review-collapse__digest {
    margin-inline-start: auto;
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }
  /* Nested variant: a disclosure INSIDE a section that already has a heading, so it
     drops the card treatment and is just a quiet, clickable line. A bordered box
     inside a bordered box would read as a second section rather than as this one's
     tail. */
  .cbf-review-collapse--sub {
    margin-top: var(--spacing-200);
    border: 0;
    background: transparent;
  }
  .cbf-review-collapse[hidden] { display: none; }
  .cbf-review-collapse--sub .cbf-review-collapse__summary {
    padding: var(--spacing-200) 0;
  }
  /* No surface to tint, so the hover lands on the text itself. */
  .cbf-review-collapse--sub .cbf-review-collapse__summary:hover { background: transparent; }
  .cbf-review-collapse--sub .cbf-review-collapse__summary:hover .cbf-review-collapse__title,
  .cbf-review-collapse--sub .cbf-review-collapse__summary:hover .cbf-review-collapse__chevron {
    color: var(--color-content-default);
  }
  .cbf-review-collapse--sub .cbf-review-collapse__summary:focus-visible { outline-offset: 2px; }
  .cbf-review-collapse--sub .cbf-review-collapse__body { padding: 0; }
  /* The title is the only thing on this summary, so it carries the weight of a
     regular row rather than a section heading. */
  .cbf-review-collapse--sub .cbf-review-collapse__title {
    font-weight: var(--typography-font-weight-medium);
  }

  .cbf-review-collapse__warn { display: inline-flex; align-self: center; flex: none; }
  .cbf-review-collapse__warn[hidden] { display: none; }
  .cbf-review-collapse__body {
    padding: 0 var(--spacing-300) var(--spacing-300);
  }

  /* Draw-down ------------------------------------------------------------- */
  .cbf-review-drawdown { padding-block-end: var(--spacing-300); }
  .cbf-review-drawdown__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300);
    margin-bottom: var(--spacing-150);
  }
  .cbf-review-drawdown__pct {
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* The meter. Two segments in one track: what the contract has already paid out,
     and what THIS invoice would add on top of it if it is approved. The second
     segment is the whole point — a COR approving a draw wants to see where it lands,
     not where the contract stood before they got here. */
  .cbf-review-meter {
    display: flex;
    height: 8px;
    border-radius: var(--radius-full, 9999px);
    background: var(--color-background-elevation-sunken);
    overflow: hidden;
  }
  .cbf-review-meter__seg { transition: width 300ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .cbf-review-meter__seg { transition: none; }
  }
  .cbf-review-meter__seg--drawn { background: var(--color-background-brand); }
  /* Pending is the SAME hue stepped back toward the surface, so it reads as "more of
     the same thing, not yet real" rather than as a second, unrelated category. */
  .cbf-review-meter__seg--pending {
    background: color-mix(in srgb, var(--color-background-brand) 38%, var(--color-background-elevation-raised));
  }
  /* Unless it doesn't fit — then it is not "pending", it is over the line. */
  .cbf-review-meter__seg--pending.is-over { background: var(--color-background-utility-warning); }

  /* Label/figure pairs on one baseline grid so the money aligns on its decimal —
     the whole point of showing related figures together. */
  .cbf-review-drawdown__figures {
    margin: var(--spacing-300) 0 0;
    display: grid;
    gap: var(--spacing-100);
  }
  .cbf-review-drawdown__figures > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300);
  }
  .cbf-review-drawdown__figures dt {
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
  }
  .cbf-review-drawdown__figures dd {
    margin: 0;
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default);
    font-variant-numeric: tabular-nums;
  }
  .cbf-review-drawdown__asof { color: var(--color-content-default-tertiary); }
  /* The bottom line of the block: ruled off from the inputs above it and carried in
     primary text, because it is the figure the decision actually rests on. */
  .cbf-review-drawdown__after {
    margin-top: var(--spacing-100);
    padding-block-start: var(--spacing-200);
    border-block-start: 1px solid var(--color-border-default);
  }
  .cbf-review-drawdown__after dt { color: var(--color-content-default); }
  .cbf-review-drawdown__after dd { font-weight: var(--typography-font-weight-semibold); }
  /* An invoice that outruns the award is a finding, not a footnote — the status
     pair, so the row sits on its own tint rather than going bare red. */
  .cbf-review-drawdown__after.is-over {
    margin-top: var(--spacing-200);
    padding: var(--spacing-200) var(--spacing-250);
    border-block-start: 0;
    border-radius: var(--radius-100);
    background: var(--color-background-utility-warning-subtle);
    color: var(--color-content-utility-warning);
  }
  .cbf-review-drawdown__after.is-over dt,
  .cbf-review-drawdown__after.is-over dd { color: inherit; }

  /* Why a decision is shut — sits directly under the decision buttons, where the
     COR is looking at the moment they find it shut. Says either "you have flagged
     issues" or "you have an edit still open". */
  .cbf-review-actions__note {
    margin: var(--spacing-200) 0 0;
    font-size: var(--font-size-150);
    color: var(--color-content-default-secondary);
  }
  .cbf-review-actions__note[hidden] { display: none; }


  /* Attachments ----------------------------------------------------------- */
  .cbf-review-attachments { margin-top: var(--spacing-200); }
  .cbf-review-attachments__head {
    align-items: center;
    gap: var(--spacing-300);
    margin-bottom: var(--spacing-300);
  }
  .cbf-review-attachments__head .cbf-review__section-title { margin: 0; }
  .cbf-review-attachments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    overflow: hidden;
  }

  /* Decision sub-states (Approve-confirm / Return-comment) are .stack/.cluster
     groups toggled via the [hidden] attribute. Those layout primitives set
     `display: flex`, which OVERRIDES the UA `[hidden] { display: none }` — so
     without this guard all three action groups render at once. Restore hidden's
     intent for the toggled groups. */
  .cbf-review-actions [hidden] { display: none !important; }
  /* The result block is a .stack (display:flex) — same hub gap; restore [hidden]. */
  .cbf-review-result[hidden] { display: none !important; }
  .cbf-review-result__actions { display: flex; justify-content: flex-end; }

  /* Document column ------------------------------------------------------- */
  /* On a page there is no fixed-height dialog body to bound the pane, so the COLUMN
     owns the bounded height: one viewport tall, less the sticky offset and a little
     breathing room at the bottom. It sticks as a unit — title and document together —
     while the review panel scrolls past it in normal page flow.
     Note this only works because cbf-app-panel clips with `overflow: clip` rather
     than `hidden`; `hidden` would make it a scrollport and strand the sticky here. */
  .cbf-invoice-processor__doccol {
    position: sticky;
    top: var(--spacing-500);
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
    min-height: 0;
  }
  /* The title takes its natural height; the pane takes the rest. That remainder is
     the definite height the internal scroll (and the compare columns) resolve
     against — without it they have nothing to scroll inside of. */
  .cbf-invoice-processor__doctitle { flex: none; }
  .cbf-invoice-processor__docpane { flex: 1; min-height: 0; }
  .cbf-review-docpane {
    background: var(--color-background-elevation-sunken);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }
  /* Bar names the document on screen and offers a way back to the invoice. */
  .cbf-review-docpane__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-300);
    flex: none;
    padding: var(--spacing-300) var(--spacing-400);
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-background-elevation-raised);
  }
  .cbf-review-docpane__bar[hidden] { display: none; }
  .cbf-review-docpane__name {
    min-width: 0;
    font-size: var(--font-size-150);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-content-default-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Scroll area holds the centered document(s). */
  .cbf-review-docpane__scroll {
    flex: 1;
    min-height: 0;
    padding: var(--spacing-600);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-y: auto;
  }
  .cbf-review-docpane__scroll > [data-doc-view][hidden] { display: none; }

  /* Compare mode — a backup file opens side by side with the invoice so the COR
     checks the bill against its backup. The pane itself STOPS scrolling; each
     document column is its own bounded, independently-scrolling viewport. */
  .cbf-review-docpane__scroll--compare {
    flex-direction: row;
    align-items: stretch;
    gap: var(--spacing-500);
    overflow: hidden; /* columns own the scroll, not the pane */
  }
  .cbf-review-docpane__scroll--compare > [data-doc-view] {
    flex: 1 1 0;
    min-width: 0;
    max-width: none;
    min-height: 0;
    max-height: 100%;
    overflow-y: auto;
    align-self: stretch;
  }


  /* Backup-file placeholder — a centered card standing in for an un-previewable file. */
  .cbf-doc-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-300);
    text-align: center;
    flex: 1 0 auto;
  }
  .cbf-doc-placeholder__icon { color: var(--color-content-default-tertiary); }
  .cbf-doc-placeholder__name {
    margin: 0;
    font-size: var(--font-size-250);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
    word-break: break-word;
  }
  .cbf-doc-placeholder .cbf-invoice-doc__sub { margin-bottom: var(--spacing-200); }
  .cbf-invoice-doc {
    position: relative;
    flex: 1 0 auto;
    width: 100%;
    max-width: 620px;
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-100);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-background-default-knockout) 10%, transparent);
    padding: var(--spacing-700) var(--spacing-700) var(--spacing-600);
    color: var(--color-content-default);
    font-size: var(--font-size-150);
    line-height: var(--line-height-normal);
  }
  .cbf-invoice-doc__stamp {
    position: absolute;
    top: var(--spacing-500);
    right: var(--spacing-500);
    font-size: var(--font-size-100);
    font-weight: var(--typography-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-background-utility-danger, #b42318);
    border: 1.5px solid currentColor;
    border-radius: var(--radius-100);
    padding: 2px var(--spacing-200);
    transform: rotate(-4deg);
    opacity: 0.8;
  }
  .cbf-invoice-doc__head {
    display: flex; justify-content: space-between; gap: var(--spacing-400);
    align-items: flex-start; margin-bottom: var(--spacing-500);
  }
  .cbf-invoice-doc__vendor { margin: 0; font-size: var(--font-size-400); font-weight: var(--typography-font-weight-bold); }
  .cbf-invoice-doc__sub { margin: 0; color: var(--color-content-default-tertiary); font-size: var(--font-size-100); }
  .cbf-invoice-doc__meta { text-align: right; }
  .cbf-invoice-doc__meta p { margin: 0 0 var(--spacing-100); }
  .cbf-invoice-doc__meta span { color: var(--color-content-default-tertiary); margin-right: var(--spacing-200); }
  .cbf-invoice-doc__billto { margin-bottom: var(--spacing-500); }
  .cbf-invoice-doc__billto p { margin: 0; }

  .cbf-invoice-doc__items { width: 100%; border-collapse: collapse; }
  .cbf-invoice-doc__items th, .cbf-invoice-doc__items td { text-align: left; padding: var(--spacing-250) 0; vertical-align: top; }
  .cbf-invoice-doc__items thead th {
    border-bottom: 1px solid var(--color-content-default);
    font-weight: var(--typography-font-weight-semibold); font-size: var(--font-size-100); color: var(--color-content-default-secondary);
  }
  .cbf-invoice-doc__items tbody tr + tr td { border-top: 1px solid var(--color-border-default-subtle, var(--color-border-default)); }
  .cbf-invoice-doc__items tfoot th, .cbf-invoice-doc__items tfoot td { padding: var(--spacing-150) 0; text-align: right; }
  .cbf-invoice-doc__items tfoot th { font-weight: var(--typography-font-weight-regular); color: var(--color-content-default-secondary); }
  .cbf-invoice-doc__items tfoot tr:first-child th, .cbf-invoice-doc__items tfoot tr:first-child td { padding-top: var(--spacing-400); }
  .cbf-invoice-doc__total th, .cbf-invoice-doc__total td {
    border-top: 1px solid var(--color-content-default); font-weight: var(--typography-font-weight-bold);
    font-size: var(--font-size-200); padding-top: var(--spacing-300) !important;
  }
  .cbf-invoice-doc .cbf-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cbf-invoice-doc__items th.cbf-num { text-align: right; }
  .cbf-invoice-doc__memo { margin: var(--spacing-600) 0 0; color: var(--color-content-default-secondary); line-height: var(--line-height-relaxed); }
  .cbf-invoice-doc__memo span { color: var(--color-content-default-tertiary); }
  .cbf-invoice-doc__generated {
    margin: var(--spacing-600) 0 0; padding-top: var(--spacing-400);
    border-top: 1px solid var(--color-border-default-subtle, var(--color-border-default));
    color: var(--color-content-default-tertiary); font-size: var(--font-size-100); font-style: italic;
  }
</style>

<style is:global>
  /* Read-only external links injected into field values (contract number, indirect
     rate percent). Injected via innerHTML (no Astro scope hash), so styled globally.
     Reads as a link with a trailing "opens in a new tab" glyph. */
  .cbf-invoice-field__value .cbf-review-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    color: var(--color-background-brand);
    text-decoration: none;
  }
  .cbf-invoice-field__value .cbf-review-link:hover { text-decoration: underline; }
  .cbf-invoice-field__value .cbf-review-link:focus-visible {
    outline: 2px solid var(--color-background-brand);
    outline-offset: 2px;
    border-radius: var(--radius-100, 4px);
  }
  .cbf-review-link__ext { flex: none; opacity: 0.85; }

  /* Document line items are injected by JS (no Astro scope hash) — styled globally. */
  .cbf-invoice-doc__items tbody td { font-size: var(--font-size-150); }

  /* Per-line controls — flag and edit at rest, save/cancel while that line is being
     edited (the same two-state cluster the panel field rows use). Quiet until the
     line is engaged, so the ledger still reads as a bill rather than as a row of
     buttons; always visible once the line carries an issue or is being edited,
     because those states are persistent. */
  .cbf-invoice-line__actions { width: 1%; white-space: nowrap; text-align: right; }
  .cbf-invoice-line__act {
    display: inline-flex;
    color: var(--color-content-default-tertiary);
    opacity: 0;
    transition: opacity 120ms ease;
  }
  .cbf-invoice-line:hover .cbf-invoice-line__act,
  .cbf-invoice-line__act:focus-within,
  .cbf-invoice-line[data-flagged] .cbf-invoice-line__act { opacity: 1; }
  .cbf-invoice-line[data-flagged] [data-line-flag] { color: var(--color-content-utility-warning); }
  @media (hover: none) { .cbf-invoice-line__act { opacity: 1; } }

  /* A flagged line and the objection to it read as one unit: the line takes a soft
     warning tint (never a colored left border) and the reason sits in the row
     directly beneath, spanning the full ledger width. */
  .cbf-invoice-line[data-flagged] > td {
    background: var(--color-background-utility-warning-subtle);
  }
  /* The objection row takes the status PAIR — -subtle surface, -strong text — since
     everything in it is warning content the COR wrote. The flagged LINE above it
     keeps neutral text on the same tint on purpose: those cells are the vendor's own
     figures, and recolouring a bill's line items would state that the numbers are the
     warning rather than that the line carries one. */
  .cbf-invoice-line__note > td {
    padding-top: 0;
    background: var(--color-background-utility-warning-subtle);
    color: var(--color-content-utility-warning);
  }
  .cbf-invoice-line__note-text,
  .cbf-review-attach__note-text {
    font-size: var(--font-size-150);
  }
  .cbf-invoice-line__note-clear,
  .cbf-review-attach__note-clear {
    display: inline-flex;
    vertical-align: middle;
    margin-left: var(--spacing-150);
  }
  /* The line's comment capture, opened in place under the line it belongs to.
     Actions right-align, landing under the flag control that opened the capture —
     the same treatment a field row's capture gets, so flagging feels identical
     wherever the COR does it. */
  .cbf-invoice-line__note-actions,
  .cbf-review-attach__note-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-200);
    margin-top: var(--spacing-200);
  }
  .cbf-invoice-line__note-btn,
  .cbf-review-attach__note-btn { display: inline-flex; }

  /* "Go to field" from the issues list lands the eye on the right row.
     Two steps under the -border token: the flash has to clear the -subtle tint a
     flagged row already rests on (yellow-2), but -border (yellow-6) is a border
     weight — as a FILL behind text it reads heavy and over-saturated. yellow-4 is the
     wash between them.
     Read as a RAMP STEP, not a semantic token, because the warning scale publishes
     only 2 (-subtle) / 6 (-border) / 9 / 11 (-strong) and there is no named step in
     that gap. Per the theme file's contract that is a gap to PROMOTE to the hub, not
     to paper over with a --cbf-* token (components never read those). Until it is
     promoted this tracks the yellow ramp rather than the warning semantics — if a
     theme ever re-points warning off yellow, this is the line that has to follow. */
  .is-flash {
    animation: cbf-issue-flash 1.2s ease-out;
  }
  @keyframes cbf-issue-flash {
    0%, 55% { background-color: var(--color-yellow-4); }
    100% { background-color: transparent; }
  }

  /* A PANEL row needs the fill to bleed past its content box. Its grid stops exactly
     at the panel's text edges, so a background that stops there too reads as clipped
     — the highlight looks cut off at both sides rather than wrapped around the row.
     A same-colour spread shadow paints that gutter WITHOUT touching layout: negative
     margins would reflow the row and stretch its hairline rule mid-animation, and a
     positioned pseudo-element is unavailable on the ledger's <tr> counterpart.
     Ledger rows keep the plain fill — a <tr> already spans the full table, so it has
     no edge to fall short of. */
  .cbf-invoice-field.is-flash {
    border-radius: var(--radius-200);
    animation-name: cbf-issue-flash-bleed;
  }
  @keyframes cbf-issue-flash-bleed {
    0%, 55% {
      background-color: var(--color-yellow-4);
      box-shadow: 0 0 0 var(--spacing-300) var(--color-yellow-4);
    }
    100% {
      background-color: transparent;
      box-shadow: 0 0 0 var(--spacing-300) transparent;
    }
  }

  /* The two hairlines that BOUND the row — its own, and the one the next row draws —
     would otherwise run straight across the band and read as cuts through it. Hidden
     by colour, not by width, so nothing reflows. */
  .cbf-invoice-field.is-flash,
  .cbf-invoice-field.is-flash + .cbf-invoice-field { border-top-color: transparent; }

  /* A flagged row's issue note carries its own -subtle tint, which would sit ON TOP of
     the flash as a second, paler yellow inside the first. Instead the two crossfade:
     the note holds back while the band is up, then arrives exactly as the band leaves,
     landing on its resting colour so nothing pops when the class comes off. */
  .cbf-invoice-field.is-flash .cbf-invoice-field__issue {
    animation: cbf-issue-note-flash 1.2s ease-out;
  }
  @keyframes cbf-issue-note-flash {
    0%, 55% { background-color: transparent; }
    100% { background-color: var(--color-background-utility-warning-subtle); }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-flash,
    .cbf-invoice-field.is-flash {
      animation: none;
      outline: 2px solid var(--color-content-utility-warning);
      outline-offset: var(--spacing-150);
    }
  }

  /* Backup-documentation rows are injected by JS — styled globally. The filename
     carries its own extension; the affordances are the view control (renders the
     file in the document pane) and the download control — actions, not decoration. */
  /* The row is now a BLOCK: a header line (name + controls) that can be followed by
     an objection capture or a raised issue, the same shape a field row and a line
     item use. */
  .cbf-review-attach {
    padding: var(--spacing-150) var(--spacing-200) var(--spacing-150) var(--spacing-400);
  }
  .cbf-review-attach__row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
  }
  .cbf-review-attach + .cbf-review-attach { border-top: 1px solid var(--color-border-default-subtle, var(--color-border-default)); }
  /* A flagged document takes the same warning pair as every other flagged thing. */
  .cbf-review-attach[data-flagged] {
    background: var(--color-background-utility-warning-subtle);
    color: var(--color-content-utility-warning);
  }
  .cbf-review-attach[data-flagged] .cbf-review-attach__name,
  .cbf-review-attach[data-flagged] [data-doc-flag] { color: inherit; }
  .cbf-review-attach__note { margin-top: var(--spacing-200); }
  /* Raised objection on a document. The clear control goes to the ROW's right edge,
     under the flag that raised it, rather than trailing the reason text wherever it
     happens to end — otherwise its position moves with the length of the sentence. */
  .cbf-review-attach__issue {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-200);
    margin-top: var(--spacing-100);
  }
  .cbf-review-attach__issue .cbf-review-attach__note-text { flex: 1; min-width: 0; }
  .cbf-review-attach__issue .cbf-review-attach__note-clear { flex: none; margin-left: 0; }
  /* Marks WHICH document is the bill itself, since it now sits in the same list as
     the backup that supports it. Content, not decoration: normal case, not shrunk
     below the caption floor. */
  .cbf-review-attach__tag {
    flex: none;
    font-size: var(--font-size-100);
    color: var(--color-content-default-tertiary);
  }
  .cbf-review-attach[data-flagged] .cbf-review-attach__tag { color: inherit; }
  .cbf-review-attach__name {
    flex: 1;
    min-width: 0;
    font-size: var(--font-size-150);
    color: var(--color-content-default);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cbf-review-attach--empty .cbf-review-attach__name { color: var(--color-content-default-tertiary); }
  /* The row's own gap separates the NAME from its controls; the controls sit closer
     to each other than that, at the same spacing a field row uses, so a cluster of
     icons reads as one cluster on both surfaces. */
  .cbf-review-attach__actions {
    display: inline-flex;
    flex: none;
    gap: var(--spacing-050, 2px);
  }
  .cbf-review-attach__dl,
  .cbf-review-attach__flag,
  .cbf-review-attach__open,
  .cbf-review-attach__view { flex: none; line-height: 0; color: var(--color-content-default-tertiary); }
  /* Which budget this is, and why it moved. Sits under the name because it is what
     makes the row identifiable — a list of "Line Item Budget" rows is useless without
     it. Aligned to the name, clear of the label-free left gutter. */
  .cbf-review-attach__meta {
    margin: var(--spacing-050, 2px) 0 0;
    font-size: var(--font-size-100);
    color: var(--color-content-default-tertiary);
    line-height: var(--line-height-tight, 1.3);
  }
  /* Row controls recede until the row is engaged, exactly as field-row controls do —
     a list of files should read as FILES, not as three columns of icons repeated
     down the page. Opacity, not display: the buttons stay in the tab order and
     :focus-within brings them back for keyboard users.
     Two states outlive the hover and stay lit, because they are facts about the
     document rather than things you can do to it: a flagged document keeps its flag,
     and the document currently in the pane keeps its eye. */
  .cbf-review-attach__flag,
  .cbf-review-attach__view,
  .cbf-review-attach__open,
  .cbf-review-attach__dl { opacity: 0; transition: opacity 120ms ease; }
  .cbf-review-attach:hover .cbf-review-attach__flag,
  .cbf-review-attach:hover .cbf-review-attach__view,
  .cbf-review-attach:hover .cbf-review-attach__open,
  .cbf-review-attach:hover .cbf-review-attach__dl,
  .cbf-review-attach:focus-within .cbf-review-attach__flag,
  .cbf-review-attach:focus-within .cbf-review-attach__view,
  .cbf-review-attach:focus-within .cbf-review-attach__open,
  .cbf-review-attach:focus-within .cbf-review-attach__dl,
  .cbf-review-attach[data-flagged] .cbf-review-attach__flag,
  .cbf-review-attach__view.is-active { opacity: 1; }
  /* Touch has no hover to reveal them with. */
  @media (hover: none) {
    .cbf-review-attach__flag,
    .cbf-review-attach__view,
    .cbf-review-attach__open,
    .cbf-review-attach__dl { opacity: 1; }
  }
  .cbf-review-attach__dl .esa-icon-button:hover,
  .cbf-review-attach__flag .esa-icon-button:hover,
  .cbf-review-attach__open .esa-icon-button:hover,
  .cbf-review-attach__view .esa-icon-button:hover {
    background: color-mix(in srgb, var(--color-content-default-tertiary) 14%, transparent);
    color: var(--color-content-default);
  }
  /* Active view control: the file it points at is the one on screen in the pane. */
  .cbf-review-attach__view.is-active { color: var(--color-background-brand); }
  .cbf-review-attach__view.is-active .esa-icon-button {
    background: var(--color-background-brand-subtle, color-mix(in srgb, var(--color-background-brand) 12%, transparent));
    color: var(--color-background-brand);
  }
</style>

<script>
  import '@esa/ecology/esa-textarea';
  // The controls a field row flips to while editing — one per input kind the vendor's
  // submission wizard uses, so a correction is made with the SAME control the value
  // was submitted with. Each has to be registered here or the element never upgrades.
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-combobox';
  import '@esa/ecology/esa-dialog';
  import '../bcn-date-picker';

  type Stage = 'Submitted' | 'In review' | 'Returned' | 'Approved';
  type LineItem = { description: string; qty: number; unitPrice: number };
  type Invoice = {
    number: string; vendor: string;
    contract: string; contractNumber: string; project: string; projectNumber: string;
    submitted: string; reviewBy: string; daysRemaining: number; netTerms: string;
    amount: number; stage: Stage; final: boolean;
    invoiceDate: string; perfStart: string; perfEnd: string;
    contractStart: string; contractEnd: string;
    billTo: string; lineItems: LineItem[]; notes?: string; pdfName: string;
    supportingDocs: string[];
    contractValue: number; expended: number; remaining: number; asOf: string;
    inStatusDays?: number;
  };
  type Decision = { variant: 'success' | 'danger'; title: string; text: string; badge: string };

  const usd = new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2,
  });
  const usdCompact = new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1,
  });
  const qtyFmt = new Intl.NumberFormat('en-US');

  // ---- File download (prototype) ---------------------------------------
  // No real blobs exist for the mock invoices, so a download builds a minimal
  // valid one-page PDF named after the file.
  const pdfEscape = (s: string) => s.replace(/([()\\])/g, '\\$1');
  function makePlaceholderPdf(filename: string, subtitle: string): Blob {
    const body =
      `BT /F1 18 Tf 60 740 Td (${pdfEscape(filename)}) Tj ` +
      `/F1 11 Tf 0 -26 Td (${pdfEscape(subtitle)}) Tj ` +
      `0 -18 Td (Columbia Basin Fish & Wildlife Program — prototype placeholder) Tj ET`;
    const objs = [
      '<</Type/Catalog/Pages 2 0 R>>',
      '<</Type/Pages/Kids[3 0 R]/Count 1>>',
      '<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 5 0 R>>>>/Contents 4 0 R>>',
      `<</Length ${body.length}>>\nstream\n${body}\nendstream`,
      '<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>',
    ];
    let pdf = '%PDF-1.4\n';
    const offsets: number[] = [];
    objs.forEach((o, i) => { offsets.push(pdf.length); pdf += `${i + 1} 0 obj\n${o}\nendobj\n`; });
    const xref = pdf.length;
    pdf += `xref\n0 ${objs.length + 1}\n0000000000 65535 f \n`;
    offsets.forEach((off) => { pdf += `${String(off).padStart(10, '0')} 00000 n \n`; });
    pdf += `trailer\n<</Size ${objs.length + 1}/Root 1 0 R>>\nstartxref\n${xref}\n%%EOF`;
    return new Blob([pdf], { type: 'application/pdf' });
  }
  // ---- Placeholder spreadsheet ------------------------------------------------
  // A Line Item Budget is an Excel WORKBOOK, so a download named .xlsx has to be one.
  // Handing a demo a file Excel refuses to open is worse than the wrong extension, so
  // this writes a real (minimal) xlsx: a STORED-entry zip around the five parts
  // OOXML requires. Stored rather than deflated keeps it to a CRC and a header —
  // no compressor needed for a few hundred bytes of placeholder.
  const CRC_TABLE = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      t[n] = c >>> 0;
    }
    return t;
  })();
  function crc32(bytes: Uint8Array): number {
    let c = 0xffffffff;
    for (let i = 0; i < bytes.length; i++) c = CRC_TABLE[(c ^ bytes[i]) & 0xff] ^ (c >>> 8);
    return (c ^ 0xffffffff) >>> 0;
  }
  function makeZip(entries: { name: string; text: string }[]): Blob {
    const enc = new TextEncoder();
    const chunks: Uint8Array[] = [];
    const central: Uint8Array[] = [];
    let offset = 0;
    const u32 = (v: number) => [v & 255, (v >>> 8) & 255, (v >>> 16) & 255, (v >>> 24) & 255];
    const u16 = (v: number) => [v & 255, (v >>> 8) & 255];
    entries.forEach(({ name, text }) => {
      const nameBytes = enc.encode(name);
      const data = enc.encode(text);
      const crc = crc32(data);
      const local = Uint8Array.from([
        ...u32(0x04034b50), ...u16(20), ...u16(0), ...u16(0), ...u16(0), ...u16(0),
        ...u32(crc), ...u32(data.length), ...u32(data.length),
        ...u16(nameBytes.length), ...u16(0), ...nameBytes,
      ]);
      chunks.push(local, data);
      central.push(Uint8Array.from([
        ...u32(0x02014b50), ...u16(20), ...u16(20), ...u16(0), ...u16(0), ...u16(0), ...u16(0),
        ...u32(crc), ...u32(data.length), ...u32(data.length),
        ...u16(nameBytes.length), ...u16(0), ...u16(0), ...u16(0), ...u16(0), ...u32(0),
        ...u32(offset), ...nameBytes,
      ]));
      offset += local.length + data.length;
    });
    const centralSize = central.reduce((n, c) => n + c.length, 0);
    const end = Uint8Array.from([
      ...u32(0x06054b50), ...u16(0), ...u16(0),
      ...u16(entries.length), ...u16(entries.length),
      ...u32(centralSize), ...u32(offset), ...u16(0),
    ]);
    // Flattened into one ArrayBuffer-backed view: a bare Uint8Array is typed over
    // ArrayBufferLike (which admits SharedArrayBuffer) and isn't a valid BlobPart.
    const total = [...chunks, ...central, end];
    const out = new Uint8Array(total.reduce((n, c) => n + c.length, 0));
    let at = 0;
    total.forEach((c) => { out.set(c, at); at += c.length; });
    return new Blob([out.buffer as ArrayBuffer], {
      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    });
  }
  function makePlaceholderXlsx(sheetName: string, rows: string[][]): Blob {
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const sheet = rows.map((cells, r) =>
      `<row r="${r + 1}">${cells.map((v, c) =>
        `<c r="${String.fromCharCode(65 + c)}${r + 1}" t="inlineStr"><is><t>${esc(v)}</t></is></c>`).join('')}</row>`,
    ).join('');
    const NS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
    const REL = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
    return makeZip([
      { name: '[Content_Types].xml', text: `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/></Types>` },
      { name: '_rels/.rels', text: `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="${REL}/officeDocument" Target="xl/workbook.xml"/></Relationships>` },
      { name: 'xl/workbook.xml', text: `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="${NS}" xmlns:r="${REL}"><sheets><sheet name="${esc(sheetName).slice(0, 31)}" sheetId="1" r:id="rId1"/></sheets></workbook>` },
      { name: 'xl/_rels/workbook.xml.rels', text: `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="${REL}/worksheet" Target="worksheets/sheet1.xml"/></Relationships>` },
      { name: 'xl/worksheets/sheet1.xml', text: `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="${NS}"><sheetData>${sheet}</sheetData></worksheet>` },
    ]);
  }

  /** The placeholder a filename deserves — a workbook for .xlsx, a document otherwise. */
  function placeholderFor(filename: string, subtitle: string): Blob {
    return /\.xlsx?$/i.test(filename)
      ? makePlaceholderXlsx(filename.replace(/\.[^.]+$/, '').slice(0, 31), [[filename], [subtitle]])
      : makePlaceholderPdf(filename, subtitle);
  }

  function saveBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
  function openBlobInTab(blob: Blob) {
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank', 'noopener');
    // Long enough for the new tab to have fetched the blob; revoking immediately
    // would hand it a dead URL.
    setTimeout(() => URL.revokeObjectURL(url), 60_000);
  }
  function downloadFile(filename: string, invoiceNumber: string) {
    saveBlob(placeholderFor(filename, `Attachment for invoice ${invoiceNumber}`), filename);
  }

  const urgencyOf = (d: number) => (d < 0 ? 'overdue' : d <= 3 ? 'due-soon' : 'on-track');
  const daysLabel = (d: number) => {
    if (d < 0) { const n = Math.abs(d); return `${n} day${n === 1 ? '' : 's'} overdue`; }
    if (d === 0) return 'Due today';
    return `${d} day${d === 1 ? '' : 's'} left`;
  };
  const openStages: Stage[] = ['Submitted', 'In review'];
  const isOpenStage = (s: Stage) => openStages.includes(s);

  // How the invoice's performance-period END sits relative to the contract's END
  // date — the COR reads how close this invoice's work runs to contract close.
  const contractEndGap = (perfEndStr: string, contractEndStr: string): string => {
    const a = new Date(perfEndStr);
    const b = new Date(contractEndStr);
    if (isNaN(a.getTime()) || isNaN(b.getTime())) return '';
    const days = Math.round((b.getTime() - a.getTime()) / 86_400_000);
    if (days === 0) return 'ends on the contract end date';
    const n = Math.abs(days);
    return days > 0
      ? `${n} day${n === 1 ? '' : 's'} before contract end`
      : `${n} day${n === 1 ? '' : 's'} past contract end`;
  };


  // A part as a share of a whole, in the same voice the data module uses: one
  // decimal below 10% so a small routine draw still reads as a real number.
  const pctLabel = (part: number, whole: number): string => {
    const w = Number(whole) || 0;
    if (w <= 0) return '—';
    const pct = (Number(part) || 0) / w * 100;
    if (pct > 0 && pct < 0.1) return '<0.1%';
    return `${pct < 10 ? pct.toFixed(1) : Math.round(pct)}%`;
  };

  // Bind ONE processor surface: populate the single invoice, wire view controls +
  // approve/return + copy + download. No prev/next, no cross-row decisions Map — a
  // decision updates the result alert in place for this one record.
  function bindProcessor(root: HTMLElement) {
    const dataEl = root.querySelector<HTMLScriptElement>('[data-processor-data]');
    if (!dataEl) return;
    let inv: Invoice;
    try { inv = JSON.parse(dataEl.textContent ?? 'null'); } catch { return; }
    if (!inv) return;

    type ContractFacts = { contract: string; project: string; projectNumber: string };
    type Indirect = { rate: number; effective: string; expires: string; expired: boolean };
    let indirect: Indirect | null = null;
    try {
      indirect = JSON.parse(root.querySelector('[data-indirect-rate]')?.textContent ?? 'null');
    } catch { /* leave null — the row then reads "None on file" */ }

    let CONTRACT_FACTS: Record<string, ContractFacts> = {};
    try {
      CONTRACT_FACTS = JSON.parse(root.querySelector('[data-contract-facts]')?.textContent ?? '{}');
    } catch { /* leave empty — a contract change then just sets the number */ }

    // esa-combobox takes its options as a JS PROPERTY (an array), which SSR markup
    // cannot set, so the server-rendered JSON on the element is assigned here — the
    // same handoff the vendor wizard uses for its own combobox.
    root.querySelectorAll<HTMLElement & { options: unknown }>('[data-combobox-options]').forEach((el) => {
      try { el.options = JSON.parse(el.dataset.comboboxOptions ?? '[]'); } catch { /* leave empty */ }
    });

    // Name the edit controls WITHOUT giving them a visible label.
    //
    // The row's <dt> is this field's label and it stays in its column while editing,
    // so a control that also drew its own label would print the word twice and shove
    // the row's layout around. The hub form legos render no <label> when `label` is
    // empty — but they also expose no way to be NAMED without one, which would leave
    // a bare input for a screen reader.
    //
    // These are Lit elements, so their shadow roots are OPEN: the inner control is
    // reachable, and an aria-label set on it is safe because none of the three binds
    // that attribute in its template (Lit leaves attributes it doesn't own alone).
    // The name comes from the rendered <dt> — the same text the sighted user reads,
    // from the same place labelFor() takes it, so the two can never diverge.
    //
    // bcn-date-picker is the spoke's own component and needs none of this: it takes
    // `hide-label` and keeps `label` as its accessible name.
    root.querySelectorAll<HTMLElement>('[data-field-input]:not([hide-label])').forEach((el) => {
      const name = (el.closest('.cbf-invoice-field')
        ?.querySelector('.cbf-invoice-field__label')?.textContent ?? '').trim();
      if (!name) return;
      customElements.whenDefined(el.localName).then(async () => {
        await (el as unknown as { updateComplete?: Promise<unknown> }).updateComplete;
        const inner = el.shadowRoot?.querySelector('input, textarea');
        if (inner && !inner.hasAttribute('aria-label')) inner.setAttribute('aria-label', name);
      });
    });

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel);

    // Pre-clone the real esa-pill markup per stage + urgency (scope hash intact).
    const stageHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-badge-templates] [data-stage]').forEach((el) => {
      stageHTML.set(el.dataset.stage ?? '', el.innerHTML);
    });
    const urgencyHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-badge-templates] [data-urgency]').forEach((el) => {
      urgencyHTML.set(el.dataset.urgency ?? '', el.innerHTML);
    });

    const badgeWith = (html: string, label: string) => {
      const t = document.createElement('div');
      t.innerHTML = html;
      const el = t.querySelector('.esa-pill__label') ?? t.firstElementChild ?? t;
      el.textContent = label;
      return t.innerHTML;
    };

    // This invoice's decision (in place — no cross-row Map).
    let decision: Decision | null = null;

    const result = $('[data-review-result]');
    const resultText = $('[data-result-text]');
    const actions = $('[data-actions]');
    const def = $('[data-actions-default]');
    const returnBox = $('[data-actions-return]');
    const reason = $<HTMLElement & { value: string }>('[data-return-reason]');
    const statusSlot = $('[data-f-status]');
    // Approve guard modal (esa-dialog) + its optional PR-number field.
    const approveDialog = $<HTMLElement & { show(): void; close(): void }>('[data-approve-dialog]');
    const approvePr = $<HTMLElement & { value: string }>('[data-approve-pr]');

    // Submitted-documents + contract-documents lists: the cloneable open/download
    // button markup (real esa-icon-button legos, server-rendered once).
    const attachList = $('[data-f-attachments]');
    const attachTitle = $('[data-f-attach-title]');
    const dlBtnHTML = $('[data-dl-template]')?.querySelector('button')?.outerHTML ?? '';
    const openBtnHTML = $('[data-open-template]')?.querySelector('button')?.outerHTML ?? '';
    const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    let currentFiles: string[] = [];
    let currentNumber = '';

    // ---- Read-only external links (contract record, rate agreement) ------------
    // The contract number and the indirect-rate percent link out to their source
    // record, opening in a new tab. Stub routes for the prototype — the affordance
    // (and its new-tab indicator) is the point.
    const base = import.meta.env.BASE_URL;
    const contractHref = (num: string) => `${base}contracts/${encodeURIComponent(num)}`;
    const rateHref = () => `${base}vendors/indirect-rate`;
    const EXT_ICON = '<svg class="cbf-review-link__ext" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>';
    const linkHtml = (label: string, href: string) =>
      `<a class="cbf-review-link" href="${href}" target="_blank" rel="noopener" aria-label="${escAttr(label)} (opens in a new tab)">${escAttr(label)}${EXT_ICON}</a>`;
    // Write a field row's display as an external link, with an optional quiet sub.
    const setFieldLink = (key: string, label: string, href: string, sub?: string) => {
      const row = root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);
      if (!row) return;
      const display = row.querySelector<HTMLElement>('[data-field-display]');
      if (display) display.innerHTML = linkHtml(label, href);
      const subEl = row.querySelector<HTMLElement>('[data-field-sub]');
      if (subEl) { subEl.textContent = sub ?? ''; subEl.hidden = !sub; }
    };

    const showActionMode = (mode: 'default' | 'return' | 'done', dec?: Decision) => {
      if (def) def.hidden = mode !== 'default';
      if (returnBox) returnBox.hidden = mode !== 'return';
      if (actions) actions.hidden = mode === 'done';
      if (result) result.hidden = mode !== 'done';
      if (mode === 'done' && dec && result && resultText) {
        const box = result.querySelector('.esa-alert-box');
        if (box) {
          box.classList.remove('esa-alert-box--success', 'esa-alert-box--danger', 'esa-alert-box--info', 'esa-alert-box--warning');
          box.classList.add(`esa-alert-box--${dec.variant}`);
          const titleEl = box.querySelector('.esa-alert-box__title');
          if (titleEl) titleEl.textContent = dec.title;
        }
        resultText.textContent = dec.text;
      }
    };

    const setText = (sel: string, value: string) => { const el = $(sel); if (el) el.textContent = value; };
    const setDisabled = (wrap: Element | null, off: boolean) => {
      const btn = wrap?.querySelector('button');
      if (btn) btn.disabled = off;
      wrap?.querySelector('.esa-button')?.classList.toggle('esa-button--disabled', off);
    };

    // Write one cbf-invoice-field row: its value, and the quiet derived line beneath
    // it (hidden when there is nothing to derive, or while that row is being edited —
    // its inputs are standing where the read state would be).
    const setField = (key: string, value: string, sub?: string) => {
      const row = root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);
      if (!row) return;
      const display = row.querySelector<HTMLElement>('[data-field-display]');
      if (display) display.textContent = value;
      const subEl = row.querySelector<HTMLElement>('[data-field-sub]');
      if (subEl) {
        subEl.textContent = sub ?? '';
        subEl.hidden = !sub || editingFields.has(key);
      }
    };

    // ══════════════════════════════════════════════════════════════════════════
    // Correcting the invoice: EDIT a field, or FLAG it as an issue.
    //
    // These are the two things a COR does to a line of an invoice that is wrong.
    // Editing is for what they can fix themselves (a transposed date, a contract
    // value that moved after a modification). Flagging is for what only the vendor
    // can fix — it records WHAT is wrong and WHY, and every flag is carried into
    // the Return-for-revision memo, so returning is just "send what I marked".
    //
    // Both run off one addressing scheme, a field KEY:
    //   'perfStart'   a submitted field on the record   (a cbf-invoice-field row)
    //   'line:2'      a whole line item                 (flag target only — the
    //                 ledger reproduces the vendor's PDF, so a line is objected to,
    //                 never rewritten; there is no addressing for a line's cells.)
    // ══════════════════════════════════════════════════════════════════════════

    const readRaw = (key: string): string => {
      const v = (inv as unknown as Record<string, unknown>)[key];
      return v === undefined || v === null ? '' : String(v);
    };

    // ---- Control value plumbing ----------------------------------------------
    // Every control exposes `.value`, but they don't all speak the record's dialect:
    // bcn-date-picker works in ISO (YYYY-MM-DD) while the record stores the display
    // form the whole surface reads in ("May 22, 2026"). Convert at the boundary so
    // the record keeps ONE representation and no other code has to know.
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const toIso = (human: string): string => {
      const d = new Date(human);
      if (Number.isNaN(d.getTime())) return '';
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    };
    // Parsed field-by-field rather than through Date(): `new Date('2026-05-22')` is
    // UTC midnight, which reads back as the 21st anywhere west of Greenwich.
    const fromIso = (iso: string): string => {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso.trim());
      if (!m) return iso.trim();
      return `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}`;
    };

    const controlOf = (el: HTMLElement | null) => el?.dataset.control ?? 'text';

    /** Seed a control from the record, in whatever dialect that control speaks. */
    const seedControl = (el: (HTMLElement & { value: string }) | null, key: string) => {
      if (!el) return;
      const raw = readRaw(key);
      el.value = controlOf(el) === 'date' ? toIso(raw) : raw;
    };

    /** Read a control back out, normalised to the record's representation. */
    const readControl = (el: (HTMLElement & { value: string }) | null): string => {
      if (!el) return '';
      const v = String(el.value ?? '');
      return controlOf(el) === 'date' ? fromIso(v) : v;
    };

    // `amount` is the one money field the COR can write — the vendor types their total
    // on the submission form — so it is stored as a NUMBER while every other submitted
    // field is text.
    //
    // It is NOT derived, deliberately. The vendor types the total ("Enter the total
    // due, matching your uploaded invoice PDF") and separately attaches the PDF the
    // ledger reproduces. Summing the ledger into `amount` would silently make the two
    // agree, destroying the most useful check on this screen: whether the total the
    // vendor CLAIMS matches the bill they ATTACHED. The document totals itself; this
    // figure stands on its own.
    const writeRaw = (key: string, raw: string) => {
      const rec = inv as unknown as Record<string, unknown>;
      rec[key] = key === 'amount' ? (Number(raw) || 0) : raw;
      // Choosing a contract carries its consequences with it, exactly as it does on
      // the vendor's form: the contract NAME and the PROJECT follow from the choice.
      // Leaving them stale would produce an invoice filed against one contract and
      // charged to another contract's project.
      if (key === 'contractNumber') {
        const facts = CONTRACT_FACTS[raw];
        if (facts) {
          inv.contract = facts.contract;
          inv.project = facts.project;
          inv.projectNumber = facts.projectNumber;
        }
      }
    };

    // Human name for a key — read from the rendered row label rather than kept in a
    // second registry that could drift from the markup.
    const labelFor = (key: string): string => {
      if (key.startsWith('line:')) return `Line ${Number(key.split(':')[1]) + 1}`;
      if (key.startsWith('doc:')) return key.slice(4);
      const row = root.querySelector<HTMLElement>(`[data-field="${key}"] .cbf-invoice-field__label`);
      return (row?.textContent ?? '').trim() || key;
    };

    // ---- Issues --------------------------------------------------------------
    // key → the COR's written reason. Insertion order is the order they raised them,
    // which is the order the return memo lists them in.
    const issues = new Map<string, string>();
    const issuesList = $('[data-issues-list]');
    const issuesEmpty = $('[data-issues-empty]');
    const issuesCount = $('[data-issues-count]');
    const issuesClearAll = $('[data-issues-clear-all]');
    const issueTmpl = (name: string) =>
      root.querySelector<HTMLElement>(`[data-issues-templates] [data-tmpl="${name}"]`)?.innerHTML ?? '';

    const renderIssues = () => {
      const entries = [...issues.entries()];
      const n = entries.length;

      if (issuesEmpty) issuesEmpty.hidden = n > 0;
      if (issuesClearAll) issuesClearAll.hidden = n === 0;
      if (issuesCount) {
        issuesCount.hidden = n === 0;
        const badge = issuesCount.querySelector('.esa-badge__text');
        if (badge) badge.textContent = String(n);
      }
      if (issuesList) {
        issuesList.innerHTML = entries
          .map(([key, comment]) => `<li class="cbf-invoice-issue" data-issue-field="${escAttr(key)}">
            <span class="cbf-invoice-issue__field">${escAttr(labelFor(key))}</span>
            <span class="cbf-invoice-issue__actions">
              <span data-issue-goto data-issue-field="${escAttr(key)}">${issueTmpl('goto')}</span>
              <span data-issue-clear data-issue-field="${escAttr(key)}">${issueTmpl('clear')}</span>
            </span>
            <span class="cbf-invoice-issue__comment">${escAttr(comment)}</span>
          </li>`)
          .join('');
      }

      updateDecisionGate();
    };

    // What the COR may decide right now, and why not. Two things shut a decision, and
    // the note says which one is in the way:
    //   an OPEN EDIT   — deciding would decide on a figure that isn't saved yet, so
    //                    both decisions wait until the row is saved or abandoned;
    //   a FLAGGED FIELD — the COR has stated this invoice is wrong, so it cannot also
    //                    be approved. Return stays open: that is the way out.
    const updateDecisionGate = () => {
      const openEdits = editingFields.size;
      const n = issues.size;
      // Both the opener and the confirm are gated: a sub-state opened before the edit
      // began must not become a back door around the same rule.
      setDisabled($('[data-act-approve]'), openEdits > 0 || n > 0);
      setDisabled($('[data-act-approve-confirm]'), openEdits > 0 || n > 0);
      setDisabled($('[data-act-return]'), openEdits > 0);
      setDisabled($('[data-act-return-confirm]'), openEdits > 0);
      const gate = $('[data-decide-note]');
      if (!gate) return;
      gate.hidden = openEdits === 0 && n === 0;
      gate.textContent = openEdits > 0
        ? `Save or cancel your open edit${openEdits === 1 ? '' : 's'} before deciding.`
        // Says the count, then both ways forward — "can be returned, not approved" is
        // passive and names only what's blocked, not what to do about it.
        : n === 0
          ? ''
          : `${n} issue${n === 1 ? '' : 's'} flagged. Clear ${n === 1 ? 'it' : 'them'} to approve, or return the invoice.`;
    };

    // Paint an issue onto the field row it belongs to (the panel rows only; line
    // items carry theirs inside the ledger, repainted by renderLineItems).
    const paintFieldIssues = () => {
      root.querySelectorAll<HTMLElement>('.cbf-invoice-field[data-flaggable]').forEach((row) => {
        const key = row.dataset.field ?? '';
        const comment = issues.get(key);
        const box = row.querySelector<HTMLElement>('[data-field-issue]');
        const text = row.querySelector<HTMLElement>('[data-field-issue-text]');
        if (comment) row.dataset.flagged = ''; else delete row.dataset.flagged;
        if (box) box.hidden = !comment;
        if (text) text.textContent = comment ?? '';
      });
    };

    // Open the comment capture on a field row, seeded with any existing reason.
    const openNote = (key: string) => {
      const row = root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);
      if (!row) return;
      const note = row.querySelector<HTMLElement>('[data-field-note]');
      const input = row.querySelector<HTMLElement & { value: string }>('[data-field-note-input]');
      const issueBox = row.querySelector<HTMLElement>('[data-field-issue]');
      if (input) input.value = issues.get(key) ?? '';
      if (note) note.hidden = false;
      if (issueBox) issueBox.hidden = true;
      (input as unknown as HTMLElement | null)?.focus?.();
    };
    const closeNote = (key: string) => {
      const row = root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);
      const note = row?.querySelector<HTMLElement>('[data-field-note]');
      if (note) note.hidden = true;
      paintFieldIssues();
    };

    const raiseIssue = (key: string, comment: string) => {
      const text = comment.trim();
      if (!text) { issues.delete(key); } else { issues.set(key, text); }
      renderIssues();
      paintFieldIssues();
      renderLineItems();
      renderAttachments();
    };
    const clearIssue = (key: string) => {
      issues.delete(key);
      renderIssues();
      paintFieldIssues();
      renderLineItems();
      renderAttachments();
    };

    // ---- The line-item ledger (read-only) --------------------------------------
    // A plain reproduction of the vendor's PDF: description, qty, unit, total. There
    // are no per-line controls — the COR reads the bill here and raises any objection
    // on the panel fields. The ledger totals ITSELF, independently of the vendor's
    // typed Amount, so the two can still be seen to disagree.
    const itemsBody = $('[data-f-items]');

    const renderLineItems = () => {
      if (!itemsBody) return;
      itemsBody.innerHTML = inv.lineItems
        .map((li) => `<tr class="cbf-invoice-line">
            <td>${escAttr(li.description)}</td>
            <td class="cbf-num">${qtyFmt.format(li.qty)}</td>
            <td class="cbf-num">${usd.format(li.unitPrice)}</td>
            <td class="cbf-num">${usd.format(li.qty * li.unitPrice)}</td>
          </tr>`)
        .join('');
    };

    // ---- Submitted documents: the invoice, then its backup ---------------------
    // The invoice PDF leads the list — it is the document under review, so it belongs
    // with what was submitted, and "Download all" has to include it. Every row offers
    // the same two actions: open in a new tab, or download. Nothing is viewed in this
    // page's document pane (that stays fixed on the invoice), and there is no flagging
    // here — the COR raises any objection on the panel fields.
    const renderAttachments = () => {
      if (!attachList) return;

      attachList.innerHTML = currentFiles
        .map((name, i) => {
          const isInvoice = i === 0;
          const tag = isInvoice ? '<span class="cbf-review-attach__tag">Invoice</span>' : '';
          return `<li class="cbf-review-attach">
            <div class="cbf-review-attach__row">
              <span class="cbf-review-attach__name" title="${escAttr(name)}">${escAttr(name)}</span>
              ${tag}
              <span class="cbf-review-attach__actions">
                <span class="cbf-review-attach__open" data-attach-open data-file="${escAttr(name)}">${openBtnHTML}</span>
                <span class="cbf-review-attach__dl" data-attach-dl data-file="${escAttr(name)}">${dlBtnHTML}</span>
              </span>
            </div>
          </li>`;
        })
        .join('')
        // An invoice with NO backup is a fact worth stating, now that the invoice
        // leads the list and the absence would otherwise be invisible.
        + (inv.supportingDocs.length === 0
          ? `<li class="cbf-review-attach cbf-review-attach--empty"><div class="cbf-review-attach__row">
              <span class="cbf-review-attach__name">No backup documentation attached.</span>
            </div></li>`
          : '');

      // The cloned lego buttons are generic — name them per file.
      const nameBtn = (sel: string, verb: string, suffix = '') => {
        attachList.querySelectorAll<HTMLElement>(sel).forEach((slot) => {
          const file = slot.dataset.file ?? '';
          const btn = slot.querySelector('button');
          if (btn) { btn.setAttribute('aria-label', `${verb} ${file}${suffix}`); btn.setAttribute('title', `${verb} ${file}${suffix}`); }
        });
      };
      nameBtn('[data-attach-open]', 'Open', ' in a new tab');
      nameBtn('[data-attach-dl]', 'Download');
    };

    // ---- Contract documents: the Line Item Budget, revision by revision ---------
    type BudgetRev = {
      revision: number; issued: string; reason: string;
      label: string; file: string; current: boolean;
    };
    let budgetRevs: BudgetRev[] = [];
    try {
      budgetRevs = JSON.parse(root.querySelector('[data-budget-revisions]')?.textContent ?? '[]');
    } catch { /* leave empty — the section then renders its own empty note */ }

    const budgetList = $('[data-f-budget-docs]');
    const budgetTitle = $('[data-f-budget-title]');
    const budgetPastWrap = $('[data-f-budget-past-wrap]');
    const budgetPastTitle = $('[data-f-budget-past-title]');
    const budgetPast = $('[data-f-budget-past]');

    // One revision row. The ISSUED DATE is the only thing said about it: it is what
    // identifies the document and decides which invoices it governs. Download only —
    // a budget is opened in a spreadsheet, not this page's document pane.
    const budgetRow = (rev: { label: string; file: string; issued: string; current?: boolean }) =>
      `<li class="cbf-review-attach">
        <div class="cbf-review-attach__row">
          <span class="cbf-review-attach__name" title="${escAttr(rev.label)}">${escAttr(rev.label)}</span>
          ${rev.current ? '<span class="cbf-review-attach__tag">Current</span>' : ''}
          <span class="cbf-review-attach__actions">
            <span class="cbf-review-attach__dl" data-budget-dl data-file="${escAttr(rev.file)}">${dlBtnHTML}</span>
          </span>
        </div>
        <p class="cbf-review-attach__meta">Issued ${escAttr(rev.issued)}</p>
      </li>`;

    const renderBudgetDocs = () => {
      if (!budgetList) return;
      // The current revision leads and stays visible; everything it superseded folds
      // into the disclosure beneath. `current` is the data's own flag, so a contract
      // whose newest LIB is not the current one still leads with the right document.
      const current = budgetRevs.filter((r) => r.current);
      const past = budgetRevs.filter((r) => !r.current);
      if (budgetTitle) {
        budgetTitle.textContent = `Contract line item budgets (${budgetRevs.length})`;
      }
      budgetList.innerHTML = budgetRevs.length
        ? (current.length ? current : budgetRevs.slice(0, 1)).map(budgetRow).join('')
        : `<li class="cbf-review-attach cbf-review-attach--empty"><div class="cbf-review-attach__row">
            <span class="cbf-review-attach__name">No Line Item Budget on this contract.</span>
          </div></li>`;

      // Superseded revisions. The disclosure disappears entirely at zero rather than
      // opening onto an empty list.
      const pastRows = current.length ? past : budgetRevs.slice(1);
      if (budgetPastWrap) budgetPastWrap.hidden = pastRows.length === 0;
      if (budgetPastTitle) {
        budgetPastTitle.textContent =
          `${pastRows.length} earlier revision${pastRows.length === 1 ? '' : 's'}`;
      }
      if (budgetPast) budgetPast.innerHTML = pastRows.map(budgetRow).join('');

      // Name the cloned lego buttons per revision — "Download" alone is useless in a
      // list where every row downloads something different.
      root.querySelectorAll<HTMLElement>('[data-budget-dl]').forEach((slot) => {
        const row = slot.closest('li')?.querySelector('.cbf-review-attach__name')?.textContent ?? '';
        const btn = slot.querySelector('button');
        if (btn) {
          btn.setAttribute('aria-label', `Download ${row}`);
          btn.setAttribute('title', `Download ${row}`);
        }
      });
    };

    // ---- Editing ONE field row -------------------------------------------------
    // Editing is scoped to the row you opened. Several rows can be open at once (each
    // saves or abandons on its own), and every other row stays readable — the COR is
    // never made to re-read the whole invoice as a form to fix one transposed date.
    const editingFields = new Set<string>();

    const fieldRow = (key: string) =>
      root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);

    // Show/hide a row's read and edit halves. Deliberately does NOT touch input
    // values: it re-runs on every populate(), and re-seeding would silently discard
    // whatever the COR has typed into a row that is still open.
    const applyFieldEdit = (key: string) => {
      const row = fieldRow(key);
      if (!row) return;
      const on = editingFields.has(key);
      if (on) row.dataset.editing = ''; else delete row.dataset.editing;
      const display = row.querySelector<HTMLElement>('[data-field-display]');
      const sub = row.querySelector<HTMLElement>('[data-field-sub]');
      const input = row.querySelector<HTMLElement>('[data-field-input]');
      if (input) input.hidden = !on;
      if (display) display.hidden = on;
      if (sub) sub.hidden = on || !sub.textContent;
    };
    const applyAllFieldEdits = () => {
      root.querySelectorAll<HTMLElement>('.cbf-invoice-field[data-editable]')
        .forEach((row) => applyFieldEdit(row.dataset.field ?? ''));
    };

    const startFieldEdit = (key: string) => {
      const row = fieldRow(key);
      if (!row || !row.hasAttribute('data-editable')) return;
      // Editing and objecting to the same field at the same time is incoherent — the
      // open comment capture closes as the row goes into edit.
      const note = row.querySelector<HTMLElement>('[data-field-note]');
      if (note) note.hidden = true;
      editingFields.add(key);
      // Seed from the record ONLY here, at the moment the row opens.
      const input = row.querySelector<HTMLElement & { value: string }>('[data-field-input]');
      seedControl(input, key);
      applyFieldEdit(key);
      paintFieldIssues();
      updateDecisionGate();
      (input as unknown as HTMLElement | null)?.focus?.();
    };

    // Cancel discards by simply closing: nothing was written to the record, so the
    // read state that reappears is still the truth.
    const cancelFieldEdit = (key: string) => {
      editingFields.delete(key);
      applyFieldEdit(key);
      updateDecisionGate();
    };

    const saveFieldEdit = (key: string) => {
      const row = fieldRow(key);
      if (!row) return;
      const input = row.querySelector<HTMLElement & { value: string }>('[data-field-input]');
      if (input) writeRaw(key, readControl(input));
      editingFields.delete(key);
      // Repaint everything: a corrected Amount re-derives the share-of-contract line,
      // the balance-after-this-invoice line, and the budget document's figures.
      populate({ keepDoc: true });
    };

    // Repaint the whole surface from the record. Called once on load, and again after
    // every saved edit.
    //
    // `keepDoc` is what separates the two: a LOAD lands the COR on the invoice, but a
    // save must leave the document pane exactly where they left it. Correcting the
    // total while comparing the claim against the attached bill, only to have the
    // comparison snap shut on save, would punish the very check this screen exists
    // to support.
    const populate = (opts?: { keepDoc?: boolean }) => {
      // Status badge (decided stage overrides the invoice stage).
      const shownStage = decision ? decision.badge : inv.stage;
      if (statusSlot) statusSlot.innerHTML = `<span class="cbf-grid-status">${stageHTML.get(shownStage) ?? shownStage}</span>`;

      // Submission timeline. The SUBMITTED date leads (emphasized), with the payment
      // terms and how long the invoice has sat in its current status beneath it.
      setText('[data-f-submitted]', inv.submitted);
      setText('[data-f-net-terms]', inv.netTerms);
      const inStatus = inv.inStatusDays ?? 0;
      const stageWord = inv.stage === 'In review' ? 'review' : inv.stage.toLowerCase();
      setText(
        '[data-f-days-in-status]',
        `${inStatus} day${inStatus === 1 ? '' : 's'} in ${stageWord} status`,
      );

      // Final-invoice notice + document stamp.
      const finalAlert = $('[data-f-final-alert]');
      if (finalAlert) finalAlert.hidden = !inv.final;
      const stamp = $('[data-f-stamp]');
      if (stamp) stamp.hidden = !inv.final;

      // ── The field rows ──────────────────────────────────────────────────────
      // The submitted block leads and closes on the vendor's claimed Amount; the
      // contract block states the award's own term and size and what is left on it.
      // Each row's `sub` is DERIVED context — never a stored value — so it is
      // recalculated here and lands fresh after every saved edit.
      setField('number', inv.number);
      setField('vendor', inv.vendor);
      setField('invoiceDate', inv.invoiceDate);
      // Contract is a read-only link out to the contract record (opens in a new tab),
      // subbed with the human name. Project leads with the reference NUMBER — the ID
      // the COR transcribes into Asset Suite.
      setFieldLink('contractNumber', inv.contractNumber, contractHref(inv.contractNumber), inv.contract);
      setField('projectNumber', inv.projectNumber, inv.project);
      // Each performance date subs the CONTRACT date it has to sit inside, so the
      // comparison needs no second lookup. The end date adds the gap only when the
      // period runs PAST contract end — that is a finding; being comfortably inside
      // the term is not, and saying so on every invoice would be noise.
      setField('perfStart', inv.perfStart, `Contract start ${inv.contractStart}`);
      const endGap = contractEndGap(inv.perfEnd, inv.contractEnd);
      setField(
        'perfEnd',
        inv.perfEnd,
        `Contract end ${inv.contractEnd}${endGap.includes('past') ? ` · ${endGap}` : ''}`,
      );

      // The billed figure. No derived share-of-contract sub — the draw-down block
      // below carries the contract context.
      setField('amount', usd.format(inv.amount));

      // Contract balance. Full precision, not compact — these get transcribed into
      // Asset Suite, where $573.6K is not a number you can type.
      setText('[data-f-dd-value]', usd.format(inv.contractValue));
      setText('[data-f-dd-invoiced]', usd.format(inv.expended));
      setText('[data-f-dd-amount]', usd.format(inv.amount));

      // The bottom line, and the only figure here that MOVES with the amount.
      // Overdrawing the award is a finding, so the row states the overage rather
      // than a negative balance.
      const after = inv.remaining - inv.amount;
      const over = after < 0;
      setText('[data-f-dd-after-label]', over ? 'Over the remaining balance by' : 'Remaining after this invoice');
      setText('[data-f-dd-after]', usd.format(Math.abs(after)));
      $('[data-f-dd-after-row]')?.classList.toggle('is-over', over);

      // The meter: what the contract has already paid out, and what THIS invoice
      // would add on top if approved. Neither segment runs past the end of the track
      // — an overage is told in words above, not by a bar that silently clips.
      const cv = Number(inv.contractValue) || 0;
      const drawnPct = cv > 0 ? (inv.expended / cv) * 100 : 0;
      const pendingPct = cv > 0 ? (inv.amount / cv) * 100 : 0;
      const drawnW = Math.max(0, Math.min(100, drawnPct));
      const pendingW = Math.max(0, Math.min(100 - drawnW, pendingPct));
      const drawnSeg = $('[data-f-dd-drawn]');
      const pendingSeg = $('[data-f-dd-pending]');
      if (drawnSeg) drawnSeg.style.width = `${drawnW}%`;
      if (pendingSeg) {
        pendingSeg.style.width = `${pendingW}%`;
        pendingSeg.classList.toggle('is-over', over);
      }

      // Collapsed, the section still has to answer "is there room for this bill?" —
      // the remaining balance.
      setText('[data-f-contract-digest]', `${usdCompact.format(inv.remaining)} remaining`);
      const amtCopy = root.querySelector<HTMLElement>('[data-field="amount"] [data-copy]');
      if (amtCopy) amtCopy.dataset.copyValue = inv.amount.toFixed(2);

      // The indirect rate in force during the performance period, and the dates that
      // define it. Nothing else: the BES vendor and location decide WHICH rate is
      // fetched, they are not something the COR reads off this row, and a rate's
      // history is not this screen's business.
      const rateAlert = $('[data-field="indirectRate"] [data-field-alert]');
      const rateExpired = !!indirect?.expired;
      if (!indirect) {
        setField('indirectRate', 'None on file');
      } else {
        // The percent links out to the rate agreement (opens in a new tab); the date
        // range it holds for is the quiet sub beneath.
        setFieldLink('indirectRate', `${indirect.rate}%`, rateHref(), `${indirect.effective} – ${indirect.expires}`);
        setText('[data-f-rate-alert-text]', `Most recent rate, expired ${indirect.expires}`);
      }
      if (rateAlert) rateAlert.hidden = !rateExpired;

      // Invoice document.
      setText('[data-f-vendor-doc]', inv.vendor);
      setText('[data-f-num-doc]', inv.number);
      setText('[data-f-date]', inv.invoiceDate);
      setText('[data-f-billto]', inv.billTo);
      // The ledger — each line flaggable on its own, and rebuilt here so an edit to a
      // quantity or a rate shows up in the document. The document totals ITSELF: this
      // is the bill the vendor attached, and it adds up to whatever it adds up to.
      // It is deliberately NOT the panel's Amount (the total the vendor typed) — the
      // COR is here to notice when a claim and its evidence disagree.
      const subtotal = inv.lineItems.reduce((t, li) => t + li.qty * li.unitPrice, 0);
      renderLineItems();
      setText('[data-f-subtotal]', usd.format(subtotal));
      setText('[data-f-tax]', usd.format(0));
      setText('[data-f-total]', usd.format(subtotal));
      const memoWrap = $('[data-f-memo-wrap]');
      if (memoWrap) memoWrap.hidden = !inv.notes;
      setText('[data-f-memo]', inv.notes ?? '');
      setText('[data-f-pdf]', `Submitted document · ${inv.pdfName}`);

      // Submitted documents: the invoice itself, then its backup.
      currentNumber = inv.number;
      currentFiles = [inv.pdfName, ...inv.supportingDocs];
      if (attachTitle) attachTitle.textContent = `Submitted documents (${currentFiles.length})`;
      renderAttachments();

      // Contract line item budgets — the budget's revision history.
      renderBudgetDocs();

      // Approve-modal copy. A saved edit must not wipe a return memo the COR has
      // already begun writing, so the reason only clears on a fresh record.
      setText('[data-f-num-approve]', inv.number);
      setText('[data-f-amount-approve]', usd.format(inv.amount));
      if (reason && !opts?.keepDoc) reason.value = '';

      if (!opts?.keepDoc) showActionMode(decision ? 'done' : 'default', decision ?? undefined);

      // Flags last: they annotate the rows just written, and gate the decisions.
      paintFieldIssues();
      renderIssues();
      // Any row left open stays open across a repaint — saving one field must not
      // close another the COR is still typing into.
      applyAllFieldEdits();
    };

    // ---- Editing and flagging -------------------------------------------------
    // One delegated listener covers the panel rows, the injected ledger rows, and
    // the issues list — so rows re-rendered at any time stay wired.
    const keyOfRow = (el: HTMLElement) =>
      el.closest<HTMLElement>('.cbf-invoice-field')?.dataset.field ?? '';

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;

      // Edit / save / cancel on a FIELD row. The row's cluster only ever shows one
      // of these sets, so the three can never race each other.
      const editBtn = t.closest<HTMLElement>('[data-field-edit]');
      if (editBtn) { startFieldEdit(keyOfRow(editBtn)); return; }
      const editSave = t.closest<HTMLElement>('[data-field-edit-save]');
      if (editSave) { saveFieldEdit(keyOfRow(editSave)); return; }
      const editCancel = t.closest<HTMLElement>('[data-field-edit-cancel]');
      if (editCancel) { cancelFieldEdit(keyOfRow(editCancel)); return; }

      // Raise / re-open a note on a FIELD row.
      const flagBtn = t.closest<HTMLElement>('[data-field-flag]');
      if (flagBtn) {
        const key = flagBtn.closest<HTMLElement>('.cbf-invoice-field')?.dataset.field ?? '';
        if (key) openNote(key);
        return;
      }
      const saveNote = t.closest<HTMLElement>('[data-field-note-save]');
      if (saveNote) {
        const row = saveNote.closest<HTMLElement>('.cbf-invoice-field');
        const key = row?.dataset.field ?? '';
        const input = row?.querySelector<HTMLElement & { value: string }>('[data-field-note-input]');
        raiseIssue(key, String(input?.value ?? ''));
        closeNote(key);
        return;
      }
      const cancelNote = t.closest<HTMLElement>('[data-field-note-cancel]');
      if (cancelNote) {
        closeNote(cancelNote.closest<HTMLElement>('.cbf-invoice-field')?.dataset.field ?? '');
        return;
      }
      const editIssue = t.closest<HTMLElement>('[data-field-issue-edit]');
      if (editIssue) {
        openNote(editIssue.closest<HTMLElement>('.cbf-invoice-field')?.dataset.field ?? '');
        return;
      }
      const clearFieldIssue = t.closest<HTMLElement>('[data-field-issue-clear]');
      if (clearFieldIssue) {
        clearIssue(clearFieldIssue.closest<HTMLElement>('.cbf-invoice-field')?.dataset.field ?? '');
        return;
      }

      // The issues list: jump to the flagged field, or drop the flag. Issues are
      // raised only on panel fields now (the ledger and documents carry no flags).
      const goto = t.closest<HTMLElement>('[data-issue-goto]');
      if (goto) {
        const key = goto.dataset.issueField ?? '';
        const target = root.querySelector<HTMLElement>(`.cbf-invoice-field[data-field="${key}"]`);
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target?.classList.add('is-flash');
        setTimeout(() => target?.classList.remove('is-flash'), 1200);
        return;
      }
      const issueClear = t.closest<HTMLElement>('[data-issue-clear]');
      if (issueClear) {
        clearIssue(issueClear.dataset.issueField ?? '');
        return;
      }
      if (t.closest('[data-issues-clear-all]')) {
        issues.clear();
        renderIssues();
        paintFieldIssues();
      }
    });

    // A single-line text edit answers to the keys a text field answers to: Enter
    // commits, Escape abandons. Reaching for the mouse to leave a one-word correction
    // is the difference between fixing five fields and fixing one.
    // (Native key events are composed, so they surface here from inside the Lit
    // element's shadow root — retargeted to the host, which is inside the row.)
    //
    // ONLY for text and number, though. In a combobox Enter picks the highlighted
    // option and Escape shuts the panel; in a date picker they commit or dismiss the
    // calendar; in a textarea Enter is a newline. Stealing those keys would break the
    // control to save a keystroke — those rows are saved with their buttons.
    const KEY_COMMIT_CONTROLS = new Set(['text', 'number']);
    root.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'Enter' && ev.key !== 'Escape') return;
      const fieldInput = (ev.target as HTMLElement).closest<HTMLElement>('[data-field-input]');
      if (!fieldInput || !KEY_COMMIT_CONTROLS.has(controlOf(fieldInput))) return;
      const key = keyOfRow(fieldInput);
      if (!key) return;
      ev.preventDefault();
      if (ev.key === 'Enter') saveFieldEdit(key); else cancelFieldEdit(key);
    });

    // Wire actions (delegated to wrapper spans like the rest of the spoke).
    // Approve opens the guard modal; the gate (open edits / flagged issues) is
    // enforced on the button, so a disabled Approve never reaches the dialog.
    $('[data-act-approve]')?.addEventListener('click', () => {
      if (approvePr) approvePr.value = '';
      approveDialog?.show();
    });
    // Returning opens with the flagged issues already written up. The COR marked
    // them one at a time across the invoice; the memo is that work, collected — so
    // nothing has to be retyped and nothing silently fails to reach the vendor. The
    // text stays editable: this is a first draft, not a locked summary.
    $('[data-act-return]')?.addEventListener('click', () => {
      if (reason && issues.size > 0 && !(reason.value ?? '').trim()) {
        const lines = [...issues.entries()]
          .map(([key, comment], i) => `${i + 1}. ${labelFor(key)} — ${comment}`)
          .join('\n');
        reason.value =
          `${issues.size} issue${issues.size === 1 ? '' : 's'} need${issues.size === 1 ? 's' : ''} correction before this invoice can be approved:\n\n${lines}`;
      }
      showActionMode('return');
    });
    $('[data-act-approve-cancel]')?.addEventListener('click', () => approveDialog?.close());
    $('[data-act-return-cancel]')?.addEventListener('click', () => showActionMode('default'));

    $('[data-act-approve-confirm]')?.addEventListener('click', () => {
      // The optional Payment Request (PR) number the COR recorded on approval.
      const pr = (approvePr?.value ?? '').trim();
      const dec: Decision = {
        variant: 'success', title: 'Approved', badge: 'Approved',
        text: pr
          ? `Routed to the Contracting Officer for payment · PR ${pr}.`
          : 'Routed to the Contracting Officer for payment.',
      };
      decision = dec;
      if (statusSlot) statusSlot.innerHTML = `<span class="cbf-grid-status">${stageHTML.get('Approved') ?? 'Approved'}</span>`;
      approveDialog?.close();
      showActionMode('done', dec);
    });

    $('[data-act-return-confirm]')?.addEventListener('click', () => {
      const note = (reason?.value ?? '').trim();
      const n = issues.size;
      const flags = n > 0 ? `${n} flagged item${n === 1 ? '' : 's'}` : '';
      const carried = [flags, note ? 'your comments' : ''].filter(Boolean).join(' and ');
      const dec: Decision = {
        variant: 'danger', title: 'Returned for revision', badge: 'Returned',
        text: carried
          ? `Sent to the vendor with ${carried}.${note ? ` “${note}”` : ''}`
          : 'Sent to the vendor for revision.',
      };
      decision = dec;
      if (statusSlot) statusSlot.innerHTML = `<span class="cbf-grid-status">${stageHTML.get('Returned') ?? 'Returned'}</span>`;
      showActionMode('done', dec);
    });

    // Submitted documents: open in a new tab, or download. (Download-all downloads
    // every file in turn, lightly staggered so the browser accepts the burst.)
    attachList?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const openSlot = target.closest<HTMLElement>('[data-attach-open]');
      if (openSlot?.dataset.file) {
        openBlobInTab(placeholderFor(openSlot.dataset.file, `Attachment for invoice ${currentNumber}`));
        return;
      }
      const dlSlot = target.closest<HTMLElement>('[data-attach-dl]');
      if (dlSlot?.dataset.file) downloadFile(dlSlot.dataset.file, currentNumber);
    });
    $('[data-attach-all]')?.addEventListener('click', () => {
      currentFiles.forEach((file, i) => setTimeout(() => downloadFile(file, currentNumber), i * 250));
    });

    // Per-revision Line Item Budget: download only. The filename is the revision's
    // own, and it downloads a real (minimal) workbook whose header rows identify the
    // revision once the file is off this page.
    root.addEventListener('click', (e) => {
      const budgetBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-budget-dl]');
      if (!budgetBtn) return;
      const file = budgetBtn.dataset.file ?? '';
      const rev = budgetRevs.find((r) => r.file === file);
      const rows: string[][] = [
        [rev?.label ?? 'Line Item Budget'],
        ['Contract', inv.contractNumber, inv.contract],
        ['Issued', rev?.issued ?? '', rev?.reason ?? ''],
        [],
        ['Description', 'Qty', 'Unit price', 'Total'],
        ...inv.lineItems.map((li) => [
          li.description, String(li.qty), li.unitPrice.toFixed(2), (li.qty * li.unitPrice).toFixed(2),
        ]),
        [],
        ['Contract value', inv.contractValue.toFixed(2)],
        ['Expended', inv.expended.toFixed(2)],
        ['Remaining', inv.remaining.toFixed(2)],
      ];
      saveBlob(makePlaceholderXlsx(rev?.label ?? 'Line Item Budget', rows), file);
    });

    // Copy controls: each [data-copy] copies one atomic value to the clipboard.
    const copyTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
    const writeClipboard = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
        return ok;
      }
    };
    root.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement)?.closest<HTMLElement>('[data-copy]');
      if (!trigger || !root.contains(trigger)) return;
      let text = (trigger.dataset.copyValue ?? '').trim();
      if (!text) {
        const targetSel = trigger.dataset.copyTarget;
        const valueEl = targetSel
          ? root.querySelector<HTMLElement>(targetSel)
          : trigger.closest('.cbf-review-fields__row')?.querySelector<HTMLElement>('.cbf-review-fields__value');
        text = (valueEl?.textContent ?? '').trim();
      }
      if (!text) return;
      void writeClipboard(text).then((ok) => {
        if (!ok) return;
        trigger.dataset.state = 'copied';
        clearTimeout(copyTimers.get(trigger));
        copyTimers.set(trigger, setTimeout(() => { delete trigger.dataset.state; }, 1200));
      });
    });

    // Panel top edge — the title now rides inside the sticky document column, so the
    // panel is pushed down to start level with the document pane, where it started
    // before the title moved. The title's height is content-dependent (the eyebrow
    // wraps on narrow viewports), so measure it rather than hard-coding a margin.
    // When the sidebar primitive WRAPS the two columns into one stack, the offset
    // would be dead space, so it zeroes out — detected on offsetLeft, which the
    // margin itself cannot change, so this can never oscillate.
    const splitEl = root.querySelector<HTMLElement>('.cbf-invoice-processor__split');
    const titleEl = root.querySelector<HTMLElement>('.cbf-invoice-processor__doctitle');
    const docColEl = root.querySelector<HTMLElement>('.cbf-invoice-processor__doccol');
    const panelEl = root.querySelector<HTMLElement>('.cbf-review-panel');
    if (splitEl && titleEl && docColEl && panelEl) {
      let last = '';
      const syncPanelOffset = () => {
        const stacked = panelEl.offsetLeft === docColEl.offsetLeft;
        const h = titleEl.offsetHeight;
        const next = stacked || !h ? '0px' : `calc(${h}px + var(--spacing-400))`;
        if (next === last) return;
        last = next;
        splitEl.style.setProperty('--cbf-panel-offset', next);
      };
      syncPanelOffset();
      const ro = new ResizeObserver(syncPanelOffset);
      ro.observe(titleEl);
      ro.observe(splitEl);
    }

    populate();
  }

  document.querySelectorAll<HTMLElement>('.cbf-invoice-processor').forEach(bindProcessor);
</script>
