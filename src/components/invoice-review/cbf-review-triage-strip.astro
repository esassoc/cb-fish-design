---
// cbf-review-triage-strip — the COR's urgency band for the invoice-review queue.
// Answers "how many invoices are on me right now, and which are running out of
// clock?" in one glanceable row: open count, overdue, due soon, and the dollar
// value awaiting the COR's decision. The review window is an SLA, so urgency is
// the headline — overdue is the one accented metric.
//
// bcn-lego-checked: esa-stat is the single-metric lego (checked the full ecology
// catalog — esa-stat owns value/label/sub/accent); this section only composes a
// row of them inside the .cluster layout primitive, exactly like
// cbf-vendor-financial-outlook. No bespoke metric markup, no colored left-border
// status block (a banned pattern) — the count IS the signal.
import EsaStat from '@esa/ecology/esa-stat.astro';

interface Props {
  open: number;
  overdue: number;
  dueSoon: number;
  awaiting: string; // pre-formatted USD
  caption: string;
}
const { open, overdue, dueSoon, awaiting, caption } = Astro.props;
const inv = (n: number) => (n === 1 ? '1 invoice' : `${n} invoices`);
---
<section class="cbf-review-triage-strip stack" data-gap="sm" aria-label="Review queue status">
  <header class="cbf-review-triage-strip__head repel">
    <h2 class="type-section-title">Awaiting your review</h2>
    <span class="type-caption cbf-review-triage-strip__caption">{caption}</span>
  </header>

  <div class="cbf-review-triage-strip__stats cluster" data-gap="xl">
    <EsaStat value={String(open)} label="In your queue" sub={inv(open)} />
    <EsaStat value={String(overdue)} label="Overdue" sub="past review-by date" accent={overdue > 0} />
    <EsaStat value={String(dueSoon)} label="Due soon" sub="3 days or less" />
    <EsaStat value={awaiting} label="Value awaiting decision" />
  </div>
</section>

<style>
  .cbf-review-triage-strip {
    padding-bottom: var(--spacing-600);
    border-bottom: 1px solid var(--color-border);
  }
  .cbf-review-triage-strip__head {
    align-items: baseline;
    gap: var(--spacing-400);
    flex-wrap: wrap;
  }
  .cbf-review-triage-strip__caption {
    color: var(--color-text-muted);
  }
  .cbf-review-triage-strip__stats {
    /* top-align stats instead of the .cluster center default */
    --align: flex-start;
    row-gap: var(--spacing-500);
  }
</style>
