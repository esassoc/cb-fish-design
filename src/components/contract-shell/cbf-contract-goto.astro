---
// cbf-contract-goto — Go to, rebuilt as a fast path (IA redesign, decision 5). It
// no longer mirrors the section list (the tab strip is that); it jumps to any
// contract, project, vendor or page by number or name — "lib", "411206 lib",
// "CR-411206", "87760 lib" — with this contract's pins and the viewer's recents
// shown before anything is typed, and the viewer's actions as a short group last.
//
// Everything role- or state-dependent is precomputed here (every role's pages,
// every "role:state" action list) into one JSON attribute, the same way the shell
// ships clientConfig; the script reads the live role (html[data-cbf-role]) and
// state (html[data-contract-state]) each time the menu opens, so the lens and the
// state switch never need to talk to it.
//
// Results are plain links whose hrefs the shell already resolves on click: a built
// page → its route; an unbuilt page → `#goto:<tab>/<child>`; any other record →
// `#goto:recent` (the shell toasts that it's outside the prototype). The shell
// closes this menu via hidePopover() when a link inside is followed.
//
// It drops from the button, end-aligned to its right edge — the same placement and
// menu surface as the "Related items" menu in cbf-report-tabs, so CBFish has one
// way a nav menu opens. It's a native `popover` (top layer) rather than an absolute
// child because cbf-app-panel clips its overflow; the script pins it under the
// button and keeps it inside the viewport, which esa-popover can't (it always
// centers — docs/hub-issues.md).
//
// bcn-lego-checked: the trigger is esa-button. The finder is bespoke: esa-text-field
// renders its input inside a shadow root, so aria-activedescendant on it can't point
// at the result rows (ids don't cross shadow boundaries) — the combobox needs a light-
// DOM input, as cbf-omni-search does. esa-command-palette is a flat action launcher in
// its own modal (no anchored placement, no grouped pages/records/actions);
// esa-entity-search is a single-list omnibox with no empty-state groups;
// esa-dropdown-menu has no filter or group headings; esa-popover always centers.
// Checked Beacon (no contract-scoped Go to). Panel CSS is the cbf-report-tabs menu
// surface; rows reuse its brand-subtle active cue.
import EsaButton from '@esa/ecology/esa-button.astro';
import { withBase } from '../../lib/base';
import {
  TABS, CONTRACTS, VIEWER_ROLES, DEFAULT_STATE, PAGE_ALIASES, GOTO_PINS, GOTO_RECENTS, GOTO_RECORDS,
  childrenFor, childLabel, hrefFor, allModels,
} from '../../data/contract-shell.mjs';

interface Props {
  contract: string;
}
const { contract } = Astro.props;
const c = (CONTRACTS as any)[contract];
const ctx = `Contract ${c.number}`;

const pageHref = (target: string) => {
  const href = hrefFor(c, target);
  return href ? withBase(href) : `#goto:${target}`;
};

// Every page of this contract a role may see, with the words it answers to.
const pages = Object.fromEntries(
  VIEWER_ROLES.map((role) => [
    role,
    TABS.flatMap((t: any) =>
      childrenFor(t, role).map((ch: any, i: number) => {
        const target = `${t.key}/${ch.key}`;
        const words = [childLabel(ch), ch.label, t.label, target, ...((PAGE_ALIASES as any)[target] ?? [])];
        return {
          target,
          top: i === 0,
          section: t.label,
          label: childLabel(ch),
          sub: `${t.label} · ${ctx}`,
          hay: words.join(' ').toLowerCase(),
          href: pageHref(target),
        };
      }),
    ),
  ]),
);

// The viewer's own actions, for every role × state.
const models = allModels(contract) as Record<string, any>;
const actions = Object.fromEntries(
  Object.entries(models).map(([key, m]) => [
    key,
    m.mine.map((a: any) => ({
      label: a.verb,
      sub: [a.task, a.when].filter(Boolean).join(' · '),
      hay: `${a.verb} ${a.task} ${a.target}`.toLowerCase(),
      href: a.href ? withBase(a.href) : `#goto:${a.target}`,
    })),
  ]),
);

const record = (r: any) => ({
  kind: r.kind,
  label: r.label,
  sub: r.sub,
  hay: `${r.kind} ${r.label} ${r.sub}`.toLowerCase(),
  href: '#goto:recent',
});

const data = {
  number: String(c.number),
  digits: String(c.number).replace(/\D/g, ''),
  ctx,
  defaultState: DEFAULT_STATE,
  pins: GOTO_PINS,
  pages,
  actions,
  recents: (GOTO_RECENTS as any[]).filter((r) => r.label !== ctx).map(record),
  records: (GOTO_RECORDS as any[]).map(record),
};
---
<div class="cbf-goto-root">
  <EsaButton variant="secondary" appearance="outline" size="sm" popovertarget="cbf-goto-menu" aria-haspopup="true">Go to</EsaButton>

  <div id="cbf-goto-menu" class="cbf-goto-menu" popover="auto" data-cs-goto-menu data-cs-goto-data={JSON.stringify(data)}>
    <div class="cbf-goto__search">
      <input
        class="cbf-goto__input typography-body-md"
        data-cs-goto-input
        type="search"
        role="combobox"
        aria-label={`Go to — from contract ${c.number}`}
        aria-expanded="true"
        aria-controls="cbf-goto-results"
        aria-autocomplete="list"
        placeholder="Contract, project, vendor or page"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div id="cbf-goto-results" class="cbf-goto__results" role="listbox" aria-label="Go to results" data-cs-goto-results></div>
    <p class="cbf-goto__none typography-body-sm" data-cs-goto-none hidden>No matches</p>
  </div>
</div>

<script>
  type Row = { label: string; sub: string; section?: string; hay?: string; href: string; target?: string; top?: boolean; kind?: string };
  type Data = {
    number: string; digits: string; ctx: string; defaultState: string; pins: string[];
    pages: Record<string, Row[]>; actions: Record<string, Row[]>; recents: Row[]; records: Row[];
  };

  const menu = document.querySelector<HTMLElement>('[data-cs-goto-menu]');
  const trigger = document.querySelector<HTMLElement>('[popovertarget="cbf-goto-menu"]');
  const input = menu?.querySelector<HTMLInputElement>('[data-cs-goto-input]');
  const list = menu?.querySelector<HTMLElement>('[data-cs-goto-results]');
  const none = menu?.querySelector<HTMLElement>('[data-cs-goto-none]');
  const data: Data | null = menu ? JSON.parse(menu.dataset.csGotoData ?? 'null') : null;

  // ── Placement ────────────────────────────────────────────────────────────────
  // Pin the menu under the trigger with right edges aligned, sliding left only as
  // far as the viewport needs (on a narrow screen the button wraps to the left).
  // Placed in `beforetoggle` so it never paints at the top-layer default, and
  // re-placed on scroll/resize while open (the top layer is fixed, not anchored).
  const GAP = 6;
  const EDGE = 16;
  const place = (): void => {
    if (!menu || !trigger) return;
    const r = trigger.getBoundingClientRect();
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    const width = Math.min(34 * rem, window.innerWidth - 2 * EDGE); // = the CSS width
    const left = Math.min(Math.max(EDGE, r.right - width), window.innerWidth - EDGE - width);
    menu.style.top = `${r.bottom + GAP}px`;
    menu.style.left = `${left}px`;
    menu.style.maxHeight = `${window.innerHeight - r.bottom - GAP - EDGE}px`;
  };

  // ── Finding ──────────────────────────────────────────────────────────────────
  const role = (): string => (document.documentElement.dataset.cbfRole === 'cor' ? 'cor' : 'vendor');
  const liveActions = (): Row[] => {
    if (!data) return [];
    const state = document.documentElement.dataset.contractState || data.defaultState;
    return data.actions[`${role()}:${state}`] ?? data.actions[`${role()}:${data.defaultState}`] ?? [];
  };

  /** Does a token name THIS contract? "CR-411206", "411206", "4112", "1206". */
  const isOurs = (t: string): boolean => {
    if (!data) return false;
    if (t === data.number.toLowerCase()) return true;
    return /^\d{3,}$/.test(t) && (data.digits.startsWith(t) || data.digits.endsWith(t));
  };
  const hits = (hay: string | undefined, tokens: string[]): boolean =>
    !!hay && tokens.every((t) => hay.includes(t));

  type Group = { heading: string; rows: Row[] };

  const emptyGroups = (): Group[] => {
    if (!data) return [];
    const mine = data.pages[role()] ?? [];
    const pins = data.pins.map((p) => mine.find((x) => x.target === p)).filter(Boolean) as Row[];
    // Then the full map: every page of the contract, under its section, so Go to
    // is the "see everything" view and the tabs don't have to be.
    const sections = [...new Set(mine.map((p) => p.section))];
    return [
      { heading: 'Pinned', rows: pins },
      { heading: 'Recent', rows: data.recents },
      { heading: 'Actions', rows: liveActions() },
      ...sections.map((s) => ({
        heading: s ?? '',
        rows: mine.filter((p) => p.section === s).map((p) => ({ ...p, sub: '' })),
      })),
    ];
  };

  const queryGroups = (q: string): Group[] => {
    if (!data) return [];
    const tokens = q.toLowerCase().split(/\s+/).filter(Boolean);
    const scoped = tokens.some(isOurs);
    const rest = tokens.filter((t) => !isOurs(t));
    const mine = data.pages[role()] ?? [];

    const pages = scoped && !rest.length ? mine.filter((p) => p.top) : mine.filter((p) => hits(p.hay, rest));

    // Records only when the query isn't scoped to this contract. A contract record
    // plus page words ("87760 lib") offers that contract's page — still a stub.
    const records: Row[] = [];
    if (!scoped) {
      for (const r of data.records) {
        if (hits(r.hay, tokens)) { records.push(r); continue; }
        if (r.kind !== 'Contract') continue;
        const named = tokens.filter((t) => /\d/.test(t) && r.hay!.includes(t));
        const words = tokens.filter((t) => !named.includes(t));
        if (!named.length || !words.length) continue;
        const contractNo = r.label.replace(/^Contract\s+/, '');
        for (const p of mine.filter((x) => hits(x.hay, words)).slice(0, 2)) {
          records.push({ label: p.label, sub: p.sub.replace(data.ctx, `Contract ${contractNo}`), href: '#goto:recent' });
        }
      }
    }

    const acts = liveActions().filter((a) => (scoped && !rest.length) || hits(a.hay, rest));

    return [
      { heading: 'Pages', rows: pages.slice(0, 8) },
      { heading: 'Records', rows: records.slice(0, 6) },
      { heading: 'Actions', rows: acts },
    ];
  };

  // ── Rendering + keyboard ─────────────────────────────────────────────────────
  let active = -1;
  const options = (): HTMLAnchorElement[] =>
    list ? Array.from(list.querySelectorAll<HTMLAnchorElement>('[role="option"]')) : [];

  const setActive = (i: number): void => {
    const opts = options();
    if (!opts.length) { active = -1; input?.removeAttribute('aria-activedescendant'); return; }
    active = (i + opts.length) % opts.length;
    opts.forEach((o, n) => o.setAttribute('aria-selected', String(n === active)));
    input?.setAttribute('aria-activedescendant', opts[active].id);
    opts[active].scrollIntoView({ block: 'nearest' });
  };

  const render = (): void => {
    if (!list || !input || !none) return;
    const q = input.value.trim();
    const groups = (q ? queryGroups(q) : emptyGroups()).filter((g) => g.rows.length);
    list.replaceChildren();
    let n = 0;
    groups.forEach((g, gi) => {
      const group = document.createElement('div');
      group.className = 'cbf-goto__group';
      group.setAttribute('role', 'group');
      const head = document.createElement('p');
      head.id = `cbf-goto-g${gi}`;
      head.className = 'cbf-goto__heading typography-body-sm';
      head.textContent = g.heading;
      group.setAttribute('aria-labelledby', head.id);
      group.append(head);
      for (const r of g.rows) {
        const a = document.createElement('a');
        a.id = `cbf-goto-o${n++}`;
        a.className = 'cbf-goto__option';
        a.href = r.href;
        a.tabIndex = -1;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');
        const label = document.createElement('span');
        label.className = 'cbf-goto__label typography-label-md';
        label.textContent = r.label;
        const sub = document.createElement('span');
        sub.className = 'cbf-goto__sub typography-body-sm';
        sub.textContent = r.sub;
        a.append(label);
        if (r.sub) a.append(sub);
        group.append(a);
      }
      list.append(group);
    });
    none.hidden = n > 0;
    input.setAttribute('aria-expanded', String(n > 0));
    setActive(q && n ? 0 : -1);
    if (!q || !n) {
      active = -1;
      options().forEach((o) => o.setAttribute('aria-selected', 'false'));
      input.removeAttribute('aria-activedescendant');
    }
  };

  input?.addEventListener('input', render);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active < 0 ? -1 : active - 1); }
    else if (e.key === 'Enter') {
      const opt = options()[active];
      if (opt) { e.preventDefault(); opt.click(); }
    }
  });
  list?.addEventListener('mousemove', (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]');
    const i = opt ? options().indexOf(opt) : -1;
    if (i >= 0 && i !== active) setActive(i);
  });

  menu?.addEventListener('beforetoggle', (e) => {
    if ((e as ToggleEvent).newState !== 'open') return;
    if (input) input.value = '';
    render();
    place();
  });
  menu?.addEventListener('toggle', (e) => {
    const open = (e as ToggleEvent).newState === 'open';
    trigger?.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
    const method = open ? 'addEventListener' : 'removeEventListener';
    window[method]('scroll', place);
    window[method]('resize', place);
  });
</script>

<style>
  /* The cbf-report-tabs menu surface (raised, hairline, radius-100, soft shadow). */
  .cbf-goto-menu {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(34rem, calc(100vw - 2rem)); /* mirrored in place() */
    overflow: auto;
    padding: 0;
    background: var(--color-background-elevation-raised);
    color: var(--color-content-default);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-100);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-background-default-knockout) 14%, transparent);
  }
  .cbf-goto-menu:popover-open {
    display: flex;
    flex-direction: column;
  }
  .cbf-goto__search {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-background-elevation-raised);
    border-bottom: 1px solid var(--color-border-default);
  }
  .cbf-goto__input {
    width: 100%;
    border: 0;
    outline: 0;
    padding: var(--spacing-100) 0;
    background: transparent;
    color: var(--color-content-default);
  }
  .cbf-goto__input::placeholder {
    color: var(--cbf-text-placeholder, var(--color-content-default-tertiary));
  }
  .cbf-goto__input::-webkit-search-cancel-button {
    appearance: none;
  }
  .cbf-goto__results {
    padding: var(--spacing-200) 0;
  }
  .cbf-goto__none {
    margin: 0;
    padding: var(--spacing-400);
    color: var(--color-content-default-secondary);
  }

  /* The rows are built by the script, so they can't carry Astro's scope hash. */
  .cbf-goto__results :global(.cbf-goto__group + .cbf-goto__group) {
    margin-top: var(--spacing-200);
  }
  .cbf-goto__results :global(.cbf-goto__heading) {
    margin: 0;
    padding: var(--spacing-200) var(--spacing-400) var(--spacing-100);
    color: var(--color-content-default-secondary);
  }
  .cbf-goto__results :global(.cbf-goto__option) {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-200) var(--spacing-400);
    color: var(--color-content-default);
    text-decoration: none;
  }
  .cbf-goto__results :global(.cbf-goto__sub) {
    color: var(--color-content-default-secondary);
  }
  /* Same quiet selection cue as the cbf-report-tabs menu items. */
  .cbf-goto__results :global(.cbf-goto__option[aria-selected='true']),
  .cbf-goto__results :global(.cbf-goto__option:hover) {
    background: var(--color-background-brand-subtle);
    color: var(--color-background-brand);
  }
  .cbf-goto__results :global(.cbf-goto__option:focus-visible) {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, currentColor);
    outline-offset: -2px;
  }
</style>
