---
// cbf-contract-basics — every recorded fact about the contract: the live Contract
// Summary's "Basics" list (project, area, continuation, description, dates, value,
// people, work order, type, accrual category, pricing method) and its location map.
// It is the reference behind the Overview's short "Contract details", which opens it
// in a drawer — the Overview shows the handful of facts people act on; this keeps
// the rest one click away instead of on the page.
//
// bcn-lego-checked: content only — a facts <dl>, two small fact sub-tables and a
// static map placeholder. Ecology has no key-value / spec-list lego and no map
// surface (Google Maps can't be embedded here); Beacon renders these as plain
// markup too and is not on this machine. Lifted unchanged from the former
// cbf-contract-summary.
import { CONTRACTS } from '../../data/contract-shell.mjs';

interface Props {
  contract: string;
}
const { contract } = Astro.props;
const s = (CONTRACTS as any)[contract].summary;

const pinSvg =
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="var(--color-background-brand)" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>';
---
<div class="cbf-summary">
  <p class="cbf-summary__modified typography-meta">Last modified by {s.lastModifiedBy}, {s.lastModifiedAt}</p>
  <div class="cbf-summary__basics">
    <div class="cbf-summary__basics-main">
      <dl class="cbf-summary__dl">
        <dt>Project number</dt><dd><a class="cbf-doc-link" href="#">{s.projectNumber}</a></dd>
        <dt>Project title</dt><dd>{s.projectTitle}</dd>
        <dt>BPA PM</dt><dd>{s.bpaPm}</dd>
        <dt>Project stage</dt><dd>{s.projectStage}</dd>
        <dt>Project area</dt>
        <dd>
          <table class="cbf-summary__subtable">
            <thead><tr><th>Province</th><th>Subbasin</th><th>%</th></tr></thead>
            <tbody><tr><td>{s.projectArea.province}</td><td>{s.projectArea.subbasin}</td><td>{s.projectArea.pct}</td></tr></tbody>
          </table>
        </dd>
        <dt>Contract number</dt><dd>{s.contractNumber}</dd>
        <dt>Contract title</dt><dd>{s.contractTitle}</dd>
        <dt>Contract continuation</dt>
        <dd>
          <table class="cbf-summary__subtable">
            <thead><tr><th>Previous</th><th>Will be renewed</th><th>Next</th></tr></thead>
            <tbody><tr>
              <td><span class="cbf-doc-link">{s.continuation.previous}</span></td>
              <td>{s.continuation.willBeRenewed}</td>
              <td>{s.continuation.next === '—' ? '—' : <span class="cbf-doc-link">{s.continuation.next}</span>}</td>
            </tr></tbody>
          </table>
        </dd>
        <dt>Contract status</dt><dd>{s.status}</dd>
        <dt>Contract description</dt>
        <dd><p class="cbf-summary__desc-lede">{s.descriptionLede}</p><p class="cbf-summary__desc">{s.description}</p></dd>
        <dt>Account type(s)</dt><dd>{s.accountTypes}</dd>
        <dt>Contract start date</dt><dd>{s.startDate}</dd>
        <dt>Contract end date</dt><dd>{s.endDate}</dd>
        <dt>Current contract value</dt><dd>{s.currentValue}</dd>
        <dt>Expenditures</dt>
        <dd>{s.expenditures}<span class="typography-meta cbf-summary__note">* {s.expendituresNote}</span></dd>
        <dt>BPA CO</dt><dd><a class="cbf-doc-link" href="#">{s.bpaCo}</a></dd>
        <dt>BPA COR</dt><dd><a class="cbf-doc-link" href="#">{s.bpaCor}</a></dd>
        <dt>Env. compliance lead</dt><dd><a class="cbf-doc-link" href="#">{s.envComplianceLead}</a></dd>
        <dt>Contract contractor</dt><dd><a class="cbf-doc-link" href="#">{s.contractor}</a></dd>
        <dt>Work order task(s)</dt><dd><a class="cbf-doc-link" href="#">{s.workOrderTasks}</a></dd>
        <dt>Contract type</dt><dd>{s.contractType}</dd>
        <dt>Accrual category</dt><dd>{s.accrualCategory}</dd>
        <dt>Pricing method</dt><dd>{s.pricingMethod}</dd>
        {s.signatureBased && <><dt>Signature based</dt><dd>{s.signatureBased}</dd></>}
      </dl>
    </div>
    <div class="cbf-summary__map" aria-hidden="true">
      <div class="cbf-summary__map-canvas"><Fragment set:html={pinSvg} /></div>
      <p class="cbf-summary__map-cap typography-meta">Select the map to see this contract's location details.</p>
    </div>
  </div>
</div>

<style>
  .cbf-summary__modified { margin: 0 0 var(--spacing-300); color: var(--color-content-default-tertiary); }

  .cbf-summary__basics { display: flex; flex-wrap: wrap; gap: var(--spacing-500); align-items: flex-start; }
  .cbf-summary__basics-main { flex: 1; min-width: min(100%, 420px); }

  /* Facts list — label column right-aligned, value column, row rules (table look). */
  .cbf-summary__dl { display: grid; grid-template-columns: 210px 1fr; margin: 0; }
  .cbf-summary__dl > dt {
    grid-column: 1;
    text-align: right;
    padding: var(--spacing-300) var(--spacing-400);
    border-top: 1px solid var(--color-border-default-subtle, var(--color-border-default));
    color: var(--color-content-default-secondary);
    font-weight: var(--typography-font-weight-medium);
  }
  .cbf-summary__dl > dd {
    grid-column: 2;
    margin: 0;
    padding: var(--spacing-300) var(--spacing-400);
    border-top: 1px solid var(--color-border-default-subtle, var(--color-border-default));
    min-width: 0;
  }
  .cbf-summary__dl > dt:first-of-type,
  .cbf-summary__dl > dt:first-of-type + dd { border-top: 0; }

  .cbf-summary__desc-lede { margin: 0 0 var(--spacing-200); }
  .cbf-summary__desc { margin: 0; color: var(--color-content-default-secondary); max-width: 80ch; }
  .cbf-summary__note { display: block; margin-top: 2px; color: var(--color-content-default-tertiary); }

  .cbf-summary__subtable { width: 100%; border-collapse: collapse; }
  .cbf-summary__subtable th, .cbf-summary__subtable td {
    text-align: left;
    padding: var(--spacing-200) var(--spacing-300);
    border: 1px solid var(--color-border-default);
    font-size: var(--font-size-150, 0.875rem);
    vertical-align: top;
  }
  .cbf-summary__subtable th { background: var(--color-background-elevation-sunken, #f4f4f4); font-weight: var(--typography-font-weight-semibold); white-space: nowrap; }

  /* Location map — static placeholder (no external map embed). */
  .cbf-summary__map { width: 320px; flex: none; }
  .cbf-summary__map-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 220px;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    background:
      repeating-linear-gradient(0deg, transparent 0 23px, color-mix(in srgb, var(--color-background-brand) 6%, transparent) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, color-mix(in srgb, var(--color-background-brand) 6%, transparent) 23px 24px),
      color-mix(in srgb, var(--color-content-utility-success, #15803d) 8%, var(--color-background-elevation-raised));
  }
  .cbf-summary__map-cap { margin: var(--spacing-200) 0 0; font-style: italic; color: var(--color-content-default-tertiary); }

  .cbf-summary :global(.cbf-doc-link) { color: var(--color-content-link); text-decoration: underline; }
</style>
