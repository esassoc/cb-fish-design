---
/*
 * cbf-libmvp-demo-controls — the two demo controls for the v1 LIB entry screen
 * (/lib-mvp). A FORK of cbf-lib-demo-controls (behind /lib-entry), on the
 * lib-mvp-demo and lib-mvp-review keys, so resetting or clearing one prototype
 * never touches the other in the same tab.
 *
 * WHAT IT IS
 * PROTOTYPE SCAFFOLDING, not product. It lives inside the dashed role-switch
 * strip for exactly that reason: everything in that strip is a device for the
 * person DEMOING the screen, and nothing in it should ever be mistaken for a
 * control CBFish would ship.
 *
 *   Reset to sample data   the seeded budget back exactly as it ships — typed
 *                          edits gone, the COR's marks gone, the role lens kept.
 *   Clear all entries      the screen a vendor starting from nothing sees — no
 *                          cost lines, no indirect rate, a draft review with no
 *                          marks (the first-run empty state).
 *
 * HOW IT WORKS
 * Both are a flag plus a reload — see the module comment in
 * src/data/lib-mvp-demo.mjs. Both drop every stored working copy of the lines
 * (each sessionStorage key under LINES_KEY_PREFIX — the contract LIB and every
 * child LIB). Reset drops the stored review and the blank flag; Clear stores a
 * blank draft review and SETS the blank flag. Nothing here reaches into a
 * sibling component: each surface asks isBlank() on its own mount.
 *
 * THE REVEAL GATE (the is:global block at the bottom)
 * The seeded budget is server-rendered, so a cleared page would paint the mock
 * data and then wipe it a frame later. The inline script sets
 * `<html data-cbf-libmvp-blank>` BEFORE first paint, the gate hides every
 * surface that opted in with `data-libmvp-surface` while it is set, and the
 * mount pass lifts it with `data-cbf-libmvp-ready` once they have cleared
 * themselves. A timeout in the inline script lifts it regardless, so a JS
 * failure can never leave the page invisible.
 *
 * bcn-lego-checked: the controls ARE legos — esa-button for both actions,
 * esa-confirm-dialog for the "are you sure" (it owns its own backdrop, focus
 * trap, Esc and the confirm/cancel event pair, which is the whole of what this
 * needs), esa-badge for the cleared-state marker, and the `cluster` layout
 * primitive for the row. No esa-* lego exists for "reset the prototype" and none
 * should — this is scaffolding for a demo, so the only thing this file owns is
 * which legos to line up and the reveal gate above, which is page state and not
 * a UI primitive at all. Beacon is not cloned on this machine.
 */
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import { BLANK_KEY } from '../../data/lib-mvp-demo.mjs';
---

<!-- Before first paint, so a cleared page never flashes the seeded budget.
     Inline on purpose: a module script is deferred, and deferred is too late. -->
<script is:inline define:vars={{ BLANK_KEY }}>
  (() => {
    let blank = false;
    try {
      blank = window.sessionStorage?.getItem(BLANK_KEY) === '1';
    } catch {
      /* private mode / no storage — the seeded budget renders as normal */
    }
    if (!blank) return;
    document.documentElement.dataset.cbfLibmvpBlank = '';
    // Safety net. If the mount scripts never run, the page must still be usable
    // rather than held invisible by a gate nothing is left to lift.
    window.setTimeout(() => {
      document.documentElement.dataset.cbfLibmvpReady = '';
    }, 2000);
  })();
</script>

<div class="cluster" data-gap="2xs" data-libmvp-demo>
  <span data-demo-cleared hidden>
    <EsaBadge value="Cleared — no sample data" variant="warning" size="sm" />
  </span>
  <span data-demo-reset>
    <EsaButton size="sm" variant="secondary" appearance="outline" icon="rotate-ccw">
      Reset to sample data
    </EsaButton>
  </span>
  <span data-demo-clear>
    <EsaButton size="sm" variant="secondary" appearance="soft" icon="trash-2">
      Clear all entries
    </EsaButton>
  </span>
</div>

<!-- Both actions throw away whatever was typed, so both ask first — the message
     says what is about to be lost, which is the fact that decides it. -->
<esa-confirm-dialog data-libmvp-demo-confirm cancel-label="Keep what's on screen"></esa-confirm-dialog>

<script>
  import '@esa/ecology/esa-confirm-dialog';
  import { BLANK_KEY, isBlank } from '../../data/lib-mvp-demo.mjs';
  import { REVIEW_KEY, blankReview } from '../../data/lib-mvp-review.mjs';
  import { LINES_KEY_PREFIX } from '../../lib/lib-mvp-view';

  const root = document.querySelector<HTMLElement>('[data-libmvp-demo]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const dialog = document.querySelector<HTMLElement & {
      heading: string;
      message: string;
      variant: string;
      confirmLabel: string;
      show: () => void;
    }>('[data-libmvp-demo-confirm]');

    const ACTIONS: Record<string, any> = {
      reset: {
        heading: 'Reset to the sample budget?',
        message:
          'You’ll lose every line typed, added or deleted, the indirect rate pick, and any '
          + 'review marks made as the BPA COR. The sample budget comes back as it ships.',
        confirmLabel: 'Reset the budget',
        variant: 'warning',
      },
      clear: {
        heading: 'Clear every entry?',
        message:
          'You’ll lose every cost line, subcontract LIB, the indirect rate and the BPA review, '
          + 'and see the budget as a new vendor does. “Reset to sample data” brings the sample back.',
        confirmLabel: 'Clear the budget',
        variant: 'danger',
      },
    };

    let pending = '';

    /** Every stored working copy of the lines — the contract LIB and each child. */
    const dropStoredLines = (store: Storage) => {
      const doomed: string[] = [];
      for (let i = 0; i < store.length; i++) {
        const k = store.key(i);
        if (k && k.startsWith(LINES_KEY_PREFIX)) doomed.push(k);
      }
      doomed.forEach((k) => store.removeItem(k));
    };

    /** Both actions are stored state plus a reload — see src/data/lib-mvp-demo.mjs. */
    const apply = (kind: string) => {
      try {
        const store = window.sessionStorage;
        if (store) {
          dropStoredLines(store);
          if (kind === 'clear') {
            store.setItem(REVIEW_KEY, JSON.stringify(blankReview()));
            store.setItem(BLANK_KEY, '1');
          } else {
            store.removeItem(REVIEW_KEY);
            store.removeItem(BLANK_KEY);
          }
        }
      } catch {
        /* a blocked store means the reload just re-renders the seeded budget */
      }
      window.location.reload();
    };

    const ask = (kind: string) => {
      const a = ACTIONS[kind];
      if (!a) return;
      if (!dialog) { apply(kind); return; }
      pending = kind;
      dialog.heading = a.heading;
      dialog.message = a.message;
      dialog.confirmLabel = a.confirmLabel;
      dialog.variant = a.variant;
      dialog.show();
    };

    root.addEventListener('click', (e: Event) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-demo-reset]')) ask('reset');
      else if (t.closest('[data-demo-clear]')) ask('clear');
    });

    dialog?.addEventListener('confirm', () => {
      if (pending) apply(pending);
      pending = '';
    });
    dialog?.addEventListener('cancel', () => { pending = ''; });

    // ── The cleared state, and lifting the reveal gate ──────────────────────
    // The badge says which state the screen is in, because "no lines" and "the
    // page has not finished loading" look identical for a moment otherwise.
    const blank = isBlank();
    const cleared = root.querySelector<HTMLElement>('[data-demo-cleared]');
    if (cleared) cleared.hidden = !blank;

    if (blank) {
      // DOMContentLoaded, not this script's own frame: every surface clears
      // itself in its own deferred mount script, and they all run before it.
      const reveal = () => {
        document.documentElement.dataset.cbfLibmvpReady = '';
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(reveal), { once: true });
      } else {
        requestAnimationFrame(reveal);
      }
    }
  }
</script>

<style is:global>
  /* ── The reveal gate ──────────────────────────────────────────────────────
     Page state, not component styling, which is why it is global and keyed off
     two attributes on <html>: active only on a page that set
     data-cbf-libmvp-blank before paint, and only until the mount pass sets
     data-cbf-libmvp-ready. A surface opts in with `data-libmvp-surface` on its
     root. Visibility rather than display, so nothing reflows when it lifts. */
  html[data-cbf-libmvp-blank]:not([data-cbf-libmvp-ready]) [data-libmvp-surface] {
    visibility: hidden;
  }
</style>
