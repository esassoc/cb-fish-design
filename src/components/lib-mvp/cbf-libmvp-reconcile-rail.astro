---
// cbf-libmvp-reconcile-rail — the reconciliation rail on the v1 Line Item Budget
// entry screen (/lib-mvp). A FORK of cbf-lib-reconcile-rail (behind /lib-entry),
// cut to docs/lib-mvp-scope.md. It is the thing the vendor watches while they
// type: the running total against the Contract Value, the direct / indirect
// split, the nine submit gates, the three advisories, and the Submit / Resubmit
// action they own. It sticks beside the cost grid and must never disagree with it.
//
// ── IT RENDERS, IT NEVER JUDGES ─────────────────────────────────────────────
// The gates and advisories are computed by the grid (`submitChecksFor` /
// `advisoriesFor` in src/data/lib-mvp.mjs, over the live lines) and arrive whole
// on EVENTS.totals. The rail paints those arrays GENERICALLY — one row per entry,
// keyed by `key`, label / detail / pass straight from the entry — so a gate added
// to the engine shows up here with no change. It does not recompute a gate, and
// it does not count anything the arrays don't already say. In production the
// totals come from the server; the rail cannot disagree with the stored budget.
//
// ── EVENT CONTRACT (on `document`) ──────────────────────────────────────────
// LISTENS
//   EVENTS.totals    detail: { budget, total, direct, indirect, indirectBase,
//                              remaining, pctOfValue, checks, advisories }
//     Only `budget === 'main'` is the contract LIB; a child LIB's totals are
//     ignored (the parent's `children` gate already speaks for them).
//     checks     = submitChecksFor() → [{ key, label, pass, detail, ids }]
//     advisories = advisoriesFor()   → [{ key, label, detail, ids }]; an advisory
//                  with no ids does not apply and is hidden.
//   EVENTS.indirect  detail: { config: { rateId } } — resolved here with
//     withResolvedIndirect for the rate / base line under "Indirect". The dollars
//     still arrive on EVENTS.totals, which the grid re-fires after a pick.
//   EVENTS.review    detail: { review } — status badge, the button's label
//     (Submit vs Resubmit) and whether the vendor may submit at all.
// FIRES
//   EVENTS.review, only from the Submit click: submitReview → saveReview →
//   fireReview. That is the vendor's one action; every other surface repaints
//   from the broadcast.
//
// Everything is SERVER-RENDERED first from priceLines() / submitChecksFor() /
// advisoriesFor() with the seeded review, so the rail is right before a byte of
// script runs; the listeners only move what is already on screen.
//
// bcn-lego-checked: every primitive here is a lego — esa-progress-bar is the
// proportional readout, esa-badge the status and fail markers, esa-button the
// submit action, esa-stat the headline total, esa-icon the pass / fail glyph
// (checked the full ecology catalog: no esa-checklist / esa-gate / esa-summary-
// rail exists, and Beacon has no ui- equivalent — its budget reconciliation is an
// AG Grid footer, not a rail). What this file owns is composition only: the sticky
// shell, the ledger rows, and the row-state toggling. Status is carried by the
// glyph + an inline warning tint + an esa-badge — never a colored left border.
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaProgressBar from '@esa/ecology/esa-progress-bar.astro';
import {
  contract,
  costLines,
  indirectConfig,
  INDIRECT_BASES,
  SUBAWARD_CAP,
  priceLines,
  submitChecksFor,
  advisoriesFor,
  usd,
  pct,
} from '../../data/lib-mvp.mjs';
import {
  seedReview,
  openRequiredFlags,
  vendorCanEdit,
  statusBadge,
  reviewMeta,
} from '../../data/lib-mvp-review.mjs';

interface Props {
  /** Rail heading. */
  title?: string;
  /** One-line context under the heading. */
  lede?: string;
}
const {
  title = 'Reconciliation',
  lede = `Contract ${contract.number} · ${contract.fiscalYear}`,
} = Astro.props;

// The same calls the grid makes, so the first paint and the first event agree.
const review = seedReview();
const { totals } = priceLines(costLines, indirectConfig);
const checks = submitChecksFor(costLines, indirectConfig, { openRequired: openRequiredFlags(review) });
const advisories = advisoriesFor(costLines, indirectConfig);
const blocked = checks.filter((c) => !c.pass);
const canSubmit = blocked.length === 0 && vendorCanEdit(review);
const badge = statusBadge(review);

// A returned budget is RESUBMITTED — "Submit" again would pretend the round trip
// never happened.
const submitLabel = review.status === 'returned' ? 'Resubmit line item budget' : 'Submit line item budget';

// The meter clamps at 100% (a bar cannot show 104%) while the text states the
// overage. Rounded to a tenth: esa-progress-bar prints its value verbatim.
const isOver = totals.total > contract.contractValue;
const meterValue = Math.round(Math.max(0, Math.min(100, totals.pctOfValue * 100)) * 10) / 10;
const remainingText = isOver
  ? `${usd(Math.abs(totals.remaining))} over the Contract Value`
  : `${usd(totals.remaining)} remaining`;

// Kept byte-identical to the client's rateNote() below.
const base = INDIRECT_BASES[indirectConfig.base];
const rateNote = indirectConfig.rateId
  ? `${indirectConfig.label} · ${base?.short ?? ''}${indirectConfig.subawardCap ? `, first ${usd(SUBAWARD_CAP)} of each subaward` : ''}`
  : 'No indirect rate selected';

const reasonText = (n: number) =>
  n === 0
    ? 'All checks clear. Submitting sends the budget to the COR and makes it read-only while they review it.'
    : `${n} check${n === 1 ? '' : 's'} still ${n === 1 ? 'stands' : 'stand'} between you and submitting.`;
---
<aside
  class:list={['cbf-libmvp-rail', 'stack', isOver && 'is-over']}
  data-gap="lg"
  data-libmvp-rail
  data-libmvp-surface
  aria-label="Budget reconciliation and submit checklist"
>
  <header class="stack" data-gap="3xs">
    <div class="repel" data-gap="sm">
      <h2 class="typography-heading-md">{title}</h2>
      {/* One badge per status, server-rendered; the script reveals the current
          one rather than rewriting a lego's variant class. */}
      <span class="cbf-libmvp-rail__status">
        {['draft', 'in-review', 'returned', 'approved'].map((s) => {
          const b = statusBadge({ status: s });
          return (
            <span data-rail-status={s} hidden={b.value !== badge.value}>
              <EsaBadge value={b.value} variant={b.variant} size="sm" />
            </span>
          );
        })}
      </span>
    </div>
    <p class="cbf-libmvp-rail__lede typography-body-sm">{lede}</p>
  </header>

  {/* ── Running total vs the Contract Value ──────────────────────────────── */}
  {/* esa-stat forwards no extra attrs, so the live-update hook rides the wrapper. */}
  <div class="cbf-libmvp-rail__total" data-stat-total>
    <EsaStat
      value={usd(totals.total)}
      label="Line item budget total"
      sub={`${pct(totals.pctOfValue)} of the ${usd(contract.contractValue)} Contract Value`}
    />
  </div>

  <div class="stack" data-gap="xs" data-meter>
    <EsaProgressBar
      value={meterValue}
      variant={isOver ? 'danger' : 'primary'}
      size="lg"
      label="Committed against Contract Value"
    />
    <p class="cbf-libmvp-rail__remaining typography-body-sm" data-remaining>{remainingText}</p>
  </div>

  {/* ── Direct / indirect split ──────────────────────────────────────────── */}
  <dl class="cbf-libmvp-rail__ledger stack" data-gap="xs">
    <div class="repel" data-gap="sm">
      <dt class="typography-body-sm">Direct costs</dt>
      <dd class="cbf-libmvp-rail__amount typography-body-sm" data-ledger="direct">{usd(totals.direct)}</dd>
    </div>
    <div class="repel" data-gap="sm">
      <dt class="typography-body-sm">
        <span>Indirect at <span data-ledger="indirect-rate">{pct(indirectConfig.rate)}</span></span>
        <span class="cbf-libmvp-rail__ledger-note typography-body-sm">
          <span data-ledger="indirect-rate-note">{rateNote}</span>
          <span aria-hidden="true"> · </span>
          <span data-ledger="indirect-base">{usd(totals.indirectBase)} base</span>
        </span>
      </dt>
      <dd class="cbf-libmvp-rail__amount typography-body-sm" data-ledger="indirect">{usd(totals.indirect)}</dd>
    </div>
    <div class="repel cbf-libmvp-rail__ledger-rule" data-gap="sm">
      <dt class="typography-body-sm">Contract Value</dt>
      <dd class="cbf-libmvp-rail__amount typography-body-sm">{usd(contract.contractValue)}</dd>
    </div>
  </dl>

  {/* ── The submit gate ──────────────────────────────────────────────────── */}
  <section class="cbf-libmvp-rail__gate stack" data-gap="sm" aria-label="Submit checklist">
    <div class="repel" data-gap="sm">
      <h3 class="typography-title">Before you submit</h3>
      <span class="cbf-libmvp-rail__count typography-body-sm" role="status" data-gate-count>
        {checks.length - blocked.length} of {checks.length} clear
      </span>
    </div>

    <ul class="cbf-libmvp-rail__list stack" data-gap="2xs" data-checks>
      {checks.map((c) => (
        <li
          class:list={['cbf-libmvp-rail__check', 'repel', c.pass ? 'is-pass' : 'is-fail']}
          data-gap="sm"
          data-check={c.key}
        >
          <span class="cbf-libmvp-rail__body">
            {/* Both glyphs ship server-rendered; the row class reveals one. */}
            <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--pass">
              <EsaIcon name="circle-check" size="sm" label="Clear" />
            </span>
            <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--fail">
              <EsaIcon name="circle-alert" size="sm" label="Needs attention" />
            </span>
            <span class="cbf-libmvp-rail__text">
              <span class="cbf-libmvp-rail__label typography-body-sm" data-row-label>{c.label}</span>
              <span class="cbf-libmvp-rail__detail typography-body-sm" data-row-detail>{c.detail}</span>
            </span>
          </span>
          {/* Badge on failing rows only — a second chip on every passing row
              would be decoration, not information. */}
          <span class="cbf-libmvp-rail__badge">
            <EsaBadge value="Needs fix" variant="warning" />
          </span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── Noted for the COR — the three advisories, which block nothing ───── */}
  <section
    class="cbf-libmvp-rail__notes stack"
    data-gap="sm"
    aria-label="Noted for the COR"
    data-advisories
    hidden={!advisories.some((a) => a.ids.length > 0)}
  >
    <div class="stack" data-gap="3xs">
      <h3 class="typography-title">Noted for the COR</h3>
      <p class="cbf-libmvp-rail__detail typography-body-sm">These don’t block submitting. The COR sees each one.</p>
    </div>
    <ul class="cbf-libmvp-rail__list stack" data-gap="2xs" data-advisory-list>
      {advisories.map((a) => (
        <li class="cbf-libmvp-rail__note" data-advisory={a.key} hidden={a.ids.length === 0}>
          <span class="cbf-libmvp-rail__body">
            <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--info">
              <EsaIcon name="info" size="sm" label="Noted" />
            </span>
            <span class="cbf-libmvp-rail__text">
              <span class="cbf-libmvp-rail__label typography-body-sm" data-row-label>{a.label}</span>
              <span class="cbf-libmvp-rail__detail typography-body-sm" data-row-detail>{a.detail}</span>
            </span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  {/* ── The COR reads this rail; they do not act on it. Return and approve
       belong to the review panel, beside the marks that justify them. ── */}
  <p class="cbf-libmvp-rail__cor typography-body-sm">
    You’re viewing the vendor’s reconciliation. Return or approve the budget from your review,
    next to the marks you made.
  </p>

  {/* ── The submit action the vendor owns ────────────────────────────────── */}
  <div class="cbf-libmvp-rail__submit stack" data-gap="xs">
    <EsaButton
      variant="primary"
      size="lg"
      disabled={!canSubmit}
      data-submit
      aria-describedby="cbf-libmvp-rail-reason"
    >
      {submitLabel}
    </EsaButton>

    <p class="cbf-libmvp-rail__reason typography-body-sm" id="cbf-libmvp-rail-reason" data-submit-reason>
      {reasonText(blocked.length)}
    </p>

    {/* Submitting emails the COR in v1 — said up front, so the vendor knows
        someone is told, and who. */}
    <p class="cbf-libmvp-rail__reason typography-body-sm" data-submit-email>
      {reviewMeta.reviewer}, the BPA COR, gets an email when you submit.
    </p>
  </div>

  {/* Cloned for any check or advisory key the server did not render, so the
      lists stay generic over whatever the engine sends. */}
  <template data-check-tpl>
    <li class="cbf-libmvp-rail__check repel is-fail" data-gap="sm" data-check="">
      <span class="cbf-libmvp-rail__body">
        <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--pass">
          <EsaIcon name="circle-check" size="sm" label="Clear" />
        </span>
        <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--fail">
          <EsaIcon name="circle-alert" size="sm" label="Needs attention" />
        </span>
        <span class="cbf-libmvp-rail__text">
          <span class="cbf-libmvp-rail__label typography-body-sm" data-row-label></span>
          <span class="cbf-libmvp-rail__detail typography-body-sm" data-row-detail></span>
        </span>
      </span>
      <span class="cbf-libmvp-rail__badge">
        <EsaBadge value="Needs fix" variant="warning" />
      </span>
    </li>
  </template>
  <template data-advisory-tpl>
    <li class="cbf-libmvp-rail__note" data-advisory="">
      <span class="cbf-libmvp-rail__body">
        <span class="cbf-libmvp-rail__mark cbf-libmvp-rail__mark--info">
          <EsaIcon name="info" size="sm" label="Noted" />
        </span>
        <span class="cbf-libmvp-rail__text">
          <span class="cbf-libmvp-rail__label typography-body-sm" data-row-label></span>
          <span class="cbf-libmvp-rail__detail typography-body-sm" data-row-detail></span>
        </span>
      </span>
    </li>
  </template>
</aside>

<script>
  // Live reconciliation. The grid owns the numbers and the gate and broadcasts
  // them; this rail only re-renders what it already painted on the server.
  // Formatting comes from the shared data module, so the rail and the grid can
  // never print the same dollar two different ways.
  import {
    contract,
    EVENTS,
    INDIRECT_BASES,
    SUBAWARD_CAP,
    withResolvedIndirect,
    usd,
    pct,
  } from '../../data/lib-mvp.mjs';
  import {
    loadReview,
    saveReview,
    submitReview,
    fireReview,
    vendorCanEdit,
    statusBadge,
    reviewMeta,
  } from '../../data/lib-mvp-review.mjs';
  import { blankConfig } from '../../data/lib-mvp-demo.mjs';

  interface Row { key: string; label: string; detail: string; pass?: boolean; ids?: string[] }
  interface Totals {
    budget?: string;
    total: number;
    direct: number;
    indirect: number;
    indirectBase: number;
    remaining: number;
    pctOfValue: number;
    checks?: Row[];
    advisories?: Row[];
  }

  const rail = document.querySelector<HTMLElement>('[data-libmvp-rail]');
  if (rail) init(rail);

  function init(rail: HTMLElement) {
    const text = (sel: string, value: string, scope: ParentNode = rail) => {
      const el = scope.querySelector(sel);
      if (el) el.textContent = value;
    };

    /* How many rows of the last gate the grid sent are failing — the ONLY gate
       input to whether Submit is open. Seeded from the server render. */
    let failed = rail.querySelectorAll('[data-checks] [data-check].is-fail').length;
    let review: any = loadReview();

    // ── the money band ──────────────────────────────────────────────────────
    const applyTotals = (d: Totals) => {
      const over = d.total > contract.contractValue;
      rail.classList.toggle('is-over', over);
      text('[data-stat-total] .esa-stat__value', usd(d.total));
      text('[data-stat-total] .esa-stat__sub', `${pct(d.pctOfValue)} of the ${usd(contract.contractValue)} Contract Value`);

      // esa-progress-bar is a static server snapshot; driving the fill, the
      // printed value, aria and the variant class is how one is animated.
      const bar = rail.querySelector<HTMLElement>('[data-meter] .esa-progress-bar');
      const shown = Math.round(Math.max(0, Math.min(100, d.pctOfValue * 100)) * 10) / 10;
      const fill = bar?.querySelector<HTMLElement>('.esa-progress-bar__fill');
      if (fill) fill.style.width = `${shown}%`;
      const valueText = bar?.querySelector('.esa-progress-bar__value');
      if (valueText) valueText.textContent = `${shown}%`;
      if (bar) {
        bar.setAttribute('aria-valuenow', String(Math.round(shown)));
        bar.classList.toggle('esa-progress-bar--primary', !over);
        bar.classList.toggle('esa-progress-bar--danger', over);
      }
      text('[data-remaining]', over ? `${usd(Math.abs(d.remaining))} over the Contract Value` : `${usd(d.remaining)} remaining`);
      text('[data-ledger="direct"]', usd(d.direct));
      text('[data-ledger="indirect"]', usd(d.indirect));
      if (typeof d.indirectBase === 'number') text('[data-ledger="indirect-base"]', `${usd(d.indirectBase)} base`);
    };

    // ── generic rows: find by key, or clone the template ──────────────────
    const rowFor = (listSel: string, tplSel: string, attr: string, key: string) => {
      const list = rail.querySelector<HTMLElement>(listSel);
      let row = list?.querySelector<HTMLElement>(`[${attr}="${CSS.escape(key)}"]`) ?? null;
      if (!row && list) {
        const tpl = rail.querySelector<HTMLTemplateElement>(tplSel);
        row = (tpl?.content.firstElementChild?.cloneNode(true) as HTMLElement) ?? null;
        if (row) {
          row.setAttribute(attr, key);
          list.append(row);
        }
      }
      return row;
    };

    const applyChecks = (checks: Row[]) => {
      const keys = new Set(checks.map((c) => c.key));
      /* A row the engine stopped sending no longer applies. */
      rail.querySelectorAll<HTMLElement>('[data-checks] [data-check]').forEach((r) => {
        r.hidden = !keys.has(r.dataset.check ?? '');
      });
      checks.forEach((c) => {
        const row = rowFor('[data-checks]', '[data-check-tpl]', 'data-check', c.key);
        if (!row) return;
        row.hidden = false;
        row.classList.toggle('is-pass', !!c.pass);
        row.classList.toggle('is-fail', !c.pass);
        text('[data-row-label]', c.label, row);
        text('[data-row-detail]', c.detail, row);
      });
      failed = checks.filter((c) => !c.pass).length;
      text('[data-gate-count]', `${checks.length - failed} of ${checks.length} clear`);
    };

    const applyAdvisories = (advisories: Row[]) => {
      rail.querySelectorAll<HTMLElement>('[data-advisory-list] [data-advisory]').forEach((r) => { r.hidden = true; });
      let any = false;
      advisories.forEach((a) => {
        const row = rowFor('[data-advisory-list]', '[data-advisory-tpl]', 'data-advisory', a.key);
        if (!row) return;
        const live = (a.ids ?? []).length > 0;
        row.hidden = !live;
        any = any || live;
        text('[data-row-label]', a.label, row);
        text('[data-row-detail]', a.detail, row);
      });
      const box = rail.querySelector<HTMLElement>('[data-advisories]');
      if (box) box.hidden = !any;
    };

    // ── status and the submit action ────────────────────────────────────────
    const applyReview = () => {
      const label = statusBadge(review).value;
      rail.querySelectorAll<HTMLElement>('[data-rail-status]').forEach((el) => {
        el.hidden = statusBadge({ status: el.dataset.railStatus }).value !== label;
      });
      text(
        'button[data-submit] .esa-button__label',
        review.status === 'returned' ? 'Resubmit line item budget' : 'Submit line item budget',
      );
      refreshSubmit();
    };

    const refreshSubmit = () => {
      const editable = vendorCanEdit(review);
      const open = failed === 0 && editable;
      const btn = rail.querySelector<HTMLButtonElement>('button[data-submit]');
      if (btn) {
        btn.disabled = !open;
        btn.closest('.esa-button')?.classList.toggle('esa-button--disabled', !open);
      }
      /* Once it's with the COR or approved, the gate is not what holds it. */
      text(
        '[data-submit-reason]',
        !editable
          ? review.status === 'approved'
            ? 'BPA approved this budget. It’s locked — changes go through a contract change.'
            : `Submitted. ${reviewMeta.reviewer} is reviewing it; you can edit again if it’s returned.`
          : failed === 0
            ? 'All checks clear. Submitting sends the budget to the COR and makes it read-only while they review it.'
            : `${failed} check${failed === 1 ? '' : 's'} still ${failed === 1 ? 'stands' : 'stand'} between you and submitting.`,
      );
      const email = rail.querySelector<HTMLElement>('[data-submit-email]');
      if (email) email.hidden = !editable;
    };

    // ── the indirect line ───────────────────────────────────────────────────
    const rateNote = (cfg: any) => {
      const base = (INDIRECT_BASES as any)[cfg.base];
      return cfg.rateId
        ? `${cfg.label} · ${base?.short ?? ''}${cfg.subawardCap ? `, first ${usd(SUBAWARD_CAP)} of each subaward` : ''}`
        : 'No indirect rate selected';
    };

    document.addEventListener(EVENTS.totals, (event) => {
      const d = (event as CustomEvent<Totals>).detail;
      if (!d || (d.budget ?? 'main') !== 'main') return;
      applyTotals(d);
      if (Array.isArray(d.checks)) applyChecks(d.checks);
      if (Array.isArray(d.advisories)) applyAdvisories(d.advisories);
      refreshSubmit();
    });

    document.addEventListener(EVENTS.indirect, (event) => {
      const picked = (event as CustomEvent).detail?.config;
      if (!picked) return;
      const cfg: any = withResolvedIndirect({ ...blankConfig(), rateId: picked.rateId ?? null });
      text('[data-ledger="indirect-rate"]', pct(cfg.rate));
      text('[data-ledger="indirect-rate-note"]', rateNote(cfg));
    });

    document.addEventListener(EVENTS.review, (event) => {
      const next = (event as CustomEvent).detail?.review;
      if (!next) return;
      review = next;
      applyReview();
    });

    // The one action the vendor owns. v1 emails the COR on submit and resubmit.
    rail.querySelector<HTMLButtonElement>('button[data-submit]')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      if (btn.disabled || failed > 0 || !vendorCanEdit(review)) return;
      const again = review.status === 'returned';
      review = saveReview(submitReview(review));
      fireReview(review);
      const sb = document.querySelector('[data-snackbar]') as any;
      sb?.success?.call(
        sb,
        `${again ? 'Resubmitted' : 'Sent'} to the COR for review. ${reviewMeta.reviewer} gets an email.`,
        { duration: 5000 },
      );
    });

    applyReview();
  }
</script>

<style>
  /* Neutral surface, value-layered against the page — the rail is chrome, not a
     brand panel. The only saturated color in it is the primary submit button. */
  .cbf-libmvp-rail {
    position: sticky;
    /* Below the contract shell's sticky bar (cbf-contract-shell sets the height). */
    top: calc(var(--cbf-contract-bar-h, 0px) + var(--spacing-500));
    align-self: start;
    padding: var(--spacing-500);
    background: var(--color-background-elevation-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-200);
    /* The gate can outgrow a short viewport; the rail scrolls itself. */
    max-height: calc(100vh - var(--cbf-contract-bar-h, 0px) - var(--spacing-800));
    overflow-y: auto;
  }
