---
// cbf-lib-pi-documents — the working surface of /lib-pi-editing (CBF-8204): the
// contract's Documents, Workflow, and Email archive tabs, plus the two dialogs
// (edit properties / COR notification) and the client state machine that applies
// the three rule tiers from src/data/lib-pi-editing.mjs. The demo controls strip
// (cbf-doc-demo-controls) and rules panel (cbf-doc-rules-panel) live outside this
// component; the script here reads/decorates them via data hooks.
//
// bcn-lego-checked: ecology has NO table/grid lego (checked the full catalog —
// nothing renders a tabular surface; AG Grid is only warranted for sortable/
// filterable data grids, and these are two small static-shape tables whose CELLS
// the script mutates in place). The documents table + Document Approval grid are
// therefore semantic <table>s that faithfully port the real CBFish tables from
// the CBF-8204 screenshots. The email "envelope" card is likewise bespoke — no
// esa-* models a rendered email preview, and Beacon is not on this machine.
// Everything else IS a lego: tabs = esa-tab-layout; row menus = esa-dropdown-menu
// (trigger esa-icon-button); dialogs = esa-dialog; banners/warnings =
// esa-alert-box; replace-upload = esa-file-upload; Title/Description =
// esa-text-field/esa-textarea; SOW revision = esa-select; buttons = esa-button;
// empty archive = esa-empty-state; badges = esa-badge.
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import CbfContractSummary from './cbf-contract-summary.astro';
import {
  contract,
  documents,
  APPROVAL_COLS,
  CHECK_SVG,
  LAST_SOW_ACTION,
} from '../../data/lib-pi-editing.mjs';

const typeLabel = (d: (typeof documents)[number]) => (d.subtype ? `${d.type}: ${d.subtype}` : d.type);
---
<section class="cbf-lipd stack" data-gap="md" data-lipd>
  <!-- The editing-state banner lives in the Prototype settings bar (cbf-doc-demo-controls),
       not here — LIB/PI editing is a rare action and shouldn't occupy the contract. -->
  <!-- The full contract tab strip is built by the script from CONTRACT_TABS; only
       Documents & Workflow are enabled, and the two panels below are re-slotted to
       their live index (it shifts when a contract manager loses the COR-only tabs). -->
  <esa-tab-layout data-lipd-tabs active-index="0" size="md" appearance="underline">
    <!-- ═══════════════ Summary (enabled — default) ═══════════════ -->
    <div data-panel="summary" slot="panel-0" class="cbf-lipd__panel stack" data-gap="md">
      <CbfContractSummary />
    </div>

    <!-- ═══════════════ Documents (enabled) ═══════════════ -->
    <div data-panel="documents" slot="panel-9" class="cbf-lipd__panel stack" data-gap="md">
      <p class="cbf-lipd__intro">
        Use this area to store and manage document attachments relevant to this contract. When a
        replacement clears an approval the Contracting Officer's Representative (COR) has given, the
        COR is notified by email automatically.
      </p>

      <div class="cbf-lipd__toolbar repel">
        <span class="type-caption">
          Viewing {documents.length} of {contract.totalDocs} attached documents — filtered to
          Line Item Budget &amp; Property Inventory (the transmittal memo and design report are shown
          for contrast).
        </span>
        <span data-add-doc>
          <EsaButton color="primary" size="sm" icon="plus">Add…</EsaButton>
        </span>
      </div>

      <div class="cbf-lipd__doctable">
        <table class="cbf-doc-table">
          <thead>
            <tr>
              <th class="cbf-doc-table__menu-col"><span class="visually-hidden">Actions</span></th>
              <th>Title</th>
              <th>File</th>
              <th>Size</th>
              <th>Type</th>
              <th>Uploaded</th>
              <th>Uploaded by</th>
              <th>COR approval</th>
            </tr>
          </thead>
          <tbody>
            {documents.map((d) => (
              <tr data-doc-row={d.id}>
                <td class="cbf-doc-table__menu-col">
                  <esa-dropdown-menu data-doc-menu={d.id} position="below-start">
                    <EsaIconButton icon="menu" label={`Actions for ${d.title}`} size="sm" />
                  </esa-dropdown-menu>
                </td>
                <td class="cbf-doc-table__title" data-cell="title">{d.title}</td>
                <td><a class="cbf-doc-link" href="#" data-cell="file">{d.file}</a></td>
                <td class="cbf-num" data-cell="size">{d.size}</td>
                <td>{typeLabel(d)}</td>
                <td data-cell="uploaded">{d.uploaded}</td>
                <td data-cell="uploadedBy">{d.uploadedBy}</td>
                <td data-cell="cor">
                  {d.approvalNA ? (
                    <span class="cbf-na" title="COR approval does not apply to this document">N/A</span>
                  ) : d.approvals.cotr ? (
                    <span class="cbf-check" title={`Approved by the COR on ${d.approvals.cotr}`}><Fragment set:html={CHECK_SVG} /> {d.approvals.cotr}</span>
                  ) : (
                    <span class="cbf-none" title="Not yet approved by the COR">–</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══════════════ Workflow (enabled) ═══════════════ -->
    <div data-panel="workflow" slot="panel-5" class="cbf-lipd__panel stack" data-gap="md">
      <div class="cbf-lipd__status repel">
        <div class="cbf-lipd__status-facts">
          <span>Contract status: <strong>Issued</strong></span>
          <span>Last SOW action: <span>{LAST_SOW_ACTION}</span></span>
        </div>
        <div class="cbf-lipd__status-rev">
          <esa-select data-sow-rev label="SOW revision" size="sm"></esa-select>
        </div>
      </div>

      <h3 class="type-section-title">Document approval</h3>
      <div data-appr-readonly hidden>
        <EsaAlertBox variant="info" title="Original requisition — read-only">
          These approvals are the finalized record of the original contract requisition (SOW revision 1) and can't be changed. Switch to the CCR revision to work the current documents.
        </EsaAlertBox>
      </div>
      <div class="cbf-lipd__scroll">
        <table class="cbf-appr-table">
          <thead>
            <tr>
              <th>Required documents</th>
              <th>Attached date</th>
              {APPROVAL_COLS.map((c) => <th>{c.label}</th>)}
              <th>Last modified</th>
            </tr>
          </thead>
          <tbody data-appr-body></tbody>
        </table>
      </div>

      <h3 class="type-section-title">Workflow history</h3>
      <div class="cbf-lipd__scroll">
        <table class="cbf-hist-table">
          <thead>
            <tr><th>Date</th><th>Step</th><th>From</th><th>To</th><th>Document status</th></tr>
          </thead>
          <tbody data-history></tbody>
        </table>
      </div>
    </div>
  </esa-tab-layout>

  <!-- ── Edit-properties dialog (the real modal, with the supportive fixes) ── -->
  <esa-dialog data-edit-dialog size="lg" heading="View and edit the properties of this attachment">
    <div class="cbf-edit stack" data-gap="md">
      <p class="cbf-edit__lede">
        Replace the file or adjust its properties. Everything you don't change is kept exactly as
        it is — including approvals, unless you upload a new file.
      </p>

      <section class="cbf-edit__section">
        <span class="cbf-edit__num" aria-hidden="true">1</span>
        <div class="cbf-edit__fields">
          <div class="cbf-edit__specs">
            <div><span class="cbf-edit__label">Type</span><strong data-ed-type></strong></div>
            <div><span class="cbf-edit__label">Subtype</span><strong data-ed-subtype></strong></div>
            <div><span class="cbf-edit__label">WE ref</span><strong data-ed-weref></strong></div>
          </div>
          <p class="cbf-edit__guidance type-caption" data-ed-guidance></p>
        </div>
      </section>

      <section class="cbf-edit__section">
        <span class="cbf-edit__num" aria-hidden="true">2</span>
        <div class="cbf-edit__fields stack" data-gap="sm">
          <p class="cbf-edit__file">
            Current file: <a href="#" class="cbf-doc-link" data-ed-file></a>
            <span class="type-caption" data-ed-size></span>
          </p>
          <div data-ed-upload-slot>
            <esa-file-upload
              data-ed-upload
              label="Replace the file"
              accept=".xls,.xlsx,.doc,.docx,.pdf"
              max-size-mb="5"
            ></esa-file-upload>
          </div>
          <p class="type-caption">
            Uploading a new file replaces the current one when you save — the title, type, authors,
            and sharing below all stay put.
          </p>
          <p class="cbf-edit__newfile" data-ed-newfile hidden></p>
          <div data-ed-warning hidden>
            <EsaAlertBox variant="warning" title="Replacing this file clears its approvals">
              <span data-ed-warning-text></span>
            </EsaAlertBox>
          </div>
        </div>
      </section>

      <section class="cbf-edit__section">
        <span class="cbf-edit__num" aria-hidden="true">3</span>
        <div class="cbf-edit__fields stack" data-gap="sm">
          <esa-text-field data-ed-title label="Title"></esa-text-field>
          <esa-textarea data-ed-desc label="Description" rows="3"></esa-textarea>
          <div class="cbf-edit__specs">
            <div><span class="cbf-edit__label">Primary author</span><strong data-ed-author></strong></div>
            <div><span class="cbf-edit__label">Doc ID</span><strong data-ed-docid></strong></div>
          </div>
        </div>
      </section>

      <section class="cbf-edit__section">
        <span class="cbf-edit__num" aria-hidden="true">4</span>
        <div class="cbf-edit__fields">
          <div class="cbf-edit__specs">
            <div><span class="cbf-edit__label">View permission</span><strong data-ed-perm></strong></div>
          </div>
        </div>
      </section>

      <div class="cbf-edit__history">
        <div><span class="cbf-edit__label">Original upload</span><span data-ed-orig></span></div>
        <div><span class="cbf-edit__label">Original uploaded by</span><span data-ed-origby></span></div>
        <div><span class="cbf-edit__label">Last upload</span><span data-ed-last></span></div>
        <div><span class="cbf-edit__label">Last uploaded by</span><span data-ed-lastby></span></div>
      </div>
    </div>

    <div slot="footer" class="cbf-edit__footer">
      <span class="type-caption" data-save-hint>
        Nothing to save yet — replace the file or edit a property to enable Save.
      </span>
      <span data-ed-cancel><EsaButton color="secondary" appearance="outline">Cancel</EsaButton></span>
      <span data-ed-save><EsaButton color="primary" disabled>Save</EsaButton></span>
    </div>
  </esa-dialog>

  <!-- ── COR notification dialog (shows the email that was just sent) ── -->
  <esa-dialog data-email-dialog size="md" heading="The COR has been notified">
    <div class="stack" data-gap="sm">
      <p>
        Because <strong data-em-doc-title></strong> was already approved by the COR, replacing it
        cleared that approval — this email went out automatically:
      </p>
      <div data-em-preview></div>
    </div>
    <div slot="footer" class="cbf-edit__footer">
      <span data-em-close><EsaButton color="primary">Done</EsaButton></span>
    </div>
  </esa-dialog>

  <!-- Cloneable email envelope — the single source of the email-card markup. -->
  <template data-email-template>
    <article class="cbf-email">
      <header class="cbf-email__head">
        <div><span class="cbf-email__label">From</span><span data-em-from></span></div>
        <div><span class="cbf-email__label">To</span><span data-em-to></span></div>
        <div><span class="cbf-email__label">Sent</span><span data-em-sent></span></div>
        <div class="cbf-email__subject"><span class="cbf-email__label">Subject</span><strong data-em-subject></strong></div>
      </header>
      <div class="cbf-email__body">
        <p data-em-p1></p>
        <p data-em-p2></p>
        <p class="cbf-email__meta" data-em-meta></p>
      </div>
      <footer class="cbf-email__foot type-caption">
        System-generated notification · cbfish.org · do not reply
      </footer>
    </article>
  </template>
</section>

<script>
  import '@esa/ecology/esa-tab-layout';
  import '@esa/ecology/esa-dropdown-menu';
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import '@esa/ecology/esa-file-upload';
  import '@esa/ecology/esa-button-toggle';
  import {
    contract,
    documents,
    sowRevisions,
    AWARD_STATES,
    ROLES,
    ROLE_PEOPLE,
    APPROVAL_COLS,
    CHECK_SVG,
    editRule,
    contractTabsFor,
    WORKFLOW_ROWS,
    REV1_APPROVALS,
    SOW_REV2_APPROVALS,
    HISTORY_BY_REVISION,
  } from '../../data/lib-pi-editing.mjs';

  const root = document.querySelector<HTMLElement>('[data-lipd]');
  if (root) init(root);

  function init(root: HTMLElement) {
    // ── Live state ─────────────────────────────────────────────────────────
    const state = { award: 'pending', role: 'cm' };
    const docs = documents.map((d: any) => ({ ...d, approvals: { ...d.approvals }, resetInfo: null }));
    // Workflow History is per SOW revision; the replace flow prepends to the CCR (rev 2) trail.
    const historyByRev: Record<string, any[]> = {
      rev1: [...HISTORY_BY_REVISION.rev1],
      rev2: [...HISTORY_BY_REVISION.rev2],
    };
    let editingDoc: any = null;
    let pendingFile: { name: string; size: string } | null = null;
    let propsDirty = false;

    const $ = <T extends HTMLElement = HTMLElement>(sel: string, scope: ParentNode = document) =>
      scope.querySelector<T>(sel);
    const $$ = (sel: string, scope: ParentNode = document) =>
      Array.from(scope.querySelectorAll<HTMLElement>(sel));
    const docById = (id: string) => docs.find((d: any) => d.id === id);
    const roleLabel = () => ROLES.find((r: any) => r.value === state.role)!.label;
    const stateLabel = () => AWARD_STATES.find((s: any) => s.value === state.award)!.label;
    const actor = () => (ROLE_PEOPLE as any)[state.role];
    // Reflect the selected persona in the header's logged-in-user menu so "who is
    // viewing" is consistent everywhere. Replace only the button's text node so the
    // circle-user + chevron icons (and any impersonation markup) are left intact.
    const setNavUser = (name: string) => {
      const btn = document.querySelector('[data-omni-user]');
      if (!btn || btn.classList.contains('is-impersonating')) return;
      const textNode = Array.from(btn.childNodes).find(
        (n) => n.nodeType === Node.TEXT_NODE && n.textContent!.trim().length > 0,
      );
      if (textNode) textNode.textContent = ` ${name} `;
      else btn.insertBefore(document.createTextNode(` ${name} `), btn.lastElementChild);
    };
    const toast = (msg: string) => {
      const sb = $('[data-snackbar]') as any;
      (sb?.info ?? sb?.success)?.call(sb, msg, { duration: 4000 });
    };
    const fmtNow = () => {
      const d = new Date();
      let h = d.getHours();
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      const mins = String(d.getMinutes()).padStart(2, '0');
      return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()} ${h}:${mins} ${ampm}`;
    };
    const shortDate = () => {
      const d = new Date();
      return `${d.getMonth() + 1}/${d.getDate()}/${d.getFullYear()}`;
    };
    // Approval indicators carry an explanatory tooltip (native title) so the check /
    // dash aren't left to be guessed at. `who` names the approver for that column.
    const checkHtml = (date: string, who: string) =>
      `<span class="cbf-check" title="Approved by ${who} on ${date}">${CHECK_SVG} ${date}</span>`;
    const noneHtml = (who: string) =>
      `<span class="cbf-none" title="Not yet approved by ${who}">–</span>`;
    // Locked (read-only) check for the original requisition — muted, can't be changed.
    const lockedCheckHtml = (date: string, who: string) =>
      `<span class="cbf-check cbf-check--locked" title="Approved by ${who} on ${date} — original requisition (read-only)">${CHECK_SVG} ${date}</span>`;

    // ── Demo controls (in cbf-doc-demo-controls, outside this component) ────
    const awardToggle = $('[data-demo-award]') as any;
    const roleToggle = $('[data-demo-role]') as any;
    if (awardToggle) {
      awardToggle.options = AWARD_STATES.map((s: any) => ({ label: s.label, value: s.value }));
      awardToggle.value = state.award;
      awardToggle.addEventListener('change', () => { state.award = awardToggle.value; update(); });
    }
    if (roleToggle) {
      roleToggle.options = ROLES.map((r: any) => ({ label: r.label, value: r.value }));
      roleToggle.value = state.role;
      // Role also gates which contract tabs are visible, so rebuild the strip.
      roleToggle.addEventListener('change', () => { state.role = roleToggle.value; buildTabs(); update(); });
    }

    // ── Tabs — the full contract strip, mirroring the live app ───────────────
    // Only Documents & Workflow are enabled; the rest render disabled for context.
    // Contract managers don't see the COR-only tabs, so the visible set (and the two
    // live panels' slot indices) shift with the role — rebuild on every change.
    const tabsEl = $('[data-lipd-tabs]', root) as any;
    const summaryPanel = $('[data-panel="summary"]', root)!;
    const docPanel = $('[data-panel="documents"]', root)!;
    const wfPanel = $('[data-panel="workflow"]', root)!;
    let activeKey = 'summary';

    // Keep the trailing breadcrumb in step with the selected tab. (The current crumb
    // is the last .esa-breadcrumbs__item rendered by the breadcrumbs lego.)
    const CRUMB_LABEL: Record<string, string> = {
      summary: 'Contract Summary',
      workflow: 'Workflow',
      documents: 'Documents',
    };
    // Update ONLY the trailing crumb. The breadcrumbs lego marks every href-less
    // item as .esa-breadcrumbs__current, so target the last crumb explicitly rather
    // than the first match (which would clobber "Projects").
    const syncCrumb = () => {
      const items = document.querySelectorAll('.esa-breadcrumbs__item');
      const cur = items[items.length - 1]?.querySelector('.esa-breadcrumbs__current');
      if (cur && CRUMB_LABEL[activeKey]) cur.textContent = CRUMB_LABEL[activeKey];
    };

    const buildTabs = () => {
      const vis = contractTabsFor(state.role);
      tabsEl.tabs = vis.map((t: any) => ({ label: t.label, disabled: !t.panel }));
      const idx = (key: string) => vis.findIndex((t: any) => t.key === key);
      summaryPanel.setAttribute('slot', `panel-${idx('summary')}`);
      docPanel.setAttribute('slot', `panel-${idx('documents')}`);
      wfPanel.setAttribute('slot', `panel-${idx('workflow')}`);
      // Keep whichever enabled tab was active selected across the rebuild.
      tabsEl.activeIndex = vis.findIndex((t: any) => t.key === activeKey);
      syncCrumb();
    };
    tabsEl.addEventListener('tabchange', (e: any) => {
      const t = contractTabsFor(state.role)[e.detail.index];
      if (t?.panel) { activeKey = t.key; syncCrumb(); }
    });
    buildTabs();

    // ── SOW revision select — drives the approval grid + history per revision ──
    // rev1 = original requisition (locked); rev2 = the CCR (live, editable).
    const revSelect = $('[data-sow-rev]', root) as any;
    const currentRev = () => (revSelect?.value === 'rev1' ? 'rev1' : 'rev2');
    if (revSelect) {
      revSelect.options = sowRevisions;
      revSelect.value = 'rev2';
      revSelect.addEventListener('change', () => update());
    }

    // ── Dialog plumbing ─────────────────────────────────────────────────────
    const editDialog = $('[data-edit-dialog]', root) as any;
    const emailDialog = $('[data-email-dialog]', root) as any;
    const saveBtnWrap = $('[data-ed-save]', root)!;
    const saveBtn = saveBtnWrap.querySelector('button')!;
    const saveHint = $('[data-save-hint]', root)!;

    const setSaveEnabled = (enabled: boolean, hint: string) => {
      saveBtn.disabled = !enabled;
      saveBtnWrap.querySelector('.esa-button')?.classList.toggle('esa-button--disabled', !enabled);
      saveHint.textContent = hint;
    };

    /** esa-file-upload keeps its file list internal — swap in a fresh element. */
    const resetFileUpload = () => {
      const slot = $('[data-ed-upload-slot]', root)!;
      const old = slot.firstElementChild as HTMLElement;
      const fresh = document.createElement('esa-file-upload');
      fresh.setAttribute('data-ed-upload', '');
      fresh.setAttribute('label', 'Replace the file');
      fresh.setAttribute('accept', '.xls,.xlsx,.doc,.docx,.pdf');
      fresh.setAttribute('max-size-mb', '5');
      old.replaceWith(fresh);
    };

    const openEdit = (doc: any) => {
      editingDoc = doc;
      pendingFile = null;
      propsDirty = false;
      $('[data-ed-type]', root)!.textContent = doc.type;
      $('[data-ed-subtype]', root)!.textContent = doc.subtype || '—';
      $('[data-ed-weref]', root)!.textContent = doc.weRef || '—';
      $('[data-ed-guidance]', root)!.textContent = doc.guidance;
      $('[data-ed-file]', root)!.textContent = doc.file;
      $('[data-ed-size]', root)!.textContent = `(${doc.size})`;
      ($('[data-ed-title]', root) as any).value = doc.title;
      ($('[data-ed-desc]', root) as any).value = '';
      $('[data-ed-author]', root)!.textContent = doc.primaryAuthor;
      $('[data-ed-docid]', root)!.textContent = doc.docId;
      $('[data-ed-perm]', root)!.textContent = doc.viewPermission;
      $('[data-ed-orig]', root)!.textContent = doc.originalUpload;
      $('[data-ed-origby]', root)!.textContent = doc.originalUploadedBy;
      $('[data-ed-last]', root)!.textContent = doc.lastUpload;
      $('[data-ed-lastby]', root)!.textContent = doc.lastUploadedBy;
      $('[data-ed-newfile]', root)!.hidden = true;
      $('[data-ed-warning]', root)!.hidden = true;
      setSaveEnabled(false, 'Nothing to save yet — replace the file or edit a property to enable Save.');
      editDialog.show();
    };

    // New file chosen (composed change event from esa-file-upload, delegated so
    // the swapped-in fresh element needs no rebinding).
    root.addEventListener('change', (e: any) => {
      // Composed events retarget to the esa-file-upload host, which lives in the slot.
      const fromUpload = (e.target as HTMLElement).closest?.('[data-ed-upload-slot]');
      if (!fromUpload || !editingDoc) return;
      const files: File[] = e.detail?.files ?? [];
      if (!files.length) return;
      const f = files[0];
      pendingFile = { name: f.name, size: `${(f.size / 1024).toFixed(1)} KB` };
      const newfileEl = $('[data-ed-newfile]', root)!;
      newfileEl.hidden = false;
      newfileEl.textContent = `New file “${pendingFile.name}” will replace “${editingDoc.file}” when you save.`;
      const hadAny = Object.values(editingDoc.approvals).some(Boolean);
      const warnEl = $('[data-ed-warning]', root)!;
      warnEl.hidden = !hadAny;
      if (hadAny) {
        const parts: string[] = [];
        if (editingDoc.approvals.cotr)
          parts.push(`${contract.cor} (COR) approved this document on ${editingDoc.approvals.cotr} — they will be notified by email and asked to re-approve.`);
        const others = APPROVAL_COLS.filter((c: any) => c.key !== 'cotr' && editingDoc.approvals[c.key]);
        if (others.length)
          parts.push(`${others.map((c: any) => c.label).join(', ')} approval${others.length > 1 ? 's' : ''} will also be cleared.`);
        if (state.role === 'qc')
          parts.push('Since you are QC, your own QC approval is re-applied to your edit automatically.');
        $('[data-ed-warning-text]', root)!.textContent = parts.join(' ');
      }
      setSaveEnabled(true, 'Ready to save — the file is replaced and every specification is kept.');
    });

    // Title/description edits also arm Save (input events are composed).
    editDialog.addEventListener('input', (e: any) => {
      if (!editingDoc) return;
      if ((e.target as HTMLElement).closest('[data-ed-title], [data-ed-desc]')) {
        propsDirty = true;
        if (!pendingFile) setSaveEnabled(true, 'Ready to save your property changes.');
      }
    });

    const closeEdit = () => {
      editDialog.close();
      editingDoc = null;
      pendingFile = null;
      propsDirty = false;
      resetFileUpload();
    };

    $('[data-ed-cancel]', root)!.querySelector('button')!.addEventListener('click', closeEdit);
    saveBtn.addEventListener('click', () => {
      if (!editingDoc || saveBtn.disabled) return;
      const doc = editingDoc;
      const who = actor();
      const now = fmtNow();
      const newTitle = (($('[data-ed-title]', root) as any).value || '').trim();
      if (newTitle) doc.title = newTitle;

      if (pendingFile) {
        const hadCotr = !!doc.approvals.cotr;
        const prevCotrDate = doc.approvals.cotr;
        const hadAny = Object.values(doc.approvals).some(Boolean);
        doc.file = pendingFile.name;
        doc.size = pendingFile.size;
        doc.uploaded = now;
        doc.uploadedBy = who;
        doc.lastUpload = now;
        doc.lastUploadedBy = who;
        doc.approvals = { ec: null, cotr: null, qc: state.role === 'qc' ? shortDate() : null, fw: null };
        doc.resetInfo = hadAny ? { by: who, at: now } : null;

        historyByRev.rev2.unshift({
          date: now,
          step: 'DocumentReplaced',
          from: who,
          to: hadCotr ? contract.cor : '',
          docStatus:
            `${doc.type} - Replaced by ${roleLabel()} - COR Approval = NotSet` +
            (state.role === 'qc' ? '; QC Approval = Green (own edit)' : ''),
        });

        if (hadCotr) {
          const email = {
            from: 'donotreply@cbfish.org',
            to: `${contract.cor} (COR)`,
            sent: now,
            subject: `Action required: ${doc.type} replaced on Contract ${contract.number} (${contract.action})`,
            p1: `${who} (${roleLabel()}) replaced the file on “${doc.title}” while the SOW was ${stateLabel()}. All document specifications were retained.`,
            p2: `Your approval of this document (given ${prevCotrDate}) no longer applies. Please review the new file and re-approve it on the contract's Workflow tab.`,
            meta: `Contract ${contract.number} · ${contract.action} · ${doc.file}`,
            docTitle: doc.title,
          };
          showEmailDialog(email);
        } else {
          toast(`File replaced — all specifications for “${doc.title}” were retained.`);
        }
      } else if (propsDirty) {
        toast(`Properties of “${doc.title}” saved.`);
      }
      closeEdit();
      update();
    });

    // ── Email preview / archive ────────────────────────────────────────────
    const emailTemplate = $('[data-email-template]', root) as unknown as HTMLTemplateElement;
    const renderEmailCard = (email: any) => {
      const node = emailTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const set = (sel: string, text: string) => { node.querySelector(sel)!.textContent = text; };
      set('[data-em-from]', email.from);
      set('[data-em-to]', email.to);
      set('[data-em-sent]', email.sent);
      set('[data-em-subject]', email.subject);
      set('[data-em-p1]', email.p1);
      set('[data-em-p2]', email.p2);
      set('[data-em-meta]', email.meta);
      return node;
    };
    const showEmailDialog = (email: any) => {
      $('[data-em-doc-title]', root)!.textContent = email.docTitle;
      const preview = $('[data-em-preview]', root)!;
      preview.replaceChildren(renderEmailCard(email));
      emailDialog.show();
    };
    $('[data-em-close]', root)!.querySelector('button')!.addEventListener('click', () => emailDialog.close());

    // ── Context menus ───────────────────────────────────────────────────────
    // A disabled "Edit Properties" item can't show a native title tooltip (disabled
    // buttons don't receive hover). The lego early-returns on click for disabled
    // items, so we drop only the DOM `disabled` attribute — the item stays inert but
    // becomes hoverable — and attach the rule reason as its tooltip.
    const enhanceDisabledEdit = (menu: any) => {
      const panel = menu.shadowRoot?.querySelector('.esa-dropdown-menu__panel');
      if (!panel) return;
      const reason = menu.dataset.editReason;
      const editBtn = Array.from(panel.querySelectorAll('.esa-dropdown-menu__item')).find(
        (b: any) => b.textContent.trim().startsWith('Edit Properties'),
      ) as HTMLElement | undefined;
      if (editBtn && reason) {
        editBtn.removeAttribute('disabled');
        editBtn.setAttribute('aria-disabled', 'true');
        editBtn.setAttribute('title', reason);
      }
    };
    // Enhance whenever a menu opens (covers pointer and keyboard).
    $$('[data-doc-menu]').forEach((menu) => {
      new MutationObserver(() => {
        if (menu.hasAttribute('open')) setTimeout(() => enhanceDisabledEdit(menu), 0);
      }).observe(menu, { attributes: true, attributeFilter: ['open'] });
    });

    root.addEventListener('menu-action', (e: any) => {
      const menu = (e.target as HTMLElement).closest('[data-doc-menu]');
      if (!menu) return;
      const doc = docById(menu.getAttribute('data-doc-menu')!);
      if (!doc) return;
      switch (e.detail) {
        case 'view':
          toast('Viewing documents is unchanged by this story — out of scope for the prototype.');
          break;
        case 'copy':
          toast('Attachment link copied (prototype).');
          break;
        case 'delete':
          toast('Deleting attachments is unchanged by this story — and no longer the only way to swap a file.');
          break;
        case 'edit':
          if (editRule(state.award, state.role, doc.kind).allowed) openEdit(doc);
          break;
      }
    });

    $('[data-add-doc]')?.querySelector('button')?.addEventListener('click', () =>
      toast('Adding attachments is unchanged by this story — out of scope for the prototype.'),
    );

    // ── Rendering ───────────────────────────────────────────────────────────
    // The editing-state banner lives in the Prototype settings bar (outside `root`),
    // so it's queried against the whole document.
    const renderBanner = () => {
      const rule = editRule(state.award, state.role, 'lib');
      const which = rule.allowed ? 'allowed' : rule.tier === 3 ? 'locked' : 'restricted';
      $$('[data-banner]').forEach((b) => { b.hidden = b.dataset.banner !== which; });
      const active = $(`[data-banner="${which}"] [data-banner-text]`)!;
      active.textContent = `Acting as ${actor()} (${roleLabel()}) · CR/CCR state ${stateLabel()}. ${rule.reason}`;
    };

    const renderMenus = () => {
      docs.forEach((doc: any) => {
        const menu = $(`[data-doc-menu="${doc.id}"]`, root) as any;
        if (!menu) return;
        const rule = editRule(state.award, state.role, doc.kind);
        const locked = editRule(state.award, state.role, 'other'); // tier-3 lock applies to all actions
        // Stash the reason so a disabled Edit Properties gets an explanatory tooltip
        // (see enhanceDisabledEdit) — no separate "why?" menu item needed.
        menu.dataset.editReason = rule.allowed ? '' : rule.reason;
        menu.items = [
          { label: 'View Document', action: 'view' },
          { label: 'Edit Properties', action: 'edit', disabled: !rule.allowed },
          { label: 'Delete Attachment', action: 'delete', variant: 'danger', disabled: !locked.allowed },
          { label: 'Copy Attachment Link', action: 'copy' },
        ];
        if (menu.hasAttribute('open')) setTimeout(() => enhanceDisabledEdit(menu), 0);
      });
    };

    const corCellHtml = (doc: any) =>
      doc.approvalNA
        ? '<span class="cbf-na" title="COR approval does not apply to this document">N/A</span>'
        : doc.approvals.cotr
          ? checkHtml(doc.approvals.cotr, 'the COR')
          : doc.resetInfo
            ? '<span class="cbf-reappr" title="A replacement cleared the COR\'s approval — the COR has been notified and must re-approve">Needs re-approval</span>'
            : noneHtml('the COR');

    const renderDocRows = () => {
      docs.forEach((doc: any) => {
        const row = $(`[data-doc-row="${doc.id}"]`, root);
        if (!row) return;
        $('[data-cell="title"]', row)!.textContent = doc.title;
        $('[data-cell="file"]', row)!.textContent = doc.file;
        $('[data-cell="size"]', row)!.textContent = doc.size;
        $('[data-cell="uploaded"]', row)!.textContent = doc.uploaded;
        $('[data-cell="uploadedBy"]', row)!.textContent = doc.uploadedBy;
        $('[data-cell="cor"]', row)!.innerHTML = corCellHtml(doc);
      });
    };

    // Approvals for a workflow row under the selected revision. rev1 = the locked
    // original-requisition snapshot; rev2 = the CCR — live doc approvals (which the
    // replace flow clears) for attached rows, static full set for the SOW row.
    const approvalsFor = (row: any, rev: string) => {
      if (rev === 'rev1') return (REV1_APPROVALS as any)[row.key];
      if (row.docId) return docById(row.docId)!.approvals;
      return SOW_REV2_APPROVALS;
    };

    const renderApprovalGrid = () => {
      const rev = currentRev();
      const locked = rev === 'rev1';
      const readonlyNote = $('[data-appr-readonly]', root);
      if (readonlyNote) readonlyNote.hidden = !locked;

      const rows = WORKFLOW_ROWS.map((row: any) => {
        const appr = approvalsFor(row, rev);
        const doc = row.docId ? docById(row.docId) : null;
        // Only the live CCR (rev2) doc rows can be reset by a replacement.
        const reset = !locked && !!doc?.resetInfo;
        const attached = !locked && doc ? doc.uploaded : row.attached;
        const lastMod = !locked && doc ? doc.lastUpload : row.lastModified;

        const cells = APPROVAL_COLS.map((c: any) => {
          const date = appr[c.key];
          const html = date
            ? locked
              ? lockedCheckHtml(date, c.label)
              : checkHtml(date, c.label)
            : noneHtml(c.label);
          return `<td>${html}</td>`;
        }).join('');

        const flag = reset
          ? ' <span class="cbf-reappr" title="A replacement cleared the COR\'s approval — the COR has been notified and must re-approve">Needs re-approval</span>'
          : '';
        return (
          `<tr class="${reset ? 'is-reset' : ''}">` +
          `<th scope="row">${row.label}${flag}</th>` +
          `<td>${attached || '—'}</td>${cells}<td>${lastMod || '—'}</td>` +
          `</tr>`
        );
      });
      $('[data-appr-body]', root)!.innerHTML = rows.join('');
    };

    const renderHistory = () => {
      const tbody = $('[data-history]', root)!;
      tbody.replaceChildren(
        ...historyByRev[currentRev()].map((h: any) => {
          const tr = document.createElement('tr');
          [h.date, h.step, h.from, h.to, h.docStatus].forEach((v, i) => {
            const td = document.createElement('td');
            td.textContent = v;
            if (i === 4) td.className = 'cbf-hist-table__status';
            tr.appendChild(td);
          });
          if (h.step === 'DocumentReplaced') tr.classList.add('is-new');
          return tr;
        }),
      );
    };

    const update = () => {
      renderBanner();
      renderMenus();
      renderDocRows();
      renderApprovalGrid();
      renderHistory();
      setNavUser(actor());
    };

    update();
  }
</script>

<style>
  .cbf-lipd__panel { padding-block-start: var(--spacing-400); }
  .cbf-lipd__intro { margin: 0; color: var(--color-text-secondary); max-width: 90ch; }
  .cbf-lipd__toolbar { align-items: center; }
  /* Wide workflow tables scroll horizontally. NB: overflow-x:auto forces overflow-y
     to compute to auto too, so this ALSO clips vertically — fine for these tables
     (no popovers), but see .cbf-lipd__doctable below. */
  .cbf-lipd__scroll { overflow-x: auto; }
  /* The documents table carries a row-actions dropdown (esa-dropdown-menu positions
     absolutely and can't escape a clipping ancestor). It fits without horizontal
     scroll at desktop widths, so keep overflow visible here and let the menu spill
     over the rows below. Only narrow viewports fall back to horizontal scrolling. */
  .cbf-lipd__doctable { overflow: visible; }
  @media (max-width: 1024px) {
    .cbf-lipd__doctable { overflow-x: auto; }
  }

  /* ── Tables (ported from the CBFish contract-documents / workflow tables) ── */
  table { width: 100%; border-collapse: collapse; font-size: var(--type-size-200, 0.9375rem); }
  thead th {
    text-align: left;
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-surface-sunken, #f4f4f4);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-semibold);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  tbody td, tbody th[scope='row'] {
    padding: var(--spacing-300) var(--spacing-400);
    border-bottom: 1px solid var(--color-border-light, var(--color-border));
    vertical-align: top;
    text-align: left;
  }
  tbody th[scope='row'] { font-weight: var(--font-weight-semibold); white-space: nowrap; }
  .cbf-doc-table__menu-col { width: 48px; }
  .cbf-doc-table__title { font-weight: var(--font-weight-medium); }
  .cbf-doc-link { color: var(--color-primary); text-decoration: underline; }
  .cbf-hist-table__status { white-space: pre-line; color: var(--color-text-secondary); }

  /* --color-success (#22c55e) is a bright FILL, not a text color (~2.3:1 on white,
     fails WCAG). Use the -strong text token (#15803d, ~4.6:1) for the check + date. */
  .cbf-lipd :global(.cbf-check) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-100);
    color: var(--color-success-strong, #15803d);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }
  .cbf-lipd :global(.cbf-none) { color: var(--color-text-secondary); }
  /* Not-applicable approval (e.g. a design report doesn't route through the COR). */
  .cbf-lipd :global(.cbf-na) { color: var(--color-text-tertiary); font-style: italic; }
  /* Locked (read-only) approval — the original requisition. Muted grey to read as
     disabled; contrast minimums don't apply to disabled/inactive content. */
  .cbf-lipd :global(.cbf-check--locked) { color: var(--color-text-tertiary); font-weight: var(--font-weight-medium); }
  /* Solid burnt-amber chip with white text (#b45309 vs #fff ≈ 4.9:1, AA-compliant).
     The old pale-amber-on-pale-amber treatment was well under WCAG minimums. */
  .cbf-lipd :global(.cbf-reappr) {
    display: inline-block;
    margin-inline-start: var(--spacing-200);
    padding: 2px var(--spacing-200);
    border-radius: var(--radius-full, 9999px);
    background: var(--color-warning-strong, #b45309);
    color: var(--color-text-inverse, #fff);
    font-size: var(--type-size-100, 0.8125rem);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }
  .cbf-appr-table :global(tr.is-reset) th[scope='row'],
  .cbf-appr-table :global(tr.is-reset) td {
    background: color-mix(in srgb, var(--color-warning-strong, #b45309) 8%, var(--color-surface));
  }
  .cbf-hist-table :global(tr.is-new) td {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
  }

  /* ── Workflow status strip ── */
  .cbf-lipd__status { align-items: end; gap: var(--spacing-400); flex-wrap: wrap; }
  .cbf-lipd__status-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-500);
    color: var(--color-text-secondary);
  }
  .cbf-lipd__status-rev { min-width: 320px; }

  /* ── Edit dialog ── */
  .cbf-edit__lede { margin: 0; color: var(--color-text-secondary); }
  .cbf-edit__section {
    display: flex;
    gap: var(--spacing-400);
    padding-block: var(--spacing-300);
    border-top: 1px solid var(--color-border-light, var(--color-border));
  }
  .cbf-edit__num {
    flex: none;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full, 9999px);
    background: var(--color-surface-sunken, #f4f4f4);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-semibold);
  }
  .cbf-edit__fields { flex: 1; min-width: 0; }
  .cbf-edit__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--spacing-300) var(--spacing-500);
  }
  .cbf-edit__specs > div { display: flex; flex-direction: column; gap: 2px; }
  .cbf-edit__label {
    font-size: var(--type-size-100, 0.8125rem);
    color: var(--color-text-tertiary);
  }
  .cbf-edit__guidance { margin: var(--spacing-300) 0 0; color: var(--color-text-tertiary); }
  .cbf-edit__file { margin: 0; }
  .cbf-edit__newfile {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }
  .cbf-edit__history {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--spacing-300) var(--spacing-500);
    padding: var(--spacing-400);
    border-radius: var(--radius-200);
    background: var(--color-surface-sunken, #f4f4f4);
  }
  .cbf-edit__history > div { display: flex; flex-direction: column; gap: 2px; }
  .cbf-edit__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-300);
    width: 100%;
  }
  .cbf-edit__footer [data-save-hint] { margin-inline-end: auto; color: var(--color-text-tertiary); }

  /* ── Email envelope ── */
  .cbf-lipd :global(.cbf-email) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    background: var(--color-surface);
    overflow: hidden;
  }
  .cbf-lipd :global(.cbf-email__head) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-200) var(--spacing-500);
    padding: var(--spacing-400) var(--spacing-500);
    background: var(--color-surface-sunken, #f4f4f4);
    border-bottom: 1px solid var(--color-border);
  }
  .cbf-lipd :global(.cbf-email__head > div) { display: flex; flex-direction: column; gap: 2px; }
  .cbf-lipd :global(.cbf-email__subject) { grid-column: 1 / -1; }
  .cbf-lipd :global(.cbf-email__label) {
    font-size: var(--type-size-100, 0.8125rem);
    color: var(--color-text-tertiary);
  }
  .cbf-lipd :global(.cbf-email__body) {
    padding: var(--spacing-400) var(--spacing-500);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300);
  }
  .cbf-lipd :global(.cbf-email__body p) { margin: 0; }
  .cbf-lipd :global(.cbf-email__meta) { color: var(--color-text-tertiary); }
  .cbf-lipd :global(.cbf-email__foot) {
    padding: var(--spacing-200) var(--spacing-500);
    border-top: 1px solid var(--color-border-light, var(--color-border));
    color: var(--color-text-tertiary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
