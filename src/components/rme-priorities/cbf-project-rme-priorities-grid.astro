---
// cbf-project-rme-priorities-grid — the "Project RM&E Priorities" grid on
// the Manage RM&E Priorities page: which RM&E Priority category and SME
// apply to each project, checked directly against prod
// (ManageRme.mvc/ManageRme). Same AG Grid + search + CSV-export +
// record-count-footer conventions as the RM&E Contract Reports grid (its
// closest reference), plus row-selection checkboxes and a "Bulk Edit"
// flow — prod's own "Bulk Edit Project RM&E Priorites and Project SME"
// action, applying one RM&E Priority (and optionally an SME/comment) to
// every selected project at once, in-memory only (no backend to persist to,
// same constraint as this spoke's other inline-edit flows).
//
// bcn-lego-checked: ecology has NO table/grid/data-grid lego — AG Grid
// Community is this spoke's established tabular surface; this bcn-
// component is its reusable home. Every other control is a lego:
// cbf-search-field for search, esa-icon-button for the CSV download,
// esa-dialog + esa-select + esa-text-field + esa-textarea for the bulk-edit
// form.
import CbfSearchField from '../search/cbf-search-field.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import '../shared/cbf-data-grid-chrome.css';
import { projectRmePriorities as defaultRows, RME_PRIORITIES } from '../../data/rme-priorities.mjs';

interface Props {
  rows?: typeof defaultRows;
}

const { rows = defaultRows } = Astro.props;

const priorityOptions = RME_PRIORITIES.map((p) => ({ value: String(p.id), label: `${p.id}: ${p.title}` }));
---
<section class="cbf-project-rme-priorities stack" data-gap="md">
  <header class="cbf-data-grid__header repel">
    <span class="typography-meta cbf-data-grid__count-label">All project RM&E priorities</span>
    <span data-rme-bulk-edit-open>
      <EsaButton variant="primary" appearance="outline" disabled>Bulk edit project RM&E priorities and project SME</EsaButton>
    </span>
  </header>

  <div class="cbf-data-grid__controls repel">
    <div class="cbf-data-grid__search">
      <CbfSearchField
        placeholder="Search project number or SME…"
        iconSize={18}
        data-rme-priorities-search
        aria-label="Search project RM&E priorities"
      />
    </div>
  </div>

  <!-- AG Grid mounts here. autoHeight grows with rows so the page (not an inner
       pane) owns vertical scroll; the wrapper owns the framed surface. -->
  <div class="cbf-data-grid__grid" data-rme-priorities-grid></div>

  <footer class="cbf-data-grid__footer repel">
    <span class="typography-meta" data-rme-priorities-count>
      Showing {rows.length} of {rows.length} project RM&E priorities
    </span>
    <EsaIconButton variant="chrome" iconOnly icon="download" label="Download CSV" size="sm" data-rme-priorities-csv />
  </footer>

  <!-- Row data, serialized so the client module (which imports ag-grid-community)
       hydrates without a second fetch. -->
  <script type="application/json" data-rme-priorities-data set:html={JSON.stringify(rows)}></script>

  <esa-dialog heading="Bulk edit project RM&E priorities and project SME" show-close-button size="md" data-rme-bulk-edit-dialog>
    <form class="stack" data-gap="md" data-rme-bulk-edit-form>
      <p class="typography-body-md" data-rme-bulk-edit-summary></p>
      <esa-select
        label="RM&E priority"
        placeholder="Select…"
        required
        options={JSON.stringify(priorityOptions)}
        data-field="rmePriorityId"
      ></esa-select>
      <esa-text-field
        label="Project SME"
        placeholder="Leave blank to keep each project's current SME"
        data-field="projectSme"
      ></esa-text-field>
      <esa-textarea
        label="Comments"
        rows="2"
        placeholder="Leave blank to keep each project's current comments"
        data-field="comments"
      ></esa-textarea>
      <p class="typography-meta cbf-project-rme-priorities__error" data-rme-bulk-edit-error hidden>
        Choose an RM&E priority to apply.
      </p>
    </form>

    <div slot="footer">
      <span data-rme-bulk-edit-cancel>
        <EsaButton variant="ghost" appearance="outline">Cancel</EsaButton>
      </span>
      <span data-rme-bulk-edit-submit>
        <EsaButton variant="primary">Apply to selected</EsaButton>
      </span>
    </div>
  </esa-dialog>
</section>

<style>
  .cbf-project-rme-priorities__error {
    color: var(--color-content-utility-danger);
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-textarea';
  import { wireDataGrid } from '../shared/grid-chrome';
  import type { ColDef } from 'ag-grid-community';

  type ProjectPriority = {
    projectId: number; projectNumber: string; projectSme: string;
    rmePriorityId: number; rmePriorityTitle: string; comments: string;
  };

  function initProjectPriorities(root: HTMLElement) {
    const bulkEditOpenWrap = root.querySelector<HTMLElement>('[data-rme-bulk-edit-open]');
    const bulkEditOpenBtn = bulkEditOpenWrap?.querySelector<HTMLButtonElement>('button');
    // esa-button's disabled look (dimmed, not-allowed cursor, pointer-events:
    // none) lives on its OUTER wrapper span via a `esa-button--disabled`
    // class baked in at render time from the static `disabled` prop — toggling
    // just the native <button>.disabled property (real keyboard/form
    // semantics) leaves that class stuck, so the button stays dimmed AND
    // unclickable by a real mouse even once enabled. Both must be toggled
    // together.
    const bulkEditOpenSpan = bulkEditOpenWrap?.querySelector<HTMLElement>('span.esa-button');
    function setBulkEditEnabled(enabled: boolean): void {
      if (bulkEditOpenBtn) bulkEditOpenBtn.disabled = !enabled;
      bulkEditOpenSpan?.classList.toggle('esa-button--disabled', !enabled);
    }
    const dialog = root.querySelector<HTMLElement & { show: () => void; close: () => void }>('[data-rme-bulk-edit-dialog]');
    const form = root.querySelector<HTMLFormElement>('[data-rme-bulk-edit-form]');
    const summary = root.querySelector<HTMLElement>('[data-rme-bulk-edit-summary]');
    const cancelBtn = root.querySelector<HTMLElement>('[data-rme-bulk-edit-cancel]');
    const submitBtn = root.querySelector<HTMLElement>('[data-rme-bulk-edit-submit]');
    const errorEl = root.querySelector<HTMLElement & { hidden: boolean }>('[data-rme-bulk-edit-error]');

    const field = (name: string): (HTMLElement & { value?: string }) | null =>
      form?.querySelector<HTMLElement & { value?: string }>(`[data-field="${name}"]`) ?? null;

    function resetForm(): void {
      ['rmePriorityId', 'projectSme', 'comments'].forEach((name) => {
        const el = field(name);
        if (el && 'value' in el) el.value = '';
      });
      if (errorEl) errorEl.hidden = true;
    }

    // cbf-rme-priorities-list's "Create new" flow is a sibling section
    // reading the same taxonomy — pick up a freshly created priority here so
    // it's selectable in this dropdown without a page reload.
    document.addEventListener('cbf-rme-priority-created', (e) => {
      const { id, title } = (e as CustomEvent<{ id: number; title: string }>).detail;
      const select = field('rmePriorityId') as (HTMLElement & { options: { value: string; label: string }[] }) | null;
      if (select) select.options = [...select.options, { value: String(id), label: `${id}: ${title}` }];
    });

    const handle = wireDataGrid<ProjectPriority>({
      root,
      gridSelector: '[data-rme-priorities-grid]',
      dataSelector: '[data-rme-priorities-data]',
      searchSelector: '[data-rme-priorities-search]',
      countSelector: '[data-rme-priorities-count]',
      csvSelector: '[data-rme-priorities-csv]',
      countNoun: 'project RM&E priorities',
      csvFileName: 'project-rme-priorities.csv',
      columnDefs: [
        {
          headerName: 'Project number', field: 'projectNumber', colId: 'projectNumber', minWidth: 160,
          getQuickFilterText: (p) => p.data?.projectNumber ?? '',
        },
        {
          headerName: 'Project SME', field: 'projectSme', colId: 'projectSme', minWidth: 170,
          getQuickFilterText: (p) => p.data?.projectSme ?? '',
        },
        { headerName: 'RME priority ID list', field: 'rmePriorityId', colId: 'rmePriorityId', minWidth: 160 },
        { headerName: 'RME priority title list', field: 'rmePriorityTitle', colId: 'rmePriorityTitle', flex: 2, minWidth: 280 },
        { headerName: 'Comments', field: 'comments', colId: 'comments', flex: 2, minWidth: 220 },
      ] satisfies ColDef[],
      gridOptions: {
        rowSelection: { mode: 'multiRow' },
        onSelectionChanged: () => {
          setBulkEditEnabled(gridApi.getSelectedRows().length > 0);
        },
      },
    });
    if (!handle) return;
    const { gridApi } = handle;

    // cbf-rme-priorities-list's per-row "Edit title" flow renames a priority in
    // the sibling taxonomy list — relabel it here too (the bulk-edit dropdown
    // option and every already-assigned project row) so the two sections never
    // disagree. Mirrors the create-event handshake above.
    document.addEventListener('cbf-rme-priority-updated', (e) => {
      const { id, title } = (e as CustomEvent<{ id: number; title: string }>).detail;
      const label = `${id}: ${title}`;

      const select = field('rmePriorityId') as (HTMLElement & { options: { value: string; label: string }[] }) | null;
      if (select) {
        select.options = select.options.map((o) => (o.value === String(id) ? { ...o, label } : o));
      }

      const updated: ProjectPriority[] = [];
      gridApi.forEachNode((node) => {
        if (node.data && node.data.rmePriorityId === id) {
          node.data.rmePriorityTitle = label;
          updated.push(node.data);
        }
      });
      if (updated.length) gridApi.applyTransaction({ update: updated });
    });

    bulkEditOpenWrap?.addEventListener('click', () => {
      if (bulkEditOpenBtn?.disabled) return;
      const selected = gridApi.getSelectedRows();
      if (selected.length === 0) return;
      if (summary) {
        summary.textContent = `Applying to ${selected.length} selected project${selected.length === 1 ? '' : 's'}: ` +
          selected.map((r) => r.projectNumber).join(', ');
      }
      dialog?.show();
    });

    cancelBtn?.addEventListener('click', () => {
      dialog?.close();
      resetForm();
    });

    submitBtn?.addEventListener('click', () => {
      const prioritySelect = field('rmePriorityId') as (HTMLElement & { value?: string; options: { value: string; label: string }[] }) | null;
      const priorityId = Number(prioritySelect?.value ?? '');
      if (!priorityId) {
        if (errorEl) errorEl.hidden = false;
        return;
      }
      // Read the label straight off the selected option (not the static
      // RME_PRIORITIES import) so a priority created via the sibling
      // "Create new" flow — appended to this select's options, but never
      // added to that static list — still applies its real label.
      const priorityLabelText = prioritySelect?.options.find((o) => o.value === String(priorityId))?.label ?? '';
      const sme = (field('projectSme')?.value ?? '').trim();
      const comments = (field('comments')?.value ?? '').trim();

      const selected = gridApi.getSelectedRows();
      const updated = selected.map((row) => {
        row.rmePriorityId = priorityId;
        row.rmePriorityTitle = priorityLabelText;
        if (sme) row.projectSme = sme;
        if (comments) row.comments = comments;
        return row;
      });
      gridApi.applyTransaction({ update: updated });
      gridApi.deselectAll();

      const snackbar = document.querySelector<HTMLElement & { success?: (msg: string, cfg?: unknown) => void }>('[data-snackbar]');
      snackbar?.success?.(`Updated RM&E priority for ${updated.length} project${updated.length === 1 ? '' : 's'}.`, { duration: 5000 });

      dialog?.close();
      resetForm();
      setBulkEditEnabled(false);
    });
  }

  document
    .querySelectorAll<HTMLElement>('.cbf-project-rme-priorities')
    .forEach(initProjectPriorities);
</script>
