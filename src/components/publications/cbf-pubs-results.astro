---
// cbf-pubs-results — the /publications results region. publications-page.client paints
// the document list (count bar, page links, [pdf]·title·snippet·green path) into
// [data-pubs-results]. The painted markup is global (JS-built nodes carry no Astro
// scope hash); keep the .cbf-pubs__* class names verbatim — the client emits them.
// The document path uses --cbf-document-link (the prod "green path" tell — a
// deliberate non-success green, see theme + NEEDS.md #1).
---
<div class="cbf-pubs-results" data-pubs-results></div>

<style is:global>
  .cbf-pubs-results .cbf-pubs__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--spacing-300);
    padding-bottom: var(--spacing-300);
    margin-bottom: var(--spacing-400);
    border-bottom: 1px solid var(--color-border);
  }
  .cbf-pubs-results .cbf-pubs__count {
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .cbf-pubs-results .cbf-pubs__pages {
    font-size: 15px;
    color: var(--color-text-tertiary);
  }
  .cbf-pubs-results .cbf-pubs__page {
    padding: 0 4px;
    color: var(--color-primary);
  }
  .cbf-pubs-results .cbf-pubs__page:hover {
    text-decoration: underline;
  }
  .cbf-pubs-results .cbf-pubs__page.is-current {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .cbf-pubs-results .cbf-pubs__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
  }
  .cbf-pubs-results .cbf-pubs__doc {
    max-width: 70ch;
  }
  .cbf-pubs-results .cbf-pubs__doc-title {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200);
    margin: 0 0 var(--spacing-100);
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }
  .cbf-pubs-results .cbf-pubs__doc-title a {
    color: var(--color-secondary);
  }
  .cbf-pubs-results .cbf-pubs__doc-title a:hover {
    text-decoration: underline;
  }
  .cbf-pubs-results .cbf-pubs__fmt {
    flex: none;
    color: var(--color-text-tertiary);
    font-size: 14px;
    font-weight: var(--font-weight-regular);
  }
  .cbf-pubs-results .cbf-pubs__snippet {
    margin: 0 0 var(--spacing-100);
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-primary);
  }
  .cbf-pubs-results .cbf-pubs__snippet mark {
    background: var(--cbf-search-highlight);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
  /* prod renders the document path in green — keep that tell, via a semantic token */
  .cbf-pubs-results .cbf-pubs__path {
    font-size: 14px;
    color: var(--cbf-document-link);
    word-break: break-all;
  }
  .cbf-pubs-results .cbf-pubs__path:hover {
    text-decoration: underline;
  }

  .cbf-pubs-results .cbf-pubs__noresults {
    padding: var(--spacing-600) 0;
    font-size: 16px;
    color: var(--color-text-tertiary);
  }
</style>
