---
/*
 * cbf-record-page-title — the name of the page being viewed, under the record
 * header, led by the menu it lives under: "Setup / Pre-Award", "Overview / Contract
 * Summary" (Andy, round 3: "Add a 'Setup' prefix ahead of 'Pre-award'? Something like
 * 'Setup / Pre-Award'"). The section and slash are a quieter colour so the page name
 * reads first.
 * A page that shares its section's name (Closeout) shows the name once.
 *
 * Set in `title` (IBM Plex Sans), not the condensed display face of the headings
 * above it (Andy, round 3: "are we using like a narrow version of it? Do we have a
 * non-narrow version that we could use there?").
 */
interface Props {
  /** The menu the page lives under: "Setup", "Overview". */
  section: string;
  title: string;
}
const { section, title } = Astro.props;
---

<h2 class="cbf-record-page-title typography-title">
  {section !== title && <span class="cbf-record-page-title__section">{section} / </span>}{title}
</h2>

<style>
  .cbf-record-page-title {
    margin: 0;
    color: var(--color-content-default);
  }
  /* Same weight as the page name (the title composite's medium); only the colour
     steps back (Andy, round 3: the regular-weight prefix was "too thin"). */
  .cbf-record-page-title__section {
    color: var(--color-content-default-secondary);
  }
</style>
