---
/*
 * cbf-record-page-title — the name of the page being viewed, under the record
 * header, with the menu it lives under as a quiet line above it: "Setup" over
 * "Work Element Budgets", "Overview" over "Contract Summary" (Andy, round 3: "Go
 * with Quiet eyebrow, but don't include page 4 of 4"). No slash, no page count.
 * A page that shares its section's name (Closeout) shows the name once (Andy, round
 * 3: "I don't think we need the closeout/closeout").
 *
 * Set in `title` (IBM Plex Sans), not the condensed display face of the headings
 * above it (Andy, round 3: "are we using like a narrow version of it? Do we have a
 * non-narrow version that we could use there?").
 */
interface Props {
  /** The menu the page lives under: "Setup", "Overview". */
  section: string;
  title: string;
}
const { section, title } = Astro.props;
---

<div class="cbf-record-page-title stack" data-gap="3xs">
  {section !== title && <p class="cbf-record-page-title__section typography-body-sm">{section}</p>}
  <h2 class="cbf-record-page-title__name typography-title">{title}</h2>
</div>

<style>
  .cbf-record-page-title__section,
  .cbf-record-page-title__name {
    margin: 0;
  }
  .cbf-record-page-title__section {
    color: var(--color-content-default-secondary);
  }
  /* The spoke's brand navy, the same token as the contract H1 above it (Andy, round
     3: "make that the brand blue"). */
  .cbf-record-page-title__name {
    color: var(--color-background-default-knockout);
  }
</style>
