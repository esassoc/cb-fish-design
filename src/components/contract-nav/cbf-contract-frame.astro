---
/*
 * cbf-contract-frame — everything around a contract page's body: the site nav, the
 * record card (breadcrumbs, portfolio return, record header with its status badges,
 * always-there menus and lifecycle track), the role gate, and the floating prototype
 * controls. The page passes its navigation data and slots the page title and body.
 *
 * One frame for both header variations (round 3 at /contract-nav, round 4 "SOW hub"
 * at /contract-nav/v2), so they differ only in the data they pass.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CbfPublicNav from '../shared/cbf-public-nav.astro';
import CbfAppPanel from '../shared/cbf-app-panel.astro';
import CbfPrototypeStrip from '../shared/cbf-prototype-strip.astro';
import CbfRoleSwitch from '../shared/cbf-role-switch.astro';
import CbfRouteSwitch from '../shared/cbf-route-switch.astro';
import CbfLensSwitch from '../shared/cbf-lens-switch.astro';
import CbfRecordHeader from './cbf-record-header.astro';
import CbfRecordLifecycle from './cbf-record-lifecycle.astro';
import CbfRecordEnds from './cbf-record-ends.astro';
import CbfRoleGate from './cbf-role-gate.astro';
import CbfPortfolioReturn from './cbf-portfolio-return.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaContainer from '@esa/ecology/esa-container.astro';
import { withBase } from '../../lib/base';
import {
  ARRIVALS,
  DEFAULT_STAGE,
  LIFECYCLE,
  NAV_ARRIVAL_KEY,
  NAV_ROLES,
  NAV_ROLE_KEY,
  NAV_STAGE_KEY,
  PORTFOLIO,
  contract,
  tabHiddenFor,
  tabHiddenStages,
} from '../../data/contract-nav.mjs';

interface Page {
  slug: string;
  label: string;
  hideFor?: string[];
  hideStages?: string[];
}
interface Tab {
  key: string;
  label: string;
  pages: Page[];
}
interface Stage {
  key: string;
  label: string;
  status: string;
  variant: string;
  phases: Record<string, [string, number | null, string]>;
}
interface Crumb {
  label: string;
  href?: string;
}
interface View {
  key: string;
  label: string;
  href: string;
}
interface Props {
  /** Every tab: the always-there menus and the lifecycle phases. */
  tabs: Tab[];
  /** Keys of the tabs that sit on the title row (the rest are phases). */
  ends: string[];
  stages: Stage[];
  /** Route prefix for page links, base included: withBase('/contract-nav'). */
  base: string;
  /** The page slug that marks "you are here" in the menus. */
  current: string;
  /** Crumbs after the contract number: the page, or a WSE and its tab. */
  crumbs: Crumb[];
  /** The browser tab's title, before the site name. */
  title: string;
  pageHideFor?: string[];
  pageHideStages?: string[];
  /** The header variations, for the prototype's Header switch. */
  views: View[];
  activeView: string;
}
const { tabs, ends, stages, base, current, crumbs, title, pageHideFor, pageHideStages, views, activeView } = Astro.props;

const homeIcon =
  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>';
const allCrumbs = [
  { label: 'Home', href: withBase('/home'), icon: homeIcon },
  // Links above the contract leave this prototype; they go to Home as stand-ins.
  { label: 'Projects', href: withBase('/home') },
  { label: contract.project, href: withBase('/home') },
  { label: 'Contracts', href: withBase('/home') },
  { label: contract.number, href: `${base}/summary` },
  ...crumbs,
];
const endTabs = ends.map((k) => tabs.find((t) => t.key === k)!);
const phaseTabs = tabs.filter((t) => !ends.includes(t.key));
const lifecycle = LIFECYCLE.filter((ph) => phaseTabs.some((t) => t.key === ph.tab));
const stageKeys = stages.map((st) => st.key);
const endsLabel = `Contract ${endTabs.map((t) => t.label).join(', ').replace(/, ([^,]*)$/, ' and $1')}`;
---

<BaseLayout title={`${contract.number}: ${title} — Columbia Basin Fish & Wildlife Program`}>
  <CbfPublicNav />

  <main class="cbf-contract-frame">
    <EsaContainer maxWidth="1920px">
      <CbfAppPanel crumbs={allCrumbs} overflow="visible">
        <CbfPortfolioReturn name={PORTFOLIO.name} href={withBase('/home')} />
        <CbfRecordHeader eyebrow={`Contract ${contract.number}`} title={contract.title}>
          {stages.map((st) => (
            <span slot="status" data-hide-stages={stageKeys.filter((k) => k !== st.key).join(' ')}>
              <EsaBadge value={st.status} variant={st.variant as any} size="md" />
            </span>
          ))}
          <CbfRecordEnds slot="actions" tabs={endTabs} current={current} base={base} label={endsLabel} />
          <CbfRecordLifecycle
            tabs={phaseTabs}
            lifecycle={lifecycle}
            stages={stages}
            hiddenFor={tabHiddenFor}
            hiddenStages={tabHiddenStages}
            role={NAV_ROLES[0].key}
            current={current}
            base={base}
            label="Contract lifecycle"
          />
        </CbfRecordHeader>
        <CbfRoleGate pageHideFor={pageHideFor} pageHideStages={pageHideStages} fallback={`${base}/summary`} />
        <slot />
      </CbfAppPanel>

      {/* Last in the source, so the prototype controls come after the page in tab order;
          the panel floats bottom right. */}
      <CbfPrototypeStrip placement="float" note="Contract dates and status are mock.">
        <CbfRouteSwitch views={views} active={activeView} label="Header" />
        <CbfRoleSwitch roles={NAV_ROLES} storageKey={NAV_ROLE_KEY} />
        <CbfLensSwitch
          options={stages.map((st) => ({ key: st.key, label: st.label }))}
          label="Contract stage"
          attr="cbf-stage"
          param="stage"
          storageKey={NAV_STAGE_KEY}
          event="cbf-stage:change"
          initial={DEFAULT_STAGE}
        />
        <CbfLensSwitch
          options={ARRIVALS}
          label="Arrived from"
          attr="cbf-arrival"
          param="from"
          storageKey={NAV_ARRIVAL_KEY}
          event="cbf-arrival:change"
        />
      </CbfPrototypeStrip>
    </EsaContainer>
  </main>
</BaseLayout>

<style>
  .cbf-contract-frame { padding-block: var(--spacing-600) var(--spacing-800); }
</style>
