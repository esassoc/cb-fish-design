---
// cbf-cap-schedule-strip — the milestone schedule strip from the hatchery
// execution report: quarters FY24–FY30 across, phases down (Planning/MOA, Design
// procurement, Design, EC, 3-Step review, Construction procurement,
// Construction). Planned bars are outlined; actual bars are filled; a rule marks
// the "Data as of" date. PMs edit their own milestones (story 11): click a bar
// to change it, or add one.
//
// bcn-lego-checked: no esa timeline/gantt lego exists (checked the catalog —
// esa-progress-bar is a single 0–100 meter). This is a CSS grid of 28 quarter
// tracks; the editor is esa-dialog + esa-select + esa-text-field + esa-button.
// Beacon is not cloned on this machine.
import EsaButton from '@esa/ecology/esa-button.astro';
---
<section class="cbf-cap-sched stack" data-gap="sm" data-cap-schedule aria-labelledby="cap-sched-title">
  <div class="repel">
    <h2 class="cbf-cap-section-title" id="cap-sched-title">Schedule</h2>
    <EsaButton size="sm" variant="secondary" appearance="outline" icon="plus" data-sched-add>Add milestone</EsaButton>
  </div>
  <div class="cbf-cap-sched__scroll"><div class="cbf-cap-sched__grid" data-sched-grid></div></div>
  <p class="typography-meta cbf-cap-muted cbf-cap-sched__legend">
    <span class="cbf-cap-sched__key is-planned"></span> Planned
    <span class="cbf-cap-sched__key is-actual"></span> Actual
    <span class="cbf-cap-sched__key is-asof"></span> Data as of
  </p>

  <esa-dialog data-sched-dialog size="sm">
    <div data-sched-body class="stack" data-gap="sm"></div>
    <div slot="footer" class="cluster" data-gap="sm">
      <EsaButton variant="danger" appearance="outline" data-sched-remove>Remove</EsaButton>
      <EsaButton variant="secondary" appearance="outline" data-sched-cancel>Cancel</EsaButton>
      <EsaButton variant="primary" data-sched-save>Save</EsaButton>
    </div>
  </esa-dialog>
</section>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-text-field';
  import { getState, subscribe, view, update, can } from '../../lib/capital/store';
  import { slotLabel, firstOpenSlot, fyLabel } from '../../lib/capital/finance';
  import { findProject } from '../../lib/capital/actions';
  import { esc } from '../../lib/capital/ui';
  import { FY_LIST, MILESTONE_PHASES, SLOT_COUNT, type Milestone, type MilestonePhase } from '../../lib/capital/types';

  const root = document.querySelector<HTMLElement>('[data-cap-schedule]');
  const id = new URLSearchParams(location.search).get('id') ?? '';
  if (root) init(root);

  function init(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>('[data-sched-grid]')!;
    const addBtn = root.querySelector<HTMLElement>('[data-sched-add]')!;
    const dialog = root.querySelector<HTMLElement & { show(): void; close(): void; heading: string }>('[data-sched-dialog]')!;
    const body = root.querySelector<HTMLElement>('[data-sched-body]')!;
    const removeBtn = root.querySelector<HTMLElement>('[data-sched-remove]')!;
    let editing: Milestone | null = null;

    const slots = Array.from({ length: SLOT_COUNT }, (_, i) => ({ label: slotLabel(i), value: String(i) }));
    const optsJson = (o: { label: string; value: string }[]) => esc(JSON.stringify(o));
    const field = (n: string) => body.querySelector<HTMLElement & { value: string }>(`[data-field="${n}"]`);
    const val = (n: string) => String(field(n)?.value ?? '').trim();

    function openEditor(m: Milestone | null) {
      editing = m;
      dialog.heading = m ? 'Edit milestone' : 'Add milestone';
      removeBtn.hidden = !m;
      const none = [{ label: '—', value: '' }, ...slots];
      body.innerHTML = `
        <esa-select label="Phase" data-field="phase" options="${optsJson(MILESTONE_PHASES.map((p) => ({ label: p, value: p })))}" value="${esc(m?.phase ?? 'Construction')}"></esa-select>
        <esa-text-field label="Label" placeholder="e.g. Phase 2" data-field="label" value="${esc(m?.label ?? '')}"></esa-text-field>
        <div class="cluster" data-gap="sm">
          <esa-select label="Planned start" data-field="ps" options="${optsJson(slots)}" value="${m?.plannedStart ?? firstOpenSlot(getState().settings.dataAsOf)}"></esa-select>
          <esa-select label="Planned end" data-field="pe" options="${optsJson(slots)}" value="${m?.plannedEnd ?? firstOpenSlot(getState().settings.dataAsOf) + 3}"></esa-select>
        </div>
        <div class="cluster" data-gap="sm">
          <esa-select label="Actual start" data-field="as" options="${optsJson(none)}" value="${m?.actualStart ?? ''}"></esa-select>
          <esa-select label="Actual end" data-field="ae" options="${optsJson(none)}" value="${m?.actualEnd ?? ''}"></esa-select>
        </div>`;
      dialog.show();
    }

    addBtn.addEventListener('click', () => openEditor(null));
    root.querySelector('[data-sched-cancel]')!.addEventListener('click', () => dialog.close());
    removeBtn.addEventListener('click', () => {
      if (editing) {
        const mid = editing.id;
        update((s) => { const p = findProject(s, id); p.milestones = p.milestones.filter((x) => x.id !== mid); });
      }
      dialog.close();
    });
    root.querySelector('[data-sched-save]')!.addEventListener('click', () => {
      const num = (n: string) => (val(n) === '' ? undefined : Number(val(n)));
      const m: Milestone = {
        id: editing?.id ?? `ms-${Math.random().toString(36).slice(2, 8)}`,
        phase: val('phase') as MilestonePhase,
        label: val('label') || undefined,
        plannedStart: Math.min(num('ps')!, num('pe')!),
        plannedEnd: Math.max(num('ps')!, num('pe')!),
        actualStart: num('as'),
        actualEnd: num('ae') ?? (num('as') != null ? num('as') : undefined),
      };
      update((s) => {
        const p = findProject(s, id);
        const i = p.milestones.findIndex((x) => x.id === m.id);
        if (i >= 0) p.milestones[i] = m; else p.milestones.push(m);
      });
      dialog.close();
    });

    function render() {
      const v = view();
      const p = v.projects.find((x) => x.id === id);
      if (!p) { root!.hidden = true; return; }
      const editable = can('editProject', p);
      addBtn.hidden = !editable;
      const asOfSlot = firstOpenSlot(v.asOf); // the rule sits at the start of the first open quarter
      const col = (slot: number) => slot + 2; // column 1 is the phase label

      let html = `<div class="cbf-cap-sched__corner"></div>`;
      FY_LIST.forEach((fy, i) => {
        html += `<div class="cbf-cap-sched__fy" style="grid-column:${col(i * 4)} / span 4">${fyLabel(fy)}</div>`;
      });
      html += `<div class="cbf-cap-sched__corner"></div>`;
      for (let s = 0; s < SLOT_COUNT; s++) html += `<div class="cbf-cap-sched__q${s % 4 === 0 ? ' is-fy-start' : ''}" style="grid-column:${col(s)}">Q${(s % 4) + 1}</div>`;

      MILESTONE_PHASES.forEach((phase, i) => {
        const row = i + 3;
        html += `<div class="cbf-cap-sched__phase" style="grid-row:${row}">${esc(phase)}</div>`;
        html += `<div class="cbf-cap-sched__track" style="grid-row:${row};grid-column:2 / span ${SLOT_COUNT}"></div>`;
        for (const m of p.milestones.filter((x) => x.phase === phase)) {
          const tip = `${phase}${m.label ? ` — ${m.label}` : ''}: planned ${slotLabel(m.plannedStart)}–${slotLabel(m.plannedEnd)}${m.actualStart != null ? `; actual ${slotLabel(m.actualStart)}–${slotLabel(m.actualEnd ?? m.actualStart)}` : ''}`;
          html += `<button type="button" class="cbf-cap-sched__bar is-planned" data-ms="${esc(m.id)}" ${editable ? '' : 'disabled'} title="${esc(tip)}"
            style="grid-row:${row};grid-column:${col(m.plannedStart)} / ${col(m.plannedEnd) + 1}">${esc(m.label ?? '')}</button>`;
          if (m.actualStart != null) {
            html += `<div class="cbf-cap-sched__bar is-actual" title="${esc(tip)}" style="grid-row:${row};grid-column:${col(m.actualStart)} / ${col(m.actualEnd ?? m.actualStart) + 1}"></div>`;
          }
        }
      });
      if (asOfSlot > 0 && asOfSlot < SLOT_COUNT) {
        html += `<div class="cbf-cap-sched__asof" style="grid-row:1 / ${MILESTONE_PHASES.length + 3};grid-column:${col(asOfSlot)}" title="Data as of ${esc(v.asOf)}"></div>`;
      }
      if (!p.milestones.length) {
        html += `<p class="cbf-cap-sched__empty" style="grid-row:3 / span 3;grid-column:2 / span ${SLOT_COUNT}">No milestones yet${editable ? ' — add the first one.' : '.'}</p>`;
      }
      grid.innerHTML = html;
      grid.querySelectorAll<HTMLElement>('[data-ms]').forEach((b) => b.addEventListener('click', () => {
        const m = findProject(getState(), id).milestones.find((x) => x.id === b.dataset.ms);
        if (m) openEditor(m);
      }));
    }

    subscribe(render);
  }
</script>

<style>
  .cbf-cap-sched__scroll { overflow-x: auto; border: 1px solid var(--color-border-default); border-radius: var(--radius-200); }
  .cbf-cap-sched__legend { margin: 0; display: flex; align-items: center; flex-wrap: wrap; gap: var(--spacing-150) var(--spacing-200); }
  .cbf-cap-sched__key { display: inline-block; inline-size: 18px; block-size: 10px; border-radius: 2px; margin-inline-start: var(--spacing-200); }
  .cbf-cap-sched__key.is-planned { border: 1.5px solid var(--color-background-brand); background: var(--color-background-brand-subtle); }
  .cbf-cap-sched__key.is-actual { background: var(--color-background-brand); }
  .cbf-cap-sched__key.is-asof { inline-size: 2px; block-size: 14px; background: var(--color-background-utility-danger); }
</style>

<style is:global>
  .cbf-cap-sched__grid {
    position: relative;
    display: grid;
    grid-template-columns: 12rem repeat(28, minmax(28px, 1fr));
    grid-auto-rows: minmax(30px, auto);
    min-inline-size: 60rem;
    font-size: 12px;
  }
  .cbf-cap-sched__corner { grid-column: 1; background: var(--color-background-elevation-sunken); }
  .cbf-cap-sched__fy {
    grid-row: 1; text-align: center; font-weight: var(--typography-font-weight-semibold);
    background: var(--color-background-elevation-sunken); border-inline-start: 1px solid var(--color-border-default);
    padding: var(--spacing-100) 0; color: var(--color-background-default-knockout);
  }
  .cbf-cap-sched__q {
    grid-row: 2; text-align: center; color: var(--color-content-default-tertiary); padding: 2px 0;
    background: var(--color-background-elevation-sunken); border-bottom: 1px solid var(--color-border-default);
  }
  .cbf-cap-sched__q.is-fy-start { border-inline-start: 1px solid var(--color-border-default); }
  .cbf-cap-sched__phase {
    grid-column: 1; display: flex; align-items: center; padding: 0 var(--spacing-200);
    color: var(--color-content-default-secondary); border-top: 1px solid var(--color-border-default-subtle);
  }
  .cbf-cap-sched__track { border-top: 1px solid var(--color-border-default-subtle); }
  .cbf-cap-sched__bar {
    align-self: center; block-size: 18px; margin: 0 1px; border-radius: 3px; z-index: 1;
    font-size: 11px; line-height: 16px; padding: 0 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: start;
  }
  .cbf-cap-sched__bar.is-planned {
    border: 1.5px solid var(--color-background-brand); background: var(--color-background-brand-subtle);
    color: var(--color-background-default-knockout); cursor: pointer;
  }
  .cbf-cap-sched__bar.is-planned:disabled { cursor: default; }
  .cbf-cap-sched__bar.is-actual { block-size: 6px; align-self: end; margin-block-end: 3px; background: var(--color-background-brand); z-index: 2; }
  .cbf-cap-sched__asof { justify-self: start; inline-size: 2px; background: var(--color-background-utility-danger); z-index: 3; pointer-events: none; }
  .cbf-cap-sched__empty { margin: 0; align-self: center; text-align: center; color: var(--color-content-default-tertiary); z-index: 1; }
</style>
