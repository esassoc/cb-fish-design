---
/*
 * cbf-libw-wizard — the assembler and the only script for /lib-entry-wizard:
 * the Line Item Budget entered as a guided, step-by-step form.
 *
 * ── THE THIRD BET ON THE SAME SCREEN ────────────────────────────────────────
 *   /lib-entry         a live control in every grid cell; a new line is appended
 *                      inline. The web of cross-line dependencies stays visible
 *                      while you type.
 *   /lib-entry-sheet   a read-only ledger; every create and edit happens on a
 *                      side sheet with real field labels.
 *   /lib-entry-wizard  (this) one CATEGORY per step, front to back. Nothing is
 *                      on screen except the step you are answering.
 *
 * ── WHAT THE WIZARD BUYS, AND WHAT IT COSTS ─────────────────────────────────
 * BUYS: a LIB has nine categories that do not resemble each other, and the grid
 * had to answer all nine with one set of columns. Here each category gets a page
 * of its own — its rules stated in words, its own vocabulary, its own add
 * affordance, its own subtotal. It also gives the screen a beginning and an end,
 * which is what a first-time vendor actually lacks: the grid never tells you
 * whether you are finished, only what is currently wrong.
 *
 * COSTS: the dependencies. Fringe follows a salary line on another step; a
 * cell-phone line's months follow a position two steps back; indirect is a
 * percentage of eight of the nine steps. In a grid you watch those move. Here
 * they move behind your back, and this file is mostly the machinery for
 * admitting that honestly:
 *   · the reconciliation rail is beside every step, so the total never leaves;
 *   · every gate ROLLS UP to the stepper, so a problem three steps back is
 *     visible from wherever you are;
 *   · a dependent card FLASHES when it changes, and the stepper badge moves with
 *     it, so an edit that reaches another step still announces itself;
 *   · the Fringe step says out loud that it was filled in from the Salary step.
 * Without those four, a wizard over a dependency web is a way to hide arithmetic
 * from the person responsible for it.
 *
 * ── ARITHMETIC IS NEVER DONE HERE ───────────────────────────────────────────
 * Every amount, subtotal, base and total comes from `priceLines(lines, cfg)` in
 * src/data/lib-entry.mjs, re-called in full after EVERY edit — the same engine
 * both other versions use, so all three agree line for line.
 *
 * ── EVENT CONTRACT (all on `document`) ──────────────────────────────────────
 * DISPATCH 'cbf-lib:totals'           — same payload as the other two versions,
 *   which is what lets cbf-lib-reconcile-rail be reused unchanged.
 * DISPATCH 'cbf-lib:open-subcontract' — the subcontract jump-out.
 * LISTEN   'cbf-lib:indirect-config'  — the reused overhead block owns rate+scope.
 * LISTEN   'cbf-lib:review'           — the reused review panel owns the marks.
 * LISTEN   'cbf-lib:focus-line'       — "Go to line" from the review panel now
 *   has to change STEP as well as scroll, which a wizard makes newly interesting.
 *
 * bcn-lego-checked: this file is composition + behavior only. Its sections are
 * components — cbf-libw-stepper, cbf-libw-step, cbf-libw-line-form,
 * cbf-libw-review-step — and the surfaces that are not about entering a line are
 * REUSED unchanged from /lib-entry: cbf-lib-reconcile-rail (running total, gate
 * checklist, submit), cbf-lib-indirect-config (the overhead step),
 * cbf-lib-review-panel (inside the review step), cbf-lib-subcontract-sheet. The
 * only bare legos here are esa-button for the Back/Continue nav. I re-walked the
 * ecology catalog (ls node_modules/@esa/ecology/src/components/): there is no
 * wizard, stepper or form-flow lego of any kind. Beacon is not cloned on this
 * machine.
 */
import EsaButton from '@esa/ecology/esa-button.astro';
import CbfLibwStepper from './cbf-libw-stepper.astro';
import CbfLibwStep from './cbf-libw-step.astro';
import CbfLibwReviewStep from './cbf-libw-review-step.astro';
import CbfLibReconcileRail from '../lib-entry/cbf-lib-reconcile-rail.astro';
import CbfLibIndirectConfig from '../lib-entry/cbf-lib-indirect-config.astro';
import { categories,
  equipmentClassLabel,
} from '../../data/lib-entry.mjs';

/* Short labels for the rail. "Personnel — Salary" in an eleven-step rail is a
   rail nobody can read; the full label is the step's own heading, where there is
   room for it. Kept HERE rather than added to the shared data module, because
   they are this screen's problem and /lib-entry has no rail to label. */
const SHORT: Record<string, string> = {
  'personnel-salary': 'Salary',
  'personnel-fringe': 'Fringe',
  travel: 'Travel',
  meetings: 'Meetings',
  vehicles: 'Vehicles',
  supplies: 'Equipment',
  'rent-utilities': 'Rent',
  subcontracts: 'Subcontracts',
};

const steps = [
  ...categories.map((c: any) => ({ key: c.key, short: SHORT[c.key] ?? c.label, label: c.label })),
  /* Indirect is a STEP rather than a footnote on Review: the rate is referenced
     from an approved NICRA and the vendor confirms its scope, and scope is a
     real decision — it moves the base, and therefore the total. */
  { key: 'indirect', short: 'Indirect', label: 'Indirect rate' },
  { key: 'review', short: 'Review', label: 'Review & submit' },
];
const count = steps.length;
const stepIndexOf: Record<string, number> = Object.fromEntries(steps.map((s, i) => [s.key, i]));
---

<div class="cbf-libw" data-libw data-steps={JSON.stringify(steps.map((s) => s.key))}>
  <CbfLibwStepper steps={steps} active={0} />

  <div class="cbf-libw__body sidebar" data-side="end" data-gap="lg">
    <aside class="cbf-libw__rail">
      <CbfLibReconcileRail />
    </aside>

    <div class="cbf-libw__panels">
      {categories.map((cat: any, i: number) => (
        <CbfLibwStep cat={cat} index={i + 1} count={count} />
      ))}

      <!-- The overhead step. The config surface is REUSED from /lib-entry
           unchanged — it already owns the rate, the reference document, the
           effective dates and the applicability picker, and it announces changes
           on the same event this wizard already listens to. -->
      <section class="cbf-libw__step stack" data-gap="lg" data-step="indirect" data-step-kind="indirect" hidden>
        <header class="stack" data-gap="2xs">
          <p class="cbf-libw__ord type-body-small">Step {count - 1} of {count}</p>
          <h2 class="cbf-libw__title type-page-title">Indirect rate</h2>
          <p class="cbf-libw__lede type-body">
            The rate is not yours to set — it comes from your approved indirect cost rate
            agreement. What this step asks is which of the nine categories it applies to, because
            that decides the base, and the base decides the total.
          </p>
        </header>
        <CbfLibIndirectConfig />
      </section>

      <CbfLibwReviewStep index={count} count={count} stepIndexOf={stepIndexOf} />
    </div>
  </div>

  <!-- Back / Continue, pinned. A wizard whose nav scrolls off is a wizard that
       traps you on a long step. -->
  <nav class="cbf-libw__nav" aria-label="Wizard navigation">
    <div class="cbf-libw__nav-inner repel" data-gap="sm">
      <span data-nav-back>
        <EsaButton size="md" color="secondary" appearance="outline" icon="arrow-left">Back</EsaButton>
      </span>
      <span class="cbf-libw__nav-where stack" data-gap="3xs">
        <span class="cbf-libw__nav-step type-body" data-nav-label></span>
        <span class="cbf-libw__nav-sub type-body-small" data-nav-sub></span>
      </span>
      <span data-nav-next>
        <EsaButton size="md" color="primary" icon="arrow-right">Continue</EsaButton>
      </span>
    </div>
  </nav>
</div>

<script>
  /* The shared view derivations — see the note in cbf-libs-line-editor. */
  import * as V from '../../lib/lib-entry-view';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-combobox';
  import '@esa/ecology/esa-dropdown-menu';
  import { loadReview, flagFor, isIssued, reasonLabel } from '../../data/lib-review.mjs';
  import {
    SHAPES,
    categories,
    categoryOf,
    categoryFixedUnit,
    costLines,
    priceLines,
    effectiveRate,
    effectiveQty,
    baseAmountFor,
    baseLabelFor,
    dependentsOf,
    gsaRates,
    gsaRatesFor,
    gsaRatesForVehicleKind,
    gsaRate,
    isScheduleRated,
    weLabel,
    weShort,
    unallocatedLines,
    gsaFailingLines,
    thresholdMisfiled,
    untestableEquipmentLumps,
    monthsOverPeriod,
    perItemCost,
    onThreshold,
    thresholdTested,
    thresholdTargetFor,
    isClassOverride,
    canOverrideThreshold,
    autoFileEquipment,
    blockOf,
    filingConsequence,
    contract,
    contractMonths,
    rosterFor,
    positionKey,
    PERSONNEL_TYPES,
    TIME_UNITS,
    timeUnit,
    isSalaryLine,
    timeInMonths,
    periodProblem,
    trips,
    tripOf,
    tripLabel,
    NO_TRIP,
    isLooseTravel,
    createTrip,
    removeTrip,
    emptiedTrips,
    TRAVEL_KINDS,
    travelKind,
    travelChain,
    travelCount,
    seedCountFor,
    travelLabel,
    travelLocality,
    hasStandardRate,
    standardNeedsLocality,
    defaultRateYear,
    fringeLabel,
    fringePctOf,
    fringeOnLine,
    isDerivedFringe,
    syncFringeLines,
    DEFAULT_FRINGE_PCT,
    VEHICLE_KINDS,
    vehicleKind,
    countOf,
    indirectConfig,
    usd,
    pct,
    qtyFmt,
    equipmentClassLabel,
} from '../../data/lib-entry.mjs';
  import { initRowReorder, moveInList } from '../../lib/row-reorder';

  const root = document.querySelector<HTMLElement>('[data-libw]');
  if (root) init(root);

  function init(root: HTMLElement) {
    /* Working copies — edits, added and deleted lines mutate THESE, never the
       module's exports, so every derived number stays honest across a repaint. */
    const lines: any[] = costLines.map((l: any) => ({ ...l, allocations: { ...(l.allocations ?? {}) } }));
    let cfg: any = { ...indirectConfig, appliesTo: [...indirectConfig.appliesTo] };
    let review: any = loadReview();
    let seq = 0;

    const STEP_KEYS: string[] = JSON.parse(root.dataset.steps || '[]');
    const STEP_LABELS: Record<string, string> = Object.fromEntries(
      categories.map((c: any) => [c.key, c.label]),
    );
    STEP_LABELS.indirect = 'Indirect rate';
    STEP_LABELS.review = 'Review & submit';

    let active = 0;
    const visited = new Set<number>([0]);

    const $ = <T extends HTMLElement = HTMLElement>(sel: string, scope: ParentNode = root) =>
      scope.querySelector<T>(sel);
    const $$ = (sel: string, scope: ParentNode = root) =>
      Array.from(scope.querySelectorAll<HTMLElement>(sel));
    const cardOf = (id: string) => $(`.cbf-libwl[data-line="${id}"]`);
    const lineById = (id: string) => lines.find((l) => l.id === id);
    const num = (s: any) => {
      const v = parseFloat(String(s ?? '').replace(/[^0-9.\-]/g, ''));
      return Number.isFinite(v) ? v : 0;
    };

    /* ── Text helpers — the same rules all three versions print ── */
    const cents = (n: number) => Math.abs((n ?? 0) % 1) > 0.0001;
    const money = (n: number) => usd(n, { cents: cents(n) });
    const numText = (n: number | null | undefined) =>
      n == null ? '' : cents(n) ? String(n) : n.toLocaleString('en-US');

    const show = (el: Element | null, on: boolean) => { if (el) (el as HTMLElement).hidden = !on; };
    const setText = (el: Element | null, text: string) => { if (el) el.textContent = text; };
    const setLabel = (el: any, v: string) => { if (el) el.label = v; };
    const setBtnLabel = (wrap: Element | null, text: string) =>
      setText(wrap?.querySelector('.esa-button__label') ?? null, text);
    const setBadgeText = (wrap: Element | null, text: string) =>
      setText(wrap?.querySelector('.esa-badge__text') ?? null, text);
    const setErrText = (wrap: Element | null, text: string) =>
      setText(wrap?.querySelector('.esa-field-error__text') ?? null, text);
    /** esa-alert-box renders <strong.esa-alert-box__title> + a slotted message. */
    const setGate = (scope: ParentNode, key: string, on: boolean, title: string, msg: string) => {
      const wrap = $(`[data-gate="${key}"]`, scope);
      show(wrap, on);
      if (!on || !wrap) return;
      setText(wrap.querySelector('.esa-alert-box__title'), title);
      setText($(`[data-gate-msg="${key}"]`, scope), msg);
    };

    const displayLabel = (l: any): string =>
      l.shape === SHAPES.TRAVEL ? travelLabel(l)
      : l.category === 'personnel-fringe' ? fringeLabel(l, lines)
      : l.category === 'personnel-salary' ? (l.label ?? '')
      : l.label ?? '';
    const identOf = (l: any): string =>
      l.category === 'personnel-salary' ? 'position'
      : l.category === 'personnel-fringe' ? 'derived'
      : l.shape === SHAPES.TRAVEL ? 'travel-kind'
      : l.category === 'vehicles' ? 'vehicle-kind'
      : 'label';

    const derivedRow = (l: any) => isDerivedFringe(l);
    /* Bound, not re-implemented — a category can now fix the unit too, and this
       was the fourth copy of the rule that decides it. */
    const unitLocked = V.unitLocked;
    const unitPicked = V.unitPicked;
    const lockedUnit = V.lockedUnit;
    const lockedUnit2 = V.lockedUnit2;
    const rateLabelOf = (l: any) => (isSalaryLine(l) ? timeUnit(l).rateLabel : 'Cost per unit');

    const claimsStandard = V.claimsStandard;
    const canClaimStandard = V.canClaimStandard;
    const standardNeedsWhere = V.standardNeedsWhere;
    const standardSrcText = V.standardSrcText;
    const typedSrcText = V.typedSrcText;
    const standardAmountText = V.standardAmountText;
    const supersededText = V.supersededText;
    const fiscalYearOptions = V.fiscalYearOptions;

    /* Two answers, both the vendor's: WHERE the published rate is claimed for and
       WHICH fiscal year's schedule. The location seeds from wherever the card
       already goes and is a separate value from that moment on — the destination
       names the journey, this prices the line. Mileage has no location. */
    const normalizeClaim = (l: any, ref: any) => {
      const next: any = { year: Number(ref?.year) || defaultRateYear() };
      if (standardNeedsLocality(l.travelKind)) next.locality = ref?.locality ?? travelLocality(l) ?? '';
      return next;
    };

    const gsaOf = (l: any) => gsaRate(l.gsaKey);
    const overridden = (l: any) => isScheduleRated(l) && l.rateOverride != null;
    const gsaOver = (l: any) => {
      const g = gsaOf(l);
      return !!(g && l.rateOverride != null && l.rateOverride > g.ceiling);
    };

    /* The threshold FILES equipment rather than grading it, so a card only has
       something to say when the sort could not settle the line: an override, or
       a lump with no per-item cost to sort on. */
    const capLumpOpen = (l: any, a: any) =>
      onThreshold(l) && l.shape === SHAPES.LUMP && (a[l.id] ?? 0) >= contract.capitalizationThreshold;
    const capPass = (l: any, a: any) => !isClassOverride(l) && !capLumpOpen(l, a);

    const monthsOver = (l: any) => isSalaryLine(l) && periodProblem(l, lines) != null;

    const allocEntries = (l: any): [string, number][] =>
      (Object.entries(l.allocations ?? {}) as [string, number][]).sort((a, b) => b[1] - a[1]);
    const allocSum = (l: any) => allocEntries(l).reduce((a, [, p]) => a + p, 0);
    const allocText = (l: any) => {
      const e = allocEntries(l);
      return e.length ? e.map(([id, p]) => `${weLabel(id)} — ${p}%`).join(', ') : 'Not allocated';
    };
    /* The same split, short enough to sit on a card's read-out line. */
    const allocShortText = (l: any) =>
      allocEntries(l).map(([id, p]) => `${weShort(id)} ${p}%`).join(' · ');

    const syncLabel = (l: any) => {
      if (l.shape === SHAPES.TRAVEL || l.category === 'personnel-salary') l.label = displayLabel(l);
    };

    /** The one flag a card carries, in the same precedence all three versions use. */
    const flagOf = (l: any, a: any) =>
      gsaOver(l) ? 'gsa'
      : allocSum(l) !== 100 ? 'alloc'
      : !capPass(l, a) ? 'capital'
      : monthsOver(l) ? 'months'
      : '';

    /* ── Option sets ── */
    /* Travel is deliberately absent: a travel line states a location and a year
       and the published table answers — it does not pick a schedule ROW. */
    const gsaOptionsFor = (l: any) => {
      const rows =
        l.category === 'vehicles' && l.vehicleKind
          ? gsaRatesForVehicleKind(l.vehicleKind)
          : gsaRatesFor(l.category);
      return rows.map((g: any) => ({ label: `${g.location} · ${g.kind} · ${g.season}`, value: g.key }));
    };
    /* The roster is whatever the salary lines say it is — derived, never stored,
       so the two can never disagree. */
    const positionOptions = () => rosterFor(lines).map((p: any) => ({ label: p.title, value: p.key }));
    /* esa-combobox only commits values present in `options`, so "create" is an
       OPTION rather than free text escaping the control: a term matching no
       existing title is offered as one. Its label contains the term, so it
       survives the combobox's own label filter. */
    const NEW_POS = '__new-position__:';
    /** Re-seed every personnel combobox — the roster is shared across the steps. */
    const refreshPositionOptions = () => {
      const opts = positionOptions();
      lines.filter(isSalaryLine).forEach((l) => {
        const card = cardOf(l.id);
        const combo: any = card && $('[data-position-combo]', card);
        if (combo) { combo.options = opts; combo.value = l.staffKey ?? ''; }
      });
    };

    /* ── fill: entry VALUES. Never called while the vendor is typing into the
       field being written, so the caret cannot jump. ── */
    const fillCard = (card: HTMLElement, l: any) => {
      card.dataset.line = l.id;
      const set = (sel: string, v: string) => { const el: any = $(sel, card); if (el) el.value = v; };
      set('[data-field="label"]', l.label ?? '');
      set('[data-field="qty"]', numText(l.qty));
      set('[data-field="qtyUnit"]', l.qtyUnit ?? '');
      set('[data-field="qty2"]', numText(l.qty2));
      set('[data-field="qty2Unit"]', l.qty2Unit ?? '');
      set('[data-field="rate"]', numText(l.rate));
      set('[data-field="rateOverride"]', numText(l.rateOverride));
      set('[data-field="amount"]', numText(l.amount));
      set('[data-field="count"]', numText(travelCount(l)));
      set('[data-field="locality"]', l.locality ?? '');
      set('[data-field="standardLocality"]', l.standard?.locality ?? '');
      const yrSel: any = $('[data-standard-year]', card);
      if (yrSel) { yrSel.options = fiscalYearOptions(); yrSel.value = String(l.standard?.year ?? ''); }
      set('[data-field="duration"]', numText(l.duration));
      set('[data-field="fringePct"]', (fringePctOf(l) * 100).toFixed(1));

      $$('[data-alloc-we]', card).forEach((el: any) => {
        const p = l.allocations?.[el.dataset.allocWe];
        el.value = p != null ? String(p) : '';
      });

      const gsaSel: any = $('[data-gsa-select]', card);
      if (gsaSel) { gsaSel.options = gsaOptionsFor(l); gsaSel.value = l.gsaKey ?? ''; }
      const posCombo: any = $('[data-position-combo]', card);
      if (posCombo) { posCombo.options = positionOptions(); posCombo.value = l.staffKey ?? ''; }
      const tuSel: any = $('[data-time-unit-select]', card);
      if (tuSel) { tuSel.options = TIME_UNITS.map((u: any) => ({ label: u.plural, value: u.key })); tuSel.value = timeUnit(l).key; }
      const tkSel: any = $('[data-travel-kind-select]', card);
      if (tkSel) { tkSel.options = TRAVEL_KINDS.map((k: any) => ({ label: k.label, value: k.key })); tkSel.value = l.travelKind ?? ''; }
      /* "Not part of a trip" is an OPTION, not the absence of one: a select whose
         empty state means something has to say what it means. The list is rebuilt
         on every fill because a trip added on this step is a new choice here. */
      const trSel: any = $('[data-trip-select]', card);
      if (trSel) {
        trSel.options = [
          { label: 'Not part of a trip', value: NO_TRIP },
          ...trips.map((t: any) => ({ label: tripLabel(t), value: t.key })),
        ];
        trSel.value = l.trip || NO_TRIP;
      }
      const vkSel: any = $('[data-vehicle-kind-select]', card);
      if (vkSel) { vkSel.options = VEHICLE_KINDS.map((k: any) => ({ label: k.label, value: k.key })); vkSel.value = l.vehicleKind ?? ''; }
    };

    /* ── paint: everything DERIVED — which fields exist, what they are called,
       every gate, the mark, and the amount. Runs on every recompute. ── */
    const paintCard = (card: HTMLElement | null, l: any, priced: any) => {
      if (!card) return;
      const a = priced.amounts;
      const derived = derivedRow(l);
      const sum = allocSum(l);

      setText($('[data-name]', card), displayLabel(l) || 'Untitled line');
      setText($('[data-amount]', card), usd(a[l.id] ?? 0));
      show($('[data-delete]', card), !derived);
      /* A derived card carries no grab: its position follows the salary line it
         was generated from, and syncFringeCards re-appends the whole step in
         list order on every recompute. (No role check here — unlike the two
         grids, the wizard is the VENDOR's surface only; the COR reviews on
         /lib-entry or /lib-entry-sheet.) */
      show($('[data-grab]', card), !derived);
      const grabBtn = $('[data-grab] button', card);
      const grabName = `Reorder ${displayLabel(l) || 'this line'} — press Space to lift it, then use the arrow keys`;
      grabBtn?.setAttribute('aria-label', grabName);
      grabBtn?.setAttribute('title', grabName);

      /* Identity — reveal the one control that names a line in THIS category. */
      const ident = identOf(l);
      $$('[data-ident]', card).forEach((el) => show(el, el.dataset.ident === ident));
      if (ident === 'position') {
        /* An untitled personnel line defines no position, so it prices nothing
           and generates no fringe. That is worth an error, not a silent zero. */
        show($('[data-position-err]', card), !positionKey(l.label ?? ''));
        /* The type is NOT restated on the card: it belongs to the position, and
           the sub-block heading this card sits under already names it. */
      }
      setText($('[data-ident-derived]', card), displayLabel(l));

      /* Quantity — four renderings, one live. */
      const isTravel = l.shape === SHAPES.TRAVEL;
      const voidQty = l.shape === SHAPES.LUMP || l.shape === SHAPES.PCT_OF_BASE;
      const derivedQty = !!l.qtyFrom;
      show($('[data-group="quantity"]', card), !voidQty || isTravel);
      show($('[data-qty-typed]', card), !isTravel && !voidQty && !derivedQty);
      show($('[data-travel-qty]', card), isTravel);
      show($('[data-qty-derived]', card), derivedQty);
      if (derivedQty) {
        const src = lines.find((s) => s.id === l.qtyFrom);
        setText($('[data-qty-derived-value]', card), `${qtyFmt(effectiveQty(l, lines))} ${l.qtyUnit ?? ''}`.trim());
        setText($('[data-qty-derived-src]', card), `Follows ${src ? displayLabel(src) : l.qtyFrom} — change it there.`);
      }

      /* Three renderings of the unit, exactly one live. */
      const locked = unitLocked(l);
      show($('[data-unit-open]', card), !locked);
      show($('[data-unit-select]', card), unitPicked(l));
      show($('[data-unit-static]', card), locked && !unitPicked(l));
      setText($('[data-unit-static-value]', card), lockedUnit(l));
      setLabel($('[data-field="qty"]', card), isSalaryLine(l) ? `Time (${timeUnit(l).plural})` : 'Quantity');

      /* Siblings in the quantity row now, not a row of their own — so the unit
         is gated on the quantity existing as well as on the unit being open. */
      const hasQty2 = l.qty2 != null && !isTravel && !voidQty;
      show($('[data-qty2]', card), hasQty2);
      show($('[data-unit2-open]', card), hasQty2 && !locked);
      show($('[data-unit2-static]', card), hasQty2 && locked);
      setText($('[data-unit2-static-value]', card), lockedUnit2(l));

      /* Grouping belongs to travel and nothing else, and the destination belongs
         to a travel line only while it has no trip to inherit one from. The
         resolution — separately listed, or standard CONUS — rides the field as
         its help text, which is where this surface puts every other rule. */
      show($('[data-travel-group]', card), isTravel);
      if (isTravel) {
        show($('[data-travel-dest]', card), isLooseTravel(l));
      }

      if (isTravel) {
        const k = travelKind(l.travelKind);
        setLabel($('[data-field="count"]', card), k?.countLabel ? `Count (${k.countLabel})` : 'Count');
        show($('[data-duration]', card), !!k?.durationLabel);
        setLabel($('[data-field="duration"]', card), k?.durationLabel ? `Duration (${k.durationLabel})` : 'Duration');
      }

      /* The contract period, on the axis every time unit shares. */
      const monthsBad = monthsOver(l);
      setGate(
        card, 'months', monthsBad, 'Past contract period',
        `${countOf(effectiveQty(l, lines), timeUnit(l).plural)} is ${qtyFmt(timeInMonths(l, lines))} months of work in a ${contractMonths}-month contract period — one individual cannot be budgeted for more time than the contract runs.`,
      );
      show($('[data-months-note]', card), isSalaryLine(l) && !monthsBad);
      if (isSalaryLine(l)) {
        setText(
          $('[data-months-note]', card),
          `${countOf(effectiveQty(l, lines), timeUnit(l).plural)} of the ${contractMonths}-month contract period.`,
        );
      }

      /* Rate — typed, claimed, referenced, a lump, or derived. A travel card
         always shows the typed field, disabled while a claim sits on top of it:
         that number is still the vendor's and returns when the claim is dropped.
         The GSA block below is vehicles only now. */
      const isTravelLine = l.shape === SHAPES.TRAVEL;
      const scheduled = !isTravelLine && isScheduleRated(l);
      const claimed = claimsStandard(l);
      show($('[data-rate-typed]', card), isTravelLine || (!scheduled && !voidQty));
      const typedField: any = $('[data-rate-typed]', card);
      if (typedField) typedField.disabled = claimed;
      show($('[data-rate-lump]', card), l.shape === SHAPES.LUMP);
      show($('[data-rate-gsa]', card), scheduled);

      show($('[data-standard]', card), isTravelLine);
      if (isTravelLine) {
        const offered = canClaimStandard(l);
        show($('[data-standard-toggle]', card), offered);
        show($('[data-standard-fields]', card), claimed);
        show($('[data-standard-where]', card), claimed && standardNeedsWhere(l));
        show($('[data-standard-none]', card), !offered);
        setText($('[data-standard-none]', card), typedSrcText(l));
        setBtnLabel($('[data-standard-toggle]', card), claimed ? 'Use my own rate' : 'Use the standard rate');
        setText($('[data-standard-rate]', card), standardAmountText(l));
        setText($('[data-standard-src]', card), standardSrcText(l));
        setText($('[data-standard-superseded]', card), supersededText(l));
      }
      show($('[data-rate-derived]', card), l.shape === SHAPES.PCT_OF_BASE);
      setLabel($('[data-field="rate"]', card), rateLabelOf(l));

      if (scheduled) {
        const g = gsaOf(l);
        setText($('[data-ref-rate]', card), money(effectiveRate(l)));
        setText(
          $('[data-ref-src]', card),
          g
            ? `Referenced from ${g.location} · ${g.kind} · ${g.season} — not typed. Ceiling ${money(g.ceiling)}.`
            : 'Pick the GSA schedule row this line references — it sets the rate.',
        );
        setBtnLabel($('[data-override-toggle]', card), overridden(l) ? 'Use schedule rate' : 'Override rate');
        show($('[data-override-field]', card), overridden(l));
        setGate(
          card, 'gsa', gsaOver(l), 'Over GSA ceiling',
          g
            ? `${money(l.rateOverride)} is over the ${g.kind} ceiling of ${money(g.ceiling)} for ${g.location} (${g.season}) — ${money(l.rateOverride - g.ceiling)} over.`
            : 'Select the GSA schedule row this line references.',
        );
      } else {
        setGate(card, 'gsa', false, '', '');
      }

      if (l.shape === SHAPES.PCT_OF_BASE) {
        /* One position at two rates blends to a rate that is on neither line, so
           the card says which it is rather than printing a number nothing typed. */
        const sal = lines.filter((s) => isSalaryLine(s) && s.staffKey === l.base?.staffKey);
        const blended = new Set(sal.map((s) => fringePctOf(s))).size > 1;
        setText($('[data-derived-pct]', card), `${((l.pct ?? 0) * 100).toFixed(1)}%${blended ? ' blended' : ''}`);
        setText($('[data-derived-base]', card), `${money(baseAmountFor(l, lines, a))} base · ${baseLabelFor(l, lines)}`);
        setText($('[data-derived-src]', card), `Rate carried on the ${baseLabelFor(l, lines)} salary line — change it on the Salary step.`);
      }

      /* Fringe, stated where it is decided AND where it lands. */
      show($('[data-fringe]', card), isSalaryLine(l));
      if (isSalaryLine(l)) {
        setText($('[data-fringe-note]', card), `${money(fringeOnLine(l, lines, a))} of fringe, carried on the Fringe step.`);
      }

      /* ── The capitalization threshold ─────────────────────────────────────
         The per-item cost files the item; the card states where it landed and
         what that does to the money, and raises a gate only for the two things
         the sort cannot settle — an override, and a lump with no per-item cost
         to sort on. */
      const capBad = onThreshold(l) && !capPass(l, a);
      setGate(
        card, 'capital', capBad,
        isClassOverride(l) ? 'Overrides the threshold' : 'Too large to test per item',
        isClassOverride(l)
          ? `Filed as ${equipmentClassLabel(l.block)} against the sort: at ${money(perItemCost(l, a))} per item the ${usd(contract.capitalizationThreshold)} threshold makes this ${equipmentClassLabel(thresholdTargetFor(l))}. This override needs the COR's agreement.`
          : `A ${money(a[l.id] ?? 0)} lump has no per-item cost, so the ${usd(contract.capitalizationThreshold)} threshold cannot reach inside it. Itemize this line so each item files itself.`,
      );
      setBtnLabel(
        $('[data-cap-move]', card),
        isClassOverride(l) ? 'Use the threshold' : 'File as a supply instead',
      );
      /* The move affordance is the OVERRIDE toggle now, and it runs one way: an
         item that met the threshold can be argued back down to a supply, and
         nothing argues a cheap item up. See canOverrideThreshold. */
      show($('[data-cap-move]', card), canOverrideThreshold(l, a));
      show($('[data-cap-note]', card), thresholdTested(l) && !capBad);
      if (thresholdTested(l)) {
        setText(
          $('[data-cap-note]', card),
          `${money(perItemCost(l, a))} per item — filed as ${equipmentClassLabel(l.block)}. ${filingConsequence(l, cfg)}`,
        );
      }

      /* Allocation — a derived row's split is inherited, so it reads as a value
         and the note points at the step that can actually change it. */
      show($('[data-alloc-list]', card), !derived);
      show($('[data-alloc-derived]', card), derived);
      const sumEl = $('[data-alloc-sum]', card);
      show(sumEl?.parentElement ?? null, !derived);
      setText(sumEl, `${sum}%`);
      /* The split is folded away by default, so the total is joined out here by
         what it is a total OF — a folded card still reads. Letters and codes,
         not titles: the titles caption the fields inside the fold. */
      setText($('[data-alloc-split]', card), sum ? allocShortText(l) : '');
      const aErr = $('[data-alloc-err]', card);
      show(aErr, sum !== 100);
      /* A fix is never hidden: a split that does not total 100% springs its
         disclosure open — once. After the vendor has worked the caret on this
         card themselves (see the click handler), the fold is theirs to keep. */
      const aFold: any = $('[data-alloc-list] details', card);
      if (aFold && !derived && sum !== 100 && !card.dataset.allocFolded) aFold.open = true;
      if (sum !== 100) {
        setErrText(
          aErr,
          derived
            ? `Follows ${baseLabelFor(l, lines)} — allocate that position's salary lines on the Salary step and this follows.`
            : sum === 0
              ? 'No work element assigned — allocations must total 100%.'
              : `Allocated ${sum}% — work-element allocations must total 100%.`,
        );
      }
      if (derived) {
        setText($('[data-alloc-derived-value]', card), allocText(l));
        setText($('[data-alloc-derived-src]', card), `Inherited from ${baseLabelFor(l, lines)}, weighted by its salary lines.`);
      }

      /* The subcontract seam. */
      const seam = $('[data-open-sheet]', card);
      if (seam) {
        show(seam, !!l.sheet);
        if (l.sheet) { seam.dataset.openSheet = l.sheet; seam.dataset.openSheetLine = l.id; }
      }

      /* The COR's mark — read-only here; writing one is the reviewer's job. */
      const f = flagFor(review, l.id);
      const band = $('[data-mark]', card);
      show(band, !!f && isIssued(review));
      if (band) band.dataset.sev = f?.severity ?? '';
      if (f) {
        setText($('[data-mark-reason]', card), reasonLabel(f.reason));
        setText($('[data-mark-note]', card), f.note || 'No note written.');
        setText($('[data-mark-by]', card), `${f.author} · ${f.date}`);
      }

      /* Card state — an inline tint, never a colored left border. */
      const flag = flagOf(l, a);
      if (flag) card.dataset.flag = flag;
      else card.removeAttribute('data-flag');
    };

    /* ── The step roll-up ────────────────────────────────────────────────────
       The wizard's one real debt: a gate that fails on a step you have left is a
       gate you cannot see. So every step's failures are counted and badged on
       the rail, and the count moves the instant an edit anywhere changes it. */
    const issuesFor = (catKey: string, priced: any) =>
      lines.filter((l) => l.category === catKey && flagOf(l, priced.amounts)).length;

    const paintSteps = (priced: any) => {
      categories.forEach((cat: any, i: number) => {
        const step = $(`[data-step="${cat.key}"]`);
        setText($(`[data-cat-total="${cat.key}"]`), usd(priced.byCategory[cat.key] ?? 0));
        (cat.blocks ?? []).forEach((b: any) => {
          const k = `${cat.key}:${b.key}`;
          setText($(`[data-block-total="${k}"]`), usd(priced.byBlock[k] ?? 0));
        });

        const n = lines.filter((l) => l.category === cat.key).length;
        setText($('[data-step-count]', step ?? root), n ? countOf(n, 'lines') : 'No lines yet');
        show($('[data-step-empty]', step ?? root), n === 0);

        /* The rail badge, and the summary row's mirror of it. */
        const bad = issuesFor(cat.key, priced);
        const item = $(`[data-step-item="${cat.key}"]`);
        const badge = item ? $('[data-step-issues]', item) : null;
        show(badge, bad > 0);
        setBadgeText(badge, String(bad));
        setText(
          item ? $('[data-step-sr]', item) : null,
          bad ? `${bad} ${bad === 1 ? 'problem' : 'problems'} on this step` : '',
        );
        const sumIssues = $(`[data-summary-cat="${cat.key}"] [data-summary-issues]`);
        show(sumIssues, bad > 0);
        setText(sumIssues, bad ? `${bad} to fix` : '');
        setText($(`[data-summary-total="${cat.key}"]`), usd(priced.byCategory[cat.key] ?? 0));
      });

      /* Trip heads carry facts of their own, and the destination's resolution is
         the thing a plain text box cannot say on its own. */
      trips.forEach((t: any) => {
        const head = $(`[data-trip="${t.key}"]`);
        if (!head) return;
        setText($('[data-block-label]', head), tripLabel(t));
      });
    };

    const paintTotals = (t: any) => {
      setText($('[data-total="direct"]'), usd(t.direct));
      setText($('[data-total="indirectBase"]'), usd(t.indirectBase));
      setText($('[data-total="indirect"]'), usd(t.indirect));
      setText($('[data-total="total"]'), usd(t.total));
      setText($('[data-indirect-rate]'), pct(cfg.rate));
      setText($('[data-indirect-ref]'), cfg.referenceDoc ?? '');
      const out = categories.filter((c: any) => !cfg.appliesTo.includes(c.key)).map((c: any) => c.label);
      setText(
        $('[data-indirect-scope]'),
        out.length
          ? `${cfg.appliesTo.length} of ${categories.length} categories in scope — ${out.join(' and ')} excluded`
          : `All ${categories.length} categories in scope`,
      );
      setText(
        $('[data-total-note]'),
        `${pct(t.pctOfValue, 1)} of the ${usd(contract.contractValue)} Contract Value · ${
          t.remaining >= 0 ? `${usd(t.remaining)} remaining` : `${usd(Math.abs(t.remaining))} over`
        }`,
      );

      /* The review step states what is outstanding BEFORE the numbers. */
      const bad = lines.filter((l) => flagOf(l, priceLines(lines, cfg).amounts)).length;
      const marks = (review.flags ?? []).filter(
        (f: any) => !(review.addressed ?? []).includes(f.lineId),
      ).length;
      const parts: string[] = [];
      if (bad) parts.push(`${countOf(bad, 'lines')} with a failing check`);
      if (isIssued(review) && marks) parts.push(`${countOf(marks, 'marks')} from the COR still to address`);
      show($('[data-outstanding]'), parts.length > 0);
      setText($('[data-outstanding-msg]'), parts.length ? `${parts.join(', and ')}. The rail lists every check.` : '');
    };

    /** The one broadcast the reconciliation rail consumes — identical payload to
        both other versions, which is what lets the rail be reused unchanged. */
    const fireTotals = (t: any) => {
      document.dispatchEvent(
        new CustomEvent('cbf-lib:totals', {
          detail: {
            total: t.total,
            direct: t.direct,
            indirect: t.indirect,
            indirectBase: t.indirectBase,
            remaining: t.remaining,
            pctOfValue: t.pctOfValue,
            failing: gsaFailingLines(lines).length,
            unallocated: unallocatedLines(lines).length,
            capitalFailing: thresholdMisfiled(lines).length + untestableEquipmentLumps(lines).length,
            monthsFailing: monthsOverPeriod(lines).length,
          },
        }),
      );
    };

    const flash = (els: (HTMLElement | null)[]) => {
      els.filter(Boolean).forEach((el) => {
        const node = el as HTMLElement;
        node.classList.remove('is-recomputed');
        void node.offsetWidth; // restart the animation on a repeat edit
        node.classList.add('is-recomputed');
        window.setTimeout(() => node.classList.remove('is-recomputed'), 1500);
      });
    };

    /* ── Card placement ── */
    const containerFor = (catKey: string, block: string) =>
      $(`[data-step="${catKey}"] [data-block-lines="${block ?? ''}"]`);

    const placeCard = (card: HTMLElement, catKey: string, block: string) => {
      const box = containerFor(catKey, block) ?? containerFor(catKey, '');
      if (box) box.appendChild(card);
    };

    /* ── ONE card template ───────────────────────────────────────────────────
       Every card ships every variant and reveals what the line's shape has, so a
       single clone source covers all five shapes — and a line that changes shape
       or category is MOVED, never rebuilt. */
    const cardTemplate = ($$('.cbf-libwl')[0] as HTMLElement | undefined)
      ?.cloneNode(true) as HTMLElement | undefined;

    /* ── The generated Fringe step, kept in step with the Salary step ────────
       syncFringeLines() rewrites the fringe LINES; this reconciles the CARDS. */
    const syncFringeCards = () => {
      syncFringeLines(lines);
      const box = containerFor('personnel-fringe', '');
      if (!box || !cardTemplate) return;
      const want = lines.filter((l) => l.category === 'personnel-fringe');
      const wanted = new Set(want.map((l) => l.id));

      $$('.cbf-libwl', box).forEach((c) => {
        if (!wanted.has(c.dataset.line!)) c.remove();
      });
      want.forEach((line) => {
        let card = cardOf(line.id);
        if (!card) {
          card = cardTemplate.cloneNode(true) as HTMLElement;
          box.appendChild(card);
          fillCard(card, line);
        }
        if (card.parentElement === box) box.appendChild(card);
      });
    };

    const recompute = (originId?: string) => {
      syncFringeCards();
      const priced = priceLines(lines, cfg);
      lines.forEach((l) => paintCard(cardOf(l.id), l, priced));
      /* The ordinal is per STEP, so it is numbered after the cards are in place. */
      categories.forEach((cat: any) => {
        let n = 0;
        $$(`[data-step="${cat.key}"] .cbf-libwl`).forEach((c) => {
          setText($('[data-ord]', c), `Line ${++n}`);
        });
      });
      paintSteps(priced);
      paintTotals(priced.totals);
      fireTotals(priced.totals);
      if (originId) flash(dependentsOf(originId, lines).map((l: any) => cardOf(l.id)));
      return priced;
    };

    /* ── Step navigation ─────────────────────────────────────────────────────
       Free, not linear: a vendor revising one marked line should not have to walk
       ten steps to reach it. What the wizard enforces is ORDER as a default, not
       as a gate — nothing here refuses to advance, because an empty category is a
       valid answer and a failing gate is the rail's business, not the nav's. */
    const goto = (i: number, opts: { scroll?: boolean } = {}) => {
      const next = Math.max(0, Math.min(STEP_KEYS.length - 1, i));
      active = next;
      visited.add(next);

      STEP_KEYS.forEach((key, idx) => {
        show($(`[data-step="${key}"]`), idx === next);
        const item = $(`[data-step-item="${key}"]`);
        if (item) {
          item.dataset.state = idx === next ? 'current' : visited.has(idx) ? 'done' : 'ahead';
          const btn = $('button', item);
          if (idx === next) btn?.setAttribute('aria-current', 'step');
          else btn?.removeAttribute('aria-current');
        }
      });

      const bar: any = $('.cbf-libwn__bar esa-progress-bar, .cbf-libwn__bar .esa-progress-bar');
      const fill = $('.cbf-libwn__bar .esa-progress-bar__fill');
      const pctDone = Math.round(((next + 1) / STEP_KEYS.length) * 100);
      if (fill) (fill as HTMLElement).style.width = `${pctDone}%`;
      if (bar) bar.setAttribute?.('aria-valuenow', String(pctDone));

      setText($('[data-nav-label]'), STEP_LABELS[STEP_KEYS[next]] ?? '');
      setText($('[data-nav-sub]'), `Step ${next + 1} of ${STEP_KEYS.length}`);
      const backBtn = $('[data-nav-back] button') as HTMLButtonElement | null;
      if (backBtn) backBtn.disabled = next === 0;
      /* The last step has nowhere to continue TO. The slot keeps its space
         rather than being removed, so the centred "Step N of M" does not jump to
         the right edge on the final step. visibility (not display) also takes the
         button out of the tab order. */
      $('[data-nav-next]')?.classList.toggle('is-spent', next === STEP_KEYS.length - 1);

      /* Bring the current step chip into view — with eleven steps the rail
         scrolls, and the one you are on is the one that must be visible. */
      $(`[data-step-item="${STEP_KEYS[next]}"]`)?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      if (opts.scroll !== false) {
        root.querySelector('.cbf-libw__panels')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    /* ── Seeding a NEW line — the same rules all three versions use ── */
    const defaultGsaKeyFor = (catKey: string) => {
      const sibling = lines.find((l) => l.category === catKey && l.gsaKey);
      return sibling?.gsaKey ?? gsaRatesFor(catKey)[0]?.key ?? gsaRates[0].key;
    };
    const applyTravelKind = (l: any, kindKey: string) => {
      const k = travelKind(kindKey);
      l.travelKind = kindKey;
      if (!k) return;
      l.duration = k.durationLabel ? (l.duration ?? 1) : undefined;
      l.count = seedCountFor(l.trip, kindKey, lines.filter((x) => x.id !== l.id));
      /* Every travel rate is typed; the kind only decides whether a CLAIM on a
         published rate is available. A kind with nothing published drops a live
         claim, and the typed rate underneath is what the line falls back to. */
      l.rate = l.rate ?? 0;
      delete l.gsaKey;
      delete l.rateOverride;
      if (!hasStandardRate(kindKey)) delete l.standard;
      else if (l.standard) l.standard = normalizeClaim(l, l.standard);
      syncLabel(l);
    };

    const applyVehicleKind = (l: any, kindKey: string) => {
      const k = vehicleKind(kindKey);
      l.vehicleKind = kindKey;
      if (!k) return;
      l.shape = k.shape;
      l.qtyUnit = k.unit;
      if (k.secondUnit) { l.qty2 = l.qty2 ?? 1; l.qty2Unit = k.secondUnit; }
      else { delete l.qty2; delete l.qty2Unit; }
      if (k.shape === SHAPES.AUTHORITY) {
        delete l.rate;
        const allowed = gsaRatesForVehicleKind(kindKey);
        if (!allowed.some((g: any) => g.key === l.gsaKey)) l.gsaKey = allowed[0]?.key ?? '';
      } else {
        delete l.gsaKey;
        delete l.rateOverride;
        l.rate = l.rate ?? 0;
      }
      if (!l.label) l.label = k.label;
    };

    const addLine = (catKey: string, block: string, shape: string, kind = '') => {
      if (!cardTemplate) return;
      const line: any = {
        id: `new-${++seq}-${Date.now().toString(36)}`,
        category: catKey,
        shape,
        label: '',
        allocations: {},
      };
      if (block) line.block = block;
      if (shape === SHAPES.QTY_RATE) { line.qty = 1; line.qtyUnit = ''; line.rate = 0; }
      if (shape === SHAPES.AUTHORITY) { line.qty = 1; line.qtyUnit = ''; line.gsaKey = defaultGsaKeyFor(catKey); }
      /* A category that fixes the unit carries it on the line — see the same
         seeding in cbf-lib-cost-table. */
      const fixedUnit = categoryFixedUnit(catKey);
      if (fixedUnit) line.qtyUnit = fixedUnit;
      if (shape === SHAPES.LUMP) line.amount = 0;
      if (catKey === 'personnel-salary') {
        /* Untitled on purpose. There is no roster to pick a default off, and
           guessing a title would put a position on the budget that nobody chose.
           The card opens with its combobox empty and an error saying so. */
        line.label = '';
        line.staffKey = '';
        line.block = block === 'admin' ? 'admin' : 'technical';
        line.qty = 1;
        line.timeUnit = 'month';
        line.qtyUnit = timeUnit(line).plural;
        line.fringePct = DEFAULT_FRINGE_PCT;
      }
      if (shape === SHAPES.TRAVEL) {
        /* The ungrouped block is a block, not a trip: it files the card and
           leaves `trip` null, which is what every travel derivation reads to
           decide whether there is a journey behind this cost. */
        line.block = block || NO_TRIP;
        line.trip = block && block !== NO_TRIP ? block : null;
        if (!line.trip) line.locality = '';
        applyTravelKind(line, kind || TRAVEL_KINDS[0].key);
      }
      if (catKey === 'vehicles' && kind) applyVehicleKind(line, kind);
      syncLabel(line);

      const card = cardTemplate.cloneNode(true) as HTMLElement;
      placeCard(card, catKey, blockOf(line));
      lines.push(line);
      fillCard(card, line);
      recompute();
      card.classList.add('is-added');
      window.setTimeout(() => card.classList.remove('is-added'), 1500);
      card.scrollIntoView({ block: 'center', behavior: 'smooth' });
      window.requestAnimationFrame(() => {
        /* Focus this category's FIRST question — the description on most cards,
           but the duration on a travel line, whose kind the vendor already
           answered by choosing the menu item. */
        const first: any =
          shape === SHAPES.TRAVEL
            ? ($('[data-field="duration"]', card) ?? $('[data-field="count"]', card))
            : ($('[data-field="label"]', card) ?? $('[data-position-combo]', card));
        first?.shadowRoot?.querySelector('input')?.focus();
      });
    };

    /** A line that changes category CHANGES STEP — the one move a wizard makes
        louder than a grid does, so it is announced rather than silently done. */
    const moveLine = (line: any, target: { category: string; block: string }) => {
      const card = cardOf(line.id);
      line.category = target.category;
      /* Placement only. The line's OWN block is left alone — a category with no
         sub-blocks simply ignores it (blockOf), and dropping it here would lose
         an Office item's block the moment it crossed the threshold. */
      if (card) placeCard(card, line.category, target.block);
      recompute(line.id);
      const toStep = STEP_KEYS.indexOf(line.category);
      if (toStep >= 0) goto(toStep);
      if (card) {
        flash([card]);
        card.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    };

    /* ── Filing an equipment line into the class its cost puts it in ─────────
       The two classes are BLOCKS of one step now, not two steps, so crossing the
       threshold no longer navigates the vendor anywhere — the card re-seats under
       the other block heading on the page they are already on. moveLine still
       flashes and scrolls to it, because a card relocating under you has to be
       visible even when it only moved a little way. Returns whether it moved. */
    let filing = false;
    const fileLine = (line: any) => {
      if (filing || !onThreshold(line)) return false;
      const move = autoFileEquipment(line, priceLines(lines, cfg).amounts);
      if (!move) return false;
      filing = true;
      moveLine(line, { category: line.category, block: blockOf(line) });
      filing = false;
      return true;
    };

    /* ── Add menus — the VENDOR's vocabulary, not the model's ── */
    const SHAPE_MENU_LABEL: Record<string, string> = {
      [SHAPES.QTY_RATE]: 'Itemized — quantity × cost per unit',
      [SHAPES.AUTHORITY]: 'GSA schedule rate',
      [SHAPES.PCT_OF_BASE]: 'Percentage of a base',
      [SHAPES.LUMP]: 'Lump sum',
      [SHAPES.TRAVEL]: 'Travel line',
    };
    $$('[data-add-menu]').forEach((menu: any) => {
      const cat = categories.find((c: any) => c.key === menu.dataset.addMenu);
      if (!cat) return;
      if (cat.key === 'vehicles') {
        menu.items = VEHICLE_KINDS.map((k: any) => ({ label: k.label, action: `vehicles||${k.shape}|${k.key}` }));
        return;
      }
      if (cat.key === 'personnel-salary') {
        menu.items = PERSONNEL_TYPES.map((t: any) => ({
          label: `${t.label} position`,
          action: `personnel-salary|${t.key}|${SHAPES.QTY_RATE}|`,
        }));
        return;
      }
      if (cat.entersEquipment) {
        /* The one entry point for equipment, whichever class it ends up in — so
           the menu must NOT ask the question the sort answers. A new line always
           opens in the expensed block (a $0 item is not capital) and re-files
           itself the moment a rate is typed. What is left to choose is the only
           thing that genuinely differs: an ITEM, which has a per-item cost and
           therefore files itself, and a LUMP, which has none and therefore
           cannot — which is why a large one is held at the gate. */
        menu.items = [
          { label: 'Item — a quantity and a cost each',
            action: `${cat.key}|expensed|${SHAPES.QTY_RATE}|` },
          { label: 'Lump sum — one amount, no per-item cost',
            action: `${cat.key}|expensed|${SHAPES.LUMP}|` },
        ];
        return;
      }
      const blocks = cat.blocks ?? [null];
      menu.items = blocks.flatMap((b: any, bi: number) => [
        ...(bi > 0 ? [{ divider: true }] : []),
        ...cat.shapes.map((s: string) => ({
          label: b ? `${b.label} — ${SHAPE_MENU_LABEL[s]}` : SHAPE_MENU_LABEL[s],
          action: `${cat.key}|${b ? b.key : ''}|${s}|`,
        })),
      ]);
    });

    const wireTravelMenu = (menu: any) => {
      menu.items = TRAVEL_KINDS.map((k: any) => ({
        label: k.label,
        action: `travel|${menu.dataset.addTravel}|${SHAPES.TRAVEL}|${k.key}`,
      }));
    };
    $$('[data-add-travel]').forEach(wireTravelMenu);

    /* ── Adding a TRIP: the container, not a line ── */
    const tripBlockTemplate = ($('[data-trip]') as HTMLElement | null)
      ?.cloneNode(true) as HTMLElement | undefined;

    /** The container for a trip that already exists in the model, unattached. */
    const buildTripBlock = (trip: any): HTMLElement | null => {
      if (!tripBlockTemplate) return null;
      const block = tripBlockTemplate.cloneNode(true) as HTMLElement;
      block.dataset.blockhead = trip.key;
      block.dataset.trip = trip.key;
      $('[data-block-total]', block)?.setAttribute('data-block-total', `travel:${trip.key}`);
      $('[data-block-lines]', block)?.setAttribute('data-block-lines', trip.key);
      /* A cloned trip carries the source trip's cards — this one starts empty
         and is filled by whoever asked for it. */
      $$('.cbf-libwl', block).forEach((c) => c.remove());
      const menu: any = $('[data-add-travel]', block);
      if (menu) { menu.dataset.addTravel = trip.key; wireTravelMenu(menu); }
      ['locality', 'window', 'occurrences'].forEach((f) => {
        const el: any = $(`[data-trip-field="${f}"]`, block);
        if (el) el.value = f === 'occurrences' ? String(trip.occurrences ?? 1) : String(trip[f] ?? '');
      });
      return block;
    };

    /** Put the caret on the trip's first unanswered question. */
    const focusTripBlock = (block: HTMLElement) => {
      window.requestAnimationFrame(() => {
        const dest: any = $('[data-trip-field="locality"]', block);
        dest?.shadowRoot?.querySelector('input')?.focus();
      });
    };

    const addTrip = () => {
      /* createTrip registers the trip in BOTH lists — the pricing engine's and
         Travel's block list, which paintSteps walks for sub-block subtotals. */
      const trip: any = createTrip();
      const block = buildTripBlock(trip);
      if (!block) return;
      $('[data-step="travel"] [data-step-body]')?.appendChild(block);
      recompute();
      block.classList.add('is-added');
      window.setTimeout(() => block.classList.remove('is-added'), 1500);
      block.scrollIntoView({ block: 'center', behavior: 'smooth' });
      focusTripBlock(block);
    };

    /* ── Deleting the container but not the costs ───────────────────────────
       The other half of dropTrip, and the reason both exist: a journey can be
       wrong while the costs under it are real. Each card is refiled into the
       ungrouped block by the SAME refile() the drag uses — so it carries away
       the destination it was pricing at and its schedule row is re-pointed by
       the one piece of code that knows how — and the node MOVES, because on this
       surface a block is a real container and a card left behind would sit under
       a heading that no longer claims it. What does change is `occurrences`: a
       line that is no longer part of a journey happens once. */
    const ungroupTrip = (key: string) => {
      const block = $(`[data-trip="${key}"]`);
      const box = $(`[data-block-lines="${NO_TRIP}"]`);
      const freed = lines.filter((l) => l.trip === key);
      freed.forEach((l) => {
        const card = cardOf(l.id);
        if (!card) return;
        const last = box ? $$('.cbf-libwl', box).filter((c) => c !== card).pop() : null;
        refile(l, NO_TRIP);
        if (box) box.appendChild(card);
        if (last?.dataset.line) moveInList(lines, l.id, last.dataset.line, 'after');
        /* refile() changes two VALUES on the card — the trip it says it belongs
           to, and the destination that just became its own — and paintCard only
           writes derived text. Without this the card would sit in the ungrouped
           block still naming the trip it left. */
        fillCard(card, l);
      });
      block?.remove();
      removeTrip(key);
      recompute();
      flash(freed.map((l) => cardOf(l.id)));
    };

    /* A trip and everything filed under it. The mirror of addTrip — and the
       harder of the two answers, which is why the softer one sits beside it. */
    const dropTrip = (key: string) => {
      lines.filter((l) => l.trip === key).forEach((l) => {
        cardOf(l.id)?.remove();
        const i = lines.findIndex((x) => x.id === l.id);
        if (i >= 0) lines.splice(i, 1);
      });
      $(`[data-trip="${key}"]`)?.remove();
      removeTrip(key);
      recompute();
    };

    /* ── Reordering, and Travel's grouping gesture ────────────────────────────
       Same engine as the two grids (src/lib/row-reorder.ts), same three
       outcomes: reorder among neighbours, cross a sub-block boundary to refile,
       or drop on the MIDDLE of another travel card to make the two a trip.

       The wizard is where this pays off most and where it is hardest to see:
       cards are tall, so two lines that belong together can be a scroll apart,
       and the step's "Line 1, Line 2" ordinals — renumbered off card order on
       every recompute — are the direct read-out of what the gesture changes.

       Unlike the grids, the container here is a real nested element, so refiling
       a card means moving the NODE into the other block's [data-block-lines] box
       and not just relabelling it. */
    const catOfCard = (el: HTMLElement) =>
      (el.closest('[data-step]') as HTMLElement | null)?.dataset.step ?? '';
    const blockOfCard = (el: HTMLElement) =>
      (el.closest('[data-block-lines]') as HTMLElement | null)?.dataset.blockLines ?? '';
    /* Fringe is generated in list order on every recompute; Capital Equipment is
       a destination lines are FILED into, not arranged in. */
    const REORDERABLE = (catKey: string) =>
      catKey !== 'personnel-fringe';

    const refile = (line: any, blockKey: string) => {
      if ((line.block ?? '') === blockKey) return;
      line.block = blockKey || undefined;
      if (line.category === 'travel') {
        /* Grouping and ungrouping are one gesture. Moving a card into the
           ungrouped block takes the line OUT of its trip, so it carries away a
           copy of the destination it was pricing at — without that the line
           silently re-prices at CONUS. Joining a trip drops that copy again: the
           trip's own field is then the only place it is typed. */
        const toTrip = blockKey && blockKey !== NO_TRIP ? blockKey : null;
        if (toTrip) delete line.locality;
        else line.locality = travelLocality(line);
        line.trip = toTrip;
        line.block = blockKey || NO_TRIP;
        /* Nothing re-prices on a move. A claim on a published rate names its own
           location and year — answers about the RATE, not about which trip the
           card is filed under — so grouping changes grouping and nothing else. */
        line.label = travelLabel(line);
      }
    };

    /** Trips a move emptied stop being facts about this budget. */
    const pruneTrips = (touched: (string | undefined)[]) => {
      emptiedTrips(lines, touched.filter(Boolean) as string[]).forEach((key) => {
        $(`[data-trip="${key}"]`)?.remove();
        removeTrip(key);
      });
    };

    const groupIntoTrip = (line: any, card: HTMLElement, target: any, targetCard: HTMLElement) => {
      const from = line.trip;
      const onto = tripOf(target.trip);
      const ontoBlock = targetCard.closest('[data-trip]') as HTMLElement | null;
      /* Seeded from the trip the vendor dropped ONTO: that card is the one
         staying put, so its destination is the answer already on screen.
         Blanking it would throw away an answer in order to ask for it again. */
      const trip: any = createTrip({
        /* An ungrouped target has no trip to inherit from, but it does have the
           one fact that matters — its own destination — so the new trip opens on
           the place the vendor already named rather than on a blank. */
        locality: onto?.locality ?? target.locality ?? '',
        window: onto?.window ?? 'Dates to be set',
        occurrences: onto?.occurrences ?? 1,
      });
      const block = buildTripBlock(trip);
      const box = block && $('[data-block-lines]', block);
      if (!block || !box) return false;

      /* The new group opens where the target was, so the two cards stay where
         the vendor was looking instead of jumping to the end of the step. */
      ontoBlock?.after(block);
      box.appendChild(targetCard);
      box.appendChild(card);
      refile(target, trip.key);
      refile(line, trip.key);
      moveInList(lines, line.id, target.id, 'after');
      pruneTrips([from, onto?.key]);

      block.classList.add('is-added');
      window.setTimeout(() => block.classList.remove('is-added'), 1500);
      recompute(line.id);
      focusTripBlock(block);
      return true;
    };

    initRowReorder({
      root,
      itemSelector: '.cbf-libwl[data-line]',
      /* The whole trip container is the landmark, not a header row — dropping
         anywhere on it that is not another card means "put this in here". */
      landmarkSelector: '[data-blockhead]',
      scopeOf: (el) => {
        const cat = catOfCard(el);
        if (!cat || !REORDERABLE(cat)) return null;
        if (el.dataset.line && derivedRow(lineById(el.dataset.line))) return null;
        return cat;
      },
      /* Two cards that are both ungrouped are the case this gesture is BEST at —
         "these two are actually one trip" — even though they share a block. The
         rule it is really enforcing is that a card already in a trip cannot be
         regrouped into the trip it is already in. */
      canGroup: (a, b) =>
        catOfCard(a) === 'travel' && catOfCard(b) === 'travel'
        && (blockOfCard(a) !== blockOfCard(b)
            || (blockOfCard(a) === NO_TRIP && blockOfCard(b) === NO_TRIP)),
      /* A drop target is either a card or a whole sub-block, and the
         announcement has to name whichever it actually was. */
      describe: (el) => {
        if (el.dataset.trip) return `the ${tripLabel(tripOf(el.dataset.trip))} trip`;
        if (el.dataset.blockhead) return `${el.dataset.blockhead}`;
        const line = lineById(el.dataset.line ?? '');
        return line ? displayLabel(line) || 'this line' : 'this line';
      },
      onDrop: ({ item, target, zone }) => {
        const line = lineById(item.dataset.line ?? '');
        if (!line) return false;
        const from = line.trip;

        if (zone === 'into' && target.classList.contains('cbf-libwl')) {
          const other = lineById(target.dataset.line ?? '');
          return other ? groupIntoTrip(line, item, other, target) : false;
        }

        /* A sub-block means "in here", with no opinion about where among what is
           already there — so it lands last, where the block's own Add button
           puts a new card. */
        if (zone === 'into') {
          const box = $('[data-block-lines]', target);
          if (!box) return false;
          const last = $$('.cbf-libwl', box).filter((c) => c !== item).pop();
          box.appendChild(item);
          if (last?.dataset.line) moveInList(lines, line.id, last.dataset.line, 'after');
          refile(line, (box as HTMLElement).dataset.blockLines ?? '');
        } else {
          if (zone === 'before') target.before(item); else target.after(item);
          if (target.dataset.line) moveInList(lines, line.id, target.dataset.line, zone);
          refile(line, blockOfCard(item));
        }

        pruneTrips([from]);
        recompute(line.id);
        return true;
      },
    });

    /* ── Every esa-* control fires a composed `change`; delegate the lot ── */
    root.addEventListener('change', (e: any) => {
      const el = e.target as HTMLElement;
      const d: any = el.dataset ?? {};

      /* A TRIP field belongs to the container, not to any one line — editing it
         moves every card under that trip at once, which is the entire reason
         travel is grouped this way. */
      const block = el.closest?.('[data-trip]') as HTMLElement | null;
      if (block && d.tripField) {
        const trip: any = tripOf(block.dataset.trip!);
        if (!trip) return;
        const raw = (el as any).value;
        if (d.tripField === 'locality') {
          /* Renames the trip and its cards, and moves NOT ONE DOLLAR — a claim on
             a published rate carries its own location, stated when it is made. */
          trip.locality = String(raw ?? '').trim();
        } else if (d.tripField === 'occurrences') {
          trip.occurrences = Math.max(1, num(raw)); // a journey happens at least once
        } else {
          trip[d.tripField] = String(raw ?? '');
        }
        const moved = lines.filter((l) => l.trip === trip.key);
        moved.forEach(syncLabel);
        recompute();
        flash(moved.map((l) => cardOf(l.id)));
        return;
      }

      const card = el.closest?.('.cbf-libwl') as HTMLElement | null;
      if (!card) return;
      const line = lineById(card.dataset.line!);
      if (!line) return;

      if ('positionCombo' in d) {
        const picked = String((el as any).value ?? '');
        /* Two ways in, one outcome: pick a title this budget already defines, or
           commit the term typed into the box. Either way the line carries the
           TITLE and the key is derived from it — so a reused title lands on the
           same position without the vendor knowing a key exists at all. */
        const title = picked.startsWith(NEW_POS)
          ? picked.slice(NEW_POS.length).trim()
          : (rosterFor(lines).find((r: any) => r.key === picked)?.title ?? '');
        line.label = title;
        line.staffKey = positionKey(title);
        /* The line keeps the sub-block it sits in — the block IS the type, and a
           position's type is a fact about the position, not about its title.
           The Fringe STEP follows on its own: recompute runs syncFringeLines
           before it prices, so nothing here has to know that. */
        recompute(line.id);
        /* A new title changes the roster every OTHER personnel combobox offers,
           so they all have to be re-seeded — otherwise the second technician's
           box would not list the title the first one just created. */
        refreshPositionOptions();
        return;
      }
      if ('timeUnitSelect' in d) {
        /* The unit decides what the number means AND what the rate is per — both
           captions repaint, and neither number is silently reinterpreted. */
        line.timeUnit = (el as any).value;
        line.qtyUnit = timeUnit(line).plural;
        recompute(line.id);
        return;
      }

      if ('travelKindSelect' in d) {
        applyTravelKind(line, (el as any).value);
        fillCard(card, line);
        recompute(line.id);
        return;
      }
      if (d.field === 'standardLocality') {
        if (!line.standard) return;
        line.standard = { ...line.standard, locality: String((el as any).value ?? '').trim() };
        recompute(line.id);
        return;
      }
      if ('standardYear' in d) {
        if (!line.standard) return;
        line.standard = { ...line.standard, year: Number((el as any).value) || defaultRateYear() };
        recompute(line.id);
        return;
      }

      /* ── Joining or leaving a trip, asked rather than dragged ──────────────
         The same three consequences the drag has, and one more this surface
         adds: the card is a real node inside the trip's container, so answering
         the question MOVES it. Sending it to the block it now belongs to and
         leaving it where it was would put a card under a trip heading that no
         longer claims it. */
      if ('tripSelect' in d) {
        const picked = String((el as any).value ?? '');
        const toKey = picked && picked !== NO_TRIP ? picked : NO_TRIP;
        const from = line.trip;
        const box = $(`[data-block-lines="${toKey}"]`);
        const last = box ? $$('.cbf-libwl', box).filter((c) => c !== card).pop() : null;
        refile(line, toKey);
        if (box) box.appendChild(card);
        if (last?.dataset.line) moveInList(lines, line.id, last.dataset.line, 'after');
        pruneTrips([from]);
        fillCard(card, line);
        recompute(line.id);
        card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }
      if ('vehicleKindSelect' in d) {
        applyVehicleKind(line, (el as any).value);
        fillCard(card, line);
        recompute(line.id);
        return;
      }
      if ('gsaSelect' in d) {
        line.gsaKey = (el as any).value;
        recompute(line.id);
        return;
      }
      if (d.allocWe) {
        const p = num((el as any).value);
        if (p > 0) line.allocations[d.allocWe] = p;
        else delete line.allocations[d.allocWe];
        recompute(line.id);
        return;
      }
      if (!d.field) return;

      if (d.field === 'label') line.label = (el as any).value ?? '';
      /* A destination is a place, not a number — and on an ungrouped line it
         decides the schedule row referenced, the name the line goes by, and the
         sentence under the field saying which schedule the typed place landed
         on. The select is re-pointed by hand rather than through fillCard: a
         re-fill would write the trimmed destination back into the box the vendor
         is still typing in, and take the caret with it. */
      else if (d.field === 'locality') {
        /* Names the card. It prices nothing — a claim carries its own location. */
        line.locality = String((el as any).value ?? '').trim();
        syncLabel(line);
      }
      else if (d.field === 'qtyUnit' || d.field === 'qty2Unit') line[d.field] = (el as any).value ?? '';
      else if (d.field === 'fringePct') line.fringePct = num((el as any).value) / 100;
      else line[d.field] = num((el as any).value);
      recompute(line.id);
      /* Quantity and rate are what the threshold divides, so an equipment line
         re-files itself on the same edit that changed them. */
      fileLine(line);
    });

    /* esa-combobox re-queries on a debounced `search`. That is where the "use
       this new title" option is offered, because it depends on the term — the
       roster itself only ever holds titles already on this budget. */
    root.addEventListener('search', (e: any) => {
      const el = e.target as HTMLElement;
      if (!el?.dataset || !('positionCombo' in el.dataset)) return;
      const opts = positionOptions();
      const t = String(e.detail?.term ?? '').trim();
      const exists = opts.some((o: any) => o.label.toLowerCase() === t.toLowerCase());
      (el as any).options = !t || exists ? opts : [{ label: `Use \u201c${t}\u201d`, value: NEW_POS + t }, ...opts];
    });

    root.addEventListener('menu-action', (e: any) => {
      const [catKey, block, shape, kind] = String(e.detail ?? '').split('|');
      if (catKey && shape) addLine(catKey, block, shape, kind ?? '');
    });

    root.addEventListener('click', (e: any) => {
      const t = e.target as HTMLElement;

      /* Working the allocation caret hands the fold to the vendor: from here on
         a failing split states itself in the error under the total and stops
         springing the boxes open under someone who just closed them. */
      const fold = t.closest?.('[data-alloc-list] summary') as HTMLElement | null;
      if (fold) {
        const foldCard = fold.closest('.cbf-libwl') as HTMLElement | null;
        if (foldCard) foldCard.dataset.allocFolded = '1';
        return;
      }

      const jump = t.closest?.('[data-goto-step]') as HTMLElement | null;
      if (jump) { goto(Number(jump.dataset.gotoStep)); return; }
      if (t.closest?.('[data-nav-back]')) { goto(active - 1); return; }
      if (t.closest?.('[data-nav-next]')) { goto(active + 1); return; }
      if (t.closest?.('[data-add-trip]')) { addTrip(); return; }

      const add = t.closest?.('[data-add-line]') as HTMLElement | null;
      if (add) {
        const [catKey, block, shape, kind] = String(add.dataset.addLine).split('|');
        addLine(catKey, block, shape, kind ?? '');
        return;
      }

      const seam = t.closest?.('[data-open-sheet]') as HTMLElement | null;
      if (seam?.dataset.openSheet) {
        document.dispatchEvent(
          new CustomEvent('cbf-lib:open-subcontract', {
            detail: { sheetId: seam.dataset.openSheet, lineId: seam.dataset.openSheetLine },
          }),
        );
        return;
      }

      if (t.closest?.('[data-ungroup-trip]')) {
        const block = t.closest('[data-trip]') as HTMLElement | null;
        if (block?.dataset.trip) ungroupTrip(block.dataset.trip);
        return;
      }

      if (t.closest?.('[data-delete-trip]')) {
        const block = t.closest('[data-trip]') as HTMLElement | null;
        if (block?.dataset.trip) dropTrip(block.dataset.trip);
        return;
      }

      const card = t.closest?.('.cbf-libwl') as HTMLElement | null;
      if (!card) return;
      const line = lineById(card.dataset.line!);
      if (!line) return;

      if (t.closest('[data-delete]')) {
        /* A derived card has no delete affordance and must not acquire one: it
           would only be regenerated by the next recompute. */
        if (derivedRow(line)) return;
        lines.splice(lines.findIndex((l) => l.id === line.id), 1);
        card.remove();
        recompute();
        return;
      }
      /* Claiming seeds both answers — location from wherever the card goes, year
         from the newest schedule carried — so the common case is one click. */
      if (t.closest('[data-standard-toggle]')) {
        if (line.standard) delete line.standard;
        else line.standard = normalizeClaim(line, {});
        fillCard(card, line);
        recompute(line.id);
        return;
      }

      if (t.closest('[data-override-toggle]')) {
        if (line.rateOverride == null) line.rateOverride = gsaRate(line.gsaKey)?.rate ?? 0;
        else delete line.rateOverride;
        fillCard(card, line);
        recompute(line.id);
        return;
      }
      /* Overruling the sort, and handing the line back to it. */
      if (t.closest('[data-cap-move]')) {
        if (isClassOverride(line)) {
          delete line.classOverride;
          delete line.filedAtThreshold;
          if (!fileLine(line)) { fillCard(card, line); recompute(line.id); }
        } else {
          /* One direction only: an item that met the threshold is argued back
             down to a supply. Same STEP either way now — the two classes are
             blocks of one category, so this no longer navigates anywhere. */
          line.classOverride = true;
          line.block = 'expensed';
          moveLine(line, { category: line.category, block: 'expensed' });
        }
        return;
      }
    });

    /* ── The overhead step owns the rate AND its scope; the steps own the base ── */
    document.addEventListener('cbf-lib:indirect-config', (e: any) => {
      const incoming = e.detail?.config;
      if (!incoming) return;
      cfg = { ...cfg, ...incoming, appliesTo: [...(incoming.appliesTo ?? cfg.appliesTo)] };
      recompute();
    });

    /* ── The review round trip. This wizard never WRITES a review — marking is
       the reviewer's job, on /lib-entry or /lib-entry-sheet — so there is no
       echo to guard against and every incoming review repaints. ── */
    document.addEventListener('cbf-lib:review', (e: any) => {
      const incoming = e.detail?.review;
      if (!incoming) return;
      review = incoming;
      recompute();
    });

    /* "Go to line" from the review panel. In a grid this scrolled; here it has to
       change STEP first, which is the navigation a wizard newly owes. */
    document.addEventListener('cbf-lib:focus-line', (e: any) => {
      const { lineId } = e.detail ?? {};
      const line = lineId ? lineById(lineId) : null;
      const card = line ? cardOf(line.id) : null;
      if (!line || !card) return;
      const idx = STEP_KEYS.indexOf(line.category);
      if (idx >= 0 && idx !== active) goto(idx, { scroll: false });
      window.setTimeout(() => {
        card.scrollIntoView({ block: 'center', behavior: 'smooth' });
        flash([card]);
      }, 120);
    });

    /* ── Mount ──────────────────────────────────────────────────────────────
       Seed every card's selects and values through the same fillCard the added
       cards use, rather than keeping a second, drifting list of what to seed. */
    lines.forEach((l) => {
      const card = cardOf(l.id);
      if (card) fillCard(card, l);
    });
    /* Trip fields are server-rendered empty — they are property-driven legos. */
    trips.forEach((t: any) => {
      const block = $(`[data-trip="${t.key}"]`);
      if (!block) return;
      (['locality', 'window'] as const).forEach((f) => {
        const el: any = $(`[data-trip-field="${f}"]`, block);
        if (el) el.value = t[f] ?? '';
      });
      const occ: any = $('[data-trip-field="occurrences"]', block);
      if (occ) occ.value = String(t.occurrences ?? 1);
    });

    goto(0, { scroll: false });
    recompute();
    const rebroadcast = () => fireTotals(priceLines(lines, cfg).totals);
    if (document.readyState === 'complete') window.setTimeout(rebroadcast, 0);
    else window.addEventListener('load', rebroadcast, { once: true });
  }
</script>

<style>
  [hidden] { display: none !important; }

  .cbf-libw {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
  }

  /* The rail column. A wizard step is narrower than a nine-category grid, so the
     rail can stay beside it much further down than on either other version. */
  .cbf-libw__body { --sidebar-width: 20rem; --sidebar-content-min: 34rem; }
  @media (max-width: 1180px) {
    /* Once stacked, the rail belongs ABOVE the step — it is the running total
       the vendor is working against, not a footnote to scroll past. */
    .cbf-libw__body :global(.sidebar[data-side='end'] > :first-child),
    .cbf-libw__body > :first-child { order: 0; }
  }

  .cbf-libw__ord {
    margin: 0;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cbf-libw__title { margin: 0; color: var(--color-text-primary); }
  .cbf-libw__lede {
    margin: 0;
    max-width: 78ch;
    color: var(--color-text-secondary);
  }

  /* ── The pinned nav ──────────────────────────────────────────────────────
     Sticky to the BOTTOM of the viewport, not the document: a category step can
     run several screens, and Back/Continue that scrolls away is a wizard that
     traps you on its longest step. */
  .cbf-libw__nav {
    position: sticky;
    bottom: 0;
    z-index: 2;
    padding-block: var(--spacing-300);
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-border);
  }
  .cbf-libw__nav-inner { --align: center; align-items: center; }
  /* Kept in flow, not rendered — see goto(). */
  .cbf-libw__nav-inner .is-spent { visibility: hidden; }
  .cbf-libw__nav-where { text-align: center; }
  .cbf-libw__nav-step { color: var(--color-text-primary); font-weight: var(--font-weight-medium); }
  .cbf-libw__nav-sub { color: var(--color-text-secondary); }

  /* A trip container that was just added. */
  .cbf-libw :global(.is-added) { animation: cbf-libw-flash 1.5s var(--easing-out) 1; }
  @keyframes cbf-libw-flash {
    from { box-shadow: inset 0 0 0 100vmax var(--color-info-subtle); }
    to { box-shadow: inset 0 0 0 100vmax transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cbf-libw :global(.is-added) { animation: none; }
  }
</style>
