---
// cbf-invoice-step-details — Step 0: invoice metadata, contract ref, line items, notes.
// PDF upload lives in cbf-invoice-pdf-panel on the same step.
// bcn-lego-checked: the read-only vendor strip is a compact identity metadata layout
// (eyebrow + name + address rows), not a general card container — esa-card doesn't
// provide this structured read-only row pattern. The line-items table and the overall
// form section layout have no esa-* equivalent. cbf-invoice-step-details is the
// reusable home for this pattern.
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

interface VendorInfo {
  company: string;
  contact: string;
  address: string;
  taxId?: string;
  email?: string;
}
interface Props {
  vendor: VendorInfo;
}
const { vendor } = Astro.props;

const today = new Date().toISOString().split('T')[0];

// Mock contract options — in production these come from the API.
const contracts = [
  { value: 'CON-2024-0881', label: 'CON-2024-0881 — Tributary Habitat Assessment' },
  { value: 'CON-2024-0903', label: 'CON-2024-0903 — Salmon Passage Study' },
  { value: 'CON-2025-0112', label: 'CON-2025-0112 — Water Quality Monitoring' },
  { value: 'CON-2025-0234', label: 'CON-2025-0234 — Environmental Impact Review' },
];
// Contract ledger — total awarded + remaining (unbilled) balance per contract.
const contractAmounts: Record<string, { total: number; remaining: number }> = {
  'CON-2024-0881': { total: 120000, remaining: 18500 },
  'CON-2024-0903': { total: 85000, remaining: 85000 },
  'CON-2025-0112': { total: 240000, remaining: 96000 },
  'CON-2025-0234': { total: 60000, remaining: 12300 },
};
// Contract → project mapping (read-only reference; JS auto-populates the project field).
const contractProjects: Record<string, string> = {
  'CON-2024-0881': 'PRJ-0045 — Lower Columbia River Restoration',
  'CON-2024-0903': 'PRJ-0062 — Snake River Fish Passage',
  'CON-2025-0112': 'PRJ-0071 — Wetland Mitigation Banking',
  'CON-2025-0234': 'PRJ-0045 — Lower Columbia River Restoration',
};
---
<div class="cbf-wizard-step" data-step="0">
  <h1 class="cbf-page-title">Invoice details</h1>


  <!-- Lock notice: hidden once a PDF has been uploaded -->
  <div class="cbf-form-lock" data-form-lock-notice>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
    <span class="cbf-form-lock__msg--wide">Drop an invoice PDF on the right to unlock the form.</span>
    <span class="cbf-form-lock__msg--narrow">Upload your invoice PDF to unlock the form.</span>
    <button type="button" class="cbf-form-lock__upload-btn" data-mobile-upload-btn>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      Upload PDF
    </button>
  </div>
  <!-- Mobile PDF input: lives outside the notice so it survives after the notice is hidden -->
  <input
    type="file"
    accept=".pdf,application/pdf"
    class="cbf-mobile-pdf-input"
    data-mobile-upload-input
    tabindex="-1"
    aria-hidden="true"
  />

  <div class="cbf-form-fields">

    <esa-combobox
      mode="autocomplete"
      label="Contract"
      placeholder="Search contracts…"
      required
      data-field="contract"
      data-combobox-options={JSON.stringify(contracts)}
      data-contract-amounts={JSON.stringify(contractAmounts)}
      data-contract-projects={JSON.stringify(contractProjects)}
    ></esa-combobox>
    <esa-text-field
      label="Project"
      placeholder="Auto-populated from contract"
      disabled
      data-field="project"
      data-readonly
      help-text="Read-only — determined by the selected contract."
    ></esa-text-field>

    <esa-text-field
      label="Invoice number"
      placeholder="e.g. INV-2026-0042"
      required
      data-field="invoice-number"
    ></esa-text-field>
    <bcn-date-picker
      label="Invoice date"
      required
      data-field="invoice-date"
      value={today}
    ></bcn-date-picker>
    <bcn-date-picker
      label="Performance period — Start"
      required
      data-field="perf-start"
    ></bcn-date-picker>
    <bcn-date-picker
      label="Performance period — End"
      required
      data-field="perf-end"
    ></bcn-date-picker>

    <esa-text-field
      label="Total amount (USD)"
      placeholder="e.g. 4,850.00"
      inputmode="decimal"
      required
      data-field="total-amount"
      help-text="Enter the total due, matching your uploaded invoice PDF."
    ></esa-text-field>
    <div data-step-error="total" hidden>
      <EsaAlertBox variant="danger">Please enter the invoice total amount.</EsaAlertBox>
    </div>
    <div data-step-error="total-exceeds" hidden>
      <EsaAlertBox variant="danger">
        This amount exceeds the <span data-remaining-amount>remaining balance</span> remaining on this contract. Reduce the total, or contact your contract manager.
      </EsaAlertBox>
    </div>

    <!-- Line items — hidden; the breakdown lives in the PDF. -->
    <div hidden>
      <div class="cbf-line-items">
        <div class="cbf-line-items__head" aria-hidden="true">
          <span class="cbf-li-col--desc">Description</span>
          <span class="cbf-li-col--qty">Qty</span>
          <span class="cbf-li-col--price">Unit price</span>
          <span class="cbf-li-col--total">Total</span>
          <span class="cbf-li-col--action"></span>
        </div>
        <div class="cbf-line-items__body" data-line-items></div>
        <div class="cbf-line-items__foot">
          <button type="button" class="cbf-add-row" data-add-line-item>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add line item
          </button>
          <div class="cbf-line-items__total">
            <span>Invoice total</span>
            <strong data-invoice-total>$0.00</strong>
          </div>
        </div>
      </div>
      <div data-step-error="lineitems" hidden>
        <EsaAlertBox variant="danger">Please add at least one line item.</EsaAlertBox>
      </div>
    </div>

    <div class="cbf-final-invoice" data-final-invoice-callout>
      <esa-checkbox
        size="lg"
        label="This is the final invoice for this contract"
        data-field="final-invoice"
        data-final-invoice
      ></esa-checkbox>
    </div>

    <div class="cbf-support-docs-group">
      <p class="cbf-support-docs-group__label">
        Supporting documents <span class="cbf-optional">(optional)</span>
      </p>
      <p class="cbf-support-docs-group__desc">Attach timesheets, receipts, reports, or any other supporting files.</p>
      <div class="cbf-support-docs">
        <div class="cbf-support-docs__list" data-docs-list></div>
        <button type="button" class="cbf-support-docs__add" data-docs-add>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add documents
        </button>
      </div>
      <input
        type="file"
        multiple
        accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg"
        class="cbf-docs-input"
        data-docs-input
        tabindex="-1"
        aria-hidden="true"
      />
    </div>

    <esa-textarea
      label="Additional notes"
      placeholder="Any additional context for the payment processor…"
      rows="3"
      data-field="notes"
    ></esa-textarea>

  </div>

  <div data-step-error="upload" hidden>
    <EsaAlertBox variant="danger">Please upload a PDF invoice before continuing.</EsaAlertBox>
  </div>

  <div class="cbf-step-actions">
    <span data-wizard-next>
      <EsaButton color="primary" size="md">Review &amp; submit</EsaButton>
    </span>
  </div>
</div>

<!-- Final-invoice confirmation. Sibling of the step (no data-step) so the wizard's
     step-visibility toggling never hides it. Opened from the client on Review &
     submit when the invoice looks like a final one and the box isn't already set. -->
<esa-confirm-dialog
  data-final-invoice-dialog
  heading="Is this the final invoice?"
  confirm-label="Yes, mark as final"
  cancel-label="No, not final"
></esa-confirm-dialog>

<style>
  .cbf-page-title {
    margin: 0 0 var(--spacing-400);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    font-size: 40px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--color-surface-inverse);
  }

  /* ---- Flat form field stack ---- */
  .cbf-form-fields {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
  }

  /* ---- Form lock notice ---- */
  .cbf-form-lock {
    display: flex;
    align-items: center;
    gap: var(--spacing-250);
    margin-bottom: var(--spacing-500);
    padding: var(--spacing-300) var(--spacing-400);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    background: var(--color-surface-sunken, #f8f9fb);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .cbf-form-lock svg { flex: none; color: var(--color-text-muted); }
  .cbf-form-lock[hidden] { display: none; }

  /* Responsive text variants inside the lock notice */
  .cbf-form-lock__msg--narrow,
  .cbf-form-lock__upload-btn { display: none; }

  @media (max-width: 1100px) {
    .cbf-form-lock__msg--wide { display: none; }
    .cbf-form-lock__msg--narrow { display: inline; }
    .cbf-form-lock__upload-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-150);
      margin-left: auto;
      flex: none;
      padding: var(--spacing-150) var(--spacing-300);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-100);
      font-size: 13px;
      font-weight: var(--font-weight-semibold);
      color: var(--color-secondary);
      background: var(--color-surface);
      transition: background 0.12s ease, border-color 0.12s ease;
    }
    .cbf-form-lock__upload-btn:hover {
      background: var(--color-primary-subtle);
      border-color: var(--color-primary-border);
    }
  }

  /* Hidden file input for mobile upload */
  .cbf-mobile-pdf-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .cbf-optional {
    font-size: 13px;
    font-weight: var(--font-weight-regular);
    color: var(--color-text-muted);
  }

  /* ---- Supporting documents group ---- */
  .cbf-support-docs-group__label {
    margin: 0 0 var(--spacing-050);
    font-size: var(--type-size-200, 13px);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }
  .cbf-support-docs-group__desc {
    margin: 0 0 var(--spacing-300);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ---- Read-only grid ---- */
  .cbf-readonly-grid {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    overflow: hidden;
    background: var(--color-surface-sunken, #f8f9fb);
  }
  .cbf-readonly-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-400);
    padding: var(--spacing-300) var(--spacing-400);
    border-bottom: 1px solid var(--color-border);
  }
  .cbf-readonly-row:last-child { border-bottom: 0; }
  .cbf-readonly-label {
    flex: none;
    width: 80px;
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .cbf-readonly-value {
    flex: 1;
    font-size: 14px;
    color: var(--color-text-primary);
  }

  /* ---- Line items ---- */
  .cbf-line-items {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    overflow: hidden;
  }
  .cbf-line-items__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px 96px 88px 32px;
    gap: var(--spacing-200);
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-surface-sunken, #f8f9fb);
    border-bottom: 1px solid var(--color-border);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .cbf-line-items__body { display: flex; flex-direction: column; }
  .cbf-line-items__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-300) var(--spacing-400);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-sunken, #f8f9fb);
  }
  .cbf-add-row {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-secondary);
    padding: var(--spacing-150) var(--spacing-200);
    border-radius: var(--radius-100);
    transition: background 0.12s ease;
  }
  .cbf-add-row:hover { background: var(--color-primary-subtle); }
  .cbf-add-row:disabled { opacity: 0.4; cursor: not-allowed; }
  .cbf-line-items__total {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    font-size: 15px;
    color: var(--color-text-secondary);
  }
  .cbf-line-items__total strong {
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  /* ---- Final invoice flag ---- */
  /* A deliberate callout, not a quiet checkbox: bordered surface, generous
     padding, and a stronger accent when the wizard auto-detects a final invoice. */
  .cbf-final-invoice {
    padding: var(--spacing-400) var(--spacing-450, var(--spacing-400));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    background: var(--color-surface-sunken, #f8f9fb);
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  /* Emphasised state once the vendor confirms (or manually checks) it. */
  .cbf-final-invoice.is-flagged {
    border-color: var(--color-primary-border, var(--color-primary));
    background: var(--color-primary-subtle);
    box-shadow: 0 0 0 1px var(--color-primary-border, var(--color-primary));
  }

  /* ---- Supporting documents ---- */
  .cbf-support-docs {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    overflow: hidden;
  }

  .cbf-support-docs__list:not(:empty) {
    border-bottom: 1px solid var(--color-border);
  }

  .cbf-support-docs__add {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-secondary);
    padding: var(--spacing-300) var(--spacing-400);
    width: 100%;
    transition: background 0.12s ease;
  }
  .cbf-support-docs__add:hover { background: var(--color-primary-subtle); }
  .cbf-support-docs__add:disabled { opacity: 0.4; cursor: not-allowed; }

  .cbf-docs-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  [data-step-error] { margin-top: var(--spacing-300); }

  /* ---- Step actions ---- */
  .cbf-step-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    margin-top: var(--spacing-700);
    padding-top: var(--spacing-500);
    border-top: 1px solid var(--color-border);
  }
  .cbf-btn-ghost {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 var(--spacing-400);
    border-radius: var(--radius-100);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .cbf-btn-ghost:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    border-color: var(--color-primary-border);
    color: var(--color-text-primary);
  }
</style>

<style is:global>
  /* Supporting document rows are JS-rendered. */
  .cbf-doc-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-300) var(--spacing-400);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .cbf-doc-row:last-child { border-bottom: 0; }
  .cbf-doc-row__icon { flex: none; color: var(--color-secondary); }
  .cbf-doc-row__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
  }
  .cbf-doc-row__name {
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cbf-doc-row__size {
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .cbf-doc-row__remove {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-100);
    color: var(--color-text-muted);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .cbf-doc-row__remove:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    color: var(--color-text-primary);
  }

  /* Line item rows are JS-rendered and can't carry Astro's scope hash. */
  .cbf-line-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px 96px 88px 32px;
    gap: var(--spacing-200);
    padding: var(--spacing-250) var(--spacing-400);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }
  .cbf-line-item:last-child { border-bottom: 0; }

  .cbf-li-input {
    box-sizing: border-box;
    width: 100%;
    padding: var(--spacing-150) var(--spacing-250);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-primary);
    background: var(--color-surface);
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
    outline: none;
  }
  .cbf-li-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-subtle);
  }
  .cbf-li-input::placeholder { color: var(--color-text-muted); }
  .cbf-li-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--color-surface-sunken, #f8f9fb);
  }
  .cbf-li-qty,
  .cbf-li-price { text-align: right; }

  .cbf-li-total {
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-align: right;
  }

  .cbf-li-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-100);
    color: var(--color-text-muted);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .cbf-li-remove:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    color: var(--color-text-primary);
  }
</style>
