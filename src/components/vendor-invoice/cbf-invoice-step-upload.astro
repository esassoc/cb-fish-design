---
// cbf-invoice-step-upload — Standalone PDF upload dropzone (reference component).
// The live wizard mounts upload UI in cbf-invoice-pdf-panel on step 0 instead.
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
---
<div class="cbf-wizard-step" data-wizard-upload>
  <h1 class="cbf-page-title">Upload Invoice</h1>
  <p class="cbf-step-intro">Attach the PDF invoice you'd like to submit for payment.</p>

  <div class="cbf-upload-zone" data-upload-zone>
    <!-- Idle state: drag target -->
    <div class="cbf-upload-zone__idle" data-upload-idle>
      <div class="cbf-upload-zone__icon" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="12" y1="18" x2="12" y2="12"/>
          <line x1="9" y1="15" x2="15" y2="15"/>
        </svg>
      </div>
      <p class="cbf-upload-zone__heading">Drop your invoice PDF here</p>
      <p class="cbf-upload-zone__sub">
        or <button type="button" class="cbf-upload-zone__browse" data-upload-browse>browse to upload</button>
      </p>
      <p class="cbf-upload-zone__hint">PDF files only · Max 25 MB</p>
      <input
        type="file"
        accept=".pdf,application/pdf"
        class="cbf-upload-zone__input"
        data-upload-input
        tabindex="-1"
        aria-hidden="true"
      />
    </div>

    <!-- File selected state -->
    <div class="cbf-upload-zone__file" data-upload-file hidden>
      <div class="cbf-upload-zone__file-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
      </div>
      <div class="cbf-upload-zone__file-info">
        <span class="cbf-upload-zone__file-name" data-upload-filename></span>
        <span class="cbf-upload-zone__file-size" data-upload-filesize></span>
      </div>
      <button type="button" class="cbf-upload-zone__remove" data-upload-remove aria-label="Remove file">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div data-step-error="upload" hidden>
    <EsaAlertBox variant="danger">Please upload a PDF invoice before continuing.</EsaAlertBox>
  </div>

  <div class="cbf-step-actions">
    <span data-wizard-next>
      <EsaButton color="primary" size="md">Continue to Invoice Details</EsaButton>
    </span>
  </div>
</div>

<style>
  .cbf-page-title {
    margin: 0 0 var(--spacing-200);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    font-size: 40px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--color-surface-inverse);
  }
  .cbf-step-intro {
    margin: 0 0 var(--spacing-500);
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .cbf-upload-zone {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-100);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cbf-upload-zone.is-over,
  .cbf-upload-zone:focus-within {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
  }
  .cbf-upload-zone__idle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-200);
    padding: var(--spacing-700) var(--spacing-600);
    text-align: center;
  }
  .cbf-upload-zone__icon { color: var(--color-text-muted); }
  .cbf-upload-zone__heading {
    margin: 0;
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .cbf-upload-zone__sub {
    margin: 0;
    font-size: 15px;
    color: var(--color-text-secondary);
  }
  .cbf-upload-zone__browse {
    color: var(--color-secondary);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cbf-upload-zone__browse:hover { color: var(--color-primary); }
  .cbf-upload-zone__hint {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .cbf-upload-zone__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* File selected */
  .cbf-upload-zone__file {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    padding: var(--spacing-400) var(--spacing-500);
  }
  .cbf-upload-zone__file-icon { color: var(--color-secondary); flex: none; }
  .cbf-upload-zone__file-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
  }
  .cbf-upload-zone__file-name {
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cbf-upload-zone__file-size {
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .cbf-upload-zone__remove {
    flex: none;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-100);
    color: var(--color-text-muted);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .cbf-upload-zone__remove:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    color: var(--color-text-primary);
  }

  .cbf-step-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    margin-top: var(--spacing-700);
    padding-top: var(--spacing-500);
    border-top: 1px solid var(--color-border);
  }

  [data-step-error] { margin-top: var(--spacing-400); }
</style>
