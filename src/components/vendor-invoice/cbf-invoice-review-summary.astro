---
// cbf-invoice-review-summary — the Review & submit summary.
// Shared by BOTH the page step (cbf-invoice-step-review) and the confirm modal
// (cbf-invoice-confirm) so the markup lives in ONE place. Each section is a real
// esa-card lego; the dynamic values are [data-review="…"] placeholders that
// invoice-wizard.client.ts fills (fillReviewSummary) — no hand-rolled card.
//
// bcn-lego-checked: the cards ARE esa-card (lego). The Replace/Remove and icon-only
// "view" controls are compact inline file-row actions carrying data-* JS hooks —
// esa-button (and esa-icon-button) is a full-size CTA at the wrong scale for an
// in-row 30px action; checked Beacon (no ui-* inline file-action). These quiet row
// buttons stay bcn within this component, matching the existing row-action pattern.
import EsaCard from '@esa/ecology/esa-card.astro';
import CbfInvoiceCard from '../shared/cbf-invoice-card.astro';
---
<div class="cbf-review-summary" data-review-summary>

  <CbfInvoiceCard placeholder />

  <EsaCard title="Uploaded invoice">
    <div class="cbf-review-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span data-review="file-name"></span>
      <span class="cbf-review-meta" data-review="file-size"></span>
      <button type="button" class="cbf-doc-view" data-view-invoice hidden aria-label="Preview invoice">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
  </EsaCard>

  <div data-review="docs-card" hidden>
    <EsaCard title="Supporting documents">
      <div class="cbf-review-docs" data-review="docs-list"></div>
    </EsaCard>
  </div>

  <div data-review="notes-card" hidden>
    <EsaCard title="Notes">
      <p class="cbf-review-notes" data-review="notes"></p>
    </EsaCard>
  </div>

</div>

<style>
  .cbf-review-summary {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }

  /* Border edge + a soft shadow so the esa-cards lift off the white page. */
  .cbf-review-summary :global(.esa-card) {
    box-shadow: var(--elevation-2, 0 1px 3px rgba(16, 24, 40, 0.06));
  }

  /* ---- File row (Uploaded invoice + Supporting documents) ----
     :global() within the summary root so the identical layout reaches BOTH the
     static "Uploaded invoice" row and the supporting-doc rows injected via
     innerHTML (which don't carry Astro's scope attribute). */
  .cbf-review-summary :global(.cbf-review-row) {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    font-size: 15px;
    color: var(--color-content-default);
  }
  .cbf-review-summary :global(.cbf-review-row svg) { color: var(--color-background-brand-muted); flex: none; }
  .cbf-review-summary :global(.cbf-review-row + .cbf-review-row) { margin-top: var(--spacing-300); }
  .cbf-review-summary :global(.cbf-review-meta) { color: var(--color-content-default-tertiary); font-size: 13px; }

  /* Icon-only "view" action — pushes to the row's right edge and drives the
     side PDF panel to show this document. Same in-row scale as the file rows;
     the icon colour is set on the button so it beats the .cbf-review-row svg rule.
     :global() so it also reaches the supporting-doc buttons injected via innerHTML,
     which don't carry Astro's scope attribute. */
  .cbf-review-summary :global(.cbf-doc-view) {
    flex: none;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-100);
    background: var(--color-background-elevation-raised);
    color: var(--color-content-default-tertiary);
    cursor: pointer;
    transition: color 0.12s ease, border-color 0.12s ease, background 0.12s ease;
  }
  .cbf-review-summary :global(.cbf-doc-view[hidden]) { display: none; }
  .cbf-review-summary :global(.cbf-doc-view svg) { color: inherit; }
  .cbf-review-summary :global(.cbf-doc-view:hover) {
    color: var(--color-background-brand-muted);
    border-color: var(--color-border-brand);
    background: var(--color-background-brand-subtle);
  }
  .cbf-review-summary :global(.cbf-doc-view.is-active) {
    color: var(--color-background-elevation-raised);
    background: var(--color-background-brand-muted);
    border-color: var(--color-background-brand-muted);
  }

  /* The invoice card itself is now the shared CbfInvoiceCard component. */

  /* ---- Conditional cards ---- */
  [data-review="docs-card"][hidden],
  [data-review="notes-card"][hidden] { display: none; }

  .cbf-review-notes {
    margin: 0;
    font-size: 14px;
    color: var(--color-content-default-secondary);
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>
