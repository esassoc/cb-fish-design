---
// cbf-invoice-stepper — vertical step indicator for the vendor invoice wizard.
// JS updates is-active / is-done classes via [data-stepper-step] selectors.
interface Props {
  steps: string[];
  current?: number; // 0-indexed; defaults to 0 (JS takes over after first render)
}
const { steps, current = 0 } = Astro.props;
---
<nav class="cbf-stepper" data-stepper aria-label="Submission steps">
  {steps.map((label, i) => (
    <>
      <div
        class:list={[
          'cbf-stepper__item',
          { 'is-active': i === current, 'is-done': i < current },
        ]}
        data-stepper-step={i}
      >
        <div class="cbf-stepper__circle" aria-hidden="true">
          <svg class="cbf-stepper__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="cbf-stepper__num">{i + 1}</span>
        </div>
        <span class="cbf-stepper__label">{label}</span>
      </div>
      {i < steps.length - 1 && <div class="cbf-stepper__line" aria-hidden="true" />}
    </>
  ))}
</nav>

<style>
  .cbf-stepper {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .cbf-stepper[hidden] {
    display: none;
  }

  .cbf-stepper__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
  }

  /* ---- Circle ---- */
  .cbf-stepper__circle {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cbf-stepper__num {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    line-height: 1;
  }

  /* checkmark hidden by default, shown when done */
  .cbf-stepper__check {
    display: none;
    color: var(--color-surface);
  }

  /* ---- Active step ---- */
  .cbf-stepper__item.is-active .cbf-stepper__circle {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .cbf-stepper__item.is-active .cbf-stepper__num {
    color: var(--color-surface);
  }

  /* ---- Done step ---- */
  .cbf-stepper__item.is-done .cbf-stepper__circle {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .cbf-stepper__item.is-done .cbf-stepper__num {
    display: none;
  }
  .cbf-stepper__item.is-done .cbf-stepper__check {
    display: block;
  }

  /* ---- Label ---- */
  .cbf-stepper__label {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }
  .cbf-stepper__item.is-active .cbf-stepper__label {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }
  .cbf-stepper__item.is-done .cbf-stepper__label {
    color: var(--color-text-secondary);
  }

  /* ---- Connector line ---- */
  .cbf-stepper__line {
    width: 2px;
    height: 28px;
    background: var(--color-border);
    margin-left: 13px; /* centers under the circle */
    margin-block: 2px;
    border-radius: 1px;
    transition: background 0.15s ease;
  }
</style>
