---
// cbf-invoice-confirm — the "Review & submit" modal (modal confirmation mode).
// esa-dialog shell wrapping the shared review summary, with a Back/Submit footer that
// drives the wizard. Post-submit confirmation is a success toast (not a page) — see
// invoice-wizard.client.ts submitInvoice.
import EsaButton from '@esa/ecology/esa-button.astro';
import CbfInvoiceReviewSummary from './cbf-invoice-review-summary.astro';
---
<!-- bcn-lego-checked: esa-dialog provides the overlay shell (focus trap, Esc, backdrop,
     close button). The summary inside is composed of esa-card legos
     (CbfInvoiceReviewSummary). Back is a bcn-btn-ghost (same token-driven pattern as the
     page step's Back button); esa-button is the primary Submit CTA. -->
<esa-dialog
  data-confirm-modal
  heading="Review &amp; submit"
  size="lg"
  show-close-button
>
  <!-- JS fills the [data-review] placeholders (populateModalReview). -->
  <div data-modal-review-content>
    <CbfInvoiceReviewSummary />
  </div>

  <div slot="footer" class="cbf-confirm-modal-footer">
    <button type="button" class="cbf-btn-ghost" data-modal-back>Back</button>
    <span data-modal-submit>
      <EsaButton color="primary" size="md">Submit invoice</EsaButton>
    </span>
  </div>
</esa-dialog>

<style>
  /* Footer: Back left, Submit pushed to the right. */
  .cbf-confirm-modal-footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    flex-wrap: wrap;
    width: 100%;
  }
  .cbf-confirm-modal-footer [data-modal-submit] { margin-left: auto; }

  /* Back button — same ghost pattern as the page step's Back button. */
  .cbf-btn-ghost {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 var(--spacing-400);
    border-radius: var(--radius-100);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .cbf-btn-ghost:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    border-color: var(--color-primary-border);
    color: var(--color-text-primary);
  }
</style>
