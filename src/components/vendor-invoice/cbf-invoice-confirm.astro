---
// cbf-invoice-confirm — Step 2: success screen shown after invoice submission.
// Not shown in the sidebar stepper — the stepper hides once submission completes.
interface Props {
  vendorEmail: string;
  homeHref: string;
  resubmitHref: string;
}
const { vendorEmail, homeHref, resubmitHref } = Astro.props;
---
<div class="cbf-wizard-step cbf-wizard-step--confirm" data-step="2" hidden>
  <div class="cbf-confirm">
    <div class="cbf-confirm__icon" aria-hidden="true">
      <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </div>

    <h1 class="cbf-confirm__title">Invoice Submitted</h1>
    <p class="cbf-confirm__body">
      Your invoice has been submitted for processing.<br />
      You'll receive a confirmation email at <strong>{vendorEmail}</strong>.
    </p>

    <p class="cbf-confirm__ref">
      Reference number: <strong data-confirm-ref>&nbsp;</strong>
    </p>

    <div class="cbf-confirm__actions">
      <a href={homeHref} class="cbf-confirm__link cbf-confirm__link--outline">Return to Home</a>
      <a href={resubmitHref} class="cbf-confirm__link">Submit another invoice</a>
    </div>
  </div>
</div>

<style>
  .cbf-wizard-step--confirm {
    display: flex;
    align-items: flex-start;
  }
  .cbf-wizard-step--confirm[hidden] {
    display: none;
  }

  .cbf-confirm {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-400);
    padding-top: var(--spacing-400);
    max-width: 560px;
  }

  .cbf-confirm__icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-success-subtle, #f0fdf4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-success-strong, #15803d);
  }

  .cbf-confirm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: var(--font-weight-medium);
    letter-spacing: -1px;
    color: var(--color-surface-inverse);
  }

  .cbf-confirm__body {
    margin: 0;
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cbf-confirm__ref {
    margin: 0;
    font-size: 15px;
    color: var(--color-text-secondary);
    padding: var(--spacing-300) var(--spacing-400);
    background: var(--color-surface-sunken, #f8f9fb);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    width: 100%;
    box-sizing: border-box;
  }
  .cbf-confirm__ref strong { color: var(--color-primary); }

  .cbf-confirm__actions {
    display: flex;
    gap: var(--spacing-300);
    flex-wrap: wrap;
  }

  .cbf-confirm__link {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 var(--spacing-400);
    border-radius: var(--radius-100);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-secondary);
    border: 1px solid transparent;
    text-decoration: none;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .cbf-confirm__link:hover { background: var(--color-primary-subtle); }

  .cbf-confirm__link--outline {
    color: var(--color-text-secondary);
    border-color: var(--color-border);
    background: var(--color-surface);
  }
  .cbf-confirm__link--outline:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    border-color: var(--color-primary-border);
    color: var(--color-text-primary);
  }
</style>
