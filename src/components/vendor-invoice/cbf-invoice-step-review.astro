---
// cbf-invoice-step-review — Step 1: review all entered data before submitting.
// The summary cards (CbfInvoiceReviewSummary, composed of esa-card legos) are
// populated by invoice-wizard.client.ts from form state; this file provides the
// page shell, the info notice, and the actions.
// bcn-lego-checked: cbf-btn-ghost Back button — esa-button is used for the primary
// CTA (Submit); the Back button requires a data-wizard-back JS hook that a plain
// styled <button> carries more predictably than an Astro component with unknown
// prop-spread behaviour. Token-driven (border, spacing tokens only).
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import CbfInvoiceReviewSummary from './cbf-invoice-review-summary.astro';
---
<div class="cbf-wizard-step" data-step="1" hidden>
  <h1 class="cbf-page-title">Review &amp; submit</h1>

  <div class="cbf-review-notice">
    <EsaAlertBox variant="info">
      Review your invoice before submitting.
    </EsaAlertBox>
  </div>

  <!-- esa-card summary; JS fills the [data-review] placeholders (populateReview). -->
  <div data-review-content>
    <CbfInvoiceReviewSummary />
  </div>

  <div class="cbf-step-actions">
    <button type="button" class="cbf-btn-ghost" data-wizard-back>Back</button>
    <span data-wizard-submit>
      <EsaButton color="primary" size="md">Submit invoice</EsaButton>
    </span>
  </div>
</div>

<style>
  .cbf-page-title {
    margin: 0 0 var(--spacing-500);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    font-size: 40px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--color-surface-inverse);
  }

  .cbf-review-notice {
    margin-bottom: var(--spacing-500);
  }
  .cbf-review-notice :global(.esa-alert-box) {
    --color-info-subtle: var(--color-primary-subtle);
    --color-info-border: var(--color-primary-border);
    --color-info: var(--color-secondary);
    --color-text-secondary: var(--color-text-primary);
    font-size: 15px;
  }

  .cbf-step-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-300);
    margin-top: var(--spacing-700);
    padding-top: var(--spacing-500);
    border-top: 1px solid var(--color-border);
  }
  /* Back stays left; primary CTA (Submit) pushes to the right edge. */
  .cbf-step-actions [data-wizard-submit] { margin-left: auto; }
  .cbf-btn-ghost {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 var(--spacing-400);
    border-radius: var(--radius-100);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .cbf-btn-ghost:hover {
    background: var(--color-surface-sunken, #f8f9fb);
    border-color: var(--color-primary-border);
    color: var(--color-text-primary);
  }
</style>
