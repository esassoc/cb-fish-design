---
// cbf-invoice-rail — left sidebar for the vendor invoice wizard.
// Hosts the step indicator and the pre-filled vendor identity card.
// bcn-lego-checked: esa-card is a general content container; the vendor identity
// strip here is a compact read-only metadata display (eyebrow + name + contact + email
// rows) — esa-card doesn't provide this structured row layout. Checked Beacon: no
// matching ui-* component. cbf-invoice-rail is the reusable home for this pattern.
import CbfInvoiceStepper from './cbf-invoice-stepper.astro';

interface VendorInfo {
  company: string;
  contact: string;
  email: string;
}
interface Props {
  vendor: VendorInfo;
  steps: string[];
}
const { vendor, steps } = Astro.props;
---
<aside class="cbf-invoice-rail">
  <CbfInvoiceStepper steps={steps} current={0} />

  <div class="cbf-vendor-card">
    <p class="cbf-vendor-card__eyebrow">Submitting as</p>
    <p class="cbf-vendor-card__name">{vendor.company}</p>
    <p class="cbf-vendor-card__contact">{vendor.contact}</p>
    <p class="cbf-vendor-card__email">{vendor.email}</p>
  </div>
</aside>

<style>
  .cbf-invoice-rail {
    flex: 0 0 260px;
    border-right: 1px solid var(--color-border);
    padding: var(--spacing-600) var(--spacing-500);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-600);
    background: var(--color-surface-sunken, #f8f9fb);
  }

  .cbf-vendor-card {
    padding: var(--spacing-400);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    background: var(--color-surface);
  }
  .cbf-vendor-card__eyebrow {
    margin: 0 0 var(--spacing-150);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cbf-vendor-card__name {
    margin: 0 0 var(--spacing-150);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.35;
  }
  .cbf-vendor-card__contact {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .cbf-vendor-card__email {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Below 960px: rail becomes a horizontal top bar */
  @media (max-width: 960px) {
    .cbf-invoice-rail {
      flex: none;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--spacing-500);
      padding: var(--spacing-400) var(--spacing-500);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
    .cbf-vendor-card {
      flex: 1;
      min-width: 180px;
    }
  }

  /* Below 600px: hide vendor card to save vertical space */
  @media (max-width: 600px) {
    .cbf-invoice-rail {
      padding: var(--spacing-300) var(--spacing-400);
    }
    .cbf-vendor-card {
      display: none;
    }
  }
</style>
