---
// cbf-invoice-pdf-panel — right-side panel that doubles as the invoice drop zone and PDF viewer.
// Idle state: drag/drop target. Loaded state: inline PDF preview with remove control.
// bcn-lego-checked: combined drag-drop upload zone + inline PDF viewer — no esa-* component
// covers this pattern; checked Beacon: no matching ui-* component. cbf-invoice-pdf-panel
// is the reusable home for this pattern.
---
<aside class="cbf-pdf-panel" data-pdf-panel data-upload-zone hidden>

  <!-- Idle: drop zone (visible when no file loaded) -->
  <div class="cbf-pdf-drop" data-upload-idle>
    <input
      type="file"
      accept=".pdf,application/pdf"
      class="cbf-pdf-drop__input"
      data-upload-input
      tabindex="-1"
      aria-hidden="true"
    />
    <div class="cbf-pdf-drop__icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
    </div>
    <p class="cbf-pdf-drop__heading">Drop invoice PDF here</p>
    <p class="cbf-pdf-drop__sub">
      or <button type="button" class="cbf-pdf-drop__browse" data-upload-browse>browse to upload</button>
    </p>
    <p class="cbf-pdf-drop__hint">PDF only · Max 25 MB</p>
  </div>

  <!-- Loaded: PDF viewer (visible when file is loaded) -->
  <div class="cbf-pdf-viewer" data-pdf-viewer hidden>
    <div class="cbf-pdf-viewer__bar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <span class="cbf-pdf-viewer__name" data-pdf-filename></span>
      <button type="button" class="cbf-pdf-viewer__remove" data-upload-remove aria-label="Remove invoice">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
        Remove
      </button>
    </div>
    <iframe class="cbf-pdf-viewer__frame" data-pdf-frame title="Invoice PDF preview"></iframe>
  </div>

</aside>

<style>
  .cbf-pdf-panel {
    flex: 1;
    min-width: 0;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .cbf-pdf-panel[hidden] { display: none; }

  /* ---- Drop zone (idle) ---- */
  .cbf-pdf-panel {
    background: var(--color-surface-sunken, #f8f9fb);
  }

  .cbf-pdf-drop {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-300);
    text-align: center;
    margin: var(--spacing-500);
    padding: var(--spacing-700) var(--spacing-600);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-100);
    background: var(--color-surface);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cbf-pdf-drop[hidden] { display: none; }

  .cbf-pdf-panel.is-over .cbf-pdf-drop {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
  }

  .cbf-pdf-drop__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .cbf-pdf-drop__icon { color: var(--color-text-muted); }

  .cbf-pdf-drop__heading {
    margin: 0;
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .cbf-pdf-drop__sub {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .cbf-pdf-drop__browse {
    color: var(--color-secondary);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cbf-pdf-drop__browse:hover { color: var(--color-primary); }

  .cbf-pdf-drop__hint {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* ---- Viewer (loaded) ---- */
  .cbf-pdf-viewer {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .cbf-pdf-viewer[hidden] { display: none; }

  .cbf-pdf-viewer__bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    padding: 0 var(--spacing-400);
    height: 40px;
    flex: none;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .cbf-pdf-viewer__name {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    color: var(--color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cbf-pdf-viewer__remove {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    padding: var(--spacing-100) var(--spacing-250);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
    background: var(--color-surface);
    transition: color 0.12s ease, border-color 0.12s ease, background 0.12s ease;
  }
  .cbf-pdf-viewer__remove:hover {
    color: var(--color-danger, #dc2626);
    border-color: var(--color-danger, #dc2626);
    background: var(--color-danger-subtle, #fef2f2);
  }

  .cbf-pdf-viewer__frame {
    flex: 1;
    width: 100%;
    border: none;
    display: block;
    min-height: 0;
  }

  /* Below 1100px: panel stacks above the form — cap height and switch border direction */
  @media (max-width: 1100px) {
    .cbf-pdf-panel {
      flex: none;
      height: 420px;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
