    position: relative;
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-150);
    padding: var(--spacing-300) var(--spacing-400);
    border: 1px solid var(--color-border-default);
    border-block-start-width: 4px;
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
  }
  .cbf-soy-ov__stage.is-done { border-block-start-color: var(--color-background-utility-success, var(--color-border-default)); }
