  .cbf-soy-ov__stage-n { font-size: 12px; font-weight: var(--typography-font-weight-bold); color: var(--color-content-default-tertiary); }
  .cbf-soy-ov__stage-name { font-size: 16px; font-weight: var(--typography-font-weight-semibold); }
  .cbf-soy-ov__stage-dates { font-size: 13px; color: var(--color-content-default-secondary); }
  .cbf-soy-ov__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--spacing-400); padding: var(--spacing-400); border: 1px solid var(--color-border-default-subtle); border-radius: var(--radius-200); }
  .cbf-soy-ov__actions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--spacing-200); }
  .cbf-soy-ov__action {
    display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-400); flex-wrap: wrap;
    padding: var(--spacing-300) var(--spacing-400);
    border: 1px solid var(--color-border-default);
    border-inline-start: 4px solid var(--color-background-brand);
    border-radius: var(--radius-200);
    background: var(--color-background-elevation-raised);
  }
  .cbf-soy-ov__action-sub { font-size: 14px; color: var(--color-content-default-secondary); }
  .cbf-soy-ov__action-link { font-weight: var(--typography-font-weight-semibold); color: var(--color-background-brand); white-space: nowrap; }
  .cbf-soy-ov__callout {
    padding: var(--spacing-400) var(--spacing-500);
    border-radius: var(--radius-200);
    background: var(--color-background-brand-subtle);
    border: 1px solid var(--color-background-brand);
    align-items: center;
  }
  .cbf-soy-ov__callout-big { margin: 0; font-size: 22px; font-weight: var(--typography-font-weight-semibold); color: var(--color-content-default); }
  .cbf-soy-ov__callout-sub { margin: 0; color: var(--color-content-default-secondary); }
</style>
