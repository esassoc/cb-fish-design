---
/*
 * cbf-lib-indirect-config — the overhead / indirect block of the vendor Line Item
 * Budget entry screen (/lib-entry, the LIB tab of a CBFish contract).
 *
 * WHAT IT IS
 * A CONFIGURATION SURFACE, not a cost line — which is why it is its own component
 * rather than a row in the cost grid. An indirect rate is never just a number. It
 * carries four things that all have to agree:
 *   1. the rate itself,
 *   2. the reference document that authorizes it (the NICRA or equivalent),
 *   3. the period it is effective for, and
 *   4. which cost subtotals the rate is applied to.
 *
 * WHY IT PICKS INSTEAD OF TYPING (2026-10)
 * 1–3 are not the vendor's to type. CBFish keeps every organization's approved
 * rates under Data management → Vendor indirect rates, each with a status, its
 * effective dates and its NICRA (or the CO's de minimis agreement), approved by
 * the CO. So this block PICKS the record(s) that apply and shows their facts
 * read-only. More than one can be picked, because a contract period often runs
 * past the end of a NICRA: BPA pays the rate in force for the invoice's time
 * frame, so each month takes the rate that covers it and the block shows the
 * coverage — and warns when months are left uncovered. (4) is PRESET from the
 * picked rate's base (MTDC, say); the vendor may still change it, and a scope
 * that departs from the base is noted for the COR.
 *
 * WHY IT IS AUDIT-CRITICAL
 * (4) is the one that gets budgets sent back. Capital equipment and subcontracts
 * are deliberately OUT of the base on this contract; if the vendor sweeps them in,
 * the indirect dollars are wrong in a way that reconciles cleanly against itself
 * and therefore survives review. So the picker shows every category WITH its
 * subtotal, and the indirect base / indirect dollars recompute in front of the
 * vendor as they toggle. That visible recomputation is the whole point.
 *
 * WHY A DRAWER, NOT INLINE
 * The picker alone is nine rows on top of four fields and a rate-structure choice.
 * Inline it would sit between the context header and the cost grid and push the
 * grid — the actual work surface — below the fold. So the page carries a compact,
 * ALWAYS-VISIBLE summary (rate, reference document, effective period, scope count,
 * indirect base, indirect dollars) and the configuration itself opens in an
 * esa-side-dialog. The audit-critical facts are never hidden, and they repaint live
 * while the drawer is open, so the strip and the picker can never disagree.
 *
 * ON-SITE / OFF-SITE DUAL RATES ARE STILL OUT OF SCOPE
 * A rate that changes mid-contract is handled now (coverage, above). A dual rate
 * that splits work by site is not: it needs each cost tagged on- or off-site,
 * which no line carries. The drawer says so in one sentence.
 *
 * EVENT CONTRACT (this component talks to its siblings on `document`)
 *   dispatch  cbf-lib:indirect-config
 *             detail: { config: { rateIds, appliesTo, mode, and the DERIVED
 *                                 rate, referenceDoc, effectiveStart,
 *                                 effectiveEnd, subawardCap, base } }
 *             `rate` is a FRACTION (0.2675, not 26.75). `appliesTo` is an array of
 *             scope keys in `indirectScopes` order. Dates are MM/DD/YYYY, matching
 *             the data module. Fired ONCE on mount (after the frame, so sibling
 *             listeners are registered) and after EVERY change.
 *   The sibling cost grid re-runs priceLines(lines, config) on this event and
 *   repaints its indirect base, indirect, and total. This component previews the
 *   same numbers with priceLines(costLines, config) from the SAME data module, so
 *   the two surfaces are arithmetically identical by construction.
 *
 * bcn-lego-checked: every control here is a lego — the rate picker and the
 * applicability picker = esa-checkbox rows (a disabled box is how an expired or
 * draft rate says "not usable here"), status = esa-badge, the expiry warning =
 * esa-alert-box, the out-of-scope note = esa-alert-box, the numbers = esa-stat, the
 * panel = esa-card, the overlay = esa-side-dialog (Esc / click-outside / close
 * button / symmetric slide-out / full-viewport scrim all ship in the lego), buttons
 * = esa-button. esa-checkbox-group was checked FIRST and rejected on merit: it
 * renders label-only rows from an options array with no room for the per-row
 * category subtotal, and the subtotal beside each row is the reason a vendor can
 * see what they are including — so the picker is individual esa-checkbox legos in a
 * .repel row each. The only bespoke CSS left is the divided list frame around those
 * rows (ecology has no list/table lego — same finding as cbf-baselines-table and
 * cbf-lib-pi-documents) and the inline computation band in the drawer footer.
 * Beacon is not cloned on this machine.
 */
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaStat from '@esa/ecology/esa-stat.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import {
  indirectConfig,
  indirectScopes,
  costLines,
  priceLines,
  VENDOR_INDIRECT_RATES,
  RATE_STATUS,
  INDIRECT_BASES,
  scopesForBase,
  resolveIndirect,
  SUBAWARD_CAP,
  usd,
  pct,
} from '../../data/lib-entry.mjs';

interface Props {
  /** The starting configuration. Defaults to the data module's `indirectConfig`. */
  config?: any;
  /** Heading on the always-visible summary strip. */
  heading?: string;
  /** Render with the configuration drawer already open (demo / deep-link). */
  open?: boolean;
}

const {
  config = indirectConfig,
  heading = 'Indirect rate',
  open = false,
} = Astro.props;

const resolved = resolveIndirect(config);
const priced = priceLines(costLines, config);
const inScope = new Set(config.appliesTo);
const preset = new Set(scopesForBase(config.base));
const base = INDIRECT_BASES[config.base];
const scopeLabel = `${config.appliesTo.length} of ${indirectScopes.length}`;
const picked = new Set(config.rateIds ?? []);
---

<section
  class="cbf-lic stack"
  data-gap="sm"
  data-lic
  data-config={JSON.stringify({ rateIds: config.rateIds, appliesTo: config.appliesTo, mode: config.mode })}
  aria-label="Indirect rate"
>
  {/* ── The always-visible summary, in one line ────────────────────────────
       WHICH rate, from WHICH agreement, on WHAT base — the facts only this block
       states. It used to add the indirect base and the indirect dollars as two
       large stats, which made it a 156px card, and both numbers are already in
       the grid's totals and the reconciliation rail beside the running total.
       They stay in the drawer's base × rate = indirect band, where the scope that
       moves them is changed. ── */}
  <EsaCard variant="outlined" padding="compact">
  <div class="cbf-lic__strip repel">
    <p class="cbf-lic__authority typography-body-md">
      <span class="cbf-lic__label">Indirect rate</span>
      <strong data-lic-rate>{pct(config.rate)}</strong>
      <span data-lic-blended hidden={resolved.segments.filter((s) => s.rateId).length < 2}> blended</span>
      <span class="cbf-lic__sep" aria-hidden="true">·</span>
      <span data-lic-doc>{config.referenceDoc || 'No indirect rate picked'}</span>
      <span class="cbf-lic__sep" aria-hidden="true">·</span>
      <span class="cbf-lic__meta">
        <span data-lic-base-badge hidden={!base}><EsaBadge value={base?.short ?? ''} variant="info" size="sm" /></span>
        on <span data-lic-scope>{scopeLabel}</span> cost groups<span data-lic-cap hidden={!config.subawardCap}>, first {usd(SUBAWARD_CAP)} of each subaward</span>
      </span>
    </p>
    <span class="cluster" data-gap="sm">
      <span data-lic-gap-strip hidden={!resolved.gapMonths}>
        <EsaBadge value="Rate gap in the contract period" variant="warning" size="sm" />
      </span>
      <EsaButton variant="secondary" appearance="outline" size="sm" icon="settings" data-lic-open>
        Configure…
      </EsaButton>
    </span>
  </div>
  </EsaCard>

  {/* `open` must be ABSENT when closed, not `open="false"`: esa-side-dialog's
      `open` is a Lit Boolean property that keys off attribute PRESENCE, so the
      string "false" would render the drawer open. `undefined` is omitted. */}
  <esa-side-dialog data-lic-dialog heading="Configure the indirect rate" size="lg" open={open || undefined}>
    <div class="stack" data-gap="lg">
      <p class="cbf-lic__lede typography-body-md">
        Pick your organization’s approved rate. Rates, their agreements and dates are managed under
        Data management → Vendor indirect rates.
      </p>

      {/* ── 1. Which approved rate(s) apply ─────────────────────────────── */}
      <div class="stack" data-gap="sm">
        <h3 class="typography-title">Rates</h3>
        <ul class="cbf-lic__picker" data-lic-rates>
          {VENDOR_INDIRECT_RATES.map((r) => (
            <li class="cbf-lic__row repel" data-lic-rate-row={r.id} data-in={String(picked.has(r.id))} data-usable={String(RATE_STATUS[r.status].usable)}>
              <span class="stack" data-gap="3xs">
                <esa-checkbox
                  data-lic-rate-pick={r.id}
                  label={`${r.label} · ${pct(r.rate)}`}
                  size="md"
                  checked={picked.has(r.id) || undefined}
                  disabled={!RATE_STATUS[r.status].usable || undefined}
                ></esa-checkbox>
                <span class="cbf-lic__hint typography-body-sm">
                  {INDIRECT_BASES[r.base]?.short} · {r.start}–{r.end || 'no end date'} · {r.doc}
                  {!RATE_STATUS[r.status].usable && ` · ${RATE_STATUS[r.status].label}`}
                </span>
              </span>
              {/* A badge only where the status bears on the pick; an expired or
                  draft rate can't be picked, and its grey line already says why. */}
              {RATE_STATUS[r.status].usable && (
                <EsaBadge value={RATE_STATUS[r.status].label} variant={RATE_STATUS[r.status].variant} size="sm" />
              )}
            </li>
          ))}
        </ul>
        <p class="cbf-lic__hint typography-body-sm">
          On-site and off-site dual rates aren’t supported here yet.
        </p>
      </div>

      {/* ── 2. Coverage: which rate prices which months ─────────────────── */}
      <div class="stack" data-gap="sm">
        <h3 class="typography-title">Coverage across the contract period</h3>
        <ul class="cbf-lic__picker" data-lic-coverage>
          {resolved.segments.map((sg) => (
            <li class="cbf-lic__row repel" data-in={String(!!sg.rateId)}>
              <span>{sg.period}</span>
              <span class="cbf-lic__amount">{sg.rateId ? `${sg.label} · ${pct(sg.rate)}` : 'No rate'}</span>
            </li>
          ))}
        </ul>
        <span data-lic-gap hidden={!resolved.gapMonths}>
          <EsaAlertBox variant="warning" title="A rate expires before the contract ends">
            <span data-lic-gap-text></span>
          </EsaAlertBox>
        </span>
      </div>

      {/* ── 3. What the rate is applied to — preset from the base ──────── */}
      <div class="stack" data-gap="sm">
        <h3 class="typography-title">What this rate is applied to</h3>
        <p class="cbf-lic__hint typography-body-sm" data-lic-base-hint>
          {base
            ? `Preset to ${base.label.toLowerCase()} (${base.short}), the base in your agreement. Change it only if your agreement says otherwise — the COR sees any difference.`
            : 'Pick a rate first — its base sets what the rate is applied to.'}
        </p>
        <ul class="cbf-lic__picker" data-lic-picker>
          {indirectScopes.map((scope) => (
            <li
              class="cbf-lic__row repel"
              data-lic-row={scope.key}
              data-in={String(inScope.has(scope.key))}
            >
              <span class="stack" data-gap="3xs">
                <esa-checkbox
                  data-lic-cat={scope.key}
                  label={scope.parent ? `${scope.parentLabel} — ${scope.label}` : scope.label}
                  size="md"
                  checked={inScope.has(scope.key) || undefined}
                ></esa-checkbox>
                <span class="cbf-lic__hint typography-body-sm" data-lic-row-note>
                  {inScope.has(scope.key) !== preset.has(scope.key) && base
                    ? (preset.has(scope.key) ? `In ${base.short} — left out` : `Outside ${base.short} — added`)
                    : scope.key === 'subcontracts' && config.subawardCap ? `First ${usd(SUBAWARD_CAP)} of each subaward` : ''}
                </span>
              </span>
              <span class="cbf-lic__amount" data-lic-row-amount>{usd(priced.baseByScope[scope.key] ?? 0)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div slot="footer" class="cbf-lic__footer stack" data-gap="sm">
      <div class="cbf-lic__equation cluster" data-gap="md">
        <div class="cbf-lic__num" data-lic-eq="base">
          <EsaStat value={usd(priced.totals.indirectBase)} label="Indirect base" sub={`${scopeLabel} cost groups`} />
        </div>
        <span class="cbf-lic__op" aria-hidden="true">×</span>
        <div class="cbf-lic__num" data-lic-eq="rate">
          <EsaStat value={pct(config.rate)} label="Indirect rate" sub="blended across the period" />
        </div>
        <span class="cbf-lic__op" aria-hidden="true">=</span>
        <div class="cbf-lic__num" data-lic-eq="indirect">
          <EsaStat value={usd(priced.totals.indirect)} label="Indirect" sub="added to the budget" accent />
        </div>
      </div>
      <div class="cbf-lic__actions repel">
        <EsaButton variant="ghost" size="md" data-lic-reset>
          Reset scope to the rate’s base
        </EsaButton>
        <EsaButton variant="primary" size="md" data-lic-done>Done</EsaButton>
      </div>
    </div>
  </esa-side-dialog>
</section>

<script>
  import '@esa/ecology/esa-side-dialog';
  import '@esa/ecology/esa-checkbox';
  import {
    indirectScopes,
    costLines,
    priceLines,
    INDIRECT_BASES,
    scopesForBase,
    resolveIndirect,
    withResolvedIndirect,
    SUBAWARD_CAP,
    usd,
    pct,
  } from '../../data/lib-entry.mjs';
  import { isBlank, blankConfig } from '../../data/lib-demo.mjs';

  const root = document.querySelector<HTMLElement>('[data-lic]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(sel: string, scope: ParentNode = root) =>
      scope.querySelector<T>(sel);
    const setText = (sel: string, text: string, scope: ParentNode = root) => {
      const el = $(sel, scope);
      if (el) el.textContent = text;
    };
    const show = (el: Element | null, on: boolean) => { if (el) (el as HTMLElement).hidden = !on; };

    /* The demo's "Clear all entries": a cleared form has nothing picked and
       nothing in scope. */
    const BLANK = isBlank();
    const APPROVED = BLANK ? blankConfig() : JSON.parse(root.dataset.config || '{}');
    const config: any = withResolvedIndirect({
      ...APPROVED,
      rateIds: [...(APPROVED.rateIds ?? [])],
      appliesTo: [...(APPROVED.appliesTo ?? [])],
    });
    const baseLines = BLANK ? [] : costLines;
    const dialog = $('[data-lic-dialog]') as any;

    const fire = () => {
      document.dispatchEvent(
        new CustomEvent('cbf-lib:indirect-config', {
          detail: { config: { ...config, rateIds: [...config.rateIds], appliesTo: [...config.appliesTo] } },
        }),
      );
    };

    const sameSet = (a: string[], b: string[]) => a.length === b.length && a.every((x) => b.includes(x));

    const render = () => {
      withResolvedIndirect(config);
      const r = resolveIndirect(config);
      const priced = priceLines(baseLines, config);
      const { totals } = priced;
      const base = (INDIRECT_BASES as any)[config.base];
      const preset = scopesForBase(config.base);
      const scope = `${config.appliesTo.length} of ${indirectScopes.length}`;
      const used = r.segments.filter((s: any) => s.rateId);

      // Strip.
      /* With a gap, the 12-month blend averages in zero months — show the rate
         that IS in force, and say how much of the period it covers. */
      setText('[data-lic-rate]', pct(r.gapMonths ? r.coveredRate : config.rate));
      const blended = $('[data-lic-blended]');
      show(blended, used.length > 1 || r.gapMonths > 0);
      setText('[data-lic-blended]', r.gapMonths ? ` · covers ${r.coveredMonths} of ${r.totalMonths} months` : ' blended');
      setText('[data-lic-doc]', config.referenceDoc || 'No indirect rate picked');
      setText('[data-lic-scope]', scope);
      show($('[data-lic-cap]'), !!config.subawardCap);
      show($('[data-lic-base-badge]'), !!base);
      setText('[data-lic-base-badge] .esa-badge__text', base?.short ?? '');
      show($('[data-lic-gap-strip]'), r.gapMonths > 0);
      setText('[data-lic-stat="base"] .esa-stat__value', usd(totals.indirectBase));
      setText('[data-lic-stat="indirect"] .esa-stat__value', usd(totals.indirect));
      setText('[data-lic-stat="indirect"] .esa-stat__sub', `at ${pct(config.rate)}`);

      // Rate rows.
      root.querySelectorAll<HTMLElement>('[data-lic-rate-row]').forEach((row) => {
        row.dataset.in = String(config.rateIds.includes(row.dataset.licRateRow));
      });

      // Coverage — rebuilt, because the runs change with the pick.
      const cov = $('[data-lic-coverage]');
      if (cov) {
        cov.replaceChildren(...r.segments.map((sg: any) => {
          const li = document.createElement('li');
          li.className = 'cbf-lic__row repel';
          li.dataset.in = String(!!sg.rateId);
          const a = document.createElement('span'); a.textContent = sg.period;
          const b = document.createElement('span'); b.className = 'cbf-lic__amount';
          b.textContent = sg.rateId ? `${sg.label} · ${pct(sg.rate)}` : 'No rate';
          li.append(a, b);
          return li;
        }));
      }
      const gapWrap = $('[data-lic-gap]');
      show(gapWrap, r.gapMonths > 0);
      if (r.gapMonths > 0) {
        const lastEnd = r.picks.map((p: any) => p.end).filter(Boolean).sort().pop();
        const gaps = r.segments.filter((s: any) => !s.rateId).map((s: any) => s.period).join(', ');
        setText('[data-lic-gap-text]', `${lastEnd ? `Your rate ends ${lastEnd}, so ` : ''}${gaps} ${lastEnd ? 'carries' : 'carry'} no indirect. Pick the next rate if it’s been submitted, or plan a line item transfer or CCR once it’s approved.`);
      }

      // Scope rows.
      setText('[data-lic-base-hint]', base
        ? `Preset to ${base.label.toLowerCase()} (${base.short}), the base in your agreement. Change it only if your agreement says otherwise — the COR sees any difference.`
        : 'Pick a rate first — its base sets what the rate is applied to.');
      indirectScopes.forEach((sc: any) => {
        const row = $(`[data-lic-row="${sc.key}"]`);
        if (!row) return;
        const on = config.appliesTo.includes(sc.key);
        row.dataset.in = String(on);
        const amount = row.querySelector('[data-lic-row-amount]');
        if (amount) amount.textContent = usd(priced.baseByScope?.[sc.key] ?? 0);
        const note = row.querySelector('[data-lic-row-note]');
        if (note) {
          note.textContent = base && on !== preset.includes(sc.key)
            ? (preset.includes(sc.key) ? `In ${base.short} — left out` : `Outside ${base.short} — added`)
            : sc.key === 'subcontracts' && config.subawardCap ? `First ${usd(SUBAWARD_CAP)} of each subaward` : '';
        }
      });

      // Equation band.
      setText('[data-lic-eq="base"] .esa-stat__value', usd(totals.indirectBase));
      setText('[data-lic-eq="base"] .esa-stat__sub', `${scope} cost groups`);
      setText('[data-lic-eq="rate"] .esa-stat__value', pct(config.rate));
      setText('[data-lic-eq="rate"] .esa-stat__sub', used.length > 1 ? 'blended across the period' : 'for the period');
      setText('[data-lic-eq="indirect"] .esa-stat__value', usd(totals.indirect));

      fire();
    };

    root.addEventListener('change', (e: Event) => {
      const el = e.target as HTMLElement & { checked?: boolean };
      const scopeKey = el.dataset?.licCat;
      const rateId = el.dataset?.licRatePick;
      if (scopeKey) {
        const on = !!el.checked;
        config.appliesTo = indirectScopes
          .filter((sc: any) => (sc.key === scopeKey ? on : config.appliesTo.includes(sc.key)))
          .map((sc: any) => sc.key);
      } else if (rateId) {
        /* A scope still sitting on the OLD base's preset follows the new base; one
           the vendor changed by hand is theirs and stays. */
        const wasPreset = sameSet(config.appliesTo, scopesForBase(config.base));
        config.rateIds = el.checked
          ? [...new Set([...config.rateIds, rateId])]
          : config.rateIds.filter((x: string) => x !== rateId);
        withResolvedIndirect(config);
        if (wasPreset || !config.appliesTo.length) config.appliesTo = scopesForBase(config.base);
      } else {
        return;
      }
      render();
    });

    root.addEventListener('click', (e: Event) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-lic-open]')) dialog?.show();
      else if (t.closest('[data-lic-done]')) dialog?.close();
      else if (t.closest('[data-lic-reset]')) {
        config.appliesTo = scopesForBase(config.base);
        indirectScopes.forEach((sc: any) => {
          const box = $(`[data-lic-cat="${sc.key}"]`) as any;
          if (box) box.checked = config.appliesTo.includes(sc.key);
        });
        render();
      }
    });

    /* The COR lens: inspectable, not editable — every box disabled, reset hidden.
       Rate rows that can't be used stay disabled in both lenses. */
    const applyLens = () => {
      const cor = document.documentElement.dataset.cbfRole === 'cor';
      root.querySelectorAll<any>('[data-lic-cat]').forEach((b) => { b.disabled = cor; });
      root.querySelectorAll<any>('[data-lic-rate-pick]').forEach((b) => {
        const row = b.closest('[data-lic-rate-row]') as HTMLElement | null;
        b.disabled = cor || row?.dataset.usable !== 'true';
      });
      const reset = $('[data-lic-reset]')?.closest('.esa-button') as HTMLElement | null;
      if (reset) reset.hidden = cor;
      const openLabel = root.querySelector('[data-lic-open] .esa-button__label');
      if (openLabel) openLabel.textContent = cor ? 'Review the rate…' : 'Configure…';
    };
    document.addEventListener('cbf-role:change', applyLens);
    applyLens();

    if (BLANK) {
      root.querySelectorAll<any>('[data-lic-rate-pick], [data-lic-cat]').forEach((b) => { b.checked = false; });
    }

    render();
    requestAnimationFrame(fire);
  }
</script>

<style>
  /* ── Always-visible summary, one row ── */
  .cbf-lic__strip {
    --align: center;
    --gap: var(--spacing-400);
  }
  .cbf-lic__authority { margin: 0; }
  .cbf-lic__label {
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-content-default);
    margin-inline-end: var(--spacing-200);
  }
  .cbf-lic__ident {
    min-inline-size: 22rem;
    flex: 1 1 22rem;
  }
  .cbf-lic__authority {
    color: var(--color-content-default);
  }
  .cbf-lic__authority strong {
    font-weight: var(--typography-font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .cbf-lic__meta {
    color: var(--color-content-default-secondary);
  }
  .cbf-lic__sep {
    color: var(--color-content-default-tertiary);
    padding-inline: var(--spacing-100);
  }
  .cbf-lic__figures {
    --align: flex-end;
  }
  /* Step the stat value down from the 36px page-hero role — these are supporting
     figures inside a strip, not the headline number of the screen. */
  .cbf-lic__num {
    --stat-value-size: var(--font-size-500);
  }
  .cbf-lic__num :global(.esa-stat__value) {
    font-variant-numeric: tabular-nums;
  }

  /* ── Drawer body ── */
  .cbf-lic__lede {
    color: var(--color-content-default-secondary);
    max-inline-size: 68ch;
  }
  .cbf-lic__fields {
    --grid-min: 18rem;
  }
  .cbf-lic__hint {
    color: var(--color-content-default-secondary);
    max-inline-size: 68ch;
  }

  /* ── The applicability picker ──
     A divided list frame: ecology has no list/table lego, and the rows themselves
