---
// cbf-lib-context-header — the header of the vendor-facing Line Item Budget (LIB)
// entry screen, i.e. the LIB tab inside a CBFish contract.
//
// WHAT IT SAYS: which contract this budget is for, in one title and one line of
// facts — the sponsor, the period of performance, the Contract Value and the BPA
// COR. Nothing here is entered; it is all from the contract.
//
// WHY IT IS THIS SHORT (2026-10): it used to carry the contract title, a subline,
// two large stats (the Contract Value and the capitalization threshold) and a
// six-fact "pulled from the contract" card — and most of it said things the
// screen already said. The breadcrumb names the project and the contract; the
// reconciliation rail states the Contract Value three times, beside the running
// total it is read against; the threshold lives on the Supplies & equipment
// section that it governs, and in that section's settings menu. What is left is
// what nothing else on the screen states. The contract manager and the full fact
// list remain on the contract's Summary tab.
//
// Reads src/data/lib-entry.mjs directly — the house pattern for these section
// components (see cbf-contract-summary / cbf-baselines-table), so the page stays
// a manifest and no contract facts get retyped at the call site.
//
// bcn-lego-checked: a heading and one line of text, styled with type roles —
// there is no component to reach for, and none is needed. Checked the catalog
// for a page-header lego (esa-page-header): it carries title + lede + actions, and
// this header has no actions and sits inside the contract shell's own frame.
import { contract, usd } from '../../data/lib-entry.mjs';

const heading = `Contract ${contract.number}: ${contract.project} ${contract.projectTitle}`;
const facts = [
  contract.sponsor,
  `${contract.periodStart} – ${contract.periodEnd} (${contract.fiscalYear})`,
  `Contract Value ${usd(contract.contractValue)}`,
  `COR ${contract.bpaCor}`,
];
---
<header class="cbf-lib-context stack" data-gap="2xs" aria-labelledby="cbf-lib-context-title">
  <h1 id="cbf-lib-context-title" class="typography-heading-md">{heading}</h1>
  <p class="cbf-lib-context__subline typography-body-md">
    {facts.map((f, i) => (
      <>
        {i > 0 && <span class="cbf-lib-context__sep" aria-hidden="true">·</span>}
        <span>{f}</span>
      </>
    ))}
  </p>
</header>

<style>
  .cbf-lib-context h1 {
    margin: 0;
    color: var(--color-content-default);
  }
  .cbf-lib-context__subline {
    margin: 0;
    color: var(--color-content-default-secondary);
  }
  .cbf-lib-context__sep {
    padding-inline: var(--spacing-150);
    color: var(--color-content-default-tertiary);
  }
</style>
