---
/*
 * cbf-lib-view-switch — the jump between the three LIB entry prototypes.
 *
 *   Grid       /lib-entry         a live control in every cell; lines entered inline.
 *   Side sheet /lib-entry-sheet   a read-only ledger; every edit on a side sheet.
 *   Wizard     /lib-entry-wizard  one category per step, front to back.
 *
 * A prototype device with no production counterpart: CBFish ships ONE of these. The
 * control itself is the shared cbf-route-switch; this file only names the three.
 */
import CbfRouteSwitch from '../shared/cbf-route-switch.astro';
import { withBase } from '../../lib/base';

interface Props {
  /** Which of the three this page IS. */
  active: 'grid' | 'sheet' | 'wizard';
}
const { active } = Astro.props;

const views = [
  { key: 'grid', label: 'Grid', href: withBase('/lib-entry') },
  { key: 'sheet', label: 'Side sheet', href: withBase('/lib-entry-sheet') },
  { key: 'wizard', label: 'Wizard', href: withBase('/lib-entry-wizard') },
];
---

<CbfRouteSwitch views={views} active={active} label="Entry model" note="Three versions of the same budget" />
