---
// cbf-vendor-portal-invoices — the invoices table for the vendor portal's
// financial-outlook view. A searchable, status-filterable, group-able tracking
// table of every submitted invoice across the vendor's contracts, with an
// esa-badge status column, a click-a-row detail drawer, a live record-count
// footer, and an esa-empty-state when nothing matches.
//
// bcn-lego-checked: ecology has NO table/grid/data-grid lego (checked the full
// node_modules/@esa/ecology/src/components catalog — esa-card/esa-pill/esa-badge
// are atoms, none render tabular rows) and the spoke has no AG Grid dependency;
// Beacon is not on this machine. Status uses esa-badge, the search input reuses
// cbf-search-field, the status + group-by controls use esa-chip-group, the
// detail drawer uses esa-side-dialog, and the no-results state uses
// esa-empty-state — only the table scaffold itself is bespoke, its reusable home.
import CbfSearchField from '../search/cbf-search-field.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
import { invoices as defaultInvoices, fmtExact } from '../../data/vendor-portal-invoices.mjs';

type Stage = 'Submitted' | 'In review' | 'Approved' | 'Paid' | 'Needs revision';

interface LineItem {
  description: string;
  qty: number;
  unitPrice: number;
}

interface Invoice {
  number: string;
  contract: string;
  project: string;
  submitted: string;
  amount: number;
  stage: Stage;
  invoiceDate: string;
  issued: string;
  perfStart: string;
  perfEnd: string;
  lineItems: LineItem[];
  notes?: string;
  pdfName: string;
}

interface Props {
  invoices?: Invoice[];
}

// esa-badge variant per pipeline stage — color conveys data/state, not decoration.
const stageVariant: Record<Stage, 'info' | 'warning' | 'success' | 'secondary' | 'danger'> = {
  Submitted: 'info',
  'In review': 'warning',
  Approved: 'success',
  Paid: 'secondary',
  'Needs revision': 'danger',
};

// Single-select chip filters. value="" is the "All" escape; 'Needs revision'
// gets the amber tone so the blocked-on-vendor stage stands out in the control.
const stageFilters = [
  { value: '', label: 'All' },
  { value: 'Submitted', label: 'Submitted' },
  { value: 'In review', label: 'In review' },
  { value: 'Approved', label: 'Approved' },
  { value: 'Paid', label: 'Paid' },
  { value: 'Needs revision', label: 'Needs revision', tone: 'amber' },
];
const groupOptions = [
  { value: 'none', label: 'No grouping' },
  { value: 'contract', label: 'Contract' },
  { value: 'project', label: 'Project' },
];

const { invoices = defaultInvoices } = Astro.props;
---
<section class="cbf-vendor-portal-invoices stack" data-gap="md">
  <header class="cbf-vendor-portal-invoices__header repel">
    <h2 class="type-section-title">Invoices</h2>
    <div class="cbf-vendor-portal-invoices__search">
      <CbfSearchField
        placeholder="Search invoices, contracts or status…"
        iconSize={18}
        data-invoice-search
        aria-label="Search invoices"
      />
    </div>
  </header>

  <div class="cbf-vendor-portal-invoices__controls repel">
    <esa-chip-group
      data-invoice-stage-filter
      size="sm"
      label="Filter by status"
      value=""
      options={JSON.stringify(stageFilters)}
    ></esa-chip-group>
    <label class="cbf-vendor-portal-invoices__group">
      <span class="type-caption">Group by</span>
      <esa-chip-group
        data-invoice-group
        size="sm"
        label="Group invoices by"
        value="none"
        options={JSON.stringify(groupOptions)}
      ></esa-chip-group>
    </label>
  </div>

  <div class="cbf-vendor-portal-invoices__scroll" data-invoice-table>
    <table class="cbf-vendor-portal-invoices__table">
      <thead>
        <tr>
          <th scope="col">Invoice #</th>
          <th scope="col">Contract</th>
          <th scope="col">Submitted</th>
          <th scope="col" class="cbf-num">Amount</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody data-invoice-body>
        {invoices.map((inv) => (
          <tr
            data-row
            data-haystack={`${inv.number} ${inv.contract} ${inv.project} ${inv.stage}`.toLowerCase()}
            data-number={inv.number}
            data-contract={inv.contract}
            data-project={inv.project}
            data-submitted={inv.submitted}
            data-amount={fmtExact(inv.amount)}
            data-stage={inv.stage}
            data-detail={JSON.stringify({
              invoiceDate: inv.invoiceDate,
              issued: inv.issued,
              perfStart: inv.perfStart,
              perfEnd: inv.perfEnd,
              lineItems: inv.lineItems,
              notes: inv.notes ?? '',
              pdfName: inv.pdfName,
            })}
            tabindex="0"
            role="button"
            aria-label={`View invoice ${inv.number}`}
          >
            <td class="cbf-mono-num">{inv.number}</td>
            <td>{inv.contract}</td>
            <td>{inv.submitted}</td>
            <td class="cbf-num">{fmtExact(inv.amount)}</td>
            <td data-status-cell><EsaBadge value={inv.stage} variant={stageVariant[inv.stage]} size="lg" /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="cbf-vendor-portal-invoices__empty" data-invoice-empty hidden>
    <EsaEmptyState
      title="No invoices match your filters"
      description="Try a different invoice number, contract name, or status."
      size="sm"
    />
  </div>

  <footer class="cbf-vendor-portal-invoices__footer">
    <span class="type-caption" data-invoice-count>
      Showing {invoices.length} of {invoices.length} invoices
    </span>
  </footer>

  <!-- Click-a-row detail: the esa-side-dialog overlay drawer (lego). Body is
       populated from the clicked row's data attributes; prev/next step through
       the currently-visible rows so a reviewer can walk the whole list. -->
  <esa-side-dialog data-invoice-dialog size="lg" heading="Invoice">
    <div class="cbf-invoice-detail stack" data-gap="lg">
      <!-- Hero: the billed amount is the invoice's headline figure; its pipeline
           status sits beside it as the one accent. -->
      <div class="cbf-invoice-detail__hero">
        <div class="cbf-invoice-detail__amount-group">
          <span class="cbf-invoice-detail__label">Amount billed</span>
          <span class="type-page-title cbf-invoice-detail__amount cbf-num" data-detail-amount></span>
        </div>
        <div class="cbf-invoice-detail__status" data-detail-status></div>
      </div>

      <!-- Spec list: what the invoice is against and when. Contract leads; the
           rest recede via weight + color, not a smaller label. -->
      <dl class="cbf-invoice-detail__fields">
        <div class="cbf-invoice-detail__row">
          <dt class="cbf-invoice-detail__label">Contract</dt>
          <dd class="cbf-invoice-detail__value cbf-invoice-detail__value--lead" data-detail-contract></dd>
        </div>
        <div class="cbf-invoice-detail__row">
          <dt class="cbf-invoice-detail__label">Project</dt>
          <dd class="cbf-invoice-detail__value" data-detail-project></dd>
        </div>
        <div class="cbf-invoice-detail__row">
          <dt class="cbf-invoice-detail__label">Invoice date</dt>
          <dd class="cbf-invoice-detail__value" data-detail-invoice-date></dd>
        </div>
        <div class="cbf-invoice-detail__row">
          <dt class="cbf-invoice-detail__label">Performance</dt>
          <dd class="cbf-invoice-detail__value" data-detail-perf></dd>
        </div>
        <div class="cbf-invoice-detail__row">
          <dt class="cbf-invoice-detail__label">Submitted</dt>
          <dd class="cbf-invoice-detail__value" data-detail-submitted></dd>
        </div>
      </dl>

      <!-- Line items: the breakdown behind the hero figure. -->
      <section class="cbf-invoice-detail__section">
        <h3 class="cbf-invoice-detail__section-title">Line items</h3>
        <table class="cbf-detail-items">
          <thead>
            <tr>
              <th scope="col">Description</th>
              <th scope="col" class="cbf-num">Qty</th>
              <th scope="col" class="cbf-num">Unit price</th>
              <th scope="col" class="cbf-num">Amount</th>
            </tr>
          </thead>
          <tbody data-detail-items></tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3">Invoice total</th>
              <td class="cbf-num" data-detail-total></td>
            </tr>
          </tfoot>
        </table>
      </section>

      <!-- Notes: only rendered when the invoice carries them. -->
      <section class="cbf-invoice-detail__section" data-detail-notes-section hidden>
        <h3 class="cbf-invoice-detail__section-title">Notes</h3>
        <p class="cbf-invoice-detail__notes" data-detail-notes></p>
      </section>
    </div>

    <div slot="footer" class="cbf-invoice-detail__footer repel">
      <span data-detail-download>
        <EsaButton appearance="outline" color="secondary" icon="file-text">Download PDF</EsaButton>
      </span>
      <div class="cluster cbf-invoice-detail__nav" data-gap="md" style="align-items: center;">
        <span class="cbf-invoice-detail__position" data-detail-position></span>
        <div class="cluster" data-gap="xs">
          <span data-detail-prev>
            <EsaButton appearance="outline" color="secondary" icon="chevron-left">Previous</EsaButton>
          </span>
          <span data-detail-next>
            <EsaButton appearance="outline" color="secondary" icon="chevron-right">Next</EsaButton>
          </span>
        </div>
      </div>
    </div>
  </esa-side-dialog>
</section>

<style>
  .cbf-vendor-portal-invoices__header {
    align-items: center;
    gap: var(--spacing-400);
    flex-wrap: wrap;
  }
  .cbf-vendor-portal-invoices__search {
    flex: 1 1 280px;
    max-width: 420px;
    min-width: 220px;
  }

  .cbf-vendor-portal-invoices__controls {
    align-items: center;
    gap: var(--spacing-400);
    flex-wrap: wrap;
  }
  .cbf-vendor-portal-invoices__group {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-200);
  }
  .cbf-vendor-portal-invoices__group .type-caption {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Horizontal scroll keeps the frame stable on narrow viewports. */
  .cbf-vendor-portal-invoices__scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
    background: var(--color-surface);
  }

  .cbf-vendor-portal-invoices__table {
    width: 100%;
    border-collapse: collapse;
    /* Dense data surface — 14px floor, never fainter. */
    font-size: 14px;
    color: var(--color-text-primary);
  }
  .cbf-vendor-portal-invoices__table th,
  .cbf-vendor-portal-invoices__table td {
    text-align: left;
    padding: var(--spacing-300) var(--spacing-400);
    white-space: nowrap;
    vertical-align: middle;
  }
  .cbf-vendor-portal-invoices__table thead th {
    font-weight: 600;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-subtle, transparent);
  }
  .cbf-vendor-portal-invoices__table tbody tr[data-row] + tr[data-row] td {
    border-top: 1px solid var(--color-border);
  }
  .cbf-vendor-portal-invoices__table tbody tr[data-row]:hover td {
    background: var(--color-surface-subtle, var(--color-primary-subtle));
    cursor: pointer;
  }
  .cbf-vendor-portal-invoices__table td.cbf-num,
  .cbf-vendor-portal-invoices__table th.cbf-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* Invoice IDs read as data, not document text — tabular figures, never monospace. */
  .cbf-mono-num {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .cbf-vendor-portal-invoices__footer {
    color: var(--color-text-muted);
  }

  /* ---- Detail drawer ---------------------------------------------------- */

  /* Labels are content, not ornament: normal-case, 14px, muted — never an
     uppercase micro-eyebrow. One shared role for every label in the drawer. */
  .cbf-invoice-detail__label {
    font-size: var(--type-size-150);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  /* Hero: the billed amount on a sunken surface, status badge alongside. */
  .cbf-invoice-detail__hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-400);
    padding: var(--spacing-450, var(--spacing-400));
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-200);
  }
  .cbf-invoice-detail__amount-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-100);
    min-width: 0;
  }
  .cbf-invoice-detail__amount {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .cbf-invoice-detail__status { flex: none; }

  /* Spec list: a fixed label column + flexible value column reads as a ledger.
     Hierarchy is carried by the value's weight + color, not by label size. */
  .cbf-invoice-detail__fields { margin: 0; }
  .cbf-invoice-detail__row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--spacing-400);
    align-items: baseline;
    padding-block: var(--spacing-300);
    border-top: 1px solid var(--color-border-light, var(--color-border));
  }
  .cbf-invoice-detail__row:first-child { border-top: 0; padding-top: 0; }
  .cbf-invoice-detail__value {
    margin: 0;
    font-size: var(--type-size-200);
    color: var(--color-text-secondary);
  }
  /* Lead value (contract) is the primary identifier — heavier and darker. */
  .cbf-invoice-detail__value--lead {
    font-size: var(--type-size-300);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  /* Subsection headers (Line items, Notes): content, not ornament — readable,
     primary color, modest weight. Not the uppercase micro-label pattern. */
  .cbf-invoice-detail__section-title {
    margin: 0 0 var(--spacing-200);
    font-size: var(--type-size-200);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }
  .cbf-invoice-detail__notes {
    margin: 0;
    font-size: var(--type-size-200);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .cbf-invoice-detail__position {
    font-size: var(--type-size-150);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Narrow drawer (phone widths, where the lego clamps the panel to the
     viewport): the footer's repel row would wrap incidentally — leaving
     Download alone on one line and the nav orphaned below. Stack it
     deliberately instead: Download on top, the position + prev/next nav as a
     full-width space-between row beneath it. */
  @media (max-width: 480px) {
    .cbf-invoice-detail__footer {
      flex-direction: column;
      align-items: stretch;
      gap: var(--spacing-300);
    }
    .cbf-invoice-detail__nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<style is:global>
  /* Detail-drawer line items. Body rows are injected by JS (no Astro scope
     hash), so the table is styled globally, scoped under .cbf-detail-items. */
  .cbf-detail-items {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-size-150);
    color: var(--color-text-primary);
  }
  .cbf-detail-items th,
  .cbf-detail-items td {
    text-align: left;
    padding: var(--spacing-250) var(--spacing-300);
    vertical-align: top;
  }
  .cbf-detail-items thead th {
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }
  .cbf-detail-items tbody tr + tr td { border-top: 1px solid var(--color-border-light, var(--color-border)); }
  .cbf-detail-items tfoot th,
  .cbf-detail-items tfoot td {
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    padding-top: var(--spacing-300);
  }
  .cbf-detail-items .cbf-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Left-align the "Invoice total" caption that spans the description columns. */
  .cbf-detail-items tfoot th { text-align: left; }

  /* Group divider rows are injected by the group-by control (no Astro scope
     hash), so they are styled globally, scoped under the component class. */
  .cbf-vendor-portal-invoices__table tr[data-group-header] th {
    text-align: left;
    padding: var(--spacing-250) var(--spacing-400);
    background: var(--color-surface-sunken, #efefef);
    border-block: 1px solid var(--color-border);
    font-size: var(--type-size-150);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-secondary);
  }
  .cbf-vendor-portal-invoices__group-count {
    font-weight: var(--font-weight-regular, 400);
    color: var(--color-text-muted);
  }
</style>

<script>
  import '@esa/ecology/esa-chip-group';
  import '@esa/ecology/esa-side-dialog';

  type Dir = 1 | -1;

  function initInvoices(root: HTMLElement) {
    const search = root.querySelector<HTMLInputElement>('[data-invoice-search]');
    const stageFilter = root.querySelector<HTMLElement & { value: string }>('[data-invoice-stage-filter]');
    const groupControl = root.querySelector<HTMLElement & { value: string }>('[data-invoice-group]');
    const body = root.querySelector<HTMLElement>('[data-invoice-body]');
    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('[data-row]'));
    const empty = root.querySelector<HTMLElement>('[data-invoice-empty]');
    const tableWrap = root.querySelector<HTMLElement>('[data-invoice-table]');
    const count = root.querySelector<HTMLElement>('[data-invoice-count]');
    if (!body) return;

    const total = rows.length;
    const colCount = root.querySelectorAll('thead th').length;

    const clearGroupHeaders = () =>
      body.querySelectorAll('[data-group-header]').forEach((el) => el.remove());

    const makeGroupHeader = (label: string, n: number) => {
      const tr = document.createElement('tr');
      tr.setAttribute('data-group-header', '');
      const th = document.createElement('th');
      th.colSpan = colCount;
      th.setAttribute('scope', 'colgroup');
      th.innerHTML = `${label} <span class="cbf-vendor-portal-invoices__group-count">· ${n}</span>`;
      tr.appendChild(th);
      return tr;
    };

    const render = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      const stage = stageFilter?.value ?? '';
      const groupKey = groupControl?.value ?? 'none';

      // 1. Decide visibility from search + status filter.
      const visible: HTMLTableRowElement[] = [];
      for (const row of rows) {
        const matchQ = !q || (row.dataset.haystack ?? '').includes(q);
        const matchStage = !stage || row.dataset.stage === stage;
        const show = matchQ && matchStage;
        row.hidden = !show;
        if (show) visible.push(row);
      }

      // 2. Re-flow the tbody: flat (original order) or grouped with divider rows.
      clearGroupHeaders();
      if (groupKey === 'none') {
        for (const row of rows) body.appendChild(row); // restore original order
      } else {
        const groups = new Map<string, HTMLTableRowElement[]>();
        for (const row of visible) {
          const key = row.dataset[groupKey] ?? '—';
          let bucket = groups.get(key);
          if (!bucket) { bucket = []; groups.set(key, bucket); }
          bucket.push(row);
        }
        for (const [key, grp] of [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
          body.appendChild(makeGroupHeader(key, grp.length));
          for (const row of grp) body.appendChild(row);
        }
        for (const row of rows) if (row.hidden) body.appendChild(row); // park hidden rows last
      }

      // 3. Sync empty state + count.
      if (empty) empty.hidden = visible.length !== 0;
      if (tableWrap) tableWrap.hidden = visible.length === 0;
      if (count) count.textContent = `Showing ${visible.length} of ${total} invoices`;
    };

    search?.addEventListener('input', render);
    stageFilter?.addEventListener('change', render);
    groupControl?.addEventListener('change', render);

    initDetailDrawer(root, rows);
  }

  // Click-a-row → open the side-dialog populated from the row; prev/next walk
  // the rows currently visible (respecting the active search + filter).
  function initDetailDrawer(root: HTMLElement, rows: HTMLTableRowElement[]) {
    const dialog = root.querySelector<HTMLElement & { heading: string; show(): void }>('[data-invoice-dialog]');
    if (!dialog) return;
    const statusBox = dialog.querySelector<HTMLElement>('[data-detail-status]');
    const fContract = dialog.querySelector<HTMLElement>('[data-detail-contract]');
    const fProject = dialog.querySelector<HTMLElement>('[data-detail-project]');
    const fInvoiceDate = dialog.querySelector<HTMLElement>('[data-detail-invoice-date]');
    const fPerf = dialog.querySelector<HTMLElement>('[data-detail-perf]');
    const fSubmitted = dialog.querySelector<HTMLElement>('[data-detail-submitted]');
    const fAmount = dialog.querySelector<HTMLElement>('[data-detail-amount]');
    const itemsBody = dialog.querySelector<HTMLElement>('[data-detail-items]');
    const fTotal = dialog.querySelector<HTMLElement>('[data-detail-total]');
    const notesSection = dialog.querySelector<HTMLElement>('[data-detail-notes-section]');
    const fNotes = dialog.querySelector<HTMLElement>('[data-detail-notes]');
    const position = dialog.querySelector<HTMLElement>('[data-detail-position]');

    type LineItem = { description: string; qty: number; unitPrice: number };
    type Detail = {
      invoiceDate: string; issued: string; perfStart: string; perfEnd: string;
      lineItems: LineItem[]; notes: string; pdfName: string;
    };
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 });
    // EsaButton renders <span.esa-button><button>; the data-* hook lives on an
    // outer wrapper span (EsaButton drops unknown attrs), so listen on the
    // wrapper and toggle the inner native <button>'s disabled state.
    const prevWrap = dialog.querySelector<HTMLElement>('[data-detail-prev]');
    const nextWrap = dialog.querySelector<HTMLElement>('[data-detail-next]');
    const prev = prevWrap?.querySelector('button') ?? null;
    const next = nextWrap?.querySelector('button') ?? null;

    let current = -1;
    const visibleRows = () => rows.filter((r) => !r.hidden);

    const populate = (row: HTMLTableRowElement) => {
      const vis = visibleRows();
      current = vis.indexOf(row);
      dialog.heading = row.dataset.number ?? 'Invoice';
      const badge = row.querySelector('[data-status-cell]');
      if (statusBox) statusBox.innerHTML = badge ? badge.innerHTML : '';
      if (fContract) fContract.textContent = row.dataset.contract ?? '';
      if (fProject) fProject.textContent = row.dataset.project ?? '';
      if (fSubmitted) fSubmitted.textContent = row.dataset.submitted ?? '';
      if (fAmount) fAmount.textContent = row.dataset.amount ?? '';

      const d = JSON.parse(row.dataset.detail ?? '{}') as Detail;
      if (fInvoiceDate) fInvoiceDate.textContent = d.invoiceDate ?? '';
      if (fPerf) fPerf.textContent = d.perfStart && d.perfEnd ? `${d.perfStart} – ${d.perfEnd}` : '';
      if (itemsBody) {
        itemsBody.innerHTML = (d.lineItems ?? [])
          .map(
            (li) => `<tr>
              <td>${li.description}</td>
              <td class="cbf-num">${li.qty}</td>
              <td class="cbf-num">${usd.format(li.unitPrice)}</td>
              <td class="cbf-num">${usd.format(li.qty * li.unitPrice)}</td>
            </tr>`,
          )
          .join('');
      }
      if (fTotal) fTotal.textContent = row.dataset.amount ?? '';
      if (notesSection && fNotes) {
        fNotes.textContent = d.notes ?? '';
        notesSection.hidden = !d.notes;
      }

      if (position) position.textContent = `Invoice ${current + 1} of ${vis.length}`;
      if (prev) prev.disabled = current <= 0;
      if (next) next.disabled = current >= vis.length - 1;
    };

    const step = (dir: Dir) => {
      const vis = visibleRows();
      const target = vis[current + dir];
      if (target) populate(target);
    };

    for (const row of rows) {
      row.addEventListener('click', () => { populate(row); dialog.show(); });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); populate(row); dialog.show(); }
      });
    }
    prevWrap?.addEventListener('click', () => step(-1));
    nextWrap?.addEventListener('click', () => step(1));
  }

  document
    .querySelectorAll<HTMLElement>('.cbf-vendor-portal-invoices')
    .forEach(initInvoices);
</script>
