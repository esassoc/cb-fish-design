---
// cbf-public-nav — CBFish's two-tier public chrome, assembled from ecology
// bricks. No structural CSS, no brand values: the look comes from the theme
// re-pointing --color-background-brand (header) and --color-background-default-knockout (admin bar).
//
// CBF-8117: search moved OUT of the blue header and UP into the dark admin tray
// (centered), freeing the header for the Recent menu, My Work, and the user —
// who is also the Impersonation target (a QA/ESA-admin shortcut). The command
// palette itself is cbf-omni-search, mounted once at the end of this nav.
//
//   esa-app-bar       colored bar shell + start/main/end slots + tone
//   esa-icon-link     [icon] label [chevron] links (inherit currentColor)
//   esa-nav-dropdown  disclosure: icon-link trigger + floating panel
//   esa-link-column   heading + rule + link list (the dropdown body)
//   cbf-omni-trigger  the tray search affordance  → opens cbf-omni-search
//   cbf-logo / cbf-icon  spoke-local lockup + glyphs
//
// The end cluster (Dashboard · Recent · user) is authored as local cbf-nav-link
// chrome rather than esa-icon-link: it needs the `history` glyph (absent from the
// hub icon set) and the user menu's markup is rewritten live during impersonation.
import EsaAppBar from '@esa/ecology/esa-app-bar.astro';
import EsaIconLink from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-button.astro';
import EsaNavDropdown from '@esa/ecology/esa-nav-dropdown.astro';
import EsaLinkColumn from '@esa/ecology/esa-link-column.astro';
import EsaAvatar from '@esa/ecology/esa-avatar.astro';
import CbfLogo from './cbf-logo.astro';
import CbfIcon from '../search/cbf-icon.astro';
import CbfOmniTrigger from '../search/cbf-omni-trigger.astro';
import CbfOmniSearch from '../search/cbf-omni-search.astro';
// Menu data is shared with the homepage footer (cbf-app-footer) via app-nav.ts so
// the nav and the sitemap can never drift. `system`/`quick` are the admin-tray
// dropdowns + header shortcuts that collapse into the drawer below --cbf-nav-collapse.
import { help, mitigation, reporting, funding, system, quick, type NavLink } from '../../data/app-nav';
import { withBase } from '../../lib/base';
// app-nav hrefs are root-relative and base-less — prefix internal ones here.
// QA's own nav glyphs, copied one file at a time from esassoc/sitkatech-monorepo
// (Gemini/Source/Taurus.WebCore/wwwroot/Content/img/GeminiNav/, as referenced by
// Views/Shared/NavigationMenu.cshtml and NavigationMenuTreeMaker.cs) into
// public/images/qa-nav/. Each is its own size, as QA draws them. They paint through a
// CSS mask in currentColor, because the hub's button and dropdown take only a
// registry icon name, not an SVG.
const QA_ICONS = {
  datamanagement: ['Nav-white-Datamanagement', 11, 12],
  systemstatus: ['Nav-white-Systemstatus', 14, 14],
  systemconfiguration: ['Nav-white-Systemconfiguration', 13, 12],
  help: ['Nav-white-Help', 15, 14],
  mitigation: ['Nav-Mitigationwork', 23, 16],
  reporting: ['Nav-Reporting', 21, 10],
  funding: ['Nav-Funding', 24, 14],
  dashboard: ['Nav-Dashboard', 16, 14],
  recent: ['Nav-Recent', 14, 14],
} as const;
const qa = (key: keyof typeof QA_ICONS): string => {
  const [file, w, h] = QA_ICONS[key];
  return `--qa-icon: url(${withBase(`/images/qa-nav/${file}.svg`)}); --qa-w: ${w}px; --qa-h: ${h}px`;
};
const based = (links: NavLink[]): NavLink[] =>
  links.map((l) => (l.href?.startsWith('/') ? { ...l, href: withBase(l.href) } : l));
---
<EsaAppBar tone="brand-strong" as="nav" class="cbf-app-bar--admin">
  {/* System menus are admin tools (assumed, not confirmed): the contract pages'
      role lens hides them for COR and contractor via data-hide-for. */}
  <div class="cbf-nav-collapsible" slot="start" data-hide-for="cor contractor">
    <span class="cbf-qa-icon" style={qa('datamanagement')}><EsaIconLink variant="chrome" size="sm" iconRight="chevron-down">Data management</EsaIconLink></span>
    <span class="cbf-qa-icon" style={qa('systemstatus')}><EsaIconLink variant="chrome" size="sm" iconRight="chevron-down">System status</EsaIconLink></span>
    <span class="cbf-qa-icon" style={qa('systemconfiguration')}><EsaIconLink variant="chrome" size="sm" iconRight="chevron-down">System configuration</EsaIconLink></span>
  </div>
  <CbfOmniTrigger />
  <div class="cbf-nav-collapsible" slot="end">
    <span class="cbf-qa-icon" style={qa('help')}>
      <EsaNavDropdown size="sm" align="end" label="Help">
        <EsaLinkColumn heading="Help" links={based(help)} />
      </EsaNavDropdown>
    </span>
  </div>
</EsaAppBar>

<EsaAppBar tone="brand" as="header" class="cbf-app-bar--header">
  <Fragment slot="start">
    <span class="cbf-nav-burger" data-nav-toggle>
      <EsaIconButton variant="chrome" iconOnly icon="menu" label="Open menu" />
    </span>
    <CbfLogo />
  </Fragment>
  <div class="cbf-nav-collapsible cbf-nav-collapsible--inline">
    <span class="cbf-qa-icon" style={qa('mitigation')}>
      <EsaNavDropdown label="Mitigation work">
        <EsaLinkColumn heading="Mitigation work" links={based(mitigation)} />
      </EsaNavDropdown>
    </span>
    <span class="cbf-qa-icon" style={qa('reporting')}>
      <EsaNavDropdown label="Reporting">
        <EsaLinkColumn heading="Reporting" links={based(reporting)} />
      </EsaNavDropdown>
    </span>
    <span class="cbf-qa-icon" style={qa('funding')}>
      <EsaNavDropdown label="Funding">
        <EsaLinkColumn heading="Funding" links={based(funding)} />
      </EsaNavDropdown>
    </span>
  </div>

  <div class="cbf-nav-actions" slot="end">
    {/* Recent = recently VISITED PAGES, distinct from search. Lives here in the
        header now that the palette's no-query view is illustration-only.
        bcn-lego-checked: end-cluster stays local cbf-nav-link chrome (not esa-icon-link)
        because it needs the `history` glyph absent from the hub icon set and the user
        menu's markup is rewritten live during impersonation; --collapse hides Recent/
        My Work below the nav breakpoint, where they reappear in the esa-side-dialog drawer. */}
    {/* Order and glyphs follow QA (2026-11-10): Dashboard, Recent, then the user with
        an initials avatar. */}
    <a class="cbf-nav-link cbf-nav-link--collapse" href={withBase('/my-work')}>
      <span class="cbf-qa-icon__glyph" style={qa('dashboard')}></span> Dashboard
    </a>
    <button class="cbf-nav-link cbf-nav-link--collapse" type="button">
      <span class="cbf-qa-icon__glyph" style={qa('recent')}></span> Recent <CbfIcon name="chevron-down" size={14} />
    </button>
    <button class="cbf-nav-link cbf-nav-link--user" type="button" data-omni-user>
      <span class="cbf-nav-link__avatar" data-cbf-user-initials><EsaAvatar name="Angela Zhao" size="sm" /></span>
      <span data-cbf-user-name>Angela Zhao</span> <CbfIcon name="chevron-down" size={14} />
    </button>
  </div>
</EsaAppBar>

<CbfOmniSearch />

{/* Mobile nav drawer — the inline bar groups collapse in here below --cbf-nav-collapse.
    esa-side-dialog gives the drawer mechanics (backdrop, focus trap, Esc, slide, focus
    restore) for free; each section is an esa-link-column so the brand inherits via
    currentColor. Opened by the header hamburger (esa-icon-button). */}
<esa-side-dialog position="left" heading="Menu" size="sm" class="cbf-nav-drawer" data-nav-drawer>
  <nav class="stack" data-gap="lg" aria-label="Site navigation">
    <EsaLinkColumn heading="Mitigation work" links={based(mitigation)} />
    <EsaLinkColumn heading="Reporting" links={based(reporting)} />
    <EsaLinkColumn heading="Funding" links={based(funding)} />
    <EsaLinkColumn heading="Quick links" links={quick} />
    <EsaLinkColumn heading="System" links={based(system)} />
    <EsaLinkColumn heading="Help" links={based(help)} />
  </nav>
</esa-side-dialog>

<script>
  // Register the drawer custom element and wire the hamburger toggle. Tapping a link
  // inside the drawer closes it (a navigation gesture should dismiss the sheet).
  import '@esa/ecology/esa-side-dialog';
  const drawer = document.querySelector('[data-nav-drawer]') as (HTMLElement & { show(): void; close(): void }) | null;
  document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => drawer?.show());
  drawer?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) drawer.close();
  });
</script>

<style>
  /* End cluster — spoke chrome on the brand bar (inherits white via currentColor). */
  .cbf-nav-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-600);
  }
  .cbf-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    background: none;
    border: 0;
    font-size: 16px;
    font-weight: var(--typography-font-weight-medium);
    white-space: nowrap;
  }
  .cbf-nav-link:hover {
    text-decoration: underline;
  }
  /* a separator before the user menu — a pseudo-element rule, not a border-left
     (colored left-borders are banned as status/category indicators). */
  .cbf-nav-link--user {
    position: relative;
    padding-left: var(--spacing-500);
  }
  .cbf-nav-link--user::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 1.1em;
    background: rgba(255, 255, 255, 0.25);
  }
  /* QA's glyphs (see QA_ICONS): a mask over currentColor, ahead of the label in a
     lego trigger, or as its own span in the local links. */
  .cbf-qa-icon {
    display: contents;
  }
  .cbf-qa-icon :global(.esa-button__native)::before,
  .cbf-qa-icon__glyph {
    content: '';
    display: inline-block;
    flex: none;
    inline-size: var(--qa-w);
    block-size: var(--qa-h);
    background: currentColor;
    mask: var(--qa-icon) center / contain no-repeat;
  }
  /* QA's avatar: white initials disc on the brand bar. */
  .cbf-nav-link__avatar {
    display: inline-flex;
  }
  .cbf-nav-link__avatar :global(.esa-avatar) {
    background: var(--color-background-default);
    color: var(--color-background-brand);
  }
  .cbf-nav-link--user.is-impersonating {
    color: var(--cbf-amber-attention);
  }
  /* Phone: collapse the user menu to its glyph. font-size:0 zeroes the bare name
     text node without touching structure (the impersonation JS rewrites this
     button's innerHTML, so no wrapper span to rely on); the circle-user and
     chevron icons keep their explicit pixel size, and the impersonation badge
     keeps its own explicit font-size, so both survive. The separator is dropped
     since Recent/My Work no longer precede the user here. */
  /* Mid widths: the avatar alone stands for the user, so the end cluster clears the
     Funding menu (it ran into it from ~1340px down). */
  @media (max-width: 1360px) {
    .cbf-nav-actions { gap: var(--spacing-400); }
    /* Hidden from sight only: the name still labels the button. */
    .cbf-nav-link--user [data-cbf-user-name] {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 680px) {
    .cbf-nav-link--user { font-size: 0; padding-left: 0; }
    .cbf-nav-link--user::before { display: none; }
  }

  /* Responsive collapse (esa-app-bar is a non-wrapping flex/grid primitive with no
     overflow handling, so a dense bar clips below ~1024px). Below the breakpoint the
     inline groups fold into the esa-side-dialog drawer, reached via the hamburger.
     .cbf-nav-collapsible is display:contents so it never disturbs the bar's own
     flex/grid layout above the breakpoint — it just gates visibility. */
  .cbf-nav-collapsible { display: contents; }
  .cbf-nav-burger { display: none; } /* hidden until the bar would overflow */

  @media (max-width: 1200px) {
    .cbf-nav-collapsible,
    .cbf-nav-link--collapse { display: none; }
    .cbf-nav-burger {
      display: inline-flex;
      align-items: center;
      color: inherit; /* esa-icon-button inherits white via currentColor */
    }
  }
</style>

<style is:global>
  /* Admin tray: 3-column grid so the search trigger sits dead-center between the
     left admin links and Help, regardless of their differing widths. The bar's
     own gap and vertical padding are the hub's now — the app-bar-pad-y hook went
     out with app-bar-gap in app-bar-hooks-removed, so the tray sits at the stock
     16px block padding until the density variant lands. */
  .cbf-app-bar--admin {
  }
  .cbf-app-bar--admin .esa-app-bar__row {
    display: grid;
    /* minmax(0, 380px) lets the centered search trigger shrink below its 380px
       ideal on narrow viewports instead of forcing a horizontal scrollbar. */
    grid-template-columns: 1fr minmax(0, 380px) 1fr;
  }
  .cbf-app-bar--admin .cbf-omni-trigger { min-width: 0; }
  .cbf-app-bar--admin .esa-app-bar__start { justify-self: start; }
  /* Pinned to the middle column, so it stays centered when the role lens hides the
     admin menus on its left. */
  .cbf-app-bar--admin .esa-app-bar__main { justify-content: center; grid-column: 2; }
  .cbf-app-bar--admin .esa-app-bar__end { justify-self: end; }

  /* Phone: the header logo drops its wordmark, keeping just the compact mark, so
     the brand bar leaves room for the burger + user glyph without overflowing.
     Scoped to the header bar so the footer/other lockups are unaffected. */
  @media (max-width: 680px) {
    .cbf-app-bar--header .cbf-logo__type { display: none; }
  }

  /* icons injected during impersonation (userMenu.innerHTML is rewritten by JS) */
  .cbf-nav-link .cbf-icon { display: inline-flex; align-items: center; }
  .cbf-imp-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px var(--spacing-200);
    margin-right: 2px;
    border-radius: 999px;
    background: var(--cbf-amber-attention);
    color: var(--color-background-default-knockout, #13273e);
    font-size: 13px;
    font-weight: var(--typography-font-weight-semibold);
  }
</style>
