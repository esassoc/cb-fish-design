---
// cbf-password-gate — a client-side-only password lock in front of one page's
// content. Requested for the 2020 CRS Commitments area specifically, given the
// sensitivity of a commitment-tracking feature displaying content that could
// read as real regulatory data in production.
//
// IMPORTANT — this is a CASUAL DETERRENT, not real access control, and the
// user explicitly confirmed that's the intent before this was built:
//   - This spoke builds to static HTML (astro build, output: "static",
//     deployed via gh-pages) — there is no server to check a password against,
//     so the check can only ever run in the visitor's own browser.
//   - The password string ships in the page's JS bundle in plain text —
//     visible via view-source or the network tab. No hashing/obfuscation
//     changes that; anything computed client-side is checkable client-side.
//   - The slotted content is still present in the static HTML output (just
//     under a `hidden` attribute) — it is NOT re-fetched or built after
//     unlocking. A visitor who disables JS, or who reads the page source
//     directly, sees the content regardless of the lock screen.
// This keeps someone from stumbling onto the page in normal browsing; it does
// not protect the content from a determined viewer. Do not reuse this pattern
// anywhere real protection is required.
//
// Unlock state persists per-session via sessionStorage (not localStorage) —
// tab-scoped and cleared when the browser session ends, so it re-prompts on
// a fresh visit rather than staying unlocked indefinitely on a shared machine.
//
// bcn-lego-checked: no esa- lego models a full-page pre-content lock screen —
// esa-dialog is a layered modal OVER already-visible app chrome, not a gate
// that replaces a page's content until a check passes; esa-loading-overlay is
// a transient in-flight spinner, not an auth gate. Checked the full
// node_modules/@esa/ecology/src/components catalog and Beacon is not on this
// machine. Every control inside IS a lego: esa-card (surface), esa-text-field
// (password input, its own errorText prop for the wrong-password message),
// esa-button (submit). The lock glyph uses esa-icon's documented `paths`
// fallback slot (Lucide "lock", not in the registry) rather than a hand-drawn
// SVG. This component is the reusable home for the pattern.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  /** Plain-text password to check against — see the security note above. */
  password: string;
  /** sessionStorage key that remembers this gate is unlocked for the tab session. */
  storageKey?: string;
  title?: string;
  description?: string;
}

const {
  password,
  storageKey = 'cbf-gate-unlocked',
  title = 'This prototype is password protected',
  description = 'Enter the password to continue.',
} = Astro.props;

// Lucide "lock" — not in icon-registry.ts, supplied via esa-icon's documented
// paths fallback for glyphs outside the built-in set.
const lockPaths =
  '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>';
---
<div class="cbf-password-gate" data-cbf-gate data-storage-key={storageKey}>
  <div class="cbf-password-gate__lock" data-cbf-gate-lock>
    <EsaCard variant="outlined" padding="spacious">
      <div class="cbf-password-gate__body stack" data-gap="lg">
        <div class="cbf-password-gate__icon" aria-hidden="true">
          <EsaIcon name="lock" paths={lockPaths} size="lg" />
        </div>
        <div class="stack" data-gap="xs">
          <h1 class="type-card-title">{title}</h1>
          <p class="type-body cbf-password-gate__desc">{description}</p>
        </div>
        <form class="stack" data-gap="md" data-cbf-gate-form>
          <esa-text-field
            type="password"
            label="Password"
            data-cbf-gate-input
            required
          ></esa-text-field>
          <EsaButton type="submit" color="primary">Unlock</EsaButton>
        </form>
      </div>
    </EsaCard>
  </div>

  <div class="cbf-password-gate__content" data-cbf-gate-content hidden>
    <slot />
  </div>

  <!-- Password lives here in plain text — see the security note above; there
       is no way to protect a value that must be checked client-side. -->
  <script type="application/json" data-cbf-gate-password set:html={JSON.stringify(password)}></script>
</div>

<style>
  /* The gate wraps its slotted content in one extra <div> — without this, the
     heading/tabs/body inside lose the gap="400" rhythm cbf-app-panel__content
     applies to its own DIRECT children (this div is now the only direct
     child, so the gap only ever applied around IT, not between what's inside
     it). Reapplies the SAME token so the revealed content matches the page
     rhythm every non-gated page gets for free. */
  .cbf-password-gate__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-400);
  }
  /* Same author-CSS-beats-UA-stylesheet issue as the lock screen below — this
     unconditional `display: flex` would otherwise defeat the content div's
     initial `hidden` attribute, showing it before the password is checked. */
  .cbf-password-gate__content[hidden] {
    display: none;
  }

  .cbf-password-gate__lock {
    display: flex;
    justify-content: center;
    padding-block: var(--spacing-800, 4rem);
  }
  /* Author CSS beats the UA stylesheet's [hidden]{display:none} at equal
     specificity, so the unconditional `display: flex` above would otherwise
     defeat lock.hidden = true in the client script below. Restated here with
     higher specificity so the hidden attribute actually hides the element. */
  .cbf-password-gate__lock[hidden] {
    display: none;
  }
  .cbf-password-gate__lock :global(.esa-card) {
    max-width: 26rem;
    width: 100%;
  }
  .cbf-password-gate__body {
    align-items: center;
    text-align: center;
  }
  .cbf-password-gate__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full, 999px);
    background: var(--color-surface-sunken);
    color: var(--color-text-secondary);
  }
  .cbf-password-gate__desc {
    color: var(--color-text-secondary);
  }
  .cbf-password-gate__lock form {
    width: 100%;
    text-align: left;
  }
</style>

<script>
  import '@esa/ecology/esa-text-field';

  type GateTextField = HTMLElement & { value: string; errorText: string };

  function initGate(root: HTMLElement): void {
    const storageKey = root.dataset.storageKey ?? 'cbf-gate-unlocked';
    const lock = root.querySelector<HTMLElement>('[data-cbf-gate-lock]');
    const content = root.querySelector<HTMLElement>('[data-cbf-gate-content]');
    const form = root.querySelector<HTMLFormElement>('[data-cbf-gate-form]');
    const input = root.querySelector<GateTextField>('[data-cbf-gate-input]');
    const passwordEl = root.querySelector<HTMLScriptElement>('[data-cbf-gate-password]');
    if (!lock || !content || !form || !input || !passwordEl) return;

    const expected: string = JSON.parse(passwordEl.textContent ?? '""');

    function unlock(): void {
      sessionStorage.setItem(storageKey, '1');
      lock!.hidden = true;
      content!.hidden = false;
    }

    // Already unlocked earlier this tab session — skip straight to content.
    if (sessionStorage.getItem(storageKey) === '1') {
      unlock();
      return;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (input.value === expected) {
        unlock();
      } else {
        input.errorText = 'Incorrect password. Try again.';
        input.value = '';
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>('[data-cbf-gate]')
    .forEach(initGate);
</script>
