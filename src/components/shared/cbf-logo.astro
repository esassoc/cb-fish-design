---
// cbf-logo — the CB Fish brand lockup (mark + wordmark). Spoke-local because the
// asset is brand-specific, but it slots into hub chrome (esa-app-bar, footer).
// `variant="mark"` drops the wordmark for tight spaces.
import { withBase } from '../../lib/base';
interface Props {
  variant?: 'full' | 'mark';
  href?: string;
}
const { variant = 'full', href = withBase('/') } = Astro.props;
---
<a class="cbf-logo" href={href} title="Columbia Basin Fish & Wildlife Program">
  <img class="cbf-logo__mark" src={withBase('/logo-mark.svg')} alt="" />
  {variant === 'full' && (
    <img class="cbf-logo__type" src={withBase('/logo-type.svg')} alt="Columbia Basin Fish & Wildlife Program" />
  )}
</a>

<style>
  .cbf-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-300, 12px);
    flex: none;
    color: inherit;
    text-decoration: none;
  }
  .cbf-logo__mark { width: 48px; height: 48px; flex: none; }
  .cbf-logo__type { height: 40px; width: auto; }
</style>
