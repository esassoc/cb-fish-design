---
/*
 * cbf-role-switch — the prototype's role lens: who is reading this screen.
 *
 * Some cbfish screens are ONE document read by people with different powers (a vendor
 * who enters a Line Item Budget and the BPA COR who reviews it; a system admin, a COR
 * and a contractor on a contract). In production the role comes from who signed in;
 * here it is switchable. Sets <html data-cbf-role="…">; components reveal their own
 * half with `html[data-cbf-role='…']` selectors. Fires `cbf-role:change` with
 * { role, switched } on document.
 *
 * The control is the shared cbf-lens-switch; this file only supplies the role
 * defaults (the Line Item Budget pair) and the `role` URL parameter.
 */
import CbfLensSwitch from './cbf-lens-switch.astro';
import { ROLES, ROLE_KEY } from '../../data/lib-review.mjs';

interface Role {
  key: string;
  label: string;
  /** The line under the control: who the reader currently is. */
  who: string;
  /** The person shown as signed in, in the top bar's account menu. */
  name?: string;
}
interface Props {
  /** The role the page renders as when nothing is stored yet. */
  initial?: string;
  /** The lenses on offer. Defaults to the Line Item Budget pair (vendor, BPA COR). */
  roles?: Role[];
  /** sessionStorage key, so each prototype remembers its own lens. */
  storageKey?: string;
}
const {
  roles = ROLES.map((r) => ({
    key: r.key,
    label: r.label,
    who: r.key === 'cor' ? `${r.who} — reviewing this budget for BPA` : `${r.who} — entering this budget`,
  })),
  storageKey = ROLE_KEY,
  initial,
} = Astro.props;
---

<CbfLensSwitch
  options={roles}
  label="Viewing as"
  attr="cbf-role"
  param="role"
  storageKey={storageKey}
  event="cbf-role:change"
  initial={initial}
/>
