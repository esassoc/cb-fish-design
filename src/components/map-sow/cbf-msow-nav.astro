---
// bcn-lego-checked: esa-button does not support onclick pass-through (renders
// <span><button>…</button></span>, onclick on the Astro call goes nowhere). Work-
// around: wrap each button in a <span onclick> so the click event bubbles up from
// the inner native button. Checked @esa/ecology esa-button.astro — no onclick prop.
//
// data-theme="msow-dark" is applied to button wrapper spans only — NOT the nav
// element itself. This keeps the nav background resolving to --color-primary
// (#1e5386, the brand/application color) while buttons inside get their own
// token override so fills are readable on that dark surface.
//
// Expert-mode toggle button removed — Guided wizard is the only mode now.
// toggleWizardMode()/Expert-panel code stays in map-sow.js, just unreachable.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  contractNum?: string;
  cor?: string;
  fy?: string;
}
const { contractNum = '84042 REL 117', cor = 'Tracy Hauser', fy = '2026' } = Astro.props;
---
<nav id="msow-nav" role="banner">
  <span class="msow-brand" role="heading" aria-level="1">
    Habitat Design Tool <em>&#9679; Draft</em>
  </span>
  <span class="msow-nlabel">Contract #</span>
  <span class="msow-nval">{contractNum}</span>
  <span class="msow-nlabel" style="margin-left:8px">COR</span>
  <span class="msow-nval">{cor}</span>
  <span class="msow-nlabel" style="margin-left:8px">FY</span>
  <span class="msow-nval">{fy}</span>
  <span class="msow-spacer"></span>

  <span onclick="clearAll()" data-theme="msow-dark">
    <EsaButton color="ghost" appearance="outline" size="sm">Clear All</EsaButton>
  </span>

  <span onclick="openSOW()" data-theme="msow-dark">
    <EsaButton color="primary" size="sm">Export Metrics</EsaButton>
  </span>
</nav>
