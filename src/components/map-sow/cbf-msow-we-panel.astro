---
// Work Elements left panel — list + add button. Content rendered by map-sow.js.
// Panel is light (var(--color-surface-sunken)) so it fits the CB Fish family.
// Contract metadata lives here since the tool nav bar was dissolved.
//
// bcn-lego-checked: esa-button onclick wrapper pattern — see cbf-msow-nav comment.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  contractNum?: string;
  cor?: string;
  fy?: string;
}
const { contractNum = '84042 REL 117', cor = 'Tracy Hauser', fy = '2026' } = Astro.props;
---
<div id="we-panel" role="complementary" aria-label="Work Elements">
  <div id="we-panel-head">
    <div class="we-title">Work Elements</div>
    <div class="msow-we-meta">
      <span>#{contractNum}</span>
      <span class="msow-we-meta-sep">·</span>
      <span>FY {fy}</span>
      <span class="msow-we-meta-sep">·</span>
      <span>{cor}</span>
    </div>
    <span onclick="openWEModal(null)" class="msow-we-add-wrap">
      <EsaButton color="primary" size="sm" icon="plus" aria-label="Add new work element">
        Add Work Element
      </EsaButton>
    </span>
  </div>
  <div id="we-list" role="list" aria-label="Work element list">
    <div class="we-empty">No work elements yet.<br/>Click + Add to begin.</div>
  </div>
</div>
