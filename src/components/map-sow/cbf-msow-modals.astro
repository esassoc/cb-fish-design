---
// All modals for the Habitat Design Tool:
//   #we-modal      — create / edit a work element
//   #sowmodal      — export / print the Statement of Work
//   #welcome-modal — onboarding overlay shown on first load
//
// bcn-lego-checked: swapped from hand-rolled position:fixed overlay divs to
// esa-dialog, which provides the backdrop, focus trap, Esc-to-close, and close
// button. map-sow.js drives them via .show()/.close() instead of toggling
// style.display. See map-sow.js openWEModal/closeWEModal/openSOW/closeSOW and
// the welcome-modal `close` listener in window.onload.
//
// Buttons use esa-button via a <span onclick> wrapper — click events bubble up
// from the inner native button to the outer span, firing the onclick handler
// (esa-button.astro has no onclick prop).
import EsaButton from '@esa/ecology/esa-button.astro';
---

<!-- WE setup modal -->
<esa-dialog id="we-modal" heading="New Work Element" show-close-button>
  <div class="we-modal-field">
    <esa-text-field
      label="Work Element Title"
      placeholder="e.g. Eagle Valley Reach 1"
      required
    ></esa-text-field>
  </div>
  <div class="we-modal-field">
    <label>What type of work will this element include?</label>
    <div class="we-type-check">
      <div class="we-type-opt" id="opt-pc" onclick="toggleWEType('pc')">
        <esa-checkbox id="chk-pc" onclick="event.stopPropagation()"></esa-checkbox>
        <div>
          <div class="we-type-opt-label we-type-opt-label--pc">&#9632; Primary Channel</div>
          <div class="we-type-opt-desc">Channel restoration, wood structures, habitat units</div>
        </div>
      </div>
      <div class="we-type-opt" id="opt-fp" onclick="toggleWEType('fp')">
        <esa-checkbox id="chk-fp" onclick="event.stopPropagation()"></esa-checkbox>
        <div>
          <div class="we-type-opt-label we-type-opt-label--fp">&#9632; Floodplain &amp; Side Channels</div>
          <div class="we-type-opt-desc">Floodplain reconnection, side channels, wood placement</div>
        </div>
      </div>
      <div class="we-type-opt" id="opt-rr" onclick="toggleWEType('rr')">
        <esa-checkbox id="chk-rr" onclick="event.stopPropagation()"></esa-checkbox>
        <div>
          <div class="we-type-opt-label we-type-opt-label--rr">&#9632; Riparian Restoration</div>
          <div class="we-type-opt-desc">Fencing, planting, invasive species removal</div>
        </div>
      </div>
    </div>
    <div class="wm-err" id="we-modal-err">Please enter a title and select at least one work type.</div>
  </div>

  <div slot="footer">
    <span onclick="closeWEModal()">
      <EsaButton color="ghost" appearance="outline">Cancel</EsaButton>
    </span>
    <span onclick="saveWEModal()">
      <EsaButton color="primary">Save</EsaButton>
    </span>
  </div>
</esa-dialog>

<!-- SOW export modal -->
<esa-dialog id="sowmodal" heading="Statement of Work — Habitat Program" size="lg" show-close-button>
  <div id="sowbody"></div>

  <div slot="footer">
    <span onclick="window.print()">
      <EsaButton color="primary" icon="printer">Print / Save PDF</EsaButton>
    </span>
    <span onclick="closeSOW()">
      <EsaButton color="ghost" appearance="outline">Close</EsaButton>
    </span>
  </div>
</esa-dialog>

<!-- Welcome / onboarding modal — disabled for now (no `open` attribute; its
     content doesn't earn its interruption anymore) but kept in place since
     we expect to bring it back with different content later. The default
     work element is now created directly in map-sow.js window.onload
     instead of being gated behind this modal's `close` event — see the note
     there if this modal is reintroduced. -->
<esa-dialog id="welcome-modal" heading="Habitat Design Tool" show-close-button>
  <p class="msow-welcome-heading">Your contract is eligible to use the new map-based tool.</p>
  <p class="msow-welcome-desc">
    Define pre-project conditions and scope habitat work elements visually on the map,
    with metrics calculated automatically from your digitized features.
  </p>

  <div slot="footer">
    <span onclick="document.getElementById('welcome-modal').close()">
      <EsaButton color="primary" icon="check">Continue with new tool</EsaButton>
    </span>
  </div>
</esa-dialog>
