---
// Right sidebar — wizard body panel + expert panel (toggled by wizard mode).
// #wizard-panel (the stepper) lives in map-sow.astro as a separate left column.
// When wizard is active: #wizard-body-panel shows, #expert-panel hides.
// When expert mode: #expert-panel shows, #wizard-body-panel hides.
//
// bcn-lego-checked: the Pre-Project/Habitat Work tab strip is esa-tab-layout, used for
// the tab strip only (tabs array, keyboard nav, ARIA) — map-sow.js drives it via
// .tabs/.activeIndex (Lit properties, not attributes) and listens for its `tabchange`
// event (see showInnerTab()/window.onload). #pp-side/#work-side stay as plain sibling
// panels toggled by style.display exactly as before, rather than slotted inside the
// component: esa-tab-layout's internal .panel wrapper is plain block layout with no
// flex/scroll support and exposes no `part` for it, so it can't host our
// height-constrained, independently-scrolling panels without breaking their scrolling.
import EsaEmptyState from '@esa/ecology/esa-empty-state.astro';
---
<div id="sidebar" role="complementary" aria-label="Work element details">

  <!-- Wizard step body — shown when guided mode is active -->
  <div id="wizard-body-panel"></div>

  <!-- Expert panel — default view -->
  <div id="expert-panel">

    <div id="sidebar-empty" aria-live="polite">
      <EsaEmptyState
        title="No work element selected"
        description="Add a work element to begin entering pre-project metrics and habitat work details."
        size="sm"
      />
    </div>

    <esa-tab-layout id="inner-tabbar" size="sm" aria-label="Work element sections"></esa-tab-layout>

    <div id="pp-side" role="tabpanel"></div>
    <div id="work-side" role="tabpanel"></div>

  </div>
</div>
