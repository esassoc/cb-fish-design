---
// cbf-home-hero — the landing-page hero. The big navy brand mark with a soft
// radial halo, a brand eyebrow, the page title, and a tagline. Static landing
// copy, no props, no JS.
// bcn-lego-checked: no esa- lego composes a brand-mark + eyebrow + display title
// + tagline landing hero (esa-page-header is app-chrome titling, not a branded
// marketing hero); checked Beacon (no marketing landing pattern); this cbf-home-
// hero is the reusable section home, composing the cbf-mark brand lego.
import CbfMark from '../shared/cbf-mark.astro';
---
<header class="cbf-home-hero">
  <div class="cbf-home-hero__mark"><CbfMark size="128" /></div>
  <p class="cbf-home-hero__eyebrow">Columbia Basin Fish &amp; Wildlife Program</p>
  <h1 class="cbf-home-hero__title">Design &amp; prototypes</h1>
  <p class="cbf-home-hero__tagline">An Astro brand spoke of the ESA Ecology design system — the brand language, emerging patterns, and working prototypes for the program, in one place.</p>
</header>

<style>
  .cbf-home-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-900) 0 var(--spacing-800);
  }

  .cbf-home-hero__mark {
    color: var(--color-primary);
    line-height: 0;
    background: radial-gradient(circle at center, var(--color-primary-subtle) 0%, transparent 68%);
    padding: var(--spacing-700);
    margin: calc(-1 * var(--spacing-500)) 0 var(--spacing-400);
    filter: drop-shadow(0 8px 24px color-mix(in srgb, var(--color-primary) 18%, transparent));
  }

  .cbf-home-hero__eyebrow {
    margin: 0;
    /* eyebrow — brand-colored, NOT a gray ornamental micro-label */
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .cbf-home-hero__title {
    margin: var(--spacing-200) 0 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    font-size: clamp(2.75rem, 2rem + 3.5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .cbf-home-hero__tagline {
    margin: var(--spacing-400) auto 0;
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 720px) {
    .cbf-home-hero {
      padding-top: var(--spacing-800);
    }
  }
</style>
