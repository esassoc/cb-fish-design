---
// cbf-hero — full-bleed hero image with the logotype lockup overlaid
// bottom-left as live text (IBM Plex Condensed via --font-display), plus a
// subtle bottom legibility scrim. Values verified against cbfish.org prod:
// 640px tall, title 64px/64 condensed (line 1 wt 600, line 2 wt 400),
// inset margin 0 0 36px 61px.
---
<section class="cbf-hero">
  <div class="cbf-hero__title">
    <h1 class="cbf-hero__line cbf-hero__line--strong">Columbia Basin</h1>
    <h1 class="cbf-hero__line">Fish &amp; Wildlife Program</h1>
  </div>
</section>

<style>
  .cbf-hero {
    position: relative;
    height: 640px;
    background: #1d3c5d url('/hero.png') center 40% / cover no-repeat;
    display: flex;
    align-items: flex-end;
  }
  .cbf-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(19, 39, 62, 0) 45%, rgba(19, 39, 62, 0.45) 100%);
  }
  .cbf-hero__title {
    position: relative;
    z-index: 1;
    margin: 0 0 36px 61px;
  }
  .cbf-hero__line {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 64px;
    font-weight: var(--font-weight-regular);
    font-feature-settings: 'liga' off, 'clig' off;
  }
  .cbf-hero__line--strong {
    font-weight: var(--font-weight-semibold);
  }
</style>
