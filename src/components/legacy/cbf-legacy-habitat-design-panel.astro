---
// bcn-lego-checked: content for the new "Habitat Design" tab on the legacy
// WE-detail recreation (/legacy/we) — a static snapshot in the same
// Metric/Method/Value table shape the real Habitat Design Tool's "Export
// Metrics" produces (see public/scripts/map-sow.js openSOW()), plus the
// button that actually launches the tool. Hand-rolled to match the legacy
// page it lives on, not a themed spoke surface — see cbf-legacy-chrome.astro.
interface Props {
  contractNum: string;
  cor: string;
  fy: string;
  exportedDate: string;
  designToolHref: string;
}
const { contractNum, cor, fy, exportedDate, designToolHref } = Astro.props;

const metrics = [
  { label: 'Reach length', method: 'measured', value: '2,450 ft' },
  { label: 'Sinuosity', method: 'calc', value: '1.34' },
  { label: 'Average reach slope', method: 'calc', value: '1.85° / 3.2%' },
  { label: 'Average channel width (at riffle)', method: 'entered', value: '22 ft' },
  { label: 'Average bank height (at riffle)', method: 'entered', value: '4.5 ft' },
  { label: 'Area of restored channel', method: 'measured', value: '1.24 acres' },
  { label: 'New floodplain area', method: 'measured', value: '8.6 acres' },
  { label: 'Primary channel excavation volume', method: 'calculated', value: '3,260 CY' },
  { label: '# Riffles', method: 'measured', value: '6' },
  { label: '# Pools', method: 'measured', value: '5' },
];
---
<div class="legacy-panel legacy-hd-panel">
  <p class="legacy-hd-panel__intro">
    Results exported from the Habitat Design Tool for this work element.
  </p>

  <dl class="legacy-hd-panel__meta">
    <dt>Contract #</dt><dd>{contractNum}</dd>
    <dt>COR</dt><dd>{cor}</dd>
    <dt>FY</dt><dd>{fy}</dd>
    <dt>Last exported</dt><dd>{exportedDate}</dd>
  </dl>

  <table class="legacy-hd-panel__table">
    <thead>
      <tr><th>Metric</th><th>Method</th><th>Value</th></tr>
    </thead>
    <tbody>
      {metrics.map((m) => (
        <tr><td>{m.label}</td><td>{m.method}</td><td>{m.value}</td></tr>
      ))}
    </tbody>
  </table>

  <a class="legacy-hd-panel__cta" href={designToolHref}>Open Habitat Design Tool &rarr;</a>
</div>

<style>
  .legacy-hd-panel {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    color: #333;
    padding: 16px;
  }
  .legacy-hd-panel__intro {
    margin: 0 0 14px;
  }
  .legacy-hd-panel__meta {
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 4px 14px;
    margin: 0 0 20px;
    font-size: 13px;
  }
  .legacy-hd-panel__meta dt { color: #666; }
  .legacy-hd-panel__meta dd { margin: 0; font-weight: 600; }

  .legacy-hd-panel__table {
    border-collapse: collapse;
    width: 100%;
    max-width: 560px;
    font-size: 13px;
    background: #fff;
    border: 1px solid #ddd;
    margin-bottom: 20px;
  }
  .legacy-hd-panel__table th {
    background: transparent;
    border: 1px solid #ddd;
    padding: 5px 8px;
    text-align: left;
    font-weight: 700;
  }
  .legacy-hd-panel__table td {
    border: 1px solid #ddd;
    padding: 5px 8px;
  }
  .legacy-hd-panel__table tbody tr:hover { background: #f5f9fc; }

  .legacy-hd-panel__cta {
    display: inline-block;
    background: #5bc0de;
    color: #fff;
    font-size: 14px;
    padding: 6px 12px;
    border: 1px solid #46b8da;
    border-radius: 4px;
    text-decoration: none;
  }
  .legacy-hd-panel__cta:hover { background: #46b8da; }
</style>
