---
// bcn-lego-checked: plain legacy-page prose block, part of the /legacy/sow
// recreation (see cbf-legacy-chrome.astro) — not a themed spoke surface.
interface Props {
  helpText: string;
  title: string;
}
const { helpText, title } = Astro.props;
---
<div class="legacy-contract-header">
  <p class="legacy-contract-header__help">{helpText}</p>
  <h2 class="legacy-contract-header__title">{title}</h2>
</div>

<style>
  .legacy-contract-header {
    font-family: 'Montserrat', sans-serif;
  }
  .legacy-contract-header__help {
    font-size: 13px;
    color: #333;
    max-width: 900px;
    margin: 0 0 16px;
  }
  .legacy-contract-header__title {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 14px;
    color: #333;
  }
</style>
