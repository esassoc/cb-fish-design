---
// bcn-lego-checked: this entire component is a deliberate exception to the
// Ecology lookup order. It exists to visually recreate the REAL, pre-redesign
// qa.cbfish.org chrome (Bootstrap 3 admin bar + navy app bar + gray-page
// breadcrumb + a white "panel" wrapping the tab strip and whatever content
// immediately follows it) so the Habitat Design Tool's entry/exit point
// reads as "here is where this drops into the actual current site" — not
// the modern esa-* re-skin the rest of this spoke uses. No esa-* component
// fits because none of them are meant to look like the legacy system;
// checked Beacon (n/a, this isn't a Beacon pattern either). Colors/fonts/
// spacing below were read via getComputedStyle() directly off the live
// qa.cbfish.org SOW and Milestone pages, not eyeballed from screenshots —
// this is a pixel match, not an approximation. None of this hand-rolled
// chrome should ever be copied into a real (non-legacy) page in this spoke.
//
// The default slot renders as the white panel's body, directly under the
// tab strip — on the real site this is where the SOW page's intro/help
// text lives, in the SAME panel as the tabs (verified via DOM ancestry).
// That panel-body wrapper is ALWAYS present on the real site, even with
// nothing in it (e.g. the WE-detail page) — its own bottom padding is part
// of the tabs panel's real measured height, not an artifact to hide, so the
// slot is optional but the wrapper renders unconditionally.
// Content that comes after the tabs panel (the WE grid, "Select a work
// element", the habitat design results) is the page's OWN separate white
// panel — see .legacy-panel, defined here and reused by
// cbf-legacy-we-grid.astro / cbf-legacy-we-selector.astro /
// cbf-legacy-habitat-design-panel.astro so all the panels match.
import { withBase } from '../../lib/base';

export interface LegacyCrumb {
  label: string;
  href?: string;
}
export interface LegacyTab {
  label: string;
  /** Omit for tabs with no real page yet — renders as inert text instead of
   * a dead link. */
  href?: string;
  active?: boolean;
  incomplete?: boolean;
}

interface Props {
  crumbs: LegacyCrumb[];
  tabs: LegacyTab[];
  /** Page-specific action on the tab row (e.g. "Back to SOW") — real site
   * only shows this on pages nested under a SOW ("Back to SOW"/"Back to
   * Work Element"); the top-level SOW page itself has none. */
  tabBarAction?: { label: string; href: string };
}
const { crumbs, tabs, tabBarAction } = Astro.props;

const navItems = [
  { label: 'Mitigation work', icon: 'Nav-Mitigationwork.svg', dropdown: true },
  { label: 'Reporting', icon: 'Nav-Reporting.svg', dropdown: true },
  { label: 'Funding', icon: 'Nav-Funding.svg', dropdown: true },
  { label: 'Dashboard', icon: 'Nav-Dashboard.svg', dropdown: false },
  { label: 'Recent', icon: null, dropdown: true },
];
---
<div class="legacy-chrome">
  <div class="legacy-chrome__utilitybar">
    <div class="legacy-chrome__utilitybar-inner">
      <span>Data management</span>
      <span>System status</span>
      <span>System configuration</span>
    </div>
  </div>

  <div class="legacy-chrome__appbar">
    <div class="legacy-chrome__appbar-inner">
      <a class="legacy-chrome__brand" href="#">
        <img class="legacy-chrome__logo" src={withBase('/images/legacy/Modern-Nav-Logo.svg')} width="48" height="48" alt="" />
        <img class="legacy-chrome__logotype" src={withBase('/images/legacy/Modern-Nav-Logo-Type.svg')} width="190" height="47" alt="Columbia Basin Fish & Wildlife Program" />
      </a>
      <nav class="legacy-chrome__nav">
        {navItems.map((n) => (
          <span class="legacy-chrome__navitem">
            {n.icon && <img src={withBase(`/images/legacy/${n.icon}`)} alt="" width="16" height="16" />}
            {n.label}
            {n.dropdown && <img class="legacy-chrome__navcaret" src={withBase('/images/legacy/Nav-Down-arrow.svg')} alt="" width="9" height="9" />}
          </span>
        ))}
      </nav>
    </div>
  </div>

  <div class="legacy-chrome__messagebar"></div>

  <div class="legacy-container legacy-chrome__crumbrow">
    <ul class="legacy-chrome__crumbs">
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span class="legacy-chrome__crumbsep">/</span>}
          {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        </>
      ))}
    </ul>
    <a href="#" class="legacy-chrome__gotobtn">Go to&hellip; &#9662;</a>
  </div>

  <div class="legacy-container">
    <div class="legacy-panel">
      <div class="legacy-panel__tabbar">
        <ul class="legacy-chrome__tabs">
          {tabs.map((t) => (
            <li class={t.active ? 'is-active' : ''}>
              {t.href ? (
                <a href={t.href} class="legacy-chrome__tab">
                  {t.label}{t.incomplete && <span class="legacy-chrome__tabstar">&nbsp;*</span>}
                </a>
              ) : (
                <span class="legacy-chrome__tab legacy-chrome__tab--inert">
                  {t.label}{t.incomplete && <span class="legacy-chrome__tabstar">&nbsp;*</span>}
                </span>
              )}
            </li>
          ))}
        </ul>
        {tabBarAction && <a href={tabBarAction.href} class="legacy-chrome__backbtn">{tabBarAction.label}</a>}
      </div>
      <div class="legacy-panel__body">
        <slot />
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* bcn-lego-checked: see frontmatter — legacy recreation loads the real
     site's font (Montserrat) since neither of this spoke's loaded families
     (IBM Plex Sans/Condensed) match it. */
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');

  /* bcn-lego-checked: real qa.cbfish.org centers its whole body (breadcrumb,
     tabs, and page content) in a Bootstrap 3 .container with a capped,
     stepped width — read directly off the live site's stylesheet:
     768px->780, 992px->1000, 1200px->1200, 1400px->1360, 1600px->1560, with
     no rule beyond that (so it never grows past 1560px even on very wide
     monitors). Colored chrome bars (utility bar, navy app bar) stay
     full-bleed backgrounds; only their inner content and the gray
     breadcrumb/tab/page area are capped — shared globally since both the
     chrome component and the legacy pages' own content need it. */
  .legacy-container {
    width: 100%;
    margin: 0 auto;
    padding-inline: 15px;
    box-sizing: border-box;
  }
  @media (min-width: 768px) { .legacy-container { width: 780px; padding-inline: 0; } }
  @media (min-width: 992px) { .legacy-container { width: 1000px; } }
  @media (min-width: 1200px) { .legacy-container { width: 1200px; } }
  @media (min-width: 1400px) { .legacy-container { width: 1360px; } }
  @media (min-width: 1600px) { .legacy-container { width: 1560px; } }

  /* bcn-lego-checked: the real site's Bootstrap 3 ".panel" — white surface,
     4px radius, a near-invisible 1px border, and a very subtle drop shadow
     (0 1px 1px rgba(0,0,0,.05)), margin-bottom 20px between stacked panels.
     Read via getComputedStyle() off both the SOW grid panel and the tabs
     panel on the live site — shared globally so cbf-legacy-chrome.astro,
     cbf-legacy-we-grid.astro, and cbf-legacy-habitat-design-panel.astro all
     match instead of three near-identical hand-copies. */
  .legacy-panel {
    background: #fff;
    border: 1px solid transparent;
    border-radius: 4px;
    box-shadow: 0 1px 1px 0 rgba(0, 0, 0, 0.05);
    margin: 0 0 20px;
  }
</style>

<style>
  /* bcn-lego-checked: see frontmatter — legacy recreation, raw hex/px are
     pixel-matched values read off the real site, not token drift. */
  .legacy-chrome {
    /* real qa.cbfish.org page background (#dadada) — a base fallback so the
       gutters beside the white tabs panel read gray, not the spoke's white
       page default. The utility bar / app bar / message bar / breadcrumb
       row each set their own background over this.
       display: flow-root establishes a block formatting context so the
       tabs panel's own margin-bottom (.legacy-panel, 20px) doesn't collapse
       straight through this wrapper — without it, that 20px shows as the
       page body's near-white background instead of this gray one. */
    background: #dadada;
    display: flow-root;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    color: #333;
  }

  .legacy-chrome__utilitybar {
    background: #13273e;
    font-size: 14px;
    font-family: 'IBM Plex Sans', sans-serif;
    color: #fff;
  }
  .legacy-chrome__utilitybar-inner {
    width: 100%;
    box-sizing: border-box;
    padding: 17px 20px;
    display: flex;
    gap: 24px;
  }

  .legacy-chrome__appbar {
    background: var(--color-primary, #1e5386);
    min-height: 80px;
  }
  .legacy-chrome__appbar-inner {
    width: 100%;
    box-sizing: border-box;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .legacy-chrome__brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .legacy-chrome__logo { display: block; }
  .legacy-chrome__logotype { display: block; }

  /* bcn-lego-checked: the real site reserves a blank white strip here
     (.system-message-display > .new-navigation-ui.container, 48px, verified
     via getComputedStyle) for global announcement banners — empty on a
     normal page load, but still present and white, not gray page bg. */
  .legacy-chrome__messagebar {
    background: #fff;
    height: 48px;
  }
  .legacy-chrome__nav {
    display: flex;
    gap: 26px;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
  }
  .legacy-chrome__navitem {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .legacy-chrome__navcaret { opacity: 0.85; }

  .legacy-chrome__crumbrow {
    background: #dadada;
    padding-block: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .legacy-chrome__crumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }
  .legacy-chrome__crumbs a {
    color: #007090;
    text-decoration: none;
  }
  .legacy-chrome__crumbs a:hover { text-decoration: underline; }
  .legacy-chrome__crumbsep {
    margin: 0 6px;
    color: #999;
  }

  .legacy-chrome__gotobtn {
    background: #5bc0de;
    color: #fff;
    font-size: 13px;
    padding: 3px 12px;
    border: 1px solid #46b8da;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
  .legacy-chrome__gotobtn:hover { background: #46b8da; }

  .legacy-panel__tabbar {
    padding: 20px 0 10px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .legacy-panel__body {
    padding: 0 15px 15px;
  }

  .legacy-chrome__tabs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .legacy-chrome__tabs li {
    background: #dadada;
  }
  .legacy-chrome__tab {
    display: block;
    padding: 10px 7px;
    font-size: 14px;
    color: #007090;
    text-decoration: none;
  }
  .legacy-chrome__tab:hover { text-decoration: underline; }
  .legacy-chrome__tab--inert { cursor: default; }
  .legacy-chrome__tab--inert:hover { text-decoration: none; }
  .legacy-chrome__tabs li.is-active {
    background: #42a2c1;
  }
  .legacy-chrome__tabs li.is-active .legacy-chrome__tab {
    color: #fff;
    text-decoration: none;
  }
  .legacy-chrome__tabstar { color: #c0392b; }

  .legacy-chrome__backbtn {
    background: #5bc0de;
    color: #fff;
    font-size: 14px;
    padding: 6px 12px;
    border: 1px solid #46b8da;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
  .legacy-chrome__backbtn:hover { background: #46b8da; }
</style>
