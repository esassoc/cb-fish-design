---
// cbf-omni-footer — the palette's keyboard-hint bar. (The "show all results" CTA
// is a prominent bar above this, owned by cbf-omni-search.)
import EsaKbd from '@esa/ecology/esa-kbd.astro';
---
<div class="cbf-omni__footer">
  <div class="cbf-omni__hints">
    <span><EsaKbd>↑</EsaKbd><EsaKbd>↓</EsaKbd> Navigate</span>
    <span><EsaKbd>↵</EsaKbd> Select</span>
    <span><EsaKbd>Tab</EsaKbd> Scope</span>
    <span><EsaKbd>Esc</EsaKbd> Close</span>
  </div>
</div>

<style>
  .cbf-omni__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    padding: var(--spacing-200) var(--spacing-500);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
  }
  .cbf-omni__hints {
    display: flex;
    gap: var(--spacing-400);
  }
  .cbf-omni__hints span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px; /* keyboard-hint meta — at the 13px floor */
    color: var(--color-text-tertiary);
  }
</style>
