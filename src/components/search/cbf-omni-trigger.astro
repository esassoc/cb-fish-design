---
// cbf-omni-trigger — the minimal search affordance that lives in the dark system
// tray (CBF-8117). Click or "/" opens the command palette (cbf-omni-search). The
// `data-omni-open` hook is wired by the palette's client script.
import CbfIcon from './cbf-icon.astro';

interface Props {
  placeholder?: string;
}
const { placeholder = 'Search projects, contracts, people…' } = Astro.props;
---
<button class="cbf-omni-trigger" type="button" data-omni-open aria-label="Search">
  <CbfIcon name="search" size={14} />
  <span class="cbf-omni-trigger__ph">{placeholder}</span>
  <kbd class="cbf-omni-trigger__kbd">/</kbd>
</button>

<style>
  /* Chrome-on-dark: translucent white over the navy tray, not theme tokens. */
  .cbf-omni-trigger {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    width: 380px;
    max-width: 100%;
    padding: 5px var(--spacing-200) 5px var(--spacing-300);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.75);
    transition: background 0.12s, border-color 0.12s;
  }
  .cbf-omni-trigger:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .cbf-omni-trigger__ph {
    flex: 1;
    min-width: 0;
    text-align: left;
    font-size: 13px;
    /* Truncate rather than wrap when the trigger shrinks on narrow viewports. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cbf-omni-trigger__kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-family: var(--typography-font-family-sans);
    font-size: 13px; /* kbd glyph meta — at the 13px floor */
    font-weight: var(--typography-font-weight-medium);
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px;
  }
</style>
