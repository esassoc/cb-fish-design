---
// cbf-kbd — a keycap. Primitive used by the trigger, palette footer, and empty
// state to render keyboard hints (/, Tab, Esc, ↑↓↵).
---
<kbd class="cbf-kbd"><slot /></kbd>

<style>
  .cbf-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 4px;
  }
</style>
