---
// cbf-vendor-attention — "needs your attention" strip for the vendor portal.
// Hoists the invoices currently blocked ON THE VENDOR (Needs revision) out of
// the table into a single, unmissable call to action — the rejection/fix loop
// the discovery interviews flagged as the most painful hand-off. Renders nothing
// when there is nothing to act on.
//
// bcn-lego-checked: esa-alert-box is the ecology alert lego (info/success/
// warning/danger + slotted message); this component only composes it with an
// esa-button CTA and a tiny script that drives the invoices status filter. No
// bespoke banner markup.
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  count: number;
}
const { count } = Astro.props;
const plural = count === 1 ? 'invoice needs' : 'invoices need';
---
{count > 0 && (
  <section class="cbf-vendor-attention" aria-label="Needs your attention">
    <EsaAlertBox variant="warning" title="Needs your attention">
      <div class="cbf-vendor-attention__body repel">
        <span class="type-body">
          {`${count} ${plural} revision before BPA can continue review. Resubmit to keep payment on track.`}
        </span>
        <EsaButton color="primary" size="sm" icon="arrow-right" data-review-needs-revision>
          Review
        </EsaButton>
      </div>
    </EsaAlertBox>
  </section>
)}

<style>
  .cbf-vendor-attention__body {
    align-items: center;
    gap: var(--spacing-400);
    flex-wrap: wrap;
  }
</style>

<script>
  // The Review CTA drives the invoices table's status filter to "Needs revision"
  // and scrolls it into view — decoupled from the table via the chip-group's
  // public selector + value property, no shared module needed.
  document.querySelectorAll<HTMLElement>('[data-review-needs-revision]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const chip = document.querySelector<HTMLElement & { value: string }>('[data-invoice-stage-filter]');
      const table = document.querySelector('.cbf-vendor-portal-invoices');
      if (chip) {
        chip.value = 'Needs revision';
        chip.dispatchEvent(new CustomEvent('change', { bubbles: true }));
      }
      table?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
