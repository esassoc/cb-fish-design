---
// cbf-crs-edit-commitment-dialog — "Edit CRS Commitment", launched from the
// "Edit" action on the per-commitment detail page's Basics panel
// (cbf-crs-commitment-basics.astro). Mirrors the real CBFish
// EditBiologicalOpinionCommitment page's field set for the SAME entity — that
// page requires an authenticated account to view (confirmed live at
// qa.cbfish.org: "Continue as anonymous" still lands on a login wall for the
// Edit route, unlike the read-only Summary page), so this reuses the field
// set already checked against prod for the sibling "Create new CRS
// Commitment" form (cbf-crs-create-commitment-dialog.astro) rather than the
// Edit form specifically — same entity, same fields, and Create's own header
// comment documents the prod field-coverage check this inherits.
//
// This spoke builds to static HTML with no backend (see cbf-password-gate.astro's
// security note for the same constraint) — Save updates the in-memory commitment
// record and re-renders the Basics panel's displayed fields (plus the sibling
// timeline component and page heading); nothing persists past a page reload.
//
// Also carries a "Status by year" section — ported from the real CBFish Edit
// page, which lets a user set every tracked year's status right here rather
// than only through the separate Dashboard's per-year edit mode. One
// esa-select per tracked year (src/data/crs-commitments.mjs's YEARS), same
// six-status list cbf-crs-commitments-dashboard.astro's own edit-status dialog
// uses, plus "Unset" to clear a year entirely.
//
// bcn-lego-checked: same control set as cbf-crs-create-commitment-dialog.astro
// (see that file's own note on why Responsible-parties fields are esa-select
// `multiple` rather than plain text) plus one more esa-select per tracked year
// for the status-by-year section. esa-dialog (modal chrome), esa-text-field
// (single-line text), esa-textarea (long text), esa-date-picker (start/end
// date), esa-button (footer actions). No bespoke form control.
import EsaButton from '@esa/ecology/esa-button.astro';
import { YEARS } from '../../data/crs-commitments.mjs';

interface Props {
  categories: string[];
  subcategories: string[];
  types: string[];
  frequencies: string[];
  deliverableFrequencies: string[];
  leadAgencies: string[];
  partnerAgencies: string[];
  partnerPOCs: string[];
  policyLeads: string[];
  biopSMEs: string[];
  cors: string[];
  nmfsPOCs: string[];
  associatedProjectsOptions: string[];
}

const {
  categories, subcategories, types, frequencies, deliverableFrequencies,
  leadAgencies, partnerAgencies, partnerPOCs, policyLeads, biopSMEs, cors, nmfsPOCs,
  associatedProjectsOptions,
} = Astro.props;

const asOptions = (values: string[]) => values.map((v) => ({ label: v, value: v }));

// Canonical lifecycle order (matches cbf-crs-commitments-grid.astro's own
// STATUS_ORDER and the dashboard's edit-status dialog) plus "Unset" first, so
// clearing a year is the deliberate top choice rather than mixed in
// alphabetically among real statuses.
const yearStatusOptions = [
  { label: 'Unset', value: '' },
  ...['Not Started', 'In Progress', 'Delayed', 'Future', 'Complete', 'Closed'].map((s) => ({ label: s, value: s })),
];
---
<esa-dialog heading="Edit CRS Commitment" show-close-button size="lg" data-crs-edit-commitment-dialog>
  <form class="cbf-crs-edit-commitment-form stack" data-gap="lg" data-crs-edit-commitment-form>
    <p class="type-caption cbf-crs-edit-commitment-form__number" data-crs-edit-commitment-number></p>

    <section class="stack" data-gap="md">
      <h3 class="type-section-title">Overview</h3>

      <esa-text-field
        label="Title"
        placeholder="e.g. Continue adult fish counts at mainstem dams"
        required
        data-field="title"
      ></esa-text-field>

      <esa-text-field
        label="Source"
        placeholder="e.g. Basin Fish Passage Biological Assessment - Proposed Action"
        data-field="source"
      ></esa-text-field>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-text-field label="Section" placeholder="e.g. 2.7.1.1" data-field="sectionNumber"></esa-text-field>
        <esa-text-field label="Page" placeholder="e.g. 2-118" data-field="pageNumber"></esa-text-field>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select
          label="Category"
          required
          placeholder="Select…"
          options={JSON.stringify(asOptions(categories))}
          data-field="category"
        ></esa-select>
        <esa-select
          label="Subcategory"
          placeholder="Select…"
          options={JSON.stringify(asOptions(subcategories))}
          data-field="subcategory"
        ></esa-select>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select
          label="Type"
          placeholder="Select…"
          options={JSON.stringify(asOptions(types))}
          data-field="commitmentType"
        ></esa-select>
        <esa-select
          label="Frequency"
          placeholder="Select…"
          options={JSON.stringify(asOptions(frequencies))}
          data-field="frequency"
        ></esa-select>
      </div>

      <esa-textarea
        label="Description"
        rows="2"
        placeholder="What the commitment requires"
        data-field="description"
      ></esa-textarea>
      <esa-textarea
        label="Interpretation"
        rows="2"
        placeholder="How the Action Agencies read this requirement"
        data-field="interpretation"
      ></esa-textarea>
      <esa-textarea
        label="Implementation"
        rows="2"
        placeholder="Who does the work and how"
        data-field="implementation"
      ></esa-textarea>
      <esa-textarea
        label="Notes"
        rows="2"
        placeholder="Optional"
        data-field="notes"
      ></esa-textarea>

      <esa-text-field
        label="Other associated commitments"
        placeholder="Optional"
        data-field="otherAssociatedCommitments"
      ></esa-text-field>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-date-picker label="Start date" data-field="startDate"></esa-date-picker>
        <esa-date-picker label="End date" data-field="endDate"></esa-date-picker>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-text-field label="Deliverable" placeholder="e.g. Annual Count Summary" data-field="deliverable"></esa-text-field>
        <esa-select
          label="Deliverable frequency"
          placeholder="Select…"
          options={JSON.stringify(asOptions(deliverableFrequencies))}
          data-field="deliverableFrequency"
        ></esa-select>
      </div>

      <esa-text-field
        label="Document due date"
        placeholder="e.g. 3/1 or 12/31/2024"
        data-field="documentDueDate"
      ></esa-text-field>
    </section>

    <section class="stack" data-gap="md">
      <h3 class="type-section-title">Responsible parties</h3>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select label="Lead agency" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(leadAgencies))} data-field="leadAgency"></esa-select>
        <esa-select label="Partner agency" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(partnerAgencies))} data-field="partnerAgency"></esa-select>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select label="Partner POC" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(partnerPOCs))} data-field="partnerPOC"></esa-select>
        <esa-select label="Policy lead" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(policyLeads))} data-field="policyLead"></esa-select>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select label="BiOp SME" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(biopSMEs))} data-field="biopSME"></esa-select>
        <esa-select label="COR" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(cors))} data-field="cor"></esa-select>
      </div>

      <div class="cbf-crs-edit-commitment-form__row">
        <esa-select label="NMFS POC" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(nmfsPOCs))} data-field="nmfsPOC"></esa-select>
        <esa-select label="Associated projects" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(associatedProjectsOptions))} data-field="associatedProjects"></esa-select>
      </div>
    </section>

    <section class="stack" data-gap="md">
      <h3 class="type-section-title">Status by year</h3>
      <div class="cbf-crs-edit-commitment-form__years grid" data-gap="sm">
        {YEARS.map((year) => (
          <esa-select
            label={String(year)}
            size="sm"
            options={JSON.stringify(yearStatusOptions)}
            data-year-field={year}
          ></esa-select>
        ))}
      </div>
    </section>

    <p class="type-caption cbf-crs-edit-commitment-form__error" data-crs-edit-commitment-error hidden>
      Enter a title and choose a category to continue.
    </p>
  </form>

  <div slot="footer">
    <span data-crs-edit-commitment-cancel>
      <EsaButton color="ghost" appearance="outline">Cancel</EsaButton>
    </span>
    <span data-crs-edit-commitment-save>
      <EsaButton color="primary">Save changes</EsaButton>
    </span>
  </div>
</esa-dialog>

<style>
  .cbf-crs-edit-commitment-form__row {
    display: grid;
    /* minmax(0, 1fr), not 1fr — a bare 1fr track won't shrink below its
       content's min-content width, so a chip-mode select carrying several
       chips (e.g. Responsible parties with 2+ agencies) pushed the whole
       dialog into horizontal scroll instead of wrapping/clipping in place. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-400);
  }
  .cbf-crs-edit-commitment-form__number {
    margin: 0;
    color: var(--color-text-secondary);
  }
  .cbf-crs-edit-commitment-form__error {
    color: var(--color-danger-strong);
  }
  /* One compact select per tracked year — wraps to as many rows as the dialog
     width needs rather than one fixed 15-column strip (unlike the read-only
     timeline/dashboard, this is a form; each select needs room for its own
     label + dropdown, not just a pill). */
  .cbf-crs-edit-commitment-form__years {
    --grid-min: 7rem;
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-date-picker';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';
</script>
