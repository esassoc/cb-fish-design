---
// cbf-crs-create-commitment-dialog — the "Create new CRS Commitment" modal
// launched from the commitments grid's header CTA. Collects the fields a
// Commitment Administrator sets when standing up a new tracked commitment —
// grouped into the same "Overview" / "Responsible parties" sections as
// cbf-crs-commitment-basics.astro's read view, so create and view share one
// mental model of the record. This spoke builds to static HTML with no
// backend (see cbf-password-gate.astro's security note for the same
// constraint) — Create adds the row to the grid's in-memory AG Grid table and
// confirms with a toast; nothing persists past a page reload.
//
// Field coverage was checked directly against prod (cbfish.org's real "New CRS
// Commitment" form) — every field prod collects has a home here, EXCEPT prod's
// tag-adding comboboxes for Source/Category/Subcategory (multi-value pickers)
// and its rich-text Description editor, which are simplified to a single value
// / plain textarea respectively — this is a demo prototype, not a byte-for-
// byte port, and no lego provides a multi-select-with-existing-tags widget or
// an RTE. Commitment Number is auto-generated here (prod takes it as manual
// text) to avoid a duplicate-number entry mistake in the demo.
//
// Responsible-parties fields (Lead/Partner agency, Partner POC, Policy lead,
// BiOp SME, COR, NMFS POC, Associated projects) are esa-select in `multiple`
// (chip) mode, not plain text — real prod data confirms more than one value is
// routine (e.g. two Policy Leads on one commitment), and the mock dataset
// already stores these as comma-joined lists (src/lib/multi-value.ts is the
// storage-string <-> selected-array conversion both this dialog's sibling
// script and cbf-crs-edit-commitment-dialog.astro's use).
//
// Every control here IS a lego: esa-select (Category/Subcategory/Type/
// Frequency/Deliverable frequency/Responsible parties), esa-textarea
// (Description/Interpretation/Implementation/Notes), esa-dialog (modal chrome),
// esa-text-field (single-line text), esa-date-picker (start/end date),
// esa-button (footer actions). esa-select and esa-textarea previously never
// rendered in this spoke's dev server (esassoc/ecology#5 — a class-field-
// shadowing bug in esa-select; esa-textarea was misdiagnosed as the same bug
// but was actually a stale Vite cache — see docs/system-improvement-ledger.md)
// and this component fell back to bare form controls as a result. The hub fix
// (ecology commit a915170) is confirmed live and pulled in, so both are back
// to the real legos.
import EsaButton from '@esa/ecology/esa-button.astro';

interface Props {
  categories: string[];
  subcategories: string[];
  types: string[];
  frequencies: string[];
  deliverableFrequencies: string[];
  leadAgencies: string[];
  partnerAgencies: string[];
  partnerPOCs: string[];
  policyLeads: string[];
  biopSMEs: string[];
  cors: string[];
  nmfsPOCs: string[];
  associatedProjectsOptions: string[];
}

const {
  categories, subcategories, types, frequencies, deliverableFrequencies,
  leadAgencies, partnerAgencies, partnerPOCs, policyLeads, biopSMEs, cors, nmfsPOCs,
  associatedProjectsOptions,
} = Astro.props;

const asOptions = (values: string[]) => values.map((v) => ({ label: v, value: v }));
---
<esa-dialog heading="Create new CRS Commitment" show-close-button size="lg" data-crs-create-dialog>
  <form class="cbf-crs-create-form stack" data-gap="lg" data-crs-create-form>
    <section class="stack" data-gap="md">
      <h3 class="type-section-title">Overview</h3>

      <esa-text-field
        label="Title"
        placeholder="e.g. Continue adult fish counts at mainstem dams"
        required
        data-field="title"
      ></esa-text-field>

      <esa-text-field
        label="Source"
        placeholder="e.g. Basin Fish Passage Biological Assessment - Proposed Action"
        data-field="source"
      ></esa-text-field>

      <div class="cbf-crs-create-form__row">
        <esa-text-field label="Section" placeholder="e.g. 2.7.1.1" data-field="sectionNumber"></esa-text-field>
        <esa-text-field label="Page" placeholder="e.g. 2-118" data-field="pageNumber"></esa-text-field>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-select
          label="Category"
          required
          placeholder="Select…"
          options={JSON.stringify(asOptions(categories))}
          data-field="category"
        ></esa-select>
        <esa-select
          label="Subcategory"
          placeholder="Select…"
          options={JSON.stringify(asOptions(subcategories))}
          data-field="subcategory"
        ></esa-select>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-select
          label="Type"
          placeholder="Select…"
          options={JSON.stringify(asOptions(types))}
          data-field="commitmentType"
        ></esa-select>
        <esa-select
          label="Frequency"
          placeholder="Select…"
          options={JSON.stringify(asOptions(frequencies))}
          data-field="frequency"
        ></esa-select>
      </div>

      <esa-textarea
        label="Description"
        rows="2"
        placeholder="What the commitment requires"
        data-field="description"
      ></esa-textarea>
      <esa-textarea
        label="Interpretation"
        rows="2"
        placeholder="How the Action Agencies read this requirement"
        data-field="interpretation"
      ></esa-textarea>
      <esa-textarea
        label="Implementation"
        rows="2"
        placeholder="Who does the work and how"
        data-field="implementation"
      ></esa-textarea>
      <esa-textarea
        label="Notes"
        rows="2"
        placeholder="Optional"
        data-field="notes"
      ></esa-textarea>

      <esa-text-field
        label="Other associated commitments"
        placeholder="Optional"
        data-field="otherAssociatedCommitments"
      ></esa-text-field>

      <div class="cbf-crs-create-form__row">
        <esa-date-picker label="Start date" data-field="startDate"></esa-date-picker>
        <esa-date-picker label="End date" data-field="endDate"></esa-date-picker>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-text-field label="Deliverable" placeholder="e.g. Annual Count Summary" data-field="deliverable"></esa-text-field>
        <esa-select
          label="Deliverable frequency"
          placeholder="Select…"
          options={JSON.stringify(asOptions(deliverableFrequencies))}
          data-field="deliverableFrequency"
        ></esa-select>
      </div>

      <esa-text-field
        label="Document due date"
        placeholder="e.g. 3/1 or 12/31/2024"
        data-field="documentDueDate"
      ></esa-text-field>
    </section>

    <section class="stack" data-gap="md">
      <h3 class="type-section-title">Responsible parties</h3>

      <div class="cbf-crs-create-form__row">
        <esa-select label="Lead agency" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(leadAgencies))} data-field="leadAgency"></esa-select>
        <esa-select label="Partner agency" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(partnerAgencies))} data-field="partnerAgency"></esa-select>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-select label="Partner POC" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(partnerPOCs))} data-field="partnerPOC"></esa-select>
        <esa-select label="Policy lead" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(policyLeads))} data-field="policyLead"></esa-select>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-select label="BiOp SME" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(biopSMEs))} data-field="biopSME"></esa-select>
        <esa-select label="COR" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(cors))} data-field="cor"></esa-select>
      </div>

      <div class="cbf-crs-create-form__row">
        <esa-select label="NMFS POC" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(nmfsPOCs))} data-field="nmfsPOC"></esa-select>
        <esa-select label="Associated projects" multiple chip-mode placeholder="Select…" options={JSON.stringify(asOptions(associatedProjectsOptions))} data-field="associatedProjects"></esa-select>
      </div>
    </section>

    <p class="type-caption cbf-crs-create-form__error" data-crs-create-error hidden>
      Enter a title and choose a category to continue.
    </p>
  </form>

  <div slot="footer">
    <span data-crs-create-cancel>
      <EsaButton color="ghost" appearance="outline">Cancel</EsaButton>
    </span>
    <span data-crs-create-submit>
      <EsaButton color="primary" icon="plus">Create commitment</EsaButton>
    </span>
  </div>
</esa-dialog>

<style>
  .cbf-crs-create-form__row {
    display: grid;
    /* minmax(0, 1fr), not 1fr — a bare 1fr track won't shrink below its
       content's min-content width, so a chip-mode select carrying several
       chips (e.g. Responsible parties with 2+ agencies) pushed the whole
       dialog into horizontal scroll instead of wrapping/clipping in place. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-400);
  }

  .cbf-crs-create-form__error {
    color: var(--color-danger-strong);
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-date-picker';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-textarea';
</script>
