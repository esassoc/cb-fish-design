---
// cbf-crs-commitment-basics — the read-only "Basics" panel of a single CRS
// commitment (fish/wildlife mitigation obligation) summary page. Every field of
// the record laid out as scannable label/value pairs, grouped into two labeled
// subsections (Overview, Responsible parties), with the current status shown as
// a pill in the card header. Replaces the legacy 25-row bespoke key/value table.
//
// "Edit" (header action, beside the status pill) opens cbf-crs-edit-commitment-
// dialog.astro prefilled with this record — ported from prod's real "Edit" link
// in this same spot (checked live at qa.cbfish.org; the real Edit page itself
// requires an authenticated account to view, so the dialog's field set instead
// reuses cbf-crs-create-commitment-dialog.astro's, already checked against prod
// for the same entity — see that dialog's own header comment). Like the rest of
// this static-site spoke, Save updates the in-memory record and re-renders this
// panel's fields; nothing persists past a page reload (cbf-password-gate.astro's
// security note covers the same no-backend constraint).
//
// The edit dialog also carries a "Status by year" section (ported from prod,
// which lets a user edit every tracked year right from this same modal, not
// only through the separate Dashboard's per-year edit mode) — Save updates
// this panel's status pill AND the sibling cbf-crs-commitment-timeline.astro
// component's per-year pills, even though that's a different component
// instance elsewhere on the page (see this file's own script for how).
//
// The .grid / .stack layout primitives and .type-* roles ship from @esa/tokens as
// separate CSS modules (not bundled into tokens.css), so import them here to stay
// self-contained. STATUS_TONE (status -> esa-pill variant) lives with the data.
//
// bcn-lego-checked: the panel SURFACE is esa-card and the status chip is esa-pill
// — no reinvented card/badge/pill. Field pairs sit on the .grid primitive; the
// only component-internal CSS is a full-row span for long free-text fields and
// label/value color+rhythm — legal per CLAUDE.md (a spoke section owns its layout).
import '@esa/tokens/layouts.css';
import '@esa/tokens/type-roles.css';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import CbfCrsEditCommitmentDialog from './cbf-crs-edit-commitment-dialog.astro';
import { commitments, STATUS_TONE } from '../../data/crs-commitments.mjs';
import type { CrsCommitment } from '../../data/crs-commitments.mjs';
import { splitMultiValue } from '../../lib/multi-value';

interface Props {
  commitment: CrsCommitment;
}
const { commitment } = Astro.props;

// Edit dialog's select options are derived from the full dataset (same
// technique cbf-crs-commitments-grid.astro uses for its Create dialog) so a
// value elsewhere in the data never renders as a missing option here.
const categories = Array.from(new Set(commitments.map((c) => c.category))).sort();
const subcategories = Array.from(new Set(commitments.map((c) => c.subcategory))).sort();
const commitmentTypes = Array.from(new Set(commitments.map((c) => c.commitmentType))).sort();
const frequencies = Array.from(new Set(commitments.map((c) => c.frequency))).sort();
const deliverableFrequencies = Array.from(new Set(commitments.map((c) => c.deliverableFrequency))).sort();

// Responsible-parties option lists — same "split the comma-joined field back
// into individual values" technique as cbf-crs-commitments-grid.astro's own
// Create-dialog options (see src/lib/multi-value.ts).
const uniqueSplitValues = (key: keyof CrsCommitment) =>
  Array.from(new Set(commitments.flatMap((c) => splitMultiValue(c[key] as string)))).sort();
const leadAgencies = uniqueSplitValues('leadAgency');
const partnerAgencies = uniqueSplitValues('partnerAgency');
const partnerPOCs = uniqueSplitValues('partnerPOC');
const policyLeads = uniqueSplitValues('policyLead');
const biopSMEs = uniqueSplitValues('biopSME');
const cors = uniqueSplitValues('cor');
const nmfsPOCs = uniqueSplitValues('nmfsPOC');
const associatedProjectsOptions = uniqueSplitValues('associatedProjects');

// Field descriptors — human label, record key, and whether the value is long
// free-text that should span the full row (short fields pack two-up on the grid).
interface Field {
  label: string;
  key: keyof CrsCommitment;
  wide?: boolean;
}

const overviewFields: Field[] = [
  { label: 'Commitment #', key: 'number' },
  { label: 'Title', key: 'title', wide: true },
  { label: 'Source', key: 'source', wide: true },
  { label: 'Section', key: 'sectionNumber' },
  { label: 'Page', key: 'pageNumber' },
  { label: 'Category', key: 'category' },
  { label: 'Subcategory', key: 'subcategory' },
  { label: 'Commitment type', key: 'commitmentType' },
  { label: 'Frequency', key: 'frequency' },
  { label: 'Description', key: 'description', wide: true },
  { label: 'Interpretation', key: 'interpretation', wide: true },
  { label: 'Implementation', key: 'implementation', wide: true },
  { label: 'Notes', key: 'notes', wide: true },
  { label: 'Other associated commitments', key: 'otherAssociatedCommitments' },
  { label: 'Start date', key: 'startDate' },
  { label: 'End date', key: 'endDate' },
  { label: 'Deliverable', key: 'deliverable' },
  { label: 'Deliverable frequency', key: 'deliverableFrequency' },
  { label: 'Document due date', key: 'documentDueDate' },
];

const partyFields: Field[] = [
  { label: 'Lead agency', key: 'leadAgency' },
  { label: 'Partner agency', key: 'partnerAgency' },
  { label: 'Partner POC', key: 'partnerPOC' },
  { label: 'Policy lead', key: 'policyLead' },
  { label: 'BiOp SME', key: 'biopSME' },
  { label: 'COR', key: 'cor' },
  { label: 'NMFS POC', key: 'nmfsPOC' },
  { label: 'Associated projects', key: 'associatedProjects' },
];

// Notes is genuinely optional — hidden (not omitted: the edit dialog can ADD
// notes to a record that has none, so the row needs to exist to be un-hidden by
// the client script) when the record carries none. Every other field ("N/A"
// included) is meaningful and is always rendered verbatim.
const notesEmpty = (commitment.notes ?? '') === '';
---
<EsaCard title="Basics" variant="outlined" padding="default">
  <div slot="actions" class="cluster" data-gap="sm">
    <span data-crs-basics-status-pill>
      <EsaPill
        label={commitment.status}
        variant={STATUS_TONE[commitment.status]}
        size="sm"
        removable={false}
      />
    </span>
    <span data-crs-edit-commitment-open><EsaButton variant="secondary" appearance="outline" size="sm" icon="pencil">Edit</EsaButton></span>
  </div>

  <div class="cbf-basics stack" data-gap="xl" data-crs-basics-number={commitment.number}>
    <section class="stack" data-gap="sm">
      <h3 class="typography-heading-md">Overview</h3>
      <dl class="cbf-basics__fields grid" data-gap="md">
        {overviewFields.map((f) => (
          <div
            class:list={['cbf-basics__pair', { 'cbf-basics__pair--full': f.wide }]}
            data-crs-basics-pair={f.key}
            hidden={f.key === 'notes' && notesEmpty}
          >
            <dt class="typography-label cbf-basics__label">{f.label}</dt>
            <dd class="typography-body-md cbf-basics__value" data-crs-basics-value={f.key}>{commitment[f.key]}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="stack" data-gap="sm">
      <h3 class="typography-heading-md">Responsible parties</h3>
      <dl class="cbf-basics__fields grid" data-gap="md">
        {partyFields.map((f) => (
          <div class="cbf-basics__pair" data-crs-basics-pair={f.key}>
            <dt class="typography-label cbf-basics__label">{f.label}</dt>
            <dd class="typography-body-md cbf-basics__value" data-crs-basics-value={f.key}>{commitment[f.key]}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <CbfCrsEditCommitmentDialog
    categories={categories}
    subcategories={subcategories}
    types={commitmentTypes}
    frequencies={frequencies}
    deliverableFrequencies={deliverableFrequencies}
    leadAgencies={leadAgencies}
    partnerAgencies={partnerAgencies}
    partnerPOCs={partnerPOCs}
    policyLeads={policyLeads}
    biopSMEs={biopSMEs}
    cors={cors}
    nmfsPOCs={nmfsPOCs}
    associatedProjectsOptions={associatedProjectsOptions}
  />

  <!-- Every field the dialog can change, including statusByYear (the "Status
       by year" section) — number is excluded, it's never editable here. -->
  <script
    type="application/json"
    data-crs-basics-data
    set:html={JSON.stringify({
      title: commitment.title, source: commitment.source,
      sectionNumber: commitment.sectionNumber, pageNumber: commitment.pageNumber,
      category: commitment.category, subcategory: commitment.subcategory,
      commitmentType: commitment.commitmentType, frequency: commitment.frequency,
      description: commitment.description, interpretation: commitment.interpretation,
      implementation: commitment.implementation, notes: commitment.notes ?? '',
      otherAssociatedCommitments: commitment.otherAssociatedCommitments ?? '',
      startDate: commitment.startDate, endDate: commitment.endDate,
      deliverable: commitment.deliverable, deliverableFrequency: commitment.deliverableFrequency,
      documentDueDate: commitment.documentDueDate,
      leadAgency: commitment.leadAgency, partnerAgency: commitment.partnerAgency,
      partnerPOC: commitment.partnerPOC, policyLead: commitment.policyLead,
      biopSME: commitment.biopSME, cor: commitment.cor, nmfsPOC: commitment.nmfsPOC,
      associatedProjects: commitment.associatedProjects,
      statusByYear: commitment.statusByYear,
    })}
  ></script>
</EsaCard>

<style>
  /* Short fields pack two-up; the grid never overflows a narrow card. */
  .cbf-basics__fields {
    --grid-min: 15rem;
    margin: 0;
  }
  /* Long free-text fields (title/source/description/…) span the full row. */
  .cbf-basics__pair--full {
    grid-column: 1 / -1;
  }
  .cbf-basics__pair {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050);
  }
  /* Same author-CSS-beats-UA-stylesheet issue documented in
     cbf-password-gate.astro / cbf-crs-commitment-documents.astro: this
     component's own unconditional `display: flex` above sits later in the
     cascade than the UA stylesheet's `[hidden]{display:none}` at equal
     specificity, so it wins unless restated here with the attribute in the
     selector. Needed for the Notes row, which the edit dialog can toggle
     between empty (hidden) and populated. */
  .cbf-basics__pair[hidden] {
    display: none;
  }
  /* Labels: quiet supporting metadata. Values: full-strength text — darkened,
     never grayed, as they shrink to the dense record floor. */
  .cbf-basics__label {
    color: var(--color-content-default-secondary);
  }
  .cbf-basics__value {
    color: var(--color-content-default);
    /* free-text values can carry hard breaks / long tokens gracefully */
    overflow-wrap: anywhere;
  }
</style>

<script>
  import '@esa/ecology/esa-dialog';
  import { toISODate, isoToUSDate } from '../../lib/dates';
  import { splitMultiValue, joinMultiValue } from '../../lib/multi-value';
  import { YEARS, CURRENT_YEAR, STATUS_TONE } from '../../data/crs-commitments.mjs';

  type BasicsField = HTMLElement & { value?: string | string[] };
  type DialogEl = HTMLElement & { show: () => void; close: () => void };
  interface BasicsData {
    [key: string]: unknown;
    statusByYear: Record<string, string>;
  }

  // The two record fields that go through esa-date-picker (ISO in the field,
  // "M/D/YYYY" in storage/display) — everything else round-trips as plain text.
  const DATE_FIELDS = new Set(['startDate', 'endDate']);
  // Responsible-parties fields are esa-select `multiple` (chip-mode) — their
  // `.value` is a string[], joined/split against the record's comma-list
  // convention (src/lib/multi-value.ts). See cbf-crs-create-commitment-dialog
  // .astro's header note on why these carry more than one value in real data.
  const MULTI_FIELDS = new Set([
    'leadAgency', 'partnerAgency', 'partnerPOC', 'policyLead',
    'biopSME', 'cor', 'nmfsPOC', 'associatedProjects',
  ]);
  const PILL_VARIANTS = ['default', 'primary', 'success', 'warning', 'danger', 'info'];

  function initBasics(root: HTMLElement) {
    const dataEl = root.querySelector<HTMLScriptElement>('[data-crs-basics-data]');
    if (!dataEl) return;
    let data: BasicsData = JSON.parse(dataEl.textContent ?? '{}');

    const numberEl = root.querySelector<HTMLElement>('[data-crs-basics-number]');
    const commitmentNumber = numberEl?.dataset.crsBasicsNumber ?? '';

    const dialog = root.querySelector<DialogEl>('[data-crs-edit-commitment-dialog]');
    const form = root.querySelector<HTMLFormElement>('[data-crs-edit-commitment-form]');
    const numberDisplay = root.querySelector<HTMLElement>('[data-crs-edit-commitment-number]');
    const error = root.querySelector<HTMLElement & { hidden: boolean }>('[data-crs-edit-commitment-error]');
    const cancel = root.querySelector<HTMLElement>('[data-crs-edit-commitment-cancel]');
    const save = root.querySelector<HTMLElement>('[data-crs-edit-commitment-save]');

    const field = (name: string): BasicsField | null =>
      form?.querySelector<BasicsField>(`[data-field="${name}"]`) ?? null;
    const fieldValue = (name: string): string => {
      const v = field(name)?.value;
      return typeof v === 'string' ? v.trim() : '';
    };
    const yearField = (year: number): BasicsField | null =>
      form?.querySelector<BasicsField>(`[data-year-field="${year}"]`) ?? null;
    const yearFieldValue = (year: number): string => {
      const v = yearField(year)?.value;
      return typeof v === 'string' ? v.trim() : '';
    };

    root.querySelector('[data-crs-edit-commitment-open]')?.addEventListener('click', () => {
      if (error) error.hidden = true;
      if (numberDisplay) numberDisplay.textContent = `Commitment # ${commitmentNumber}`;
      Object.entries(data).forEach(([name, value]) => {
        if (name === 'statusByYear') return;
        const el = field(name);
        if (!el) return;
        if (MULTI_FIELDS.has(name)) el.value = splitMultiValue(value as string);
        else el.value = DATE_FIELDS.has(name) ? (toISODate(value as string) ?? '') : (value as string);
      });
      YEARS.forEach((year: number) => {
        const el = yearField(year);
        if (el) el.value = data.statusByYear[String(year)] ?? '';
      });
      dialog?.show();
    });

    cancel?.addEventListener('click', () => dialog?.close());

    save?.addEventListener('click', () => {
      const title = fieldValue('title');
      const category = fieldValue('category');
      if (!title || !category) {
        if (error) error.hidden = false;
        return;
      }

      const updated: BasicsData = { statusByYear: {} };
      for (const name of Object.keys(data)) {
        if (name === 'statusByYear') continue;
        if (MULTI_FIELDS.has(name)) {
          const v = field(name)?.value;
          updated[name] = joinMultiValue(Array.isArray(v) ? v : []);
        } else {
          const raw = fieldValue(name);
          updated[name] = DATE_FIELDS.has(name) ? (isoToUSDate(raw) ?? '') : raw;
        }
      }
      YEARS.forEach((year: number) => {
        const v = yearFieldValue(year);
        // Empty ("Unset") omits the key entirely, matching the dashboard's own
        // edit-status dialog convention — a year with no tracked status.
        if (v) updated.statusByYear[String(year)] = v;
      });
      data = updated;

      Object.entries(data).forEach(([name, value]) => {
        if (name === 'statusByYear') return;
        const valueEl = root.querySelector<HTMLElement>(`[data-crs-basics-value="${name}"]`);
        if (valueEl) valueEl.textContent = value as string;
        if (name === 'notes') {
          const pair = root.querySelector<HTMLElement & { hidden: boolean }>('[data-crs-basics-pair="notes"]');
          if (pair) pair.hidden = value === '';
        }
      });

      // Title also appears in the page's own heading and browser tab, both
      // outside this component's root — update them so an edited title
      // doesn't look stale the instant the dialog closes. Matches the exact
      // format [number].astro's BaseLayout title uses.
      const pageTitle = document.querySelector<HTMLElement>('.esa-page-header__title');
      if (pageTitle) pageTitle.textContent = title;
      document.title = `${commitmentNumber}: ${title} — Columbia Basin Fish & Wildlife Program`;

      // This record's CURRENT_YEAR status also drives the status pill in this
      // panel's own header AND the sibling cbf-crs-commitment-timeline.astro
      // component elsewhere on the page — both re-rendered here since Save
      // is the one place both go stale together.
      const newStatus = data.statusByYear[String(CURRENT_YEAR)] ?? '';
      const tone = (STATUS_TONE as Record<string, string>)[newStatus] ?? 'default';

      const statusPillWrap = root.querySelector<HTMLElement>('[data-crs-basics-status-pill]');
      const statusPill = statusPillWrap?.querySelector<HTMLElement>('.esa-pill');
      if (statusPill) {
        PILL_VARIANTS.forEach((v) => statusPill.classList.remove(`esa-pill--${v}`));
        statusPill.classList.add(`esa-pill--${tone}`);
        const label = statusPill.querySelector<HTMLElement>('.esa-pill__label');
        if (label) label.textContent = newStatus || 'Unset';
      }

      const timeline = document.querySelector<HTMLElement>('[data-crs-timeline]');
      const badgeHTML = new Map<string, string>();
      timeline?.querySelectorAll<HTMLElement>('[data-crs-timeline-badge-templates] [data-status]').forEach((el) => {
        badgeHTML.set(el.dataset.status ?? '', el.innerHTML);
      });
      YEARS.forEach((year: number) => {
        const slot = timeline?.querySelector<HTMLElement>(`[data-crs-timeline-value="${year}"]`);
        if (!slot) return;
        const status = data.statusByYear[String(year)];
        if (status && badgeHTML.has(status)) {
          slot.innerHTML = badgeHTML.get(status) as string;
        } else {
          // A freshly-built "no status" placeholder needs the timeline
          // component's own Astro scope hash copied on — otherwise its scoped
          // .cbf-timeline__none rule (added at build time) won't match a node
          // built from an innerHTML string, same reasoning as
          // cbf-crs-commitments-dashboard.astro's rebuildBar().
          const scopeAttr = slot.getAttributeNames().find((n) => n.startsWith('data-astro-cid-'));
          slot.innerHTML = `<span class="cbf-timeline__none"${scopeAttr ? ` ${scopeAttr}` : ''} aria-label="No status tracked">—</span>`;
        }
      });

      const snackbar = document.querySelector<HTMLElement & { success?: (msg: string, cfg?: unknown) => void }>('[data-snackbar]');
      snackbar?.success?.(`${commitmentNumber} updated.`, { duration: 4000 });

      dialog?.close();
    });
  }

  document
    .querySelectorAll<HTMLScriptElement>('[data-crs-basics-data]')
    .forEach((dataEl) => {
      const root = dataEl.closest<HTMLElement>('.esa-card');
      if (root) initBasics(root);
    });
</script>
