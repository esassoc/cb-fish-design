---
// cbf-crs-commitments-grid — the "2020 CRS Commitments" index: a scannable,
// searchable, filterable table of every tracked CRS BiOp commitment, each row
// linking to its detail page at /crs-commitments/<number>. Column set (and
// order) was checked directly against prod's real
// BiologicalOpinionCommitmentsIndex grid and matches it field-for-field (minus
// the Documents icon column, which the separate document-library page already
// covers) — this is the same wide, horizontally-scrolling table pattern prod
// uses, not a narrowed scan view.
//
// bcn-lego-checked: ecology has NO table/grid/data-grid lego (checked the full
// node_modules/@esa/ecology/src/components catalog — esa-card/esa-pill/esa-badge
// are atoms, none render a sortable, filterable tabular data surface) and Beacon
// is not on this machine. The tabular surface is AG Grid Community
// (ag-grid-community), the same explicit dependency the vendor-dashboard invoices
// grid chose for sort/quick-search/CSV export over a hand-rolled <table>; this
// bcn- component is its reusable home. Every other control is a lego: the Status
// cell reuses the real esa-pill markup (server-rendered once per status into a
// hidden template, cloned into grid cells so the design-system styling is
// identical — never reinvented), the search input reuses cbf-search-field, the
// Category + Status filters use esa-chip-group, the "Create new" CTA and the
// CSV download use esa-button / esa-icon-button.
import CbfSearchField from '../search/cbf-search-field.astro';
import EsaPill from '@esa/ecology/esa-pill.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIconButton from '@esa/ecology/esa-icon-button.astro';
import CbfCrsCreateCommitmentDialog from './cbf-crs-create-commitment-dialog.astro';
import '../shared/cbf-data-grid-chrome.css';
import { commitments as defaultCommitments, STATUS_TONE } from '../../data/crs-commitments.mjs';
import type { CrsCommitment } from '../../data/crs-commitments.mjs';

type CommitmentStatus = keyof typeof STATUS_TONE;

interface Props {
  commitments?: CrsCommitment[];
}

const { commitments = defaultCommitments } = Astro.props;

// Category chip filter — single-select, "All" escape first. Options derived from
// the data so the control never lists an empty bucket.
const categories = Array.from(new Set(commitments.map((c) => c.category))).sort();
const categoryFilters = [
  { value: '', label: 'All' },
  ...categories.map((c) => ({ value: c, label: c })),
];

// Status chip filter — same convention. Canonical lifecycle order (not alpha) so
// the control reads Not Started → … → Closed; Delayed gets the amber tone so the
// off-track state stands out in the control, mirroring its esa-pill warning tone.
const statusOrder: CommitmentStatus[] = [
  'Not Started', 'In Progress', 'Delayed', 'Future', 'Complete', 'Closed',
];
const presentStatuses = statusOrder.filter((s) => commitments.some((c) => c.status === s));
const statusFilters = [
  { value: '', label: 'All' },
  ...presentStatuses.map((s) => ({
    value: s,
    label: s,
    ...(s === 'Delayed' ? { tone: 'amber' as const } : {}),
  })),
];

// Option lists for the "Create new CRS Commitment" dialog's esa-select fields.
const subcategories = Array.from(new Set(commitments.map((c) => c.subcategory))).sort();
const commitmentTypes = Array.from(new Set(commitments.map((c) => c.commitmentType))).sort();
const frequencies = Array.from(new Set(commitments.map((c) => c.frequency))).sort();
const deliverableFrequencies = Array.from(new Set(commitments.map((c) => c.deliverableFrequency))).sort();
---
<section class="cbf-crs-grid stack" data-gap="md">
  <header class="cbf-data-grid__header repel">
    <span class="type-caption cbf-data-grid__count-label">All commitments</span>
    <EsaButton color="primary" icon="plus" data-crs-create-open>Create new CRS Commitment</EsaButton>
  </header>

  <CbfCrsCreateCommitmentDialog
    categories={categories}
    subcategories={subcategories}
    types={commitmentTypes}
    frequencies={frequencies}
    deliverableFrequencies={deliverableFrequencies}
  />

  <div class="cbf-data-grid__controls repel">
    <div class="cbf-data-grid__filters cluster" data-gap="lg">
      <label class="cbf-data-grid__filter">
        <span class="type-caption">Category</span>
        <esa-chip-group
          data-crs-category-filter
          size="sm"
          label="Filter by category"
          value=""
          options={JSON.stringify(categoryFilters)}
        ></esa-chip-group>
      </label>
      <label class="cbf-data-grid__filter">
        <span class="type-caption">Status</span>
        <esa-chip-group
          data-crs-status-filter
          size="sm"
          label="Filter by status"
          value=""
          options={JSON.stringify(statusFilters)}
        ></esa-chip-group>
      </label>
    </div>
    <div class="cbf-data-grid__search">
      <CbfSearchField
        placeholder="Search number, title or source…"
        iconSize={18}
        data-crs-search
        aria-label="Search commitments"
      />
    </div>
  </div>

  <!-- AG Grid mounts here. autoHeight grows with rows so the page (not an inner
       pane) owns vertical scroll; the wrapper owns the framed surface. -->
  <div class="cbf-data-grid__grid" data-crs-grid></div>

  <footer class="cbf-data-grid__footer repel">
    <span class="type-caption" data-crs-count>
      Showing {commitments.length} of {commitments.length} commitments
    </span>
    <EsaIconButton icon="download" label="Download CSV" size="sm" data-crs-csv />
  </footer>

  <!-- The real esa-pill lego, server-rendered once per status with the design-
       system scope hash intact. The grid's Status cell renderer clones the
       matching template's markup — so those chips are byte-identical to the
       lego, never a hand-rolled copy. removable=false: a status indicator, not
       a removable filter chip. Pre-renders all 6 lifecycle statuses (not just
       presentStatuses) so a newly-created commitment's default "Not Started"
       status has a matching pill even though no existing row uses it today. -->
  <div class="cbf-crs-grid__badge-templates" data-crs-badge-templates hidden aria-hidden="true">
    {statusOrder.map((s) => (
      <span data-status={s}>
        <EsaPill label={s} variant={STATUS_TONE[s]} size="sm" removable={false} />
      </span>
    ))}
  </div>

  <!-- Row data for the grid, serialized so the client module (which imports
       ag-grid-community) hydrates without a second fetch. -->
  <script type="application/json" data-crs-data set:html={JSON.stringify(commitments)}></script>
</section>

<script>
  import '@esa/ecology/esa-chip-group';
  import { withBase } from '../../lib/base';
  import { gridDateFormatter as dateFmt, asGridDate as asDate, escGridHtml as esc, wireDataGrid } from '../shared/grid-chrome';

  type Commitment = {
    number: string; title: string; source: string; sectionNumber: string; pageNumber: string;
    category: string; subcategory: string; commitmentType: string; frequency: string;
    description: string; interpretation: string; implementation: string;
    notes?: string; otherAssociatedCommitments?: string;
    startDate: string; endDate: string;
    deliverable: string; deliverableFrequency: string; documentDueDate: string;
    leadAgency: string; partnerAgency: string; partnerPOC: string; policyLead: string;
    biopSME: string; cor: string; nmfsPOC: string; associatedProjects: string;
    status: string;
  };

  // Canonical lifecycle order → a status comparator that sorts by workflow stage
  // rather than alphabetically.
  const STATUS_ORDER = ['Not Started', 'In Progress', 'Delayed', 'Future', 'Complete', 'Closed'];
  const statusRank = (s: string) => {
    const i = STATUS_ORDER.indexOf(s);
    return i === -1 ? STATUS_ORDER.length : i;
  };

  function initCommitments(root: HTMLElement) {
    const categoryFilter = root.querySelector<HTMLElement & { value: string }>('[data-crs-category-filter]');
    const statusFilter = root.querySelector<HTMLElement & { value: string }>('[data-crs-status-filter]');

    // Pre-clone the real esa-pill markup per status (server-rendered with the
    // design-system scope hash) so grid cells reuse the lego verbatim.
    const badgeHTML = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('[data-crs-badge-templates] [data-status]').forEach((el) => {
      badgeHTML.set(el.dataset.status ?? '', el.innerHTML);
    });

    // External (chip-driven) filters — kept out of the column filter UI so the
    // esa-chip-groups stay the single control surface.
    let categoryValue = '';
    let statusValue = '';

    // Only number/title/source feed quick search (category/status have their own
    // chip filters) — defaultColDef opts every column out, the three opt back in.
    const handle = wireDataGrid<Commitment>({
      root,
      gridSelector: '[data-crs-grid]',
      dataSelector: '[data-crs-data]',
      searchSelector: '[data-crs-search]',
      countSelector: '[data-crs-count]',
      csvSelector: '[data-crs-csv]',
      countNoun: 'commitments',
      csvFileName: '2020-crs-commitments.csv',
      suppressCellFocus: true,
      columnDefs: [
        {
          headerName: 'Number', field: 'number', colId: 'number',
          cellClass: 'cbf-grid-id', minWidth: 130,
          getQuickFilterText: (p) => p.data?.number ?? '',
          cellRenderer: (p: { value: string }) =>
            `<a class="cbf-grid-link" href="${esc(withBase('/crs-commitments/' + p.value))}">${esc(p.value)}</a>`,
        },
        {
          headerName: 'Commitment', field: 'title', colId: 'title', flex: 3, minWidth: 260,
          getQuickFilterText: (p) => p.data?.title ?? '',
          cellRenderer: (p: { value: string; data: Commitment }) =>
            `<a class="cbf-grid-link" href="${esc(withBase('/crs-commitments/' + p.data.number))}">${esc(p.value)}</a>`,
        },
        {
          headerName: 'Source', field: 'source', colId: 'source', flex: 2, minWidth: 200,
          getQuickFilterText: (p) => p.data?.source ?? '',
        },
        { headerName: 'Section', field: 'sectionNumber', colId: 'sectionNumber', minWidth: 100 },
        { headerName: 'Page', field: 'pageNumber', colId: 'pageNumber', minWidth: 90 },
        { headerName: 'Category', field: 'category', colId: 'category', minWidth: 130 },
        { headerName: 'Subcategory', field: 'subcategory', colId: 'subcategory', minWidth: 140 },
        { headerName: 'Type', field: 'commitmentType', colId: 'commitmentType', minWidth: 120 },
        { headerName: 'Frequency', field: 'frequency', colId: 'frequency', minWidth: 120 },
        { headerName: 'Description', field: 'description', colId: 'description', minWidth: 220 },
        { headerName: 'Interpretation', field: 'interpretation', colId: 'interpretation', minWidth: 220 },
        { headerName: 'Implementation', field: 'implementation', colId: 'implementation', minWidth: 220 },
        { headerName: 'Notes', field: 'notes', colId: 'notes', minWidth: 180 },
        {
          headerName: 'Other associated commitments', field: 'otherAssociatedCommitments',
          colId: 'otherAssociatedCommitments', minWidth: 200,
        },
        {
          headerName: 'Start', field: 'startDate', colId: 'startDate', minWidth: 120,
          cellDataType: 'date',
          valueGetter: (p) => asDate(p.data?.startDate),
          valueFormatter: (p) => (p.value instanceof Date ? dateFmt.format(p.value) : ''),
        },
        {
          headerName: 'End', field: 'endDate', colId: 'endDate', minWidth: 120,
          cellDataType: 'date',
          valueGetter: (p) => asDate(p.data?.endDate),
          valueFormatter: (p) => (p.value instanceof Date ? dateFmt.format(p.value) : ''),
        },
        { headerName: 'Deliverable', field: 'deliverable', colId: 'deliverable', minWidth: 180 },
        { headerName: 'Deliverable frequency', field: 'deliverableFrequency', colId: 'deliverableFrequency', minWidth: 160 },
        { headerName: 'Document due', field: 'documentDueDate', colId: 'documentDueDate', minWidth: 120 },
        { headerName: 'Lead agency', field: 'leadAgency', colId: 'leadAgency', minWidth: 130 },
        { headerName: 'Partner agency', field: 'partnerAgency', colId: 'partnerAgency', minWidth: 140 },
        { headerName: 'Partner POC', field: 'partnerPOC', colId: 'partnerPOC', minWidth: 150 },
        { headerName: 'Policy lead', field: 'policyLead', colId: 'policyLead', minWidth: 150 },
        { headerName: 'BiOp SME', field: 'biopSME', colId: 'biopSME', minWidth: 150 },
        { headerName: 'COR', field: 'cor', colId: 'cor', minWidth: 150 },
        { headerName: 'NMFS POC', field: 'nmfsPOC', colId: 'nmfsPOC', minWidth: 150 },
        { headerName: 'Associated projects', field: 'associatedProjects', colId: 'associatedProjects', minWidth: 180 },
        {
          headerName: 'Status', field: 'status', colId: 'status', minWidth: 140,
          comparator: (a: string, b: string) => statusRank(a) - statusRank(b),
          cellRenderer: (p: { value: string }) =>
            `<span class="cbf-grid-status">${badgeHTML.get(p.value) ?? esc(p.value)}</span>`,
        },
      ],
      gridOptions: {
        isExternalFilterPresent: () => categoryValue !== '' || statusValue !== '',
        doesExternalFilterPass: (node) =>
          (categoryValue === '' || node.data?.category === categoryValue) &&
          (statusValue === '' || node.data?.status === statusValue),
      },
    });
    if (!handle) return;
    const { gridApi, data, countState } = handle;

    // Category / Status chips → external filter.
    categoryFilter?.addEventListener('change', () => {
      categoryValue = categoryFilter.value ?? '';
      gridApi.onFilterChanged();
    });
    statusFilter?.addEventListener('change', () => {
      statusValue = statusFilter.value ?? '';
      gridApi.onFilterChanged();
    });

    // "Create new CRS Commitment" → open the dialog, add the row client-side on
    // submit. This spoke has no backend to persist to (see the dialog's own
    // header note) — the row lives only in this grid's in-memory rowData.
    const createOpenBtn = root.querySelector<HTMLElement>('[data-crs-create-open]');
    const createDialog = root.querySelector<HTMLElement & { show: () => void; close: () => void }>('[data-crs-create-dialog]');
    const createForm = root.querySelector<HTMLFormElement>('[data-crs-create-form]');
    const createCancelBtn = root.querySelector<HTMLElement>('[data-crs-create-cancel]');
    const createSubmitBtn = root.querySelector<HTMLElement>('[data-crs-create-submit]');
    const createError = root.querySelector<HTMLElement & { hidden: boolean }>('[data-crs-create-error]');

    const createField = (name: string): (HTMLElement & { value?: string }) | null =>
      createForm?.querySelector<HTMLElement & { value?: string }>(`[data-field="${name}"]`) ?? null;
    const createFieldValue = (name: string): string => (createField(name)?.value ?? '').trim();

    function resetCreateForm(): void {
      createForm?.querySelectorAll<HTMLElement & { value?: string }>('[data-field]').forEach((el) => {
        if ('value' in el) el.value = '';
      });
      if (createError) createError.hidden = true;
    }

    createOpenBtn?.addEventListener('click', () => createDialog?.show());
    createCancelBtn?.addEventListener('click', () => {
      createDialog?.close();
      resetCreateForm();
    });

    createSubmitBtn?.addEventListener('click', () => {
      const title = createFieldValue('title');
      const category = createFieldValue('category');
      if (!title || !category) {
        if (createError) createError.hidden = false;
        return;
      }

      // Next number in the existing CRS-Com-<n> series.
      const nextN = data.reduce((max, c) => {
        const n = Number(c.number.replace(/^CRS-Com-/, ''));
        return Number.isFinite(n) ? Math.max(max, n) : max;
      }, 0) + 1;

      const row: Commitment = {
        number: `CRS-Com-${nextN}`,
        title,
        source: createFieldValue('source'),
        sectionNumber: createFieldValue('sectionNumber'),
        pageNumber: createFieldValue('pageNumber'),
        category,
        subcategory: createFieldValue('subcategory'),
        commitmentType: createFieldValue('commitmentType') || 'Functional',
        frequency: createFieldValue('frequency') || 'Recurring',
        description: createFieldValue('description'),
        interpretation: createFieldValue('interpretation'),
        implementation: createFieldValue('implementation'),
        notes: createFieldValue('notes'),
        otherAssociatedCommitments: createFieldValue('otherAssociatedCommitments'),
        startDate: createFieldValue('startDate'),
        endDate: createFieldValue('endDate'),
        deliverable: createFieldValue('deliverable'),
        deliverableFrequency: createFieldValue('deliverableFrequency') || 'N/A',
        documentDueDate: createFieldValue('documentDueDate'),
        leadAgency: createFieldValue('leadAgency'),
        partnerAgency: createFieldValue('partnerAgency'),
        partnerPOC: createFieldValue('partnerPOC'),
        policyLead: createFieldValue('policyLead'),
        biopSME: createFieldValue('biopSME'),
        cor: createFieldValue('cor'),
        nmfsPOC: createFieldValue('nmfsPOC'),
        associatedProjects: createFieldValue('associatedProjects'),
        status: 'Not Started',
      };

      data.unshift(row);
      countState.total += 1;
      gridApi.applyTransaction({ add: [row], addIndex: 0 });

      const snackbar = document.querySelector<HTMLElement & { success?: (msg: string, cfg?: unknown) => void }>('[data-snackbar]');
      snackbar?.success?.(`${row.number} created.`, { duration: 5000 });

      createDialog?.close();
      resetCreateForm();
    });
  }

  document
    .querySelectorAll<HTMLElement>('.cbf-crs-grid')
    .forEach(initCommitments);
</script>
