---
// cbf-program-overview — the homepage "Welcome to…" band: the page h1 + intro
// prose beside the program-at-a-glance tiles (projects, contracts), side by
// side on wide screens and stacked on narrow ones. Mirrors the cbfish.org
// homepage overview.
//
// bcn-lego-checked: the side-by-side is the `switcher` layout primitive; the
// tiles are cbf-stat-links (linked, like the "What the program has delivered"
// totals — see its note). The heading/intro use the typography roles; only the
// copy's measure and the intro colour are local.
import CbfStatLinks, { type StatLink } from './cbf-stat-links.astro';

interface Props {
  heading: string;
  intro: string;
  stats: StatLink[];
}
const { heading, intro, stats } = Astro.props;
---
<section class="cbf-program-overview switcher" data-gap="2xl">
  <div class="cbf-program-overview__copy stack" data-gap="sm">
    <h1 class="typography-heading-lg">{heading}</h1>
    <p class="typography-body-lg cbf-program-overview__intro">{intro}</p>
  </div>
  <div class="cbf-program-overview__stats">
    <CbfStatLinks items={stats} minTile="8rem" />
  </div>
</section>

<style>
  /* below ~56rem the copy and the tiles stack */
  .cbf-program-overview { --switcher-threshold: 56rem; align-items: center; }
  .cbf-program-overview__copy { max-width: 62ch; }
  .cbf-program-overview__intro { color: var(--color-content-default-secondary); line-height: 1.6; }
</style>
