---
// cbf-metrics-basin — homepage "What the program has delivered since 2005"
// (CBF-8287): ONE card. On the right, a vertical tab list of the three
// cumulative totals (each tab: total, label, FY25 gain). The tab panel on the
// left is a schematic map of the four program states shaded by the selected
// measure, with the Columbia and Snake drawn through them.
//
// Accessibility: the tabs follow the ARIA tabs pattern (roving tabindex,
// Arrow Up/Down, Home/End, aria-selected, one tabpanel). The map is a visual
// summary only (aria-hidden); a visually hidden "<measure> by state" table
// carries every number as text, so nothing depends on colour or the picture.
// State shades step evenly by rank, and labels flip dark on the pale states.
//
// The outlines are deliberately SCHEMATIC (a dozen points per state, simple
// equirectangular projection): recognisable at a glance, light enough to inline,
// and no tile server — so it also renders inside locked-down preview frames.
//
// bcn-lego-checked: esa-tab-layout is the tabs lego, but its tabs are one-line
// text labels in a horizontal strip, and these tabs carry a big total, a label
// and a sub-line, stacked beside the panel; so this is the same ARIA tabs
// pattern hand-wired (no tile-tab lego exists; candidate for /request-lego).
// The screen-reader by-state list is a real <table> (caption, scoped headers) as in
// cbf-metrics-table: ecology has no table lego. "View … data" is esa-button.
// No esa- map lego exists; checked Beacon (maps there are full GIS views).
import EsaButton from '@esa/ecology/esa-button.astro';
import { METRICS, STATES, formatCompact, type StateCode } from '../../data/cbfish-home-metrics';
import { contractLink } from '../../lib/contract-links';
import { latestGain } from '../../lib/series';
import { OUTLINES, RIVERS } from '../../data/basin-geo';

const S = 40, COS = Math.cos((46 * Math.PI) / 180);
const px = ([lon, lat]: [number, number]) => [((lon + 125) * COS * S).toFixed(1), ((49.4 - lat) * S).toFixed(1)].join(',');
const ring = (pts: [number, number][]) => `M${pts.map(px).join('L')}Z`;
const path = (pts: [number, number][]) => `M${pts.map(px).join('L')}`;
const W = Math.round((125 - 103.8) * COS * S), H = Math.round((49.4 - 41.8) * S);
const LABEL_AT: Record<StateCode, [number, number]> = { WA: [-120.4, 47.4], OR: [-120.5, 43.9], ID: [-114.6, 43.6], MT: [-109.6, 47.0] };

const first = METRICS[0];
// shade by rank, not raw share: four evenly spaced steps keep the states
// distinct even when two values are close (0 = least … 1 = most)
const shareOf = (m: (typeof METRICS)[number], s: StateCode) => {
  const vals = Object.values(m.byState);
  return vals.filter((v) => v < m.byState[s]).length / Math.max(vals.length - 1, 1);
};
const split = (n: number) => { const [value, ...word] = formatCompact(n).split(' '); return { value, word: word.join(' ') }; };
// everything the script needs to re-label the tiles for a state
const data = METRICS.map((m) => ({
  id: m.id, short: m.short, unit: m.unit, label: m.label, total: m.total, byState: m.byState,
  gain: `+${latestGain(m.cumulative).toLocaleString('en-US')} added in FY25`,
}));
const stateNames = Object.fromEntries(STATES.map((s) => [s.code, s.name]));
const pct = (m: (typeof METRICS)[number], s: StateCode) => Math.round((m.byState[s] / Object.values(m.byState).reduce((x, y) => x + y, 0)) * 100);
const unitWord = (u: string) => u.charAt(0).toUpperCase() + u.slice(1);
---
<section class="cbf-metrics-basin stack" data-gap="lg" aria-labelledby="cbf-metrics-basin-h" data-basin
  data-metrics={JSON.stringify(data)} data-states={JSON.stringify(stateNames)}>
  <h2 id="cbf-metrics-basin-h" class="typography-heading-md">What the program has delivered since 2005</h2>

  <div class="cbf-metrics-basin__card">
    <div class="cbf-metrics-basin__tabs" role="tablist" aria-label="Measure" aria-orientation="vertical">
      {data.map((d, i) => {
        const t = split(d.total);
        return (
          <button type="button" role="tab" class="cbf-metrics-basin__tab" id={`cbf-basin-tab-${d.id}`} data-measure={d.id}
            aria-controls="cbf-basin-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'}>
            <span class="cbf-metrics-basin__tab-value">{t.value}<span class="cbf-metrics-basin__tab-word">{t.word ? ` ${t.word}` : ''}</span></span>
            <span class="cbf-metrics-basin__tab-label">{d.label}</span>
            <span class="cbf-metrics-basin__tab-sub">{d.gain}</span>
          </button>
        );
      })}
    </div>

    <div class="cbf-metrics-basin__panel" id="cbf-basin-panel" role="tabpanel" aria-labelledby={`cbf-basin-tab-${first.id}`}>
      <div class="cbf-metrics-basin__map" aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} focusable="false">
          {STATES.map((s) => (
            <g class="cbf-metrics-basin__state" data-state={s.code} style={`--share: ${shareOf(first, s.code)}`}>
              <path d={ring(OUTLINES[s.code])} />
            </g>
          ))}
          <path class="cbf-metrics-basin__highlight" d="" data-highlight />
          {RIVERS.map((r) => <path d={path(r.points)} class="cbf-metrics-basin__river-casing" />)}
          {RIVERS.map((r) => <path d={path(r.points)} class={`cbf-metrics-basin__river is-${r.id}`} />)}
          {STATES.map((s) => {
            const [x, y] = px(LABEL_AT[s.code]).split(',');
            return (
              <g class="cbf-metrics-basin__label" transform={`translate(${x} ${y})`} data-label={s.code} data-tone={shareOf(first, s.code) < 0.5 ? '' : undefined}>
                <text class="cbf-metrics-basin__label-code" text-anchor="middle" y="-6">{s.code}</text>
                <text class="cbf-metrics-basin__label-value" text-anchor="middle" y="14" data-label-value>{formatCompact(first.byState[s.code])}</text>
              </g>
            );
          })}
        </svg>
      </div>

      <table class="cbf-metrics-basin__table visually-hidden">
        <caption class="typography-label-md" data-caption>{first.short} by state</caption>
        <thead>
          <tr>
            <th scope="col">State</th>
            <th scope="col" class="is-num" data-unit-head>{unitWord(first.unit)}</th>
            <th scope="col" class="is-num">Share of total</th>
          </tr>
        </thead>
        <tbody>
          {STATES.map((s) => (
            <tr data-row={s.code}>
              <th scope="row">{s.name}</th>
              <td class="is-num" data-cell-value>{first.byState[s.code].toLocaleString('en-US')}</td>
              <td class="is-num">
                <span data-cell-pct>{pct(first, s.code)}%</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="cbf-metrics-basin__footer">
        <div class="cbf-metrics-basin__legend typography-body-xs" aria-hidden="true">
          <span>Less</span><span class="cbf-metrics-basin__ramp"></span><span>More</span>
          {RIVERS.map((r) => (
            <span class="cbf-metrics-basin__legend-river"><span class={`cbf-metrics-basin__river-key is-${r.id}`}></span>{r.name}</span>
          ))}
        </div>
        <EsaButton variant="primary" appearance="outline" size="sm" {...contractLink(first.id)} iconRight="arrow-right" data-basin-open>View {first.short.toLowerCase()} data</EsaButton>
      </div>
    </div>
  </div>
</section>

<style>
  /* land runs from a near-white sage to a deep forest sage, so shares read apart */
  .cbf-metrics-basin {
    --_land-light: var(--color-olive-2, #f8faf8);
    --_land-deep: color-mix(in srgb, var(--color-grass-11, #2a7e3b) 55%, var(--color-olive-12, #1d211c));
  }

  /* one card: the map (tab panel) on the left, the tab list on the right.
     DOM order stays tabs → panel, as the ARIA tabs pattern expects. */
  .cbf-metrics-basin__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 17rem);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    background: var(--color-background-elevation-raised);
  }
  .cbf-metrics-basin__tabs {
    display: flex;
    flex-direction: column;
    grid-column: 2;
    grid-row: 1;
    background: var(--color-background-elevation-sunken);
    border-inline-start: 1px solid var(--color-border-default-subtle);
  }
  .cbf-metrics-basin__tab {
    /* the three tabs share the column's height evenly */
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--spacing-100);
    padding: var(--spacing-500);
    text-align: left;
    color: inherit;
    border-bottom: 1px solid var(--color-border-default-subtle);
    transition: background 200ms ease;
  }
  .cbf-metrics-basin__tab:hover { background: var(--color-background-default-hover); }
  .cbf-metrics-basin__tab:focus-visible { outline: 2px solid var(--color-background-brand); outline-offset: -3px; }
  /* the selected tab opens into the panel: it takes the panel's surface and
     covers the divider between them (no coloured stripe) */
  .cbf-metrics-basin__tab[aria-selected='true'] {
    background: var(--color-background-elevation-raised);
    margin-inline-start: -1px;
    box-shadow: 0 1px 0 var(--color-border-default-subtle), 0 -1px 0 var(--color-border-default-subtle);
  }
  .cbf-metrics-basin__tab-value {
    font-family: var(--typography-font-family-display, var(--typography-font-family-sans));
    font-size: var(--typography-heading-lg-font-size);
    font-weight: var(--typography-font-weight-bold, 700);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-content-default-secondary);
  }
  .cbf-metrics-basin__tab[aria-selected='true'] .cbf-metrics-basin__tab-value { color: var(--color-background-brand); }
  .cbf-metrics-basin__tab-word { font-size: var(--typography-body-lg-font-size); font-weight: var(--typography-font-weight-semibold); }
  .cbf-metrics-basin__tab-label { font-size: var(--typography-body-sm-font-size); color: var(--color-content-default); }
  .cbf-metrics-basin__tab[aria-selected='true'] .cbf-metrics-basin__tab-label { font-weight: var(--typography-font-weight-semibold); }
  .cbf-metrics-basin__tab-sub { font-size: var(--typography-body-sm-font-size); color: var(--color-content-default-secondary); }

  /* panel: the map with its legend and link underneath */
  .cbf-metrics-basin__panel {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacing-400);
    padding: var(--spacing-500) var(--spacing-600) var(--spacing-400);
    min-width: 0;
    background:
      radial-gradient(120% 90% at 0% 0%, var(--color-background-brand-subtle), transparent 55%),
      var(--color-background-elevation-raised);
  }
  .cbf-metrics-basin__map { min-width: 0; }
  /* the by-state table is for screen readers only (same pattern as cbf-metrics-table) */
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cbf-metrics-basin__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-300) var(--spacing-500);
    padding-top: var(--spacing-300);
    border-top: 1px solid var(--color-border-default-subtle);
  }
  .cbf-metrics-basin__map svg { width: 100%; max-width: 40rem; height: auto; display: block; overflow: visible; margin-inline: auto; }
  .cbf-metrics-basin__state path {
    /* land: muted sage greens (grass toned down with olive), lightest for the
       smallest share */
    fill: color-mix(in srgb, var(--_land-deep) calc(var(--share) * 82% + 10%), var(--_land-light));
    stroke: var(--color-background-elevation-raised);
    stroke-width: 2.5;
    stroke-linejoin: round;
    transition: fill 420ms ease, filter 200ms ease;
  }
  .cbf-metrics-basin__state:hover path { filter: brightness(1.08); }
  /* the hovered state's gold outline is a separate overlay path (see script),
     drawn above its neighbours */
  .cbf-metrics-basin__highlight {
    fill: none;
    stroke: var(--cbf-gold-300);
    stroke-width: 4;
    stroke-linejoin: round;
    pointer-events: none;
  }
  /* water: two blues, so the Columbia and the Snake read as separate rivers */
  .cbf-metrics-basin__river.is-columbia { --_river: var(--color-blue-12, #113264); }
  .cbf-metrics-basin__river.is-snake { --_river: var(--color-cyan-9, #00a2c7); }
  /* a light casing under each river lifts it off the green */
  .cbf-metrics-basin__river-casing {
    fill: none;
    stroke: var(--color-background-elevation-raised, #fcfcfc);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .cbf-metrics-basin__river {
    fill: none;
    stroke: var(--_river, var(--color-blue-12, #113264));
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .cbf-metrics-basin__label { pointer-events: none; }
  .cbf-metrics-basin__label text { font-family: var(--typography-font-family-display, var(--typography-font-family-sans)); paint-order: stroke; stroke-width: 3px; stroke-linejoin: round; }
  .cbf-metrics-basin__label-code { font-size: var(--typography-label-sm-font-size); font-weight: var(--typography-font-weight-semibold); letter-spacing: .08em; fill: var(--color-content-default-knockout); stroke: color-mix(in srgb, var(--color-olive-12, #1d211c) 60%, transparent); }
  .cbf-metrics-basin__label-value { font-size: var(--typography-title-font-size); font-weight: var(--typography-font-weight-bold); fill: var(--color-content-default-knockout); stroke: color-mix(in srgb, var(--color-olive-12, #1d211c) 60%, transparent); }
  /* pale states take dark labels with a light halo */
  .cbf-metrics-basin__label[data-tone] text { fill: var(--color-content-default); stroke: color-mix(in srgb, var(--color-olive-1, #fbfdfb) 80%, transparent); }
  .cbf-metrics-basin__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-200);
    color: var(--color-content-default-tertiary);
  }
  .cbf-metrics-basin__ramp {
    width: 7rem;
    height: 8px;
    border-radius: var(--radius-full);
    background: linear-gradient(to right, color-mix(in srgb, var(--_land-deep) 10%, var(--_land-light)), color-mix(in srgb, var(--_land-deep) 92%, var(--_land-light)));
  }
  .cbf-metrics-basin__legend-river { display: inline-flex; align-items: center; gap: var(--spacing-100); margin-left: var(--spacing-300); }
  .cbf-metrics-basin__river-key { width: 1.5rem; height: 4px; border-radius: 2px; background: var(--color-blue-12, #113264); }
  .cbf-metrics-basin__river-key.is-snake { background: var(--color-cyan-9, #00a2c7); }

  /* narrow: the tabs sit above the panel as a compact list */
  @media (max-width: 720px) {
    .cbf-metrics-basin__card { grid-template-columns: minmax(0, 1fr); }
    .cbf-metrics-basin__tabs, .cbf-metrics-basin__panel { grid-column: 1; grid-row: auto; }
    .cbf-metrics-basin__tabs { border-inline-start: 0; border-bottom: 1px solid var(--color-border-default-subtle); }
    .cbf-metrics-basin__tab { flex: none; justify-content: flex-start; flex-direction: row; flex-wrap: wrap; align-items: baseline; column-gap: var(--spacing-300); padding: var(--spacing-300) var(--spacing-400); }
    .cbf-metrics-basin__tab[aria-selected='true'] { margin-inline-start: 0; }
    .cbf-metrics-basin__tab-sub { flex-basis: 100%; }
    .cbf-metrics-basin__panel { padding: var(--spacing-400); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cbf-metrics-basin__state path, .cbf-metrics-basin__tab { transition: none; }
  }
</style>

<script>
  import { formatCompact } from '../../data/cbfish-home-metrics';

  type M = { id: string; short: string; unit: string; label: string; total: number; byState: Record<string, number>; gain: string };
  const root = document.querySelector<HTMLElement>('[data-basin]');
  if (root) {
    const metrics: M[] = JSON.parse(root.dataset.metrics || '[]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const states = [...root.querySelectorAll<SVGGElement>('[data-state]')];
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-row]')]; // screen-reader table
    const highlight = root.querySelector('[data-highlight]')!;
    let current = metrics[0];

    // outline the hovered state on the map
    const emphasise = (code: string | null) => {
      const on = code ? states.find((g) => g.dataset.state === code) : null;
      highlight.setAttribute('d', on?.querySelector('path')?.getAttribute('d') ?? '');
    };

    // shade the map and fill the table for the selected measure
    const paint = () => {
      const vals = Object.values(current.byState);
      const sum = vals.reduce((a, b) => a + b, 0) || 1;
      const unit = current.unit.charAt(0).toUpperCase() + current.unit.slice(1);
      root.querySelector('[data-caption]')!.textContent = `${current.short} by state`;
      root.querySelector('[data-unit-head]')!.textContent = unit;
      states.forEach((g) => {
        const code = g.dataset.state!;
        const v = current.byState[code] ?? 0;
        const share = vals.filter((x) => x < v).length / Math.max(vals.length - 1, 1);
        g.style.setProperty('--share', String(share));
        const label = root.querySelector<SVGGElement>(`[data-label="${code}"]`);
        if (label) {
          label.querySelector('[data-label-value]')!.textContent = v ? formatCompact(v) : '—';
          label.toggleAttribute('data-tone', share < 0.5);
        }
        const row = rows.find((r) => r.dataset.row === code);
        if (row) {
          const p = Math.round((v / sum) * 100);
          row.querySelector('[data-cell-value]')!.textContent = v.toLocaleString('en-US');
          row.querySelector('[data-cell-pct]')!.textContent = `${p}%`;
        }
      });
      root.querySelectorAll<HTMLElement>('[data-basin-open]').forEach((b) => {
        // out-of-scope links (href="#") have no measure in them to swap
        if (b instanceof HTMLAnchorElement && !b.dataset.outOfScope) b.href = b.href.replace(/program-results([\/-])[a-z]+/, `program-results$1${current.id}`);
        (b.querySelector('.esa-button__label') ?? b).textContent = `View ${current.short.toLowerCase()} data`;
      });
    };

    // ARIA tabs: click or arrow keys select; roving tabindex
    const select = (t: HTMLButtonElement, focus = false) => {
      current = metrics.find((m) => m.id === t.dataset.measure) ?? current;
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', t.id);
      if (focus) t.focus();
      paint();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const to = ({ ArrowDown: (i + 1) % n, ArrowRight: (i + 1) % n, ArrowUp: (i - 1 + n) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 } as Record<string, number>)[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select(tabs[to], true);
      });
    });
    states.forEach((g) => {
      g.addEventListener('mouseenter', () => emphasise(g.dataset.state!));
      g.addEventListener('mouseleave', () => emphasise(null));
    });
    paint();
  }
</script>
