---
// Thin spoke wrapper around @esa/docs DocsShell. The shell (sidebar, topbar,
// "On this page" rail, all CSS + scroll-spy) is shared with the hub and every
// other spoke; this wrapper supplies only the CB Fish-specific axes: the brand
// theme CSS, the IBM Plex font links, the brand chrome, and the nav data. Pages
// still import this file, so nothing downstream changed when the shell moved up.
// Import DocsShell FIRST — it pulls in @esa/tokens (the :root primitives +
// default teal semantics). The theme CSS must load AFTER so it wins: a
// [data-theme] block and :root have equal specificity, so source order decides.
import DocsShell from '@esa/docs/DocsShell.astro';
import '../styles/theme-cb-fish.css';
import CbfMark from '../components/shared/cbf-mark.astro';
import { allGroups } from '../data/ds-nav';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  activeHref?: string; // base-less, e.g. "/design-system/foundations/color"
}
const { title = 'CB Fish — Design System', activeHref = '' } = Astro.props;
---
<DocsShell
  title={title}
  activeHref={activeHref}
  groups={allGroups}
  theme="cb-fish"
  brandMark="CB"
  brandName="CB Fish"
  brandTag="Design System"
  brandHref="/design-system"
>
  <span slot="brand-mark" style="display: inline-flex; color: var(--color-primary, #1e5386);"><CbfMark size="30" /></span>

  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <a class="topbar-action" slot="topbar-actions" href={withBase('/')}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Prototype Library
  </a>

  <slot />
</DocsShell>
