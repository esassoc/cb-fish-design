---
// CB Fish base layout — wires the hub tokens + the CB Fish theme, loads IBM Plex,
// and sets data-theme="cb-fish" so every inherited esa-* component re-skins.
import '@esa/tokens/tokens.css';
import '@esa/tokens/component-tokens.css';
import '../styles/theme-cb-fish.css';

interface Props {
  title?: string;
}
const { title = 'Columbia Basin Fish & Wildlife Program' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="cb-fish">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-sans, system-ui, sans-serif);
        color: var(--color-text-primary, #171717);
        background: var(--color-surface, #fff);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-text-link, #1e5386); text-decoration: none; }
      img { display: block; max-width: 100%; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
